// Modo Vim: o motor que transforma teclas em movimentos e edições.
//
// Tudo aqui é `func`: o motor recebe o texto, o cursor e o estado do Vim e
// devolve os novos. O que só o estúdio sabe fazer — salvar, fechar a aba,
// abrir um arquivo, rodar o hivec — volta em `effects`, mensagens comuns que
// a dobra despacha depois. Posições contam caracteres, como no resto do editor.
//
// As teclas chegam na notação do Vim: um caractere (`j`, `$`, `J`) ou um nome
// entre `<` e `>` (`<Esc>`, `<CR>`, `<BS>`, `<Space>`, `<C-r>`, `<Left>`…).

import ./model
import ./highlight
import ./native.go
import ./complete
import ./search
import ./analysis

// ── o que entra e o que sai ──────────────────────────────────────────────

// O documento ativo visto pelo motor. `top` e `rows` são a parte do texto que
// a página mostra (para `H`, `L`, `Ctrl+D`, `zz`…) e `tab` a largura do tab.
// Na saída, `scroll` é a linha que deve ir para o topo (-1 = nenhuma), `clip`
// o que copiar para a área de transferência e `effects` o que a dobra faz.
type Editor {
	text:     Str
	caret:    Int
	vim:      model.Vim
	undo:     model.Snapshot[dyn]
	redo:     model.Snapshot[dyn]
	dirty:    Bool
	anyDirty: Bool
	numbers:  Bool
	active:   Int
	top:      Int
	rows:     Int
	tab:      Int
	scroll:   Int
	clip:     Str
	effects:  model.Msg[dyn]
}

// Para onde um movimento leva o cursor, e como um operador o entende. `keep`
// é de `j`/`k`, que guardam a coluna desejada. `note` é uma mensagem (chave
// do i18n, com `arg` no lugar de `%1`) e `bad` diz que ela é um erro.
type Target {
	pos:       Int
	linewise:  Bool
	inclusive: Bool
	keep:      Bool
	ok:        Bool
	note:      Str
	arg:       Str
	bad:       Bool
}

// Um trecho do texto: de `from` até antes de `to`.
type Span {
	from:     Int
	to:       Int
	linewise: Bool
	ok:       Bool
}

// O resultado de ler as teclas pendentes: `#Wait` (faltam teclas), `#Done` ou
// `#Fail`. `keep` diz que a coluna desejada não muda (depois de `j`, `k`, `$`).
type Step {
	editor: Editor
	status: Atom
	keep:   Bool
}

// Um endereço da linha de comando (`12`, `.`, `$`, `'<`, `.+2`), a partir de 0.
type Address {
	line: Int
	next: Int
	ok:   Bool
}

// ── pequenas peças ───────────────────────────────────────────────────────

// A coluna "fim da linha" que `$` deixa para `j` e `k`.
func endColumn(): Int {
	return 1000000000
}

func undoLimit(): Int {
	return 200
}

func minInt(a: Int, b: Int): Int {
	if a < b {
		return a
	}
	return b
}

func maxInt(a: Int, b: Int): Int {
	if a > b {
		return a
	}
	return b
}

func clampInt(value: Int, low: Int, high: Int): Int {
	if value > high {
		return maxInt(low, high)
	}
	if value < low {
		return low
	}
	return value
}

func at(chars: Str[], i: Int): Str {
	if chars bounds i {
		return chars[i]
	}
	return ""
}

func atInt(values: Int[], i: Int): Int {
	if values bounds i {
		return values[i]
	}
	return -1
}

func isBlank(c: Str): Bool {
	return c == " " || c == "\t"
}

func isSpace(c: Str): Bool {
	return c == " " || c == "\t" || c == "\n" || c == "\r"
}

// Letras, dígitos e `_` — e qualquer letra fora do ASCII (á, ç…).
func isKeyword(c: Str): Bool {
	return highlight.isIdent(c) || c > "~"
}

func isLetter(c: Str): Bool {
	return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

// Para `w`, `b`, `e`: 0 espaço, 1 palavra, 2 pontuação. Com `big` (W, B, E),
// tudo o que não é espaço é uma palavra.
func classOf(c: Str, big: Bool): Int {
	if c == "" || isSpace(c) {
		return 0
	}
	if big || isKeyword(c) {
		return 1
	}
	return 2
}

// Para `iw` e `aw`: como `classOf`, mas o fim da linha (-1) é uma fronteira.
func kindOf(c: Str, big: Bool): Int {
	if c == "" || c == "\n" {
		return -1
	}
	if isBlank(c) {
		return 0
	}
	return classOf(c, big)
}

func digitOf(key: Str): Int {
	if len(key) == 1 && highlight.isDigit(key) {
		if hive.conv.sti(key) is Result.Ok(value) {
			return value
		}
	}
	return -1
}

// A tecla como texto: `<Space>` é um espaço, `<CR>` uma quebra de linha.
func literal(key: Str): Str {
	if key == "<Space>" {
		return " "
	} else if key == "<Tab>" {
		return "\t"
	} else if key == "<CR>" {
		return "\n"
	} else if len(key) == 1 {
		return key
	}
	return ""
}

func isEscape(key: Str): Bool {
	return key == "<Esc>" || key == "<C-[>" || key == "<C-c>"
}

func endsWith(text: Str, suffix: Str): Bool {
	size := len(text)
	return size >= len(suffix) && complete.skip(text, size - len(suffix)) == suffix
}

// O pedaço de `text` de `from` até antes de `to`.
func slice(text: Str, from: Int, to: Int): Str {
	if to <= from {
		return ""
	}
	return complete.take(complete.skip(text, from), to - from)
}

func cut(text: Str, from: Int, to: Int): Str {
	return complete.take(text, from) + complete.skip(text, to)
}

func insertAt(text: Str, pos: Int, piece: Str): Str {
	return complete.take(text, pos) + piece + complete.skip(text, pos)
}

func repeatText(text: Str, times: Int): Str {
	mut Str[dyn] parts = []
	for n := 0; n < times; n++ {
		append(parts, text)
	}
	return join(parts, "")
}

func trim(text: Str): Str {
	rest := analysis.trimLeft(text)
	chars := split(rest, "")
	mut end := len(chars)
	for ; end > 0; end-- {
		if !isBlank(at(chars, end - 1)) {
			break
		}
	}
	return complete.take(rest, end)
}

func leadingBlanks(line: Str): Str {
	return complete.take(line, len(line) - len(analysis.trimLeft(line)))
}

func upper(text: Str): Str {
	return native.upper(text)
}

func toggleCase(text: Str): Str {
	mut Str[dyn] out = []
	for each c in split(text, "") {
		low := search.lower(c)
		if low != c {
			append(out, low)
		} else {
			append(out, upper(c))
		}
	}
	return join(out, "")
}

proc keysFrom(keys: Str[], from: Int, count: Int, out: mut Str[dyn]): void {
	for i := from; i < from + count; i++ {
		append(out, at(keys, i))
	}
}

func isAny(value: Str, options: Str[]): Bool {
	return indexOf(options, value) is Result.Ok(_)
}

// ── linhas e colunas ─────────────────────────────────────────────────────

// Onde começa a linha de `pos`.
func lineStart(chars: Str[], pos: Int): Int {
	mut i := minInt(pos, len(chars))
	for ; i > 0; i-- {
		if at(chars, i - 1) == "\n" {
			return i
		}
	}
	return 0
}

// Onde termina a linha de `pos`: o índice do "\n" (ou o fim do texto).
func lineEnd(chars: Str[], pos: Int): Int {
	for i := maxInt(pos, 0); i < len(chars); i++ {
		if at(chars, i) == "\n" {
			return i
		}
	}
	return len(chars)
}

// A linha (a partir de 0) de `pos`.
func lineOf(chars: Str[], pos: Int): Int {
	mut line := 0
	for i := 0; i < pos && i < len(chars); i++ {
		if at(chars, i) == "\n" {
			line++
		}
	}
	return line
}

// Onde começa a linha `line` (a partir de 0).
func lineOffset(chars: Str[], line: Int): Int {
	if line <= 0 {
		return 0
	}
	mut seen := 0
	for i := 0; i < len(chars); i++ {
		if at(chars, i) == "\n" {
			seen++
			if seen == line {
				return i + 1
			}
		}
	}
	return lineStart(chars, len(chars))
}

// A última linha de verdade: um "\n" no fim do texto não abre outra.
func lastLine(chars: Str[]): Int {
	size := len(chars)
	total := lineOf(chars, size)
	if total > 0 && at(chars, size - 1) == "\n" {
		return total - 1
	}
	return total
}

func lineText(lines: Str[], line: Int): Str {
	if lines bounds line {
		return lines[line]
	}
	return ""
}

// Onde começa a linha `line` de um texto já partido em linhas.
func offsetOfLine(lines: Str[], line: Int): Int {
	mut offset := 0
	for i := 0; i < line && i < len(lines); i++ {
		offset = offset + len(lines[i]) + 1
	}
	return offset
}

func isEmptyAt(chars: Str[], start: Int): Bool {
	return start >= len(chars) || at(chars, start) == "\n"
}

// A coluna na tela de `pos`: um tab vai até a próxima parada.
func displayColumn(chars: Str[], pos: Int, tab: Int): Int {
	mut column := 0
	for i := lineStart(chars, pos); i < pos; i++ {
		if at(chars, i) == "\t" && tab > 0 {
			column = column + tab - column % tab
		} else {
			column++
		}
	}
	return column
}

// O caractere da linha que começa em `start` que ocupa a coluna `want` da
// tela, sem passar do último.
func atColumn(chars: Str[], start: Int, want: Int, tab: Int): Int {
	end := lineEnd(chars, start)
	mut column := 0
	for i := start; i < end; i++ {
		mut width := 1
		if at(chars, i) == "\t" && tab > 0 {
			width = tab - column % tab
		}
		if want < column + width {
			return i
		}
		column = column + width
	}
	return maxInt(end - 1, start)
}

// No modo normal o cursor fica sobre um caractere: nunca no fim de uma linha
// (a não ser numa vazia) nem depois do "\n" final do texto.
func clampNormal(chars: Str[], pos: Int): Int {
	size := len(chars)
	mut p := clampInt(pos, 0, size)
	if p == size && size > 0 && at(chars, size - 1) == "\n" {
		p = size - 1
	}
	start := lineStart(chars, p)
	end := lineEnd(chars, p)
	if p >= end && end > start {
		return end - 1
	}
	return p
}

func firstNonBlank(chars: Str[], pos: Int): Int {
	end := lineEnd(chars, pos)
	for i := lineStart(chars, pos); i < end; i++ {
		if !isBlank(at(chars, i)) {
			return i
		}
	}
	return clampNormal(chars, end)
}

func lastNonBlank(chars: Str[], pos: Int): Int {
	start := lineStart(chars, pos)
	for i := lineEnd(chars, pos) - 1; i >= start; i-- {
		if !isBlank(at(chars, i)) {
			return i
		}
	}
	return start
}

// As linhas inteiras de `a` até `b`, com o "\n" do fim.
func lineSpan(chars: Str[], a: Int, b: Int): Span {
	return Span(lineStart(chars, a), minInt(lineEnd(chars, b) + 1, len(chars)), true, true)
}

func noSpan(): Span {
	return Span(0, 0, false, false)
}

// ── movimentos ───────────────────────────────────────────────────────────

func moveTo(pos: Int): Target {
	return Target(pos, false, false, false, true, "", "", false)
}

func inclusiveTo(pos: Int): Target {
	return Target(pos, false, true, false, true, "", "", false)
}

func lineTo(pos: Int): Target {
	return Target(pos, true, false, false, true, "", "", false)
}

func keepTo(pos: Int, ok: Bool): Target {
	return Target(pos, true, false, true, ok, "", "", false)
}

func noMove(): Target {
	return Target(0, false, false, false, false, "", "", false)
}

func problem(note: Str, arg: Str): Target {
	return Target(0, false, false, false, false, note, arg, true)
}

// `w`: o começo da próxima palavra. Uma linha vazia também conta.
func nextWord(chars: Str[], pos: Int, big: Bool): Int {
	size := len(chars)
	mut i := pos
	kind := classOf(at(chars, i), big)
	if kind != 0 {
		for ; i < size; i++ {
			if classOf(at(chars, i), big) != kind {
				break
			}
		}
	}
	for ; i < size; i++ {
		c := at(chars, i)
		if c == "\n" && at(chars, i + 1) == "\n" {
			return i + 1
		}
		if !isSpace(c) {
			return i
		}
	}
	return size
}

// `e`: o fim da palavra (a próxima, se já estiver no fim de uma).
func wordEnd(chars: Str[], pos: Int, big: Bool): Int {
	size := len(chars)
	mut i := pos + 1
	for ; i < size; i++ {
		if !isSpace(at(chars, i)) {
			break
		}
	}
	if i >= size {
		return maxInt(size - 1, 0)
	}
	kind := classOf(at(chars, i), big)
	for ; i + 1 < size; i++ {
		if classOf(at(chars, i + 1), big) != kind {
			break
		}
	}
	return i
}

// `b`: o começo da palavra (a anterior, se já estiver no começo de uma).
func wordBack(chars: Str[], pos: Int, big: Bool): Int {
	mut i := pos - 1
	for ; i > 0; i-- {
		c := at(chars, i)
		if c == "\n" && at(chars, i - 1) == "\n" {
			return i
		}
		if !isSpace(c) {
			break
		}
	}
	if i <= 0 {
		return 0
	}
	kind := classOf(at(chars, i), big)
	for ; i > 0; i-- {
		if classOf(at(chars, i - 1), big) != kind {
			break
		}
	}
	return i
}

// `ge`: o fim da palavra anterior.
func wordEndBack(chars: Str[], pos: Int, big: Bool): Int {
	mut i := pos
	kind := classOf(at(chars, i), big)
	if kind != 0 {
		for ; i >= 0; i-- {
			if classOf(at(chars, i), big) != kind {
				break
			}
		}
	}
	for ; i > 0; i-- {
		c := at(chars, i)
		if c == "\n" && at(chars, i - 1) == "\n" {
			return i
		}
		if !isSpace(c) {
			return i
		}
	}
	return 0
}

// `cw` muda até o fim da palavra, mesmo estando no último caractere dela.
func changeWordEnd(chars: Str[], pos: Int, big: Bool, count: Int): Int {
	mut p := pos
	kind := classOf(at(chars, p), big)
	if classOf(at(chars, p + 1), big) == kind && at(chars, p + 1) != "\n" {
		p = wordEnd(chars, p, big)
	}
	for n := 1; n < count; n++ {
		p = wordEnd(chars, p, big)
	}
	return p
}

// `}`: a próxima linha vazia (ou o fim do texto).
// Anda linha a linha a partir de `s` enquanto elas forem vazias (`empty`) ou
// não, para a frente ou para trás.
func skipLines(chars: Str[], from: Int, empty: Bool, forward: Bool): Int {
	size := len(chars)
	mut s := from
	for ;; {
		if forward && s >= size {
			return s
		}
		if !forward && s <= 0 {
			return s
		}
		if isEmptyAt(chars, s) != empty {
			return s
		}
		if forward {
			s = lineEnd(chars, s) + 1
		} else {
			s = lineStart(chars, s - 1)
		}
	}
	return s
}

func paragraphForward(chars: Str[], pos: Int, count: Int): Int {
	size := len(chars)
	mut s := lineStart(chars, pos)
	for n := 0; n < count; n++ {
		s = skipLines(chars, skipLines(chars, s, true, true), false, true)
	}
	if s >= size {
		return size
	}
	return s
}

// `{`: a linha vazia anterior (ou o começo do texto).
func paragraphBack(chars: Str[], pos: Int, count: Int): Int {
	mut s := lineStart(chars, pos)
	for n := 0; n < count; n++ {
		s = skipLines(chars, skipLines(chars, s, true, false), false, false)
	}
	return s
}

func partnerOf(c: Str): Str {
	if c == "(" {
		return ")"
	} else if c == ")" {
		return "("
	} else if c == "[" {
		return "]"
	} else if c == "]" {
		return "["
	} else if c == "\{" {
		return "}"
	} else if c == "}" {
		return "\{"
	}
	return ""
}

// `%`: o par do primeiro parêntese, colchete ou chave da linha a partir do cursor.
func matchPair(chars: Str[], pos: Int): Result<Int, Bool> {
	end := lineEnd(chars, pos)
	mut i := pos
	for ; i < end; i++ {
		if partnerOf(at(chars, i)) != "" {
			break
		}
	}
	if i >= end {
		return Result.Error(false)
	}
	c := at(chars, i)
	partner := partnerOf(c)
	forward := c == "(" || c == "[" || c == "\{"
	mut depth := 0
	mut j := i
	for ; j >= 0 && j < len(chars); {
		here := at(chars, j)
		if here == c {
			depth++
		} else if here == partner {
			depth--
			if depth == 0 {
				return Result.Ok(j)
			}
		}
		if forward {
			j++
		} else {
			j--
		}
	}
	return Result.Error(false)
}

// `f`, `t`, `F`, `T`: o `count`-ésimo `target` na linha. `again` é o `;`,
// que não deixa `t` parado diante do mesmo caractere.
func findChar(chars: Str[], pos: Int, kind: Str, target: Str, count: Int, again: Bool): Result<Int, Bool> {
	start := lineStart(chars, pos)
	end := lineEnd(chars, pos)
	forward := kind == "f" || kind == "t"
	mut i := pos
	if again && kind == "t" {
		i = pos + 1
	} else if again && kind == "T" {
		i = pos - 1
	}
	mut left := count
	for ; left > 0; {
		if forward {
			i++
		} else {
			i--
		}
		if i < start || i >= end {
			return Result.Error(false)
		}
		if at(chars, i) == target {
			left--
		}
	}
	if kind == "t" {
		return Result.Ok(i - 1)
	} else if kind == "T" {
		return Result.Ok(i + 1)
	}
	return Result.Ok(i)
}

func reversedFind(kind: Str): Str {
	if kind == "f" {
		return "F"
	} else if kind == "F" {
		return "f"
	} else if kind == "t" {
		return "T"
	}
	return "t"
}

// Quantas teclas o movimento que começa em `i` usa: 0 = faltam teclas,
// -1 = não é um movimento.
func motionLength(keys: Str[], i: Int): Int {
	k := at(keys, i)
	next := at(keys, i + 1)
	singles := ["h", "j", "k", "l", "w", "W", "b", "B", "e", "E", "0", "^", "$", "G", "\{", "}", "%", ";", ",",
		"n", "N", "H", "M", "L", "_", "|", "+", "-", "<Left>", "<Right>", "<Up>", "<Down>", "<Home>", "<End>",
		"<BS>", "<Space>", "<CR>"]
	if isAny(k, singles) {
		return 1
	}
	if k == "g" {
		if next == "" {
			return 0
		}
		if isAny(next, ["g", "e", "E", "_", "j", "k", "0", "^", "$"]) {
			return 2
		}
		return -1
	}
	if k == "f" || k == "F" || k == "t" || k == "T" {
		if next == "" {
			return 0
		}
		return 2
	}
	return -1
}

// Para onde o movimento `keys` leva o cursor, repetido `count` vezes.
func motion(ed: Editor, chars: Str[], keys: Str[], count: Int, hasCount: Bool): Target {
	pos := ed.caret
	k := at(keys, 0)
	arg := at(keys, 1)
	size := len(chars)
	final := lastLine(chars)
	if k == "h" || k == "<Left>" {
		return moveTo(maxInt(lineStart(chars, pos), pos - count))
	} else if k == "l" || k == "<Right>" {
		return moveTo(minInt(pos + count, lineEnd(chars, pos)))
	} else if k == "<BS>" {
		mut p := pos
		for n := 0; n < count && p > 0; n++ {
			p--
			if at(chars, p) == "\n" && p > lineStart(chars, p) {
				p--
			}
		}
		return moveTo(p)
	} else if k == "<Space>" {
		mut p := pos
		for n := 0; n < count && p < size; n++ {
			p++
			if at(chars, p) == "\n" && p > lineStart(chars, p) {
				p++
			}
		}
		return moveTo(minInt(p, size))
	} else if k == "j" || k == "<Down>" || (k == "g" && arg == "j") {
		line := lineOf(chars, pos)
		wanted := minInt(line + count, final)
		return keepTo(atColumn(chars, lineOffset(chars, wanted), ed.vim.column, ed.tab), wanted != line)
	} else if k == "k" || k == "<Up>" || (k == "g" && arg == "k") {
		line := lineOf(chars, pos)
		wanted := maxInt(line - count, 0)
		return keepTo(atColumn(chars, lineOffset(chars, wanted), ed.vim.column, ed.tab), wanted != line)
	} else if k == "+" || k == "<CR>" || k == "-" || k == "_" {
		line := lineOf(chars, pos)
		mut wanted := line + count
		if k == "-" {
			wanted = line - count
		} else if k == "_" {
			wanted = line + count - 1
		}
		if wanted < 0 || wanted > final {
			return noMove()
		}
		return lineTo(firstNonBlank(chars, lineOffset(chars, wanted)))
	} else if k == "0" || k == "<Home>" || (k == "g" && arg == "0") {
		return moveTo(lineStart(chars, pos))
	} else if k == "^" || (k == "g" && arg == "^") {
		return moveTo(firstNonBlank(chars, pos))
	} else if k == "$" || k == "<End>" || (k == "g" && arg == "$") || (k == "g" && arg == "_") {
		wanted := minInt(lineOf(chars, pos) + count - 1, final)
		start := lineOffset(chars, wanted)
		end := lineEnd(chars, start)
		if end == start {
			return moveTo(start)
		}
		if k == "g" && arg == "_" {
			return inclusiveTo(lastNonBlank(chars, start))
		}
		return inclusiveTo(end - 1)
	} else if k == "|" {
		return moveTo(atColumn(chars, lineStart(chars, pos), count - 1, ed.tab))
	} else if k == "G" || (k == "g" && arg == "g") {
		mut line := final
		if k == "g" {
			line = 0
		}
		if hasCount {
			line = clampInt(count - 1, 0, final)
		}
		return lineTo(firstNonBlank(chars, lineOffset(chars, line)))
	} else if k == "w" || k == "W" {
		mut p := pos
		for n := 0; n < count; n++ {
			p = nextWord(chars, p, k == "W")
		}
		return moveTo(p)
	} else if k == "b" || k == "B" {
		mut p := pos
		for n := 0; n < count; n++ {
			p = wordBack(chars, p, k == "B")
		}
		return moveTo(p)
	} else if k == "e" || k == "E" {
		mut p := pos
		for n := 0; n < count; n++ {
			p = wordEnd(chars, p, k == "E")
		}
		return inclusiveTo(p)
	} else if k == "g" && (arg == "e" || arg == "E") {
		mut p := pos
		for n := 0; n < count; n++ {
			p = wordEndBack(chars, p, arg == "E")
		}
		return inclusiveTo(p)
	} else if k == "}" {
		return moveTo(paragraphForward(chars, pos, count))
	} else if k == "\{" {
		return moveTo(paragraphBack(chars, pos, count))
	} else if k == "%" {
		if hasCount {
			line := clampInt((count * (final + 1) + 99) / 100 - 1, 0, final)
			return lineTo(firstNonBlank(chars, lineOffset(chars, line)))
		}
		if matchPair(chars, pos) is Result.Ok(found) {
			return inclusiveTo(found)
		}
		return noMove()
	} else if k == "f" || k == "F" || k == "t" || k == "T" {
		return findTarget(chars, pos, k, literal(arg), count, false)
	} else if k == ";" || k == "," {
		kind := at(ed.vim.find, 0)
		target := at(ed.vim.find, 1)
		if kind == "" || target == "" {
			return noMove()
		}
		if k == "," {
			return findTarget(chars, pos, reversedFind(kind), target, count, true)
		}
		return findTarget(chars, pos, kind, target, count, true)
	} else if k == "H" || k == "M" || k == "L" {
		top := clampInt(ed.top, 0, final)
		bottom := clampInt(ed.top + maxInt(ed.rows, 1) - 1, top, final)
		mut line := top + (bottom - top) / 2
		if k == "H" {
			line = minInt(top + count - 1, bottom)
		} else if k == "L" {
			line = maxInt(bottom - count + 1, top)
		}
		return lineTo(firstNonBlank(chars, lineOffset(chars, line)))
	} else if k == "n" || k == "N" {
		return searchTarget(ed, chars, k == "N", count)
	}
	return noMove()
}

func findTarget(chars: Str[], pos: Int, kind: Str, target: Str, count: Int, again: Bool): Target {
	if target == "" {
		return noMove()
	}
	found := findChar(chars, pos, kind, target, count, again)
	if found is Result.Ok(p) {
		if kind == "f" || kind == "t" {
			return inclusiveTo(p)
		}
		return moveTo(p)
	}
	return noMove()
}

// ── busca ────────────────────────────────────────────────────────────────

// Onde `pattern` aparece em `text`, sem sobreposição, no máximo `limit` vezes.
// O texto é literal: não há expressões regulares.
func occurrencesOf(text: Str, pattern: Str, sensitive: Bool, limit: Int): Int[dyn] {
	mut Int[dyn] found = []
	if pattern == "" {
		return found
	}
	mut haystack := text
	mut needle := pattern
	if !sensitive {
		haystack = search.lower(text)
		needle = search.lower(pattern)
	}
	pieces := split(haystack, needle)
	size := len(needle)
	mut offset := 0
	for i := 0; i + 1 < len(pieces) && len(found) < limit; i++ {
		offset = offset + len(at(pieces, i))
		append(found, offset)
		offset = offset + size
	}
	return found
}

// Maiúsculas no padrão fazem a busca diferenciar maiúsculas (smartcase).
func sensitiveTo(pattern: Str): Bool {
	return search.lower(pattern) != pattern
}

// As ocorrências de uma busca do Vim: smartcase e, com `whole` (`*`, `#`),
// só palavras inteiras.
func matchesOf(text: Str, pattern: Str, whole: Bool, limit: Int): Int[dyn] {
	found := occurrencesOf(text, pattern, sensitiveTo(pattern), limit)
	if !whole {
		return found
	}
	chars := split(text, "")
	size := len(pattern)
	mut Int[dyn] kept = []
	for each p in found {
		if !isKeyword(at(chars, p - 1)) && !isKeyword(at(chars, p + size)) {
			append(kept, p)
		}
	}
	return kept
}

// `n` e `N`: a próxima ocorrência da última busca, dando a volta no texto.
func searchTarget(ed: Editor, chars: Str[], reverse: Bool, count: Int): Target {
	pattern := ed.vim.pattern
	if pattern == "" {
		return problem("E35: Nenhuma busca anterior", "")
	}
	found := matchesOf(ed.text, pattern, ed.vim.whole, 1000000)
	if len(found) == 0 {
		return problem("E486: Padrão não encontrado: %1", pattern)
	}
	backward := ed.vim.backward != reverse
	mut p := ed.caret
	mut wrapped := false
	for n := 0; n < count; n++ {
		mut next := -1
		if backward {
			for each m in found {
				if m < p {
					next = m
				}
			}
			if next < 0 {
				wrapped = true
				next = atInt(found, len(found) - 1)
			}
		} else {
			for each m in found {
				if m > p && next < 0 {
					next = m
				}
			}
			if next < 0 {
				wrapped = true
				next = atInt(found, 0)
			}
		}
		p = next
	}
	mut t := moveTo(p)
	if wrapped && backward {
		t.note = "a busca chegou ao INÍCIO, continuando do FIM"
	} else if wrapped {
		t.note = "a busca chegou ao FIM, continuando do INÍCIO"
	}
	return t
}

// A palavra sob o cursor (ou a primeira depois dele na linha), para `*` e `#`.
func wordUnder(chars: Str[], pos: Int): Span {
	end := lineEnd(chars, pos)
	mut i := pos
	for ; i < end; i++ {
		if isKeyword(at(chars, i)) {
			break
		}
	}
	if i >= end {
		return noSpan()
	}
	mut from := i
	for ; from > 0; from-- {
		if !isKeyword(at(chars, from - 1)) {
			break
		}
	}
	mut to := i
	for ; to < end; to++ {
		if !isKeyword(at(chars, to)) {
			break
		}
	}
	return Span(from, to, false, true)
}

// ── objetos de texto ─────────────────────────────────────────────────────

func runStart(chars: Str[], i: Int, big: Bool): Int {
	kind := kindOf(at(chars, i), big)
	mut s := i
	for ; s > 0; s-- {
		if kindOf(at(chars, s - 1), big) != kind {
			break
		}
	}
	return s
}

func runEnd(chars: Str[], i: Int, big: Bool): Int {
	kind := kindOf(at(chars, i), big)
	mut e := i
	for ; e < len(chars); e++ {
		if kindOf(at(chars, e), big) != kind {
			break
		}
	}
	return e
}

// `iw`, `aw`, `iW`, `aW`.
func wordObject(chars: Str[], pos: Int, inner: Bool, big: Bool, count: Int): Span {
	here := kindOf(at(chars, pos), big)
	if here < 0 {
		return Span(pos, pos, false, true)
	}
	mut from := runStart(chars, pos, big)
	mut to := runEnd(chars, pos, big)
	if !inner {
		if here == 0 {
			if kindOf(at(chars, to), big) > 0 {
				to = runEnd(chars, to, big)
			}
		} else if kindOf(at(chars, to), big) == 0 {
			to = runEnd(chars, to, big)
		} else if from > 0 && kindOf(at(chars, from - 1), big) == 0 {
			from = runStart(chars, from - 1, big)
		}
	}
	for n := 1; n < count; n++ {
		if kindOf(at(chars, to), big) < 0 {
			break
		}
		to = runEnd(chars, to, big)
		if !inner && kindOf(at(chars, to), big) == 0 {
			to = runEnd(chars, to, big)
		}
	}
	return Span(from, to, false, true)
}

// `i"`, `a"`, `i'`, `a'`: o par de aspas da linha que contém o cursor, ou o
// primeiro depois dele.
func quoteObject(chars: Str[], pos: Int, inner: Bool, quote: Str): Span {
	end := lineEnd(chars, pos)
	mut Int[dyn] quotes = []
	for i := lineStart(chars, pos); i < end; i++ {
		if at(chars, i) == quote && at(chars, i - 1) != "\\" {
			append(quotes, i)
		}
	}
	mut open := -1
	mut close := -1
	for p := 0; p + 1 < len(quotes); p = p + 2 {
		b := atInt(quotes, p + 1)
		if open < 0 && pos <= b {
			open = atInt(quotes, p)
			close = b
		}
	}
	if open < 0 {
		return noSpan()
	}
	if inner {
		return Span(open + 1, close, false, true)
	}
	mut to := close + 1
	for ; true; to++ {
		if !isBlank(at(chars, to)) {
			break
		}
	}
	return Span(open, to, false, true)
}

// O `open` que ainda não foi fechado, andando para trás a partir de `from`.
func unmatchedOpen(chars: Str[], from: Int, open: Str, close: Str): Int {
	mut depth := 0
	for i := from; i >= 0; i-- {
		c := at(chars, i)
		if c == close {
			depth++
		} else if c == open {
			if depth == 0 {
				return i
			}
			depth--
		}
	}
	return -1
}

func matchingClose(chars: Str[], openAt: Int, open: Str, close: Str): Int {
	mut depth := 0
	for i := openAt; i < len(chars); i++ {
		c := at(chars, i)
		if c == open {
			depth++
		} else if c == close {
			depth--
			if depth == 0 {
				return i
			}
		}
	}
	return -1
}

func onlyBlanks(chars: Str[], from: Int, to: Int): Bool {
	for i := from; i < to; i++ {
		if !isBlank(at(chars, i)) {
			return false
		}
	}
	return true
}

// `i(`, `a{`, `i[`, `a<`…: o bloco que envolve o cursor. Por dentro de um bloco
// de várias linhas, `i{` pega as linhas inteiras entre as chaves.
func blockObject(chars: Str[], pos: Int, inner: Bool, open: Str, close: Str, count: Int): Span {
	mut o := pos
	if at(chars, pos) != open {
		o = unmatchedOpen(chars, pos - 1, open, close)
	}
	for n := 1; n < count && o >= 0; n++ {
		o = unmatchedOpen(chars, o - 1, open, close)
	}
	if o < 0 {
		return noSpan()
	}
	c := matchingClose(chars, o, open, close)
	if c < 0 {
		return noSpan()
	}
	if !inner {
		return Span(o, c + 1, false, true)
	}
	mut from := o + 1
	mut to := c
	if at(chars, from) == "\n" {
		from++
	}
	closeLine := lineStart(chars, c)
	if closeLine > from && onlyBlanks(chars, closeLine, c) {
		to = closeLine
	}
	if to < from {
		to = from
	}
	linewise := from < to && from == lineStart(chars, from) && at(chars, to - 1) == "\n"
	return Span(from, to, linewise, true)
}

// `ip` e `ap`: o parágrafo (ou a sequência de linhas vazias) do cursor.
func paragraphObject(text: Str, chars: Str[], pos: Int, inner: Bool) : Span {
	lines := split(text, "\n")
	final := lastLine(chars)
	current := lineOf(chars, pos)
	empty := lineText(lines, current) == ""
	mut first := current
	for ; first > 0; first-- {
		if (lineText(lines, first - 1) == "") != empty {
			break
		}
	}
	mut last := current
	for ; last < final; last++ {
		if (lineText(lines, last + 1) == "") != empty {
			break
		}
	}
	if !inner {
		if last < final {
			last++
			for ; last < final; last++ {
				if (lineText(lines, last + 1) == "") != !empty {
					break
				}
			}
		} else if first > 0 {
			first--
			for ; first > 0; first-- {
				if (lineText(lines, first - 1) == "") != !empty {
					break
				}
			}
		}
	}
	return lineSpan(chars, lineOffset(chars, first), lineOffset(chars, last))
}

func textObject(text: Str, chars: Str[], pos: Int, inner: Bool, obj: Str, count: Int): Span {
	if obj == "w" || obj == "W" {
		return wordObject(chars, pos, inner, obj == "W", count)
	} else if obj == "\"" || obj == "'" || obj == "`" {
		return quoteObject(chars, pos, inner, obj)
	} else if obj == "(" || obj == ")" || obj == "b" {
		return blockObject(chars, pos, inner, "(", ")", count)
	} else if obj == "\{" || obj == "}" || obj == "B" {
		return blockObject(chars, pos, inner, "\{", "}", count)
	} else if obj == "[" || obj == "]" {
		return blockObject(chars, pos, inner, "[", "]", count)
	} else if obj == "<" || obj == ">" {
		return blockObject(chars, pos, inner, "<", ">", count)
	} else if obj == "p" {
		return paragraphObject(text, chars, pos, inner)
	}
	return noSpan()
}

// ── desfazer ─────────────────────────────────────────────────────────────
//
// O motor altera o editor no lugar (`ed: mut Editor`): nenhuma proc devolve
// um editor novo, o que deixa o compilador compartilhá-lo com quem só o lê em
// vez de copiá-lo a cada tecla.

func snapshot(ed: Editor): model.Snapshot {
	return model.Snapshot(ed.text, ed.caret)
}

// Guarda `before` para o `u`. Uma alteração nova esquece o que dava para refazer.
proc pushUndo(ed: mut Editor, before: model.Snapshot): void {
	mut model.Snapshot[dyn] stack = ed.undo
	append(stack, before)
	if len(stack) > undoLimit() {
		if stack bounds 0 {
			drop(stack, 0, 0)
		}
	}
	ed.undo = stack
	model.Snapshot[dyn] none = []
	ed.redo = none
}

proc undoSteps(ed: mut Editor, count: Int, back: Bool): void {
	mut model.Snapshot[dyn] from = ed.undo
	mut model.Snapshot[dyn] into = ed.redo
	if !back {
		from = ed.redo
		into = ed.undo
	}
	size := len(from)
	done := maxInt(minInt(count, size), 0)
	target := size - done
	if done > 0 && from bounds target {
		snap := from[target]
		append(into, model.Snapshot(ed.text, ed.caret))
		for j := size - 1; j > target; j-- {
			if from bounds j {
				append(into, from[j])
			}
		}
		ed.text = snap.text
		ed.caret = snap.caret
		last := size - 1
		if from bounds last && from bounds target {
			drop(from, target, last)
		}
	}
	if back {
		ed.undo = from
		ed.redo = into
	} else {
		ed.undo = into
		ed.redo = from
	}
	ed.caret = clampNormal(split(ed.text, ""), ed.caret)
	if done == 0 && back {
		say(ed, "Já está na alteração mais antiga", "", false)
	} else if done == 0 {
		say(ed, "Já está na alteração mais recente", "", false)
	}
}

// ── edições ──────────────────────────────────────────────────────────────

proc say(ed: mut Editor, message: Str, arg: Str, bad: Bool): void {
	mut Str[dyn] args = []
	if arg != "" {
		append(args, arg)
	}
	ed.vim.message = message
	ed.vim.args = args
	ed.vim.error = bad
}

proc sayTwo(ed: mut Editor, message: Str, first: Str, second: Str): void {
	ed.vim.message = message
	ed.vim.args = [first, second]
	ed.vim.error = false
}

// Mensagem de "N linhas…", que o Vim só mostra a partir de 3.
proc report(ed: mut Editor, message: Str, lines: Int): void {
	if lines >= 3 {
		say(ed, message, "{lines}", false)
	}
}

func linesIn(text: Str): Int {
	return len(split(text, "\n")) - 1
}

proc effect(ed: mut Editor, message: model.Msg): void {
	mut model.Msg[dyn] effects = ed.effects
	append(effects, message)
	ed.effects = effects
}

// Guarda as teclas da alteração para o `.`.
proc recorded(ed: mut Editor, keys: Str[dyn]): void {
	ed.vim.change = keys
	ed.vim.typed = ""
}

// Copia um trecho para o registrador sem nome.
proc yank(ed: mut Editor, chars: Str[], span: Span): void {
	mut register := slice(ed.text, span.from, span.to)
	if span.linewise && !endsWith(register, "\n") {
		register = register + "\n"
	}
	ed.vim.register = register
	ed.vim.linewise = span.linewise
	ed.clip = register
	if span.linewise {
		if span.from < lineStart(chars, ed.caret) {
			ed.caret = atColumn(chars, span.from, ed.vim.column, ed.tab)
		}
		report(ed, "%1 linhas copiadas", linesIn(register))
	} else {
		ed.caret = clampNormal(chars, span.from)
	}
}

// Apaga um trecho, que vai para o registrador. Apagar a última linha leva junto
// o "\n" de antes dela.
proc deleteSpan(ed: mut Editor, chars: Str[], span: Span): void {
	if span.to <= span.from {
		return
	}
	original := ed.text
	pushUndo(ed, snapshot(ed))
	content := slice(original, span.from, span.to)
	mut from := span.from
	mut register := content
	if span.linewise && !endsWith(content, "\n") {
		register = content + "\n"
		if from > 0 {
			from = from - 1
		}
	}
	ed.vim.register = register
	ed.vim.linewise = span.linewise
	ed.text = cut(original, from, span.to)
	after := split(ed.text, "")
	if span.linewise {
		ed.caret = firstNonBlank(after, clampNormal(after, from))
		report(ed, "%1 linhas a menos", linesIn(register))
		return
	}
	ed.caret = clampNormal(after, from)
}

// Entra no modo de inserção. `before` vai para a pilha de desfazer; `keys` e
// `count` servem para o `.` e para repetir o que for digitado (`3ihi<Esc>`).
proc enterInsert(ed: mut Editor, before: model.Snapshot, keys: Str[dyn], count: Int): void {
	pushUndo(ed, before)
	ed.vim.mode = model.VimMode.InsertMode()
	ed.vim.insertBase = ed.text
	ed.vim.insertAt = ed.caret
	ed.vim.insertKeys = keys
	ed.vim.count = maxInt(count, 1)
}

// Apaga o trecho e entra no modo de inserção no lugar dele. Linhas inteiras
// viram uma linha vazia com a indentação da primeira.
proc changeSpan(ed: mut Editor, chars: Str[], span: Span, keys: Str[dyn]): void {
	before := snapshot(ed)
	original := ed.text
	content := slice(original, span.from, span.to)
	if content != "" {
		ed.vim.register = content
		ed.vim.linewise = span.linewise
		if span.linewise && !endsWith(content, "\n") {
			ed.vim.register = content + "\n"
		}
	}
	if span.linewise {
		indent := leadingBlanks(slice(original, span.from, lineEnd(chars, span.from)))
		mut replacement := indent
		if endsWith(content, "\n") {
			replacement = indent + "\n"
		}
		ed.text = complete.take(original, span.from) + replacement + complete.skip(original, span.to)
		ed.caret = span.from + len(indent)
	} else {
		ed.text = cut(original, span.from, span.to)
		ed.caret = span.from
	}
	enterInsert(ed, before, keys, 1)
}

// A unidade de indentação do arquivo: tab, a não ser que ele indente com espaços.
func indentUnit(text: Str, tab: Int): Str {
	if complete.startsWith(text, "\t") || indexOf(text, "\n\t") is Result.Ok(_) {
		return "\t"
	}
	if complete.startsWith(text, "  ") || indexOf(text, "\n  ") is Result.Ok(_) {
		return repeatText(" ", maxInt(tab, 1))
	}
	return "\t"
}

func unindent(line: Str, tab: Int): Str {
	return complete.skip(line, indentCut(split(line, ""), 0, tab))
}

// Quantos caracteres um nível de recuo ocupa a partir de `from`: um tab, ou
// até `tab` espaços.
func indentCut(chars: Str[], from: Int, tab: Int): Int {
	if at(chars, from) == "\t" {
		return 1
	}
	limit := maxInt(tab, 1)
	mut n := 0
	for ; n < limit; n++ {
		if at(chars, from + n) != " " {
			break
		}
	}
	return n
}

// Uma linha indentada (ou desindentada) `levels` níveis. Linha vazia não ganha
// indentação.
func shiftedLine(line: Str, unit: Str, right: Bool, levels: Int, tab: Int): Str {
	if right {
		if line == "" {
			return line
		}
		return repeatText(unit, levels) + line
	}
	chars := split(line, "")
	mut cut := 0
	for n := 0; n < levels; n++ {
		cut = cut + indentCut(chars, cut, tab)
	}
	return complete.skip(line, cut)
}

// `>` e `<`: indenta ou desindenta as linhas do trecho, `levels` vezes.
proc shiftLines(ed: mut Editor, chars: Str[], span: Span, right: Bool, levels: Int): void {
	first := lineOf(chars, span.from)
	last := lineOf(chars, maxInt(span.to - 1, span.from))
	unit := indentUnit(ed.text, ed.tab)
	mut Str[dyn] lines = split(ed.text, "\n")
	for l := first; l <= last; l++ {
		if lines bounds l {
			lines[l] = shiftedLine(lines[l], unit, right, levels, ed.tab)
		}
	}
	text := join(lines, "\n")
	if text == ed.text {
		return
	}
	pushUndo(ed, snapshot(ed))
	ed.text = text
	ed.caret = firstNonBlank(split(text, ""), offsetOfLine(lines, first))
}

// `g~`, `gu`, `gU`, `~`, `u` e `U` no visual.
proc recase(ed: mut Editor, chars: Str[], span: Span, how: Str): void {
	piece := slice(ed.text, span.from, span.to)
	mut changed := toggleCase(piece)
	if how == "gu" || how == "u" {
		changed = search.lower(piece)
	} else if how == "gU" || how == "U" {
		changed = upper(piece)
	}
	if changed == piece {
		return
	}
	original := ed.text
	pushUndo(ed, snapshot(ed))
	ed.text = complete.take(original, span.from) + changed + complete.skip(original, span.to)
	if !span.linewise {
		ed.caret = clampNormal(split(ed.text, ""), span.from)
	}
}

proc applyOperator(ed: mut Editor, chars: Str[], op: Str, span: Span, keys: Str[dyn], levels: Int): void {
	if op == "y" {
		yank(ed, chars, span)
	} else if op == "d" {
		deleteSpan(ed, chars, span)
		recorded(ed, keys)
	} else if op == "c" {
		changeSpan(ed, chars, span, keys)
	} else if op == ">" || op == "<" {
		shiftLines(ed, chars, span, op == ">", levels)
		recorded(ed, keys)
	} else {
		recase(ed, chars, span, op)
		recorded(ed, keys)
	}
}

// O trecho que um operador pega com um movimento. Um movimento exclusivo que
// termina no começo de uma linha para no fim da anterior — e, se começou antes
// do primeiro caractere não branco, vale pelas linhas inteiras.
func operatorSpan(chars: Str[], caret: Int, t: Target): Span {
	from := minInt(caret, t.pos)
	mut to := maxInt(caret, t.pos)
	if t.linewise {
		return lineSpan(chars, from, to)
	}
	if t.inclusive {
		return Span(from, minInt(to + 1, len(chars)), false, true)
	}
	if to > from && at(chars, to - 1) == "\n" {
		if from <= firstNonBlank(chars, from) && to - 1 > from {
			return lineSpan(chars, from, to - 1)
		}
		to = to - 1
	}
	return Span(from, to, false, true)
}

// Abre uma linha abaixo (ou acima) do cursor, com a indentação dela — e um
// nível a mais depois de `{`, `[` ou `(`.
func openLine(text: Str, caret: Int, below: Bool): complete.TextEdit {
	chars := split(text, "")
	start := lineStart(chars, caret)
	end := lineEnd(chars, caret)
	line := slice(text, start, end)
	mut indent := leadingBlanks(line)
	if below {
		trimmed := trim(line)
		if endsWith(trimmed, "\{") || endsWith(trimmed, "[") || endsWith(trimmed, "(") {
			indent = indent + "\t"
		}
		return complete.TextEdit(insertAt(text, end, "\n" + indent), end + 1 + len(indent))
	}
	return complete.TextEdit(insertAt(text, start, indent + "\n"), start + len(indent))
}

// O que foi digitado desde que a inserção começou em `offset`, se foi só isso.
func insertedText(base: Str, offset: Int, now: Str): Result<Str, Bool> {
	grown := len(now) - len(base)
	if grown < 0 || offset < 0 || offset > len(base) {
		return Result.Error(false)
	}
	if complete.take(now, offset) == complete.take(base, offset) && complete.skip(now, offset + grown) == complete.skip(base, offset) {
		return Result.Ok(slice(now, offset, offset + grown))
	}
	return Result.Error(false)
}

// `Esc` no modo de inserção: repete o que foi digitado se houve contagem, guarda
// para o `.` (com `record`) e volta ao modo normal um caractere para trás.
proc leaveInsert(ed: mut Editor, record: Bool): void {
	base := ed.vim.insertBase
	offset := ed.vim.insertAt
	times := ed.vim.count
	keys := ed.vim.insertKeys
	mut text := ed.text
	mut caret := ed.caret
	typed := insertedText(base, offset, ed.text)
	if typed is Result.Ok(piece) {
		if piece != "" && times > 1 {
			command := at(keys, len(keys) - 1)
			for n := 1; n < times; n++ {
				if command == "o" || command == "O" {
					opened := openLine(text, caret, command == "o")
					text = opened.text
					caret = opened.caret
				}
				text = insertAt(text, caret, piece)
				caret = caret + len(piece)
			}
		}
		if record {
			ed.vim.change = keys
			ed.vim.typed = piece
		}
	}
	chars := split(text, "")
	if caret > lineStart(chars, caret) {
		caret = caret - 1
	}
	ed.text = text
	ed.caret = clampNormal(chars, caret)
	ed.vim.mode = model.VimMode.NormalMode()
	ed.vim.count = 1
	ed.vim.column = displayColumn(chars, ed.caret, ed.tab)
	// Entrou e saiu sem mudar nada: não há o que desfazer.
	mut model.Snapshot[dyn] stack = ed.undo
	last := len(stack) - 1
	if stack bounds last {
		if stack[last].text == text {
			drop(stack, last, last)
		}
	}
	ed.undo = stack
}

// `p` e `P`: o registrador depois (ou antes) do cursor, `count` vezes.
proc put(ed: mut Editor, chars: Str[], before: Bool, count: Int): void {
	register := ed.vim.register
	if register == "" {
		say(ed, "E353: Nada no registrador", "", true)
		return
	}
	original := ed.text
	caret := ed.caret
	linewise := ed.vim.linewise
	pushUndo(ed, snapshot(ed))
	size := len(chars)
	mut piece := repeatText(register, count)
	if linewise {
		mut offset := lineStart(chars, caret)
		if !before {
			end := lineEnd(chars, caret)
			if end >= size {
				offset = size
				piece = "\n" + complete.take(piece, len(piece) - 1)
			} else {
				offset = end + 1
			}
		}
		ed.text = insertAt(original, offset, piece)
		after := split(ed.text, "")
		mut first := offset
		if complete.startsWith(piece, "\n") {
			first = offset + 1
		}
		ed.caret = firstNonBlank(after, first)
		report(ed, "%1 linhas a mais", linesIn(register) * count)
		return
	}
	mut offset := caret
	if !before && offset < size && at(chars, offset) != "\n" {
		offset++
	}
	ed.text = insertAt(original, offset, piece)
	ed.caret = clampNormal(split(ed.text, ""), offset + len(piece) - 1)
}

// `J` (e `gJ`, sem mexer nos espaços): junta `count` linhas a partir do cursor.
proc joinLines(ed: mut Editor, chars: Str[], count: Int, spaces: Bool): void {
	line := lineOf(chars, ed.caret)
	final := lastLine(chars)
	if line >= final {
		return
	}
	mut Str[dyn] lines = split(ed.text, "\n")
	first := lineText(lines, line)
	mut Str[dyn] pieces = [first]
	// O fim do que já foi juntado, e quantos caracteres ele tem.
	mut tail := first
	mut size := len(first)
	mut joinAt := 0
	mut joined := 0
	times := maxInt(count - 1, 1)
	for n := 0; n < times && line + 1 + joined <= final; n++ {
		following := lineText(lines, line + 1 + joined)
		mut rest := following
		mut gap := ""
		if spaces {
			rest = analysis.trimLeft(following)
			if size > 0 && rest != "" && !endsWith(tail, " ") && !endsWith(tail, "\t") && !complete.startsWith(rest, ")") {
				gap = " "
			}
		}
		joinAt = size
		append(pieces, gap + rest)
		if gap + rest != "" {
			tail = gap + rest
		}
		size = size + len(gap) + len(rest)
		joined++
	}
	lastJoined := line + joined
	if lines bounds line {
		lines[line] = join(pieces, "")
	}
	start := line + 1
	if joined > 0 && lines bounds start && lines bounds lastJoined {
		drop(lines, start, lastJoined)
	}
	pushUndo(ed, snapshot(ed))
	ed.text = join(lines, "\n")
	ed.caret = clampNormal(split(ed.text, ""), offsetOfLine(lines, line) + joinAt)
}

// `r`: troca `count` caracteres por `c`. `r<CR>` troca todos por uma quebra de linha.
proc replaceChars(ed: mut Editor, chars: Str[], c: Str, count: Int): Outcome {
	end := lineEnd(chars, ed.caret)
	if c == "" || ed.caret + count > end {
		return failed()
	}
	original := ed.text
	caret := ed.caret
	pushUndo(ed, snapshot(ed))
	if c == "\n" {
		ed.text = complete.take(original, caret) + "\n" + complete.skip(original, caret + count)
		ed.caret = caret + 1
	} else {
		ed.text = complete.take(original, caret) + repeatText(c, count) + complete.skip(original, caret + count)
		ed.caret = caret + count - 1
	}
	return finished()
}

// `Ctrl+A` e `Ctrl+X`: soma `amount` ao número no cursor (ou ao primeiro depois dele na linha).
proc increment(ed: mut Editor, chars: Str[], amount: Int): Outcome {
	end := lineEnd(chars, ed.caret)
	mut i := ed.caret
	for ; true; i-- {
		if i <= lineStart(chars, i) {
			break
		}
		if !highlight.isDigit(at(chars, i)) {
			break
		}
		if !highlight.isDigit(at(chars, i - 1)) {
			break
		}
	}
	for ; i < end; i++ {
		if highlight.isDigit(at(chars, i)) {
			break
		}
	}
	if i >= end {
		return failed()
	}
	mut start := i
	mut stop := i
	for ; stop < end; stop++ {
		if !highlight.isDigit(at(chars, stop)) {
			break
		}
	}
	if at(chars, start - 1) == "-" {
		start--
	}
	original := ed.text
	number := slice(original, start, stop)
	if hive.conv.sti(number) is Result.Ok(value) {
		changed := "{value + amount}"
		pushUndo(ed, snapshot(ed))
		ed.text = complete.take(original, start) + changed + complete.skip(original, stop)
		ed.caret = start + len(changed) - 1
		return finished()
	}
	return failed()
}

// `Ctrl+D`, `Ctrl+U`, `Ctrl+F`, `Ctrl+B`, `Ctrl+E`, `Ctrl+Y`: rolam a tela e
// levam o cursor junto quando ele sairia dela.
proc scrollBy(ed: mut Editor, chars: Str[], k: Str, count: Int, hasCount: Bool): Outcome {
	final := lastLine(chars)
	rows := maxInt(ed.rows, 1)
	line := lineOf(chars, ed.caret)
	mut delta := 0
	mut view := ed.top
	if k == "<C-d>" || k == "<C-u>" {
		delta = maxInt(rows / 2, 1)
		if hasCount {
			delta = count
		}
		if k == "<C-u>" {
			delta = 0 - delta
		}
	} else if k == "<C-f>" || k == "<PageDown>" {
		delta = maxInt(rows - 2, 1) * count
	} else if k == "<C-b>" || k == "<PageUp>" {
		delta = 0 - maxInt(rows - 2, 1) * count
	} else if k == "<C-e>" {
		view = ed.top + count
	} else if k == "<C-y>" {
		view = ed.top - count
	}
	view = clampInt(view + delta, 0, final)
	mut target := clampInt(line + delta, 0, final)
	if target < view {
		target = view
	} else if target > view + rows - 1 {
		target = view + rows - 1
	}
	ed.scroll = view
	ed.caret = atColumn(chars, lineOffset(chars, target), ed.vim.column, ed.tab)
	return kept()
}

// `zz`, `zt`, `zb` (e `z.`, `z<CR>`, `z-`, que também vão ao primeiro não branco).
proc scrollAround(ed: mut Editor, chars: Str[], k: Str): Outcome {
	line := lineOf(chars, ed.caret)
	rows := maxInt(ed.rows, 1)
	if k == "t" || k == "<CR>" {
		ed.scroll = line
	} else if k == "z" || k == "." {
		ed.scroll = maxInt(line - rows / 2, 0)
	} else if k == "b" || k == "-" {
		ed.scroll = maxInt(line - rows + 1, 0)
	} else {
		return failed()
	}
	if k == "<CR>" || k == "." || k == "-" {
		ed.caret = firstNonBlank(chars, ed.caret)
		return finished()
	}
	return kept()
}

// `*` e `#`: busca a palavra sob o cursor, inteira.
proc searchWord(ed: mut Editor, chars: Str[], backward: Bool, count: Int): Outcome {
	word := wordUnder(chars, ed.caret)
	if !word.ok {
		say(ed, "E348: Nenhuma palavra sob o cursor", "", true)
		return failed()
	}
	ed.vim.pattern = slice(ed.text, word.from, word.to)
	ed.vim.backward = backward
	ed.vim.whole = true
	ed.vim.highlight = true
	ed.caret = word.from
	t := searchTarget(ed, chars, false, count)
	if !t.ok {
		say(ed, t.note, t.arg, t.bad)
		return failed()
	}
	ed.caret = t.pos
	say(ed, t.note, t.arg, false)
	return finished()
}

// Abre a linha de comando (`:`, `/` ou `?`), já com `text` escrito.
proc openPrompt(ed: mut Editor, prompt: Str, text: Str): void {
	ed.vim.prompt = prompt
	ed.vim.command = text
	ed.vim.historyAt = len(ed.vim.history)
	ed.vim.promptFrom = ""
}

// ── ler as teclas ────────────────────────────────────────────────────────

// O que uma tecla deu: esperar mais teclas (`#Wait`), feito (`#Done`) ou
// falhou (`#Fail`, o que para uma macro), e se a coluna desejada fica (`keep`,
// de `j`, `k`, `$`…).
type Outcome {
	status: Atom
	keep:   Bool
}

func waitFor(): Outcome {
	return Outcome(#Wait, false)
}

func finished(): Outcome {
	return Outcome(#Done, false)
}

func kept(): Outcome {
	return Outcome(#Done, true)
}

func failed(): Outcome {
	return Outcome(#Fail, false)
}

// Guarda o último `f`/`t`/`F`/`T`, para `;` e `,`.
proc remember(ed: mut Editor, k: Str, target: Str): void {
	if (k == "f" || k == "F" || k == "t" || k == "T") && literal(target) != "" {
		ed.vim.find = [k, literal(target)]
	}
}

// Um movimento sozinho: leva o cursor (no visual, a ponta da seleção).
proc moveStep(ed: mut Editor, chars: Str[], keys: mut Str[dyn], count: Int, hasCount: Bool): Outcome {
	t := motion(ed, chars, keys, count, hasCount)
	remember(ed, at(keys, 0), at(keys, 1))
	if !t.ok {
		say(ed, t.note, t.arg, t.bad)
		return failed()
	}
	ed.caret = clampNormal(chars, t.pos)
	say(ed, t.note, t.arg, t.bad)
	k := at(keys, 0)
	if k == "$" || k == "<End>" || (k == "g" && at(keys, 1) == "$") {
		ed.vim.column = endColumn()
		return kept()
	}
	return Outcome(#Done, t.keep)
}

// `d`, `c`, `y`, `>`, `<`, `g~`, `gu`, `gU` seguidos de um movimento, de um
// objeto de texto (`iw`, `a"`, `i\{`…) ou de si mesmos (`dd`, `>>`, `gUU`).
proc operatorStep(ed: mut Editor, chars: Str[], keys: Str[dyn], start: Int, op: Str, count: Int, hasCount: Bool): Outcome {
	mut i := start
	mut second := 0
	for ; i < len(keys); i++ {
		d := digitOf(at(keys, i))
		if d < 0 || (d == 0 && second == 0) {
			break
		}
		second = second * 10 + d
	}
	total := count * maxInt(second, 1)
	anyCount := hasCount || second > 0
	k := at(keys, i)
	if k == "" {
		return waitFor()
	}
	caret := ed.caret
	mut doubled := k == op
	if op is "g{rest}" {
		doubled = k == rest || (k == "g" && at(keys, i + 1) == rest)
	}
	if doubled {
		first := lineOf(chars, caret)
		last := minInt(first + total - 1, lastLine(chars))
		span := lineSpan(chars, caret, lineOffset(chars, last))
		applyOperator(ed, chars, op, span, keys, 1)
		return finished()
	}
	if k == "i" || k == "a" {
		obj := at(keys, i + 1)
		if obj == "" {
			return waitFor()
		}
		span := textObject(ed.text, chars, caret, k == "i", obj, total)
		if !span.ok {
			return failed()
		}
		applyOperator(ed, chars, op, span, keys, 1)
		return finished()
	}
	size := motionLength(keys, i)
	if size == 0 {
		return waitFor()
	}
	if size < 0 {
		return failed()
	}
	mut Str[dyn] moves = []
	keysFrom(keys, i, size, moves)
	remember(ed, at(moves, 0), at(moves, 1))
	big := k == "W"
	if op == "c" && (k == "w" || k == "W") && !isSpace(at(chars, caret)) && at(chars, caret) != "" {
		span := Span(caret, minInt(changeWordEnd(chars, caret, big, total) + 1, len(chars)), false, true)
		applyOperator(ed, chars, op, span, keys, 1)
		return finished()
	}
	if k == "w" || k == "W" {
		// A última palavra de uma linha não leva o "\n" junto.
		mut before := caret
		mut p := caret
		for n := 0; n < total; n++ {
			before = p
			p = nextWord(chars, p, big)
		}
		if lineOf(chars, p) > lineOf(chars, before) {
			p = maxInt(lineEnd(chars, before), caret)
		}
		applyOperator(ed, chars, op, Span(caret, p, false, true), keys, 1)
		return finished()
	}
	t := motion(ed, chars, moves, total, anyCount)
	if !t.ok {
		say(ed, t.note, t.arg, t.bad)
		return failed()
	}
	applyOperator(ed, chars, op, operatorSpan(chars, caret, t), keys, 1)
	return finished()
}

// Entra no modo de inserção num lugar do texto (`i`, `a`, `I`, `A`, `o`, `O`).
proc insertStep(ed: mut Editor, chars: Str[], k: Str, keys: Str[dyn], count: Int): Outcome {
	before := snapshot(ed)
	caret := ed.caret
	if k == "a" {
		if caret < len(chars) && at(chars, caret) != "\n" {
			ed.caret = caret + 1
		}
	} else if k == "A" {
		ed.caret = lineEnd(chars, caret)
	} else if k == "I" {
		ed.caret = firstNonBlank(chars, caret)
		if isBlank(at(chars, ed.caret)) {
			ed.caret = lineEnd(chars, caret)
		}
	} else if k == "o" || k == "O" {
		opened := openLine(ed.text, caret, k == "o")
		ed.text = opened.text
		ed.caret = opened.caret
	}
	enterInsert(ed, before, keys, count)
	return finished()
}

// `.`: repete a última alteração (com outra contagem, se houver uma).
proc repeatChange(ed: mut Editor, count: Int, hasCount: Bool): void {
	change := ed.vim.change
	typed := ed.vim.typed
	if len(change) == 0 {
		return
	}
	mut Str[dyn] keys = []
	if hasCount {
		keys = split("{count}", "")
	}
	mut counting := true
	for each k in change {
		if counting && digitOf(k) >= 0 {
			if !hasCount {
				append(keys, k)
			}
		} else {
			counting = false
			append(keys, k)
		}
	}
	Str[dyn] none = []
	ed.vim.pending = none
	_outcome := normalStep(ed, keys)
	if ed.vim.mode == model.VimMode.InsertMode() {
		ed.text = insertAt(ed.text, ed.caret, typed)
		ed.caret = ed.caret + len(typed)
		leaveInsert(ed, false)
	}
	ed.vim.change = change
	ed.vim.typed = typed
}

// As teclas pendentes no modo normal.
proc normalStep(ed: mut Editor, keys: mut Str[dyn]): Outcome {
	chars := split(ed.text, "")
	mut i := 0
	mut count := 0
	for ; i < len(keys); i++ {
		d := digitOf(at(keys, i))
		if d < 0 || (d == 0 && count == 0) {
			break
		}
		count = count * 10 + d
	}
	hasCount := count > 0
	n := maxInt(count, 1)
	k := at(keys, i)
	next := at(keys, i + 1)
	pos := ed.caret
	end := lineEnd(chars, pos)
	if k == "" {
		return waitFor()
	}
	if k == "q" {
		if ed.vim.recordingTo != "" {
			stopRecording(ed)
			return kept()
		} else if next == "" {
			return waitFor()
		}
		return startRecording(ed, next)
	} else if k == "@" {
		if next == "" {
			return waitFor()
		}
		return playMacro(ed, next, n)
	}
	if k == "d" || k == "c" || k == "y" || k == ">" || k == "<" {
		return operatorStep(ed, chars, keys, i + 1, k, n, hasCount)
	}
	if k == "g" {
		if next == "" {
			return waitFor()
		} else if next == "~" || next == "u" || next == "U" {
			return operatorStep(ed, chars, keys, i + 2, "g" + next, n, hasCount)
		} else if next == "d" {
			effect(ed, model.Msg.GotoDefinition(pos))
			return finished()
		} else if next == "t" {
			effect(ed, model.Msg.CycleTab(1))
			return finished()
		} else if next == "T" {
			effect(ed, model.Msg.CycleTab(-1))
			return finished()
		} else if next == "J" {
			joinLines(ed, chars, maxInt(count, 2), false)
			recorded(ed, keys)
			return finished()
		}
	}
	if k == "z" {
		if next == "" {
			return waitFor()
		}
		return scrollAround(ed, chars, next)
	}
	if k == "Z" {
		if next == "" {
			return waitFor()
		} else if next == "Z" {
			command(ed, chars, "x", false, "", 0, 0, false)
			return finished()
		} else if next == "Q" {
			command(ed, chars, "q", true, "", 0, 0, false)
			return finished()
		}
		return failed()
	}
	if k == "r" {
		if next == "" {
			return waitFor()
		}
		replaced := replaceChars(ed, chars, literal(next), n)
		recorded(ed, keys)
		return Outcome(replaced.status, false)
	}
	if k == "x" || k == "<Del>" {
		deleteSpan(ed, chars, Span(pos, minInt(pos + n, end), false, true))
		recorded(ed, keys)
		return finished()
	} else if k == "X" {
		deleteSpan(ed, chars, Span(maxInt(pos - n, lineStart(chars, pos)), pos, false, true))
		recorded(ed, keys)
		return finished()
	} else if k == "D" || k == "C" {
		last := minInt(lineOf(chars, pos) + n - 1, lastLine(chars))
		span := Span(pos, lineEnd(chars, lineOffset(chars, last)), false, true)
		if k == "C" {
			changeSpan(ed, chars, span, keys)
			return finished()
		}
		deleteSpan(ed, chars, span)
		recorded(ed, keys)
		return finished()
	} else if k == "s" {
		changeSpan(ed, chars, Span(pos, minInt(pos + n, end), false, true), keys)
		return finished()
	} else if k == "S" {
		last := minInt(lineOf(chars, pos) + n - 1, lastLine(chars))
		changeSpan(ed, chars, lineSpan(chars, pos, lineOffset(chars, last)), keys)
		return finished()
	} else if k == "Y" {
		last := minInt(lineOf(chars, pos) + n - 1, lastLine(chars))
		yank(ed, chars, lineSpan(chars, pos, lineOffset(chars, last)))
		return finished()
	} else if k == "p" || k == "P" {
		put(ed, chars, k == "P", n)
		recorded(ed, keys)
		return finished()
	} else if k == "J" {
		joinLines(ed, chars, maxInt(count, 2), true)
		recorded(ed, keys)
		return finished()
	} else if k == "u" {
		undoSteps(ed, n, true)
		return finished()
	} else if k == "<C-r>" {
		undoSteps(ed, n, false)
		return finished()
	} else if k == "." {
		repeatChange(ed, n, hasCount)
		return finished()
	} else if k == "i" || k == "a" || k == "I" || k == "A" || k == "o" || k == "O" {
		return insertStep(ed, chars, k, keys, n)
	} else if k == "~" {
		to := minInt(pos + n, end)
		if to <= pos {
			return failed()
		}
		recase(ed, chars, Span(pos, to, false, true), "~")
		recorded(ed, keys)
		ed.caret = clampNormal(split(ed.text, ""), to)
		return finished()
	} else if k == "v" || k == "V" {
		ed.vim.mode = model.VimMode.VisualMode()
		if k == "V" {
			ed.vim.mode = model.VimMode.VisualLineMode()
		}
		ed.vim.anchor = pos
		return kept()
	} else if k == ":" {
		mut range := ""
		if hasCount {
			range = ".,.+{count - 1}"
		}
		openPrompt(ed, ":", range)
		return kept()
	} else if k == "/" || k == "?" {
		openPrompt(ed, k, "")
		return kept()
	} else if k == "*" || k == "#" {
		return searchWord(ed, chars, k == "#", n)
	} else if isAny(k, ["<C-d>", "<C-u>", "<C-f>", "<C-b>", "<C-e>", "<C-y>", "<PageDown>", "<PageUp>"]) {
		return scrollBy(ed, chars, k, n, hasCount)
	} else if k == "<C-a>" || k == "<C-x>" {
		mut amount := n
		if k == "<C-x>" {
			amount = 0 - n
		}
		changed := increment(ed, chars, amount)
		recorded(ed, keys)
		return Outcome(changed.status, false)
	}
	length := motionLength(keys, i)
	if length == 0 {
		return waitFor()
	}
	if length < 0 {
		return failed()
	}
	mut Str[dyn] moves = []
	keysFrom(keys, i, length, moves)
	return moveStep(ed, chars, moves, n, hasCount)
}

// O que está selecionado no modo visual (a ponta do cursor inclusa).
func selection(text: Str, chars: Str[], caret: Int, v: model.Vim): Span {
	a := minInt(v.anchor, caret)
	b := maxInt(v.anchor, caret)
	if v.mode == model.VimMode.VisualLineMode() {
		return lineSpan(chars, a, b)
	}
	return Span(a, minInt(b + 1, len(chars)), false, true)
}

// `p` no visual: troca a seleção pelo registrador (e o registrador pelo que saiu).
proc putOver(ed: mut Editor, chars: Str[], span: Span): void {
	register := ed.vim.register
	if register == "" {
		say(ed, "E353: Nada no registrador", "", true)
		return
	}
	original := ed.text
	content := slice(original, span.from, span.to)
	mut piece := register
	if span.linewise && !ed.vim.linewise {
		piece = register + "\n"
	} else if !span.linewise && ed.vim.linewise {
		piece = "\n" + register
	}
	if span.linewise && !endsWith(content, "\n") && endsWith(piece, "\n") {
		piece = complete.take(piece, len(piece) - 1)
	}
	pushUndo(ed, snapshot(ed))
	ed.text = complete.take(original, span.from) + piece + complete.skip(original, span.to)
	ed.vim.register = content
	ed.vim.linewise = span.linewise
	after := split(ed.text, "")
	if span.linewise {
		ed.caret = firstNonBlank(after, span.from)
	} else {
		ed.caret = clampNormal(after, span.from + len(piece) - 1)
	}
}

proc toNormal(ed: mut Editor): void {
	ed.vim.mode = model.VimMode.NormalMode()
	ed.caret = clampNormal(split(ed.text, ""), ed.caret)
}

// As teclas pendentes no modo visual.
proc visualStep(ed: mut Editor, keys: mut Str[dyn]): Outcome {
	chars := split(ed.text, "")
	mut i := 0
	mut count := 0
	for ; i < len(keys); i++ {
		d := digitOf(at(keys, i))
		if d < 0 || (d == 0 && count == 0) {
			break
		}
		count = count * 10 + d
	}
	hasCount := count > 0
	n := maxInt(count, 1)
	k := at(keys, i)
	next := at(keys, i + 1)
	lines := ed.vim.mode == model.VimMode.VisualLineMode()
	span := selection(ed.text, chars, ed.caret, ed.vim)
	whole := lineSpan(chars, span.from, maxInt(span.to - 1, span.from))
	original := ed.text
	caret := ed.caret
	anchor := ed.vim.anchor
	ed.vim.visualFrom = lineOf(chars, span.from)
	ed.vim.visualTo = lineOf(chars, maxInt(span.to - 1, span.from))
	if k == "" {
		return waitFor()
	}
	if k == "q" && ed.vim.recordingTo != "" {
		stopRecording(ed)
		return kept()
	}
	if k == "v" || k == "V" {
		if (k == "v" && !lines) || (k == "V" && lines) {
			toNormal(ed)
			return finished()
		}
		if k == "v" {
			ed.vim.mode = model.VimMode.VisualMode()
		} else {
			ed.vim.mode = model.VimMode.VisualLineMode()
		}
		return kept()
	} else if k == "o" || k == "O" {
		ed.vim.anchor = caret
		ed.caret = anchor
		return finished()
	} else if k == ":" {
		openPrompt(ed, ":", "'<,'>")
		toNormal(ed)
		return kept()
	} else if k == "d" || k == "x" || k == "<Del>" {
		deleteSpan(ed, chars, span)
		toNormal(ed)
		return finished()
	} else if k == "D" || k == "X" {
		deleteSpan(ed, chars, whole)
		toNormal(ed)
		return finished()
	} else if k == "y" {
		yank(ed, chars, span)
		toNormal(ed)
		return finished()
	} else if k == "Y" {
		yank(ed, chars, whole)
		toNormal(ed)
		return finished()
	} else if k == "c" || k == "s" {
		changeSpan(ed, chars, span, keys)
		return finished()
	} else if k == "C" || k == "S" || k == "R" {
		changeSpan(ed, chars, whole, keys)
		return finished()
	} else if k == ">" || k == "<" {
		shiftLines(ed, chars, whole, k == ">", n)
		toNormal(ed)
		return finished()
	} else if k == "~" || k == "u" || k == "U" {
		recase(ed, chars, span, k)
		toNormal(ed)
		return finished()
	} else if k == "J" {
		ed.caret = span.from
		joinLines(ed, chars, maxInt(ed.vim.visualTo - ed.vim.visualFrom + 1, 2), true)
		toNormal(ed)
		return finished()
	} else if k == "p" || k == "P" {
		putOver(ed, chars, span)
		toNormal(ed)
		return finished()
	} else if k == "r" {
		if next == "" {
			return waitFor()
		}
		c := literal(next)
		if c == "" || c == "\n" {
			return failed()
		}
		mut Str[dyn] out = []
		for each ch in split(slice(original, span.from, span.to), "") {
			if ch == "\n" {
				append(out, ch)
			} else {
				append(out, c)
			}
		}
		pushUndo(ed, snapshot(ed))
		ed.text = complete.take(original, span.from) + join(out, "") + complete.skip(original, span.to)
		ed.caret = span.from
		toNormal(ed)
		return finished()
	} else if k == "g" {
		if next == "" {
			return waitFor()
		} else if next == "~" || next == "u" || next == "U" {
			recase(ed, chars, span, "g" + next)
			toNormal(ed)
			return finished()
		} else if next == "J" {
			ed.caret = span.from
			joinLines(ed, chars, maxInt(ed.vim.visualTo - ed.vim.visualFrom + 1, 2), false)
			toNormal(ed)
			return finished()
		}
	} else if k == "i" || k == "a" {
		if next == "" {
			return waitFor()
		}
		obj := textObject(original, chars, caret, k == "i", next, n)
		if !obj.ok || obj.to <= obj.from {
			return failed()
		}
		ed.vim.anchor = obj.from
		ed.caret = obj.to - 1
		return finished()
	} else if isAny(k, ["<C-d>", "<C-u>", "<C-f>", "<C-b>", "<C-e>", "<C-y>", "<PageDown>", "<PageUp>"]) {
		return scrollBy(ed, chars, k, n, hasCount)
	}
	length := motionLength(keys, i)
	if length == 0 {
		return waitFor()
	}
	if length < 0 {
		return failed()
	}
	mut Str[dyn] moves = []
	keysFrom(keys, i, length, moves)
	return moveStep(ed, chars, moves, n, hasCount)
}

// ── a entrada do motor ───────────────────────────────────────────────────

// Zera o que uma tecla devolve (mensagem, rolagem, cópia, efeitos).
proc begin(ed: mut Editor): void {
	say(ed, "", "", false)
	ed.scroll = -1
	ed.clip = ""
	model.Msg[dyn] none = []
	ed.effects = none
}

// O que a gravação de uma macro precisa saber de antes da tecla.
type KeyContext {
	recording:  Str
	inserting:  Bool
	insertBase: Str
	insertAt:   Int
	text:       Str
	prompt:     Str
	command:    Str
}

func keyContext(ed: Editor): KeyContext {
	return KeyContext(ed.vim.recordingTo, ed.vim.mode == model.VimMode.InsertMode(), ed.vim.insertBase, ed.vim.insertAt, ed.text,
		ed.vim.prompt, ed.vim.command)
}

// Uma tecla no editor. É a entrada do motor.
proc press(ed: mut Editor, key: Str): void {
	before := keyContext(ed)
	begin(ed)
	_outcome := keyStep(ed, key)
	recordKey(before, key, ed)
}

// Uma tecla, e se ela deu certo: uma macro para no primeiro erro, como no Vim.
proc keyStep(ed: mut Editor, key: Str): Outcome {
	// O cursor mudou por fora (clique, busca, ir para a definição): a coluna
	// que `j` e `k` guardam passa a ser a dele.
	if ed.caret != ed.vim.columnAt {
		ed.vim.column = displayColumn(split(ed.text, ""), ed.caret, ed.tab)
	}
	mode := ed.vim.mode
	if mode == model.VimMode.InsertMode() {
		if isEscape(key) {
			leaveInsert(ed, true)
			settled(ed)
		} else {
			typeKey(ed, key)
		}
		return finished()
	}
	if ed.vim.prompt != "" {
		return promptStep(ed, key)
	}
	Str[dyn] cleared = []
	if isEscape(key) {
		ed.vim.pending = cleared
		toNormal(ed)
		settled(ed)
		return finished()
	}
	mut Str[dyn] keys = ed.vim.pending
	append(keys, key)
	mut outcome := finished()
	if mode == model.VimMode.NormalMode() {
		outcome = normalStep(ed, keys)
	} else {
		outcome = visualStep(ed, keys)
	}
	if outcome.status == #Wait {
		ed.vim.pending = keys
		settled(ed)
		return waitFor()
	}
	ed.vim.pending = cleared
	if outcome.status == #Done && !outcome.keep {
		ed.vim.column = displayColumn(split(ed.text, ""), ed.caret, ed.tab)
	}
	settled(ed)
	return outcome
}

// Uma tecla com a linha de comando aberta: a página ainda não tinha posto o
// foco nela, ou uma macro está repetindo o comando que gravou.
proc promptStep(ed: mut Editor, key: Str): Outcome {
	if isEscape(key) {
		closePrompt(ed)
		return finished()
	} else if key == "<CR>" {
		typed := ed.vim.command
		runCommandLine(ed, typed)
		if ed.vim.error {
			return failed()
		}
		return finished()
	} else if complete.startsWith(key, "<Text>") {
		ed.vim.command = complete.skip(key, 6)
	} else {
		promptKey(ed.vim, key)
	}
	return finished()
}

proc closePrompt(ed: mut Editor): void {
	ed.vim.prompt = ""
	ed.vim.command = ""
}

// Esc na linha de comando, vindo da página.
proc cancel(ed: mut Editor): void {
	before := keyContext(ed)
	begin(ed)
	closePrompt(ed)
	recordKey(before, "<Esc>", ed)
}

// ── macros ───────────────────────────────────────────────────────────────

// Com uma macro sendo gravada, guarda a tecla. Na inserção, o que se digitou
// (e a página escreveu sozinha) entra de uma vez, no Esc; na linha de comando,
// o comando inteiro entra no Enter. `<Text>…` é um texto digitado.
proc recordKey(before: KeyContext, key: Str, ed: mut Editor): void {
	if before.recording == "" || ed.vim.recordingTo == "" {
		return
	}
	mut Str[dyn] tokens = []
	if before.inserting {
		if !isEscape(key) {
			return
		}
		typed := insertedText(before.insertBase, before.insertAt, before.text)
		if typed is Result.Ok(piece) {
			if piece != "" {
				append(tokens, "<Text>" + piece)
			}
		}
		append(tokens, "<Esc>")
	} else if before.prompt != "" {
		if key == "<CR>" {
			append(tokens, "<Text>" + before.command)
			append(tokens, "<CR>")
		} else if isEscape(key) {
			append(tokens, "<Esc>")
		} else {
			return
		}
	} else {
		append(tokens, key)
	}
	recordTokens(ed, tokens)
}

proc recordTokens(ed: mut Editor, tokens: Str[]): void {
	mut Str[dyn] recorded = ed.vim.recorded
	for each token in tokens {
		append(recorded, token)
	}
	ed.vim.recorded = recorded
}

func isRegister(reg: Str): Bool {
	return len(reg) == 1 && (isLetter(reg) || highlight.isDigit(reg))
}

// `qa` começa a gravar em `a`; `qA` continua a macro que já está em `a`.
proc startRecording(ed: mut Editor, reg: Str): Outcome {
	if !isRegister(reg) {
		return failed()
	}
	name := search.lower(reg)
	mut Str[dyn] tokens = []
	if name != reg {
		if hive.map.get(ed.vim.macros, name) is Result.Ok(old) {
			tokens = old
		}
	}
	ed.vim.recordingTo = name
	ed.vim.recorded = tokens
	return kept()
}

// `q` de novo: guarda a macro.
proc stopRecording(ed: mut Editor): void {
	mut hive.map.Map<Str, Str[dyn]> macros = ed.vim.macros
	hive.map.set(macros, ed.vim.recordingTo, ed.vim.recorded)
	Str[dyn] none = []
	ed.vim.macros = macros
	ed.vim.recordingTo = ""
	ed.vim.recorded = none
}

// Até quantas macros podem rodar uma dentro da outra (uma que chama a si mesma para aí).
func macroDepth(): Int {
	return 20
}

// O último comando de `:` do histórico, sem os dois-pontos.
func lastCommand(history: Str[]): Str {
	mut found := ""
	for each entry in history {
		if complete.startsWith(entry, ":") {
			found = complete.skip(entry, 1)
		}
	}
	return found
}

// `@a` repete as teclas gravadas em `a`, `count` vezes; `@@` repete a última
// macro e `@:` o último comando. Para no primeiro erro, como no Vim — é o que
// faz `100@a` parar no fim do arquivo.
proc playMacro(ed: mut Editor, reg: Str, count: Int): Outcome {
	mut name := search.lower(reg)
	if reg == "@" {
		name = ed.vim.lastMacro
	}
	if name == "" {
		return failed()
	}
	depth := ed.vim.replaying
	if depth >= macroDepth() {
		say(ed, "E: macros dentro de macros demais", "", true)
		return failed()
	}
	mut Str[dyn] tokens = []
	if name == ":" {
		last := lastCommand(ed.vim.history)
		if last == "" {
			say(ed, "E30: Nenhuma linha de comando anterior", "", true)
			return failed()
		}
		tokens = [":", "<Text>" + last, "<CR>"]
	} else if hive.map.get(ed.vim.macros, name) is Result.Ok(found) {
		tokens = found
	} else {
		return failed()
	}
	Str[dyn] none = []
	ed.vim.pending = none
	ed.vim.lastMacro = name
	ed.vim.replaying = depth + 1
	mut status := #Done
	for n := 0; n < count && status != #Fail; n++ {
		for each token in tokens {
			if status != #Fail {
				step := keyStep(ed, token)
				if step.status == #Fail {
					status = #Fail
				}
			}
		}
	}
	ed.vim.replaying = depth
	return Outcome(status, true)
}

// Uma tecla que chegou aqui no modo de inserção — a página ainda não sabia que
// a inserção tinha começado — vira texto, como no editor.
proc typeKey(ed: mut Editor, key: Str): void {
	original := ed.text
	caret := ed.caret
	chars := split(original, "")
	if complete.startsWith(key, "<Text>") {
		piece := complete.skip(key, 6)
		ed.text = insertAt(original, caret, piece)
		ed.caret = caret + len(piece)
	} else if key == "<BS>" {
		if caret > 0 {
			ed.text = cut(original, caret - 1, caret)
			ed.caret = caret - 1
		}
	} else if key == "<Del>" {
		if caret < len(chars) {
			ed.text = cut(original, caret, caret + 1)
		}
	} else if key == "<Left>" {
		ed.caret = maxInt(caret - 1, 0)
	} else if key == "<Right>" {
		ed.caret = minInt(caret + 1, len(chars))
	} else if key == "<CR>" {
		line := slice(original, lineStart(chars, caret), caret)
		mut indent := leadingBlanks(line)
		trimmed := trim(line)
		if endsWith(trimmed, "\{") || endsWith(trimmed, "[") || endsWith(trimmed, "(") {
			indent = indent + "\t"
		}
		ed.text = insertAt(original, caret, "\n" + indent)
		ed.caret = caret + 1 + len(indent)
	} else {
		c := literal(key)
		if c != "" {
			ed.text = insertAt(original, caret, c)
			ed.caret = caret + 1
		}
	}
}

// Uma tecla que chegou aqui com a linha de comando aberta (a página ainda não
// tinha posto o foco nela) entra no que está sendo digitado.
proc promptKey(v: mut model.Vim, key: Str): void {
	if key == "<BS>" {
		v.command = complete.take(v.command, len(v.command) - 1)
	} else if literal(key) != "" && key != "<CR>" {
		v.command = v.command + literal(key)
	}
}

// Trocar de documento (ou ligar o modo Vim) começa no modo normal, sem nada pendente.
proc reset(v: mut model.Vim): void {
	Str[dyn] none = []
	v.mode = model.VimMode.NormalMode()
	v.pending = none
	v.prompt = ""
	v.command = ""
	v.columnAt = -1
	v.serial = v.serial + 1
}

// Lembra para qual cursor a coluna desejada foi calculada.
proc settled(ed: mut Editor): void {
	ed.vim.columnAt = ed.caret
}

// Um clique (ou uma seleção com o mouse) no texto.
proc click(ed: mut Editor, start: Int, end: Int): void {
	say(ed, "", "", false)
	Str[dyn] cleared = []
	ed.vim.pending = cleared
	chars := split(ed.text, "")
	mode := ed.vim.mode
	if mode == model.VimMode.InsertMode() {
		ed.caret = start
		return
	}
	if end > start {
		if mode != model.VimMode.VisualLineMode() {
			ed.vim.mode = model.VimMode.VisualMode()
		}
		ed.vim.anchor = start
		ed.caret = end - 1
	} else {
		ed.vim.mode = model.VimMode.NormalMode()
		ed.caret = clampNormal(chars, start)
	}
	ed.vim.column = displayColumn(chars, ed.caret, ed.tab)
	settled(ed)
}

// ── a linha de comando ───────────────────────────────────────────────────

// O que foi digitado depois de `:`, `/` ou `?`, ao apertar Enter na página.
proc submit(ed: mut Editor, typed: Str): void {
	recording := ed.vim.recordingTo
	begin(ed)
	runCommandLine(ed, typed)
	if recording != "" && ed.vim.recordingTo != "" {
		recordTokens(ed, ["<Text>" + typed, "<CR>"])
	}
}

proc runCommandLine(ed: mut Editor, typed: Str): void {
	mut prompt := ed.vim.prompt
	if prompt == "" {
		prompt = ":"
	}
	ed.vim.prompt = ""
	ed.vim.command = ""
	if typed != "" {
		entry := prompt + typed
		mut Str[dyn] history = []
		for each old in ed.vim.history {
			if old != entry {
				append(history, old)
			}
		}
		append(history, entry)
		if len(history) > 100 {
			if history bounds 0 {
				drop(history, 0, 0)
			}
		}
		ed.vim.history = history
	}
	ed.vim.historyAt = len(ed.vim.history)
	if prompt == "/" || prompt == "?" {
		searchFor(ed, typed, prompt == "?")
		settled(ed)
		return
	}
	execute(ed, typed)
}

proc searchFor(ed: mut Editor, typed: Str, backward: Bool): void {
	mut pattern := typed
	if pattern == "" {
		pattern = ed.vim.pattern
	}
	if pattern == "" {
		say(ed, "E35: Nenhuma busca anterior", "", true)
		return
	}
	ed.vim.pattern = pattern
	ed.vim.backward = backward
	ed.vim.whole = false
	ed.vim.highlight = true
	chars := split(ed.text, "")
	t := searchTarget(ed, chars, false, 1)
	if !t.ok {
		say(ed, t.note, t.arg, t.bad)
		return
	}
	ed.caret = clampNormal(chars, t.pos)
	ed.vim.column = displayColumn(chars, ed.caret, ed.tab)
	say(ed, t.note, t.arg, false)
}

// ↑ e ↓ na linha de comando: as entradas já usadas do mesmo tipo.
proc browseHistory(v: mut model.Vim, delta: Int): void {
	count := len(v.history)
	mut i := v.historyAt
	for n := 0; n <= count; n++ {
		i = i + delta
		if i < 0 {
			return
		}
		if i >= count {
			v.historyAt = count
			v.command = ""
			return
		}
		entry := at(v.history, i)
		search := v.prompt == "/" || v.prompt == "?"
		if (search && (complete.startsWith(entry, "/") || complete.startsWith(entry, "?"))) || (!search && complete.startsWith(entry, v.prompt)) {
			v.historyAt = i
			v.command = complete.skip(entry, 1)
			return
		}
	}
}

func address(cmd: Str[], start: Int, current: Int, final: Int, v: model.Vim): Address {
	mut i := start
	mut line := current
	mut ok := false
	c := at(cmd, i)
	if highlight.isDigit(c) {
		number := numberAt(cmd, i)
		line = number.value - 1
		i = number.next
		ok = true
	} else if c == "." {
		i++
		ok = true
	} else if c == "$" {
		line = final
		i++
		ok = true
	} else if c == "'" && at(cmd, i + 1) == "<" {
		line = v.visualFrom
		i = i + 2
		ok = true
	} else if c == "'" && at(cmd, i + 1) == ">" {
		line = v.visualTo
		i = i + 2
		ok = true
	}
	for ;; {
		sign := at(cmd, i)
		if sign != "+" && sign != "-" {
			break
		}
		number := numberAt(cmd, i + 1)
		i = number.next
		mut value := number.value
		if number.next == number.from {
			value = 1
		}
		if sign == "+" {
			line = line + value
		} else {
			line = line - value
		}
		ok = true
	}
	return Address(line, i, ok)
}

// Um número escrito a partir de `from`: o valor e onde ele acaba (`next` igual
// a `from` quando não há dígito ali).
type Number {
	value: Int
	from:  Int
	next:  Int
}

func numberAt(cmd: Str[], from: Int): Number {
	mut value := 0
	mut i := from
	for ; i < len(cmd); i++ {
		d := digitOf(at(cmd, i))
		if d < 0 {
			break
		}
		value = value * 10 + d
	}
	return Number(value, from, i)
}

// Lê `[intervalo]comando[!] [argumentos]` e executa.
proc execute(ed: mut Editor, typed: Str): void {
	chars := split(ed.text, "")
	cmd := split(typed, "")
	current := lineOf(chars, ed.caret)
	final := lastLine(chars)
	mut i := 0
	for ; true; i++ {
		if at(cmd, i) != " " && at(cmd, i) != ":" {
			break
		}
	}
	mut from := -1
	mut to := -1
	if at(cmd, i) == "%" {
		from = 0
		to = final
		i++
	} else {
		first := address(cmd, i, current, final, ed.vim)
		if first.ok {
			from = first.line
			to = first.line
			i = first.next
			if at(cmd, i) == "," || at(cmd, i) == ";" {
				second := address(cmd, i + 1, current, final, ed.vim)
				if !second.ok {
					say(ed, "E16: Intervalo inválido", "", true)
					return
				}
				to = second.line
				i = second.next
			}
		}
	}
	for ; true; i++ {
		if at(cmd, i) != " " {
			break
		}
	}
	mut Str[dyn] letters = []
	for ; true; i++ {
		if !isLetter(at(cmd, i)) {
			break
		}
		append(letters, at(cmd, i))
	}
	mut name := join(letters, "")
	if name == "" && isAny(at(cmd, i), ["!", ">", "<", "&"]) {
		name = at(cmd, i)
		i++
	}
	mut levels := 1
	if name == ">" || name == "<" {
		for ; true; i++ {
			if at(cmd, i) != name {
				break
			}
			levels++
		}
	}
	mut bang := false
	if at(cmd, i) == "!" && name != "!" {
		bang = true
		i++
	}
	mut Str[dyn] rest = []
	for j := i; j < len(cmd); j++ {
		append(rest, at(cmd, j))
	}
	args := trim(join(rest, ""))
	hasRange := from >= 0 || to >= 0
	if !hasRange {
		from = current
		to = current
	}
	if from > to {
		swap := from
		from = to
		to = swap
	}
	if name == "" {
		if hasRange {
			ed.caret = firstNonBlank(chars, lineOffset(chars, clampInt(to, 0, final)))
		}
		return
	}
	if from < 0 || to > final {
		if !(name == "m" || name == "move" || name == "t" || name == "co" || name == "copy") || from < 0 {
			say(ed, "E16: Intervalo inválido", "", true)
			return
		}
	}
	if name == ">" || name == "<" {
		span := lineSpan(chars, lineOffset(chars, from), lineOffset(chars, to))
		shiftLines(ed, chars, span, name == ">", levels)
		return
	}
	command(ed, chars, name, bang, args, from, to, hasRange)
}

// A ajuda de uma linha que `:help` mostra.
func helpText(): Str {
	return "Vim: :w :q :wq :x :e arquivo :N :s/a/b/g :noh :set nu :d :y :m :t :sort :bn :bp :check :make :run :test :term :!comando"
}

proc command(ed: mut Editor, chars: Str[], name: Str, bang: Bool, args: Str, from: Int, to: Int, hasRange: Bool): void {
	final := lastLine(chars)
	if isAny(name, ["w", "write"]) {
		if args != "" {
			say(ed, "E: :w só salva o próprio arquivo", "", true)
			return
		}
		effect(ed, model.Msg.Save())
	} else if isAny(name, ["wa", "wall"]) {
		effect(ed, model.Msg.SaveAll())
	} else if isAny(name, ["up", "update"]) {
		if ed.dirty {
			effect(ed, model.Msg.Save())
		}
	} else if isAny(name, ["q", "quit", "clo", "close", "bd", "bdelete", "tabc", "tabclose"]) {
		if ed.dirty && !bang {
			say(ed, "E37: Alterações não salvas (use ! para descartar)", "", true)
			return
		}
		effect(ed, model.Msg.CloseDoc(ed.active))
	} else if isAny(name, ["wq", "x", "xi", "xit", "exi", "exit"]) {
		if name == "wq" || ed.dirty {
			effect(ed, model.Msg.Save())
		}
		effect(ed, model.Msg.CloseDoc(ed.active))
	} else if isAny(name, ["qa", "qall", "quita", "quitall"]) {
		if ed.anyDirty && !bang {
			say(ed, "E37: Alterações não salvas (use ! para descartar)", "", true)
			return
		}
		effect(ed, model.Msg.Quit())
	} else if isAny(name, ["wqa", "wqall", "xa", "xall"]) {
		effect(ed, model.Msg.SaveAll())
		effect(ed, model.Msg.Quit())
	} else if isAny(name, ["e", "edit"]) {
		if args != "" {
			effect(ed, model.Msg.VimEdit(args))
			return
		}
		if ed.dirty && !bang {
			say(ed, "E37: Alterações não salvas (use ! para descartar)", "", true)
			return
		}
		effect(ed, model.Msg.VimReload())
	} else if isAny(name, ["s", "su", "substitute"]) {
		substitute(ed, chars, args, from, to)
	} else if isAny(name, ["noh", "nohl", "nohlsearch"]) {
		ed.vim.highlight = false
	} else if isAny(name, ["se", "set"]) {
		setOptions(ed, args)
	} else if isAny(name, ["d", "de", "del", "delete"]) {
		deleteSpan(ed, chars, lineSpan(chars, lineOffset(chars, from), lineOffset(chars, to)))
	} else if isAny(name, ["y", "ya", "yank"]) {
		caret := ed.caret
		yank(ed, chars, lineSpan(chars, lineOffset(chars, from), lineOffset(chars, to)))
		ed.caret = caret
	} else if isAny(name, ["j", "join"]) {
		ed.caret = lineOffset(chars, from)
		joinLines(ed, chars, maxInt(to - from + 1, 2), !bang)
	} else if isAny(name, ["m", "move", "t", "co", "copy"]) {
		target := address(split(args, ""), 0, lineOf(chars, ed.caret), final, ed.vim)
		if !target.ok || target.line < -1 || target.line > final {
			say(ed, "E14: Endereço inválido", "", true)
			return
		}
		moveLines(ed, from, to, target.line, name == "m" || name == "move")
	} else if isAny(name, ["sor", "sort"]) {
		if hasRange {
			sortLines(ed, from, to, bang)
		} else {
			sortLines(ed, 0, final, bang)
		}
	} else if isAny(name, ["bn", "bnext", "tabn", "tabnext"]) {
		effect(ed, model.Msg.CycleTab(1))
	} else if isAny(name, ["bp", "bprevious", "bN", "bNext", "tabp", "tabprevious", "tabN", "tabNext"]) {
		effect(ed, model.Msg.CycleTab(-1))
	} else if isAny(name, ["check", "make", "run", "test", "build"]) {
		// `:make` compila, como no Vim; os diagnósticos vêm do `:check`.
		mut action := name
		if name == "make" {
			action = "build"
		}
		effect(ed, model.Msg.Invoke(action))
	} else if isAny(name, ["term", "terminal"]) {
		effect(ed, model.Msg.ShowPane(model.Pane.TerminalPane()))
	} else if name == "!" {
		effect(ed, model.Msg.ShowPane(model.Pane.TerminalPane()))
		if args != "" {
			effect(ed, model.Msg.TermSubmit(args))
		}
	} else if isAny(name, ["Ex", "Explore", "Sex", "Sexplore", "Vex", "Vexplore", "Lex", "Lexplore", "Hex", "Hexplore", "Tex", "Texplore"]) {
		effect(ed, model.Msg.FocusExplorer(args))
	} else if isAny(name, ["Agent", "Agente"]) {
		effect(ed, model.Msg.ShowAgent(search.lower(args)))
	} else if name == "Claude" {
		effect(ed, model.Msg.ShowAgent("claude"))
	} else if name == "Codex" {
		effect(ed, model.Msg.ShowAgent("codex"))
	} else if isAny(name, ["OpenCode", "Opencode"]) {
		effect(ed, model.Msg.ShowAgent("opencode"))
	} else if isAny(name, ["u", "un", "undo"]) {
		undoSteps(ed, 1, true)
	} else if isAny(name, ["red", "redo"]) {
		undoSteps(ed, 1, false)
	} else if isAny(name, ["h", "help"]) {
		say(ed, helpText(), "", false)
	} else {
		say(ed, "E492: Não é um comando do editor: %1", name, true)
	}
}

// `:set nu`, `:set nonu`, `:set nu!`, `:set ts=4`, `:set hls`, `:set nohls`.
proc setOptions(ed: mut Editor, args: Str): void {
	mut numbers := ed.numbers
	for each option in split(args, " ") {
		if option == "" {
			continue
		}
		mut wanted := numbers
		if isAny(option, ["nu", "number"]) {
			wanted = true
		} else if isAny(option, ["nonu", "nonumber"]) {
			wanted = false
		} else if isAny(option, ["nu!", "number!", "invnu", "invnumber"]) {
			wanted = !numbers
		} else if isAny(option, ["hls", "hlsearch"]) {
			ed.vim.highlight = true
		} else if isAny(option, ["nohls", "nohlsearch"]) {
			ed.vim.highlight = false
		} else if option is "{key}={value}" && isAny(key, ["ts", "tabstop", "sw", "shiftwidth"]) {
			if hive.conv.sti(value) is Result.Ok(size) {
				effect(ed, model.Msg.SetTabSize(size))
			} else {
				say(ed, "E521: Número esperado: %1", option, true)
				return
			}
		} else {
			say(ed, "E518: Opção desconhecida: %1", option, true)
			return
		}
		if wanted != numbers {
			numbers = wanted
			effect(ed, model.Msg.ToggleSetting("lineNumbers"))
		}
	}
}

// `:s/padrão/troca/g` nas linhas `from`–`to`. O padrão é texto literal; na
// troca, `&` é o trecho achado e `\n`, `\t` e `\&` valem o que dizem.
proc substitute(ed: mut Editor, chars: Str[], args: Str, from: Int, to: Int): void {
	parts := split(args, "")
	delimiter := at(parts, 0)
	if delimiter == "" || isKeyword(delimiter) || isBlank(delimiter) || delimiter == "\\" || delimiter == "\"" {
		say(ed, "E: use :s/padrão/troca/", "", true)
		return
	}
	mut i := 1
	mut Str[dyn] wanted = []
	for ; i < len(parts); i++ {
		if at(parts, i) == delimiter {
			break
		}
		c := at(parts, i)
		if c == "\\" && i + 1 < len(parts) {
			escaped := at(parts, i + 1)
			if escaped == "n" {
				append(wanted, "\n")
			} else if escaped == "t" {
				append(wanted, "\t")
			} else {
				append(wanted, escaped)
			}
			i++
		} else {
			append(wanted, c)
		}
	}
	i++
	mut Str[dyn] pieces = []
	mut Str[dyn] current = []
	for ; i < len(parts); i++ {
		if at(parts, i) == delimiter {
			break
		}
		c := at(parts, i)
		if c == "\\" && i + 1 < len(parts) {
			escaped := at(parts, i + 1)
			if escaped == "n" {
				append(current, "\n")
			} else if escaped == "t" {
				append(current, "\t")
			} else {
				append(current, escaped)
			}
			i++
		} else if c == "&" {
			append(pieces, join(current, ""))
			Str[dyn] fresh = []
			current = fresh
		} else {
			append(current, c)
		}
	}
	append(pieces, join(current, ""))
	i++
	mut Str[dyn] flagChars = []
	for j := i; j < len(parts); j++ {
		append(flagChars, at(parts, j))
	}
	flags := join(flagChars, "")
	mut pattern := join(wanted, "")
	if pattern == "" {
		pattern = ed.vim.pattern
	}
	if pattern == "" {
		say(ed, "E35: Nenhuma busca anterior", "", true)
		return
	}
	global := indexOf(flags, "g") is Result.Ok(_)
	mut sensitive := sensitiveTo(pattern)
	if indexOf(flags, "i") is Result.Ok(_) {
		sensitive = false
	} else if indexOf(flags, "I") is Result.Ok(_) {
		sensitive = true
	}
	size := len(pattern)
	mut Str[dyn] lines = split(ed.text, "\n")
	mut replaced := 0
	mut touched := 0
	mut lastTouched := -1
	for l := from; l <= to; l++ {
		if lines bounds l {
			line := lines[l]
			mut limit := 1
			if global {
				limit = len(line) + 1
			}
			found := occurrencesOf(line, pattern, sensitive, limit)
			if len(found) > 0 {
				lines[l] = replacedIn(line, found, size, pieces)
				replaced = replaced + len(found)
				touched++
				lastTouched = l
			}
		}
	}
	before := snapshot(ed)
	ed.vim.pattern = pattern
	ed.vim.whole = false
	if replaced == 0 {
		say(ed, "E486: Padrão não encontrado: %1", pattern, true)
		return
	}
	pushUndo(ed, before)
	ed.text = join(lines, "\n")
	ed.caret = firstNonBlank(split(ed.text, ""), offsetOfLine(lines, lastTouched))
	sayTwo(ed, "%1 substituição(ões) em %2 linha(s)", "{replaced}", "{touched}")
}

// A linha com cada ocorrência (em `found`, de `size` caracteres) trocada pela
// troca do `:s`, com `&` (entre os `pieces`) valendo o trecho achado.
func replacedIn(line: Str, found: Int[], size: Int, pieces: Str[]): Str {
	mut Str[dyn] out = []
	mut previous := 0
	for each p in found {
		append(out, slice(line, previous, p))
		append(out, join(pieces, slice(line, p, p + size)))
		previous = p + size
	}
	append(out, complete.skip(line, previous))
	return join(out, "")
}

// `:m` (mover) e `:t` (copiar) as linhas `from`–`to` para depois de `after`
// (-1 = antes da primeira).
proc moveLines(ed: mut Editor, from: Int, to: Int, after: Int, moving: Bool): void {
	if moving && after >= from && after < to {
		say(ed, "E134: Não dá para mover linhas para dentro delas mesmas", "", true)
		return
	}
	lines := split(ed.text, "\n")
	mut Str[dyn] block = []
	for l := from; l <= to; l++ {
		append(block, lineText(lines, l))
	}
	mut Str[dyn] out = []
	mut lastMoved := 0
	if after < 0 {
		for each b in block {
			append(out, b)
		}
		lastMoved = len(out) - 1
	}
	for l := 0; l < len(lines); l++ {
		if !(moving && l >= from && l <= to) {
			append(out, lineText(lines, l))
		}
		if l == after {
			for each b in block {
				append(out, b)
			}
			lastMoved = len(out) - 1
		}
	}
	text := join(out, "\n")
	if text == ed.text {
		return
	}
	pushUndo(ed, snapshot(ed))
	ed.text = text
	ed.caret = firstNonBlank(split(text, ""), offsetOfLine(out, lastMoved))
}

// `:sort` (e `:sort!`, ao contrário) das linhas `from`–`to`.
proc sortLines(ed: mut Editor, from: Int, to: Int, reverse: Bool): void {
	mut Str[dyn] lines = split(ed.text, "\n")
	mut Str[dyn] block = []
	for l := from; l <= to; l++ {
		append(block, lineText(lines, l))
	}
	mut ordered := sort(block)
	if reverse {
		mut Str[dyn] flipped = []
		for k := len(ordered) - 1; k >= 0; k-- {
			if ordered bounds k {
				append(flipped, ordered[k])
			}
		}
		ordered = flipped
	}
	for l := from; l <= to; l++ {
		k := l - from
		if lines bounds l && ordered bounds k {
			lines[l] = ordered[k]
		}
	}
	text := join(lines, "\n")
	if text == ed.text {
		return
	}
	pushUndo(ed, snapshot(ed))
	ed.text = text
	ed.caret = firstNonBlank(split(text, ""), offsetOfLine(lines, from))
}

// ── o que a página mostra ────────────────────────────────────────────────

func modeName(v: model.Vim): Str {
	if v.mode is model.VimMode.NormalMode {
		return "normal"
	} else if v.mode is model.VimMode.InsertMode {
		return "insert"
	} else if v.mode is model.VimMode.VisualMode {
		return "visual"
	} else if v.mode is model.VimMode.VisualLineMode {
		return "visualLine"
	}
}

func modeLabel(v: model.Vim): Str {
	if v.mode is model.VimMode.NormalMode {
		return ""
	} else if v.mode is model.VimMode.InsertMode {
		return "-- INSERÇÃO --"
	} else if v.mode is model.VimMode.VisualMode {
		return "-- VISUAL --"
	} else if v.mode is model.VimMode.VisualLineMode {
		return "-- VISUAL LINHA --"
	}
}

// O trecho que a página seleciona: a seleção visual, ou só o cursor.
func shown(text: Str, caret: Int, v: model.Vim): Span {
	if v.mode == model.VimMode.VisualMode() || v.mode == model.VimMode.VisualLineMode() {
		return selection(text, split(text, ""), caret, v)
	}
	return Span(caret, caret, false, true)
}

// As ocorrências para realçar: o que está sendo digitado depois de `/` ou `?`,
// senão a última busca (até `:noh`).
func highlights(text: Str, v: model.Vim): Int[dyn] {
	if (v.prompt == "/" || v.prompt == "?") && v.command != "" {
		return matchesOf(text, v.command, false, 5000)
	}
	if v.highlight && v.prompt == "" {
		return matchesOf(text, v.pattern, v.whole, 5000)
	}
	Int[dyn] none = []
	return none
}

func highlightLength(v: model.Vim): Int {
	if (v.prompt == "/" || v.prompt == "?") && v.command != "" {
		return len(v.command)
	}
	return len(v.pattern)
}

// A ocorrência que a busca incremental mostra: a primeira depois do cursor.
func currentHighlight(found: Int[], caret: Int, backward: Bool): Int {
	mut best := -1
	for i := 0; i < len(found); i++ {
		m := atInt(found, i)
		if backward && m < caret {
			best = i
		} else if !backward && m > caret && best < 0 {
			best = i
		}
	}
	if best < 0 && len(found) > 0 {
		if backward {
			return len(found) - 1
		}
		return 0
	}
	return best
}

// ── testes ───────────────────────────────────────────────────────────────

func editorFor(text: Str, caret: Int): Editor {
	model.Snapshot[dyn] none = []
	model.Msg[dyn] nothing = []
	return Editor(text: text, caret: caret, vim: model.emptyVim(), undo: none, redo: none, dirty: false, anyDirty: false,
		numbers: true, active: 0, top: 0, rows: 20, tab: 4, scroll: -1, clip: "", effects: nothing)
}

func specialKeys(): Str[dyn] {
	return ["<Esc>", "<CR>", "<BS>", "<Space>", "<Del>", "<Tab>", "<C-r>", "<C-a>", "<C-x>", "<C-d>", "<C-u>",
		"<C-e>", "<C-y>", "<C-f>", "<C-b>", "<Left>", "<Right>", "<Up>", "<Down>", "<Home>", "<End>"]
}

// "d2w<Esc>" → ["d", "2", "w", "<Esc>"].
func tokens(text: Str): Str[dyn] {
	chars := split(text, "")
	mut Str[dyn] out = []
	mut i := 0
	for ; i < len(chars); {
		mut matched := ""
		if at(chars, i) == "<" {
			for each name in specialKeys() {
				if matched == "" && slice(text, i, i + len(name)) == name {
					matched = name
				}
			}
		}
		if matched == "" {
			append(out, at(chars, i))
			i++
		} else {
			append(out, matched)
			i = i + len(matched)
		}
	}
	return out
}

proc feed(ed: mut Editor, keys: Str): void {
	for each k in tokens(keys) {
		press(ed, k)
	}
}

// Um editor com `text`, o cursor em `caret`, depois de `keys`.
proc fed(text: Str, caret: Int, keys: Str): Editor {
	mut ed := editorFor(text, caret)
	feed(ed, keys)
	return ed
}

// O que a página faz quando se digita no modo de inserção.
proc typeText(ed: mut Editor, text: Str): void {
	ed.text = insertAt(ed.text, ed.caret, text)
	ed.caret = ed.caret + len(text)
}

proc caretsOf(text: Str, caret: Int, keys: Str): Int[dyn] {
	mut ed := editorFor(text, caret)
	mut Int[dyn] seen = []
	for each k in tokens(keys) {
		press(ed, k)
		append(seen, ed.caret)
	}
	return seen
}

test "w, W, e, b e ge andam por palavras, pontuação e linhas vazias" {
	text := "foo bar.baz\n  qux quux\n\nend"
	assert caretsOf(text, 0, "wwwwwww") == [4, 7, 8, 14, 18, 23, 24]
	assert caretsOf(text, 0, "WW") == [4, 14]
	assert caretsOf(text, 0, "eeee") == [2, 6, 7, 10]
	assert caretsOf(text, 10, "bbbb") == [8, 7, 4, 0]
	assert caretsOf(text, 8, "gege") == [8, 7, 7, 6]
	assert caretsOf(text, 0, "3w") == [0, 8]
}

test "linhas: 0, ^, $, j e k com a coluna guardada, gg e G" {
	text := "foo bar.baz\n  qux quux\n\nend"
	assert fed(text, 5, "$").caret == 10
	assert fed(text, 5, "0").caret == 0
	assert fed(text, 16, "^").caret == 14
	assert caretsOf(text, 2, "jjjkk") == [14, 23, 26, 23, 14]
	assert caretsOf(text, 0, "$jj") == [10, 21, 23]
	assert fed(text, 20, "gg").caret == 0
	assert fed(text, 0, "G").caret == 24
	assert fed(text, 0, "2G").caret == 14
	assert fed(text, 0, "3gg").caret == 23
	assert fed("a\nb\n", 0, "G").caret == 2
	tabs := "\tab\n12345678"
	assert fed(tabs, 1, "j").caret == 8
}

test "f, t, F, T, ; e , ficam na linha" {
	text := "foo bar.baz(a)"
	assert fed(text, 0, "f.").caret == 7
	assert caretsOf(text, 0, "fa;,") == [0, 5, 9, 5]
	assert fed(text, 0, "t.").caret == 6
	assert fed(text, 0, "t.;").caret == 6
	assert fed(text, 13, "Fb").caret == 8
	assert fed(text, 13, "Tb").caret == 9
	assert fed(text, 0, "fq").caret == 0
	assert fed(text, 0, "2fa").caret == 9
}

test "% salta entre pares, chaves entre parágrafos" {
	assert caretsOf("(a [b] c)", 0, "%%") == [8, 0]
	assert fed("x = f(a[1])", 0, "%").caret == 10
	text := "a\nb\n\nc\nd\n\ne"
	assert caretsOf(text, 0, "}}}") == [4, 9, 10]
	assert caretsOf(text, 10, "\{\{") == [9, 4]
}

test "dw não leva o fim da linha, cw muda só até o fim da palavra" {
	assert fed("foo bar\nbaz", 4, "dw").text == "foo \nbaz"
	assert fed("foo bar baz", 0, "d2w").text == "baz"
	assert fed("a b\nc d", 0, "d2w").text == "\nc d"
	deleted := fed("foo bar", 0, "dw")
	assert deleted.text == "bar"
	assert deleted.vim.register == "foo "
	mut changed := fed("foo bar", 0, "cw")
	typeText(changed, "x")
	feed(changed, "<Esc>")
	assert changed.text == "x bar"
	assert changed.vim.mode == model.VimMode.NormalMode()
	mut probe1 := fed("foo bar", 2, "cw")
	typeText(probe1, "x")
	feed(probe1, "<Esc>")
	assert probe1.text == "fox bar"
	assert fed("foo bar baz", 4, "de").text == "foo  baz"
	assert fed("foo bar baz", 8, "db").text == "foo baz"
	assert fed("foo(a, b)", 0, "dt,").text == ", b)"
	assert fed("foo(a, b)", 0, "df(").text == "a, b)"
}

test "dd, D, x e X, com contagem" {
	assert fed("a\nb\nc\nd", 0, "dd").text == "b\nc\nd"
	assert fed("a\nb\nc\nd", 0, "2dd").text == "c\nd"
	assert fed("a\nb\nc\nd", 0, "d2d").text == "c\nd"
	last := fed("a\nb", 2, "dd")
	assert last.text == "a"
	assert last.caret == 0
	assert last.vim.register == "b\n"
	assert last.vim.linewise
	assert fed("a\nb\n", 2, "dd").text == "a\n"
	assert fed("a\nb\nc", 2, "dj").text == "a"
	assert fed("a\nb\nc", 2, "dk").text == "c"
	assert fed("a\n  b\nc", 0, "dG").text == ""
	lines := fed("a\nb\nc\nd", 0, "3dd")
	assert lines.vim.message == "%1 linhas a menos"
	assert lines.vim.args == ["3"]
	cut := fed("hello world", 5, "D")
	assert cut.text == "hello"
	assert cut.caret == 4
	assert fed("abc", 1, "x").text == "ac"
	assert fed("abcdef", 1, "3x").text == "aef"
	assert fed("abc", 2, "x").caret == 1
	assert fed("abc", 2, "X").text == "ac"
	assert fed("abc", 0, "X").text == "abc"
}

test "yy, yw, p e P, e xp troca dois caracteres" {
	below := fed("one\ntwo", 0, "yyp")
	assert below.text == "one\none\ntwo"
	assert below.caret == 4
	above := fed("one\ntwo", 4, "yyP")
	assert above.text == "one\ntwo\ntwo"
	assert above.caret == 4
	word := fed("foo bar", 4, "ywP")
	assert word.text == "foo barbar"
	assert word.caret == 6
	assert fed("a\nb", 2, "yyp").text == "a\nb\nb"
	assert fed("a\nb", 0, "yy3p").text == "a\na\na\na\nb"
	assert fed("ab", 0, "xp").text == "ba"
	copied := fed("a\nb\nc", 0, "yj")
	assert copied.clip == "a\nb\n"
	assert copied.caret == 0
	assert fed("a", 0, "p").vim.error
}

test "inserir: i, a, I, A, o e O, com indentação e contagem" {
	appended := fed("foo", 0, "A")
	assert appended.caret == 3
	assert appended.vim.mode == model.VimMode.InsertMode()
	doneBefore := appended
	mut done := doneBefore
	typeText(done, "!")
	feed(done, "<Esc>")
	assert done.text == "foo!"
	assert done.caret == 3
	opened := fed("\tfoo \{", 0, "o")
	assert opened.text == "\tfoo \{\n\t\t"
	assert opened.caret == len(opened.text)
	above := fed("\tfoo", 1, "O")
	assert above.text == "\t\n\tfoo"
	assert above.caret == 1
	assert fed("\t  x", 0, "I").caret == 3
	assert fed("ab", 0, "a").caret == 1
	mut probe2 := fed("", 0, "3i")
	typeText(probe2, "hi")
	feed(probe2, "<Esc>")
	assert probe2.text == "hihihi"
	mut probe3 := fed("a", 0, "2o")
	typeText(probe3, "x")
	feed(probe3, "<Esc>")
	assert probe3.text == "a\nx\nx"
}

test "o ponto repete a última alteração, inclusive o que foi digitado" {
	assert fed("a b c d", 0, "dw.").text == "c d"
	mut changed := fed("foo bar", 0, "ciw")
	typeText(changed, "x")
	feed(changed, "<Esc>")
	againBefore := changed
	mut again := againBefore
	feed(again, "w.")
	assert again.text == "x x"
	assert again.caret == 2
	mut semicolons := fed("a\nb", 0, "A")
	typeText(semicolons, ";")
	feed(semicolons, "<Esc>j.")
	assert semicolons.text == "a;\nb;"
	assert fed("abcdef", 0, "x2.").text == "def"
	assert fed("a\nb\nc", 0, "ddu.").text == "b\nc"
}

test "u e Ctrl+R, e uma inserção inteira é um passo só" {
	undone := fed("a\nb", 0, "ddu")
	assert undone.text == "a\nb"
	assert undone.caret == 0
	probe4Before := undone
	mut probe4 := probe4Before
	feed(probe4, "<C-r>")
	assert probe4.text == "b"
	mut typed := fed("x", 0, "A")
	typeText(typed, "yz")
	feed(typed, "<Esc>")
	assert typed.text == "xyz"
	assert len(typed.undo) == 1
	backBefore := typed
	mut back := backBefore
	feed(back, "u")
	assert back.text == "x"
	oldestBefore := back
	mut oldest := oldestBefore
	feed(oldest, "u")
	assert oldest.vim.message == "Já está na alteração mais antiga"
	several := fed("a\nb\nc\nd", 0, "dddddd2u")
	assert several.text == "b\nc\nd"
	assert len(several.undo) == 1
	assert len(several.redo) == 2
	severalBefore := several
	mut forward := severalBefore
	feed(forward, "5<C-r>")
	assert forward.text == "d"
	assert len(forward.undo) == 3
	assert len(forward.redo) == 0
	assert len(fed("abc", 0, "i<Esc>").undo) == 0
	assert fed("abc", 0, "xxx3u").text == "abc"
}

test "objetos de texto: palavras, aspas, blocos e parágrafos" {
	assert fed("f(a, b)", 3, "di(").text == "f()"
	assert fed("f(a, b)", 3, "da(").text == "f"
	assert fed("f(a, (b))", 7, "d2i(").text == "f()"
	mut probe5 := fed("x = \"hello\"", 0, "ci\"")
	typeText(probe5, "bye")
	feed(probe5, "<Esc>")
	assert probe5.text == "x = \"bye\""
	assert fed("say 'hi' now", 5, "da'").text == "say now"
	assert fed("foo bar", 5, "diw").text == "foo "
	assert fed("foo bar baz", 4, "daw").text == "foo baz"
	assert fed("foo bar", 6, "daw").text == "foo"
	block := "f() \{\n\ta\n\tb\n}"
	assert fed(block, 7, "di\{").text == "f() \{\n}"
	changed := fed(block, 7, "ci\{")
	assert changed.text == "f() \{\n\t\n}"
	assert changed.caret == 7
	assert fed(block, 7, "yiB").vim.linewise
	assert fed("x [1, 2]", 4, "di]").text == "x []"
	assert fed("a\nb\n\nc", 0, "dip").text == "\nc"
	assert fed("a\nb\n\nc", 0, "dap").text == "c"
	assert fed("f(a)", 0, "dix").text == "f(a)"
}

test "maiúsculas, r, ~, J, gJ, >> e <<" {
	assert fed("foo bar", 4, "gUiw").text == "foo BAR"
	assert fed("FOO BAR", 0, "guu").text == "foo bar"
	assert fed("ação", 0, "gUU").text == "AÇÃO"
	assert fed("abc", 0, "rx").text == "xbc"
	replaced := fed("abcd", 0, "3r-")
	assert replaced.text == "---d"
	assert replaced.caret == 2
	assert fed("abc", 1, "5rx").text == "abc"
	toggled := fed("aBc", 0, "~")
	assert toggled.text == "ABc"
	assert toggled.caret == 1
	assert fed("aBc", 0, "3~").text == "AbC"
	joined := fed("a\n  b", 0, "J")
	assert joined.text == "a b"
	assert joined.caret == 1
	assert fed("a\n  b", 0, "gJ").text == "a  b"
	assert fed("f(\n)", 0, "J").text == "f()"
	assert fed("a\nb\nc", 0, "3J").text == "a b c"
	assert fed("a", 0, ">>").text == "\ta"
	assert fed("\t\ta", 0, "<<").text == "\ta"
	assert shiftedLine("      x", "\t", false, 2, 4) == "  x"
	assert shiftedLine("\t  x", "\t", false, 2, 4) == "x"
	assert shiftedLine(" x", "\t", false, 3, 4) == "x"
	assert trim("  a b \t ") == "a b"
	assert upper("olá ção") == "OLÁ ÇÃO"
	assert fed("a\nb\nc", 0, "2>>").text == "\ta\n\tb\nc"
	assert fed("  x\ny", 4, ">>").text == "  x\n    y"
	assert fed("f \{\n\ta\n}", 7, ">i\{").text == "f \{\n\t\ta\n}"
}

test "visual: v, V, o, operadores e objetos" {
	yanked := fed("hello world", 0, "vey")
	assert yanked.vim.register == "hello"
	assert yanked.vim.mode == model.VimMode.NormalMode()
	assert yanked.caret == 0
	assert fed("hello world", 0, "ved").text == " world"
	assert fed("a\nb\nc", 0, "Vjd").text == "c"
	assert fed("ab\ncd", 1, "vjd").text == "a"
	assert fed("foo bar", 5, "viwU").text == "foo BAR"
	assert fed("a\nb", 0, "Vj>").text == "\ta\n\tb"
	swapped := fed("abcdef", 1, "vllo")
	assert swapped.caret == 1
	assert swapped.vim.anchor == 3
	over := fed("foo bar", 0, "yiwwviwp")
	assert over.text == "foo foo"
	assert over.vim.register == "bar"
	selecting := fed("a\nb\nc", 0, "Vj")
	assert selecting.vim.mode == model.VimMode.VisualLineMode()
	span := shown(selecting.text, selecting.caret, selecting.vim)
	assert span.from == 0 && span.to == 4
	probe6Before := selecting
	mut probe6 := probe6Before
	feed(probe6, "<Esc>")
	assert probe6.vim.mode == model.VimMode.NormalMode()
	assert fed("abc", 0, "vlrx").text == "xxc"
}

test "a busca: /, n, N, *, # e smartcase" {
	text := "foo bar foo baz foo"
	mut found := fed(text, 0, "/")
	submit(found, "foo")
	assert found.caret == 8
	assert found.vim.highlight
	probe7Before := found
	mut probe7 := probe7Before
	feed(probe7, "n")
	assert probe7.caret == 16
	wrappedBefore := found
	mut wrapped := wrappedBefore
	feed(wrapped, "nn")
	assert wrapped.caret == 0
	assert wrapped.vim.message == "a busca chegou ao FIM, continuando do INÍCIO"
	probe8Before := found
	mut probe8 := probe8Before
	feed(probe8, "N")
	assert probe8.caret == 0
	probe9Before := found
	mut probe9 := probe9Before
	feed(probe9, "dn")
	assert probe9.text == "foo bar foo"
	mut backward := fed(text, 10, "?")
	submit(backward, "foo")
	assert backward.caret == 8
	probe10Before := backward
	mut probe10 := probe10Before
	feed(probe10, "n")
	assert probe10.caret == 0
	mut probe11 := fed("Foo foo", 0, "/")
	submit(probe11, "foo")
	assert probe11.caret == 4
	mut probe12 := fed("Foo foo", 1, "/")
	submit(probe12, "Foo")
	assert probe12.caret == 0
	assert fed("ab abc ab", 0, "*").caret == 7
	assert fed("ab abc ab", 7, "#").caret == 0
	mut missing := fed(text, 0, "/")
	submit(missing, "zzz")
	assert missing.vim.error
	assert missing.vim.args == ["zzz"]
	assert len(highlights(text, found.vim)) == 3
	probe13Before := found
	mut probe13 := probe13Before
	submit(probe13, "noh")
	assert len(highlights(text, probe13.vim)) == 0
}

test "linha de comando: endereços, :s, :d, :m, :t, :sort e :>" {
	mut probe14 := fed("a\nb\nc", 0, ":")
	submit(probe14, "3")
	assert probe14.caret == 4
	mut probe15 := fed("a\nb\nc", 0, ":")
	submit(probe15, "$")
	assert probe15.caret == 4
	mut all := fed("foo\nboo", 0, ":")
	submit(all, "%s/o/0/g")
	assert all.text == "f00\nb00"
	assert all.vim.args == ["4", "2"]
	mut probe16 := fed("foo", 0, ":")
	submit(probe16, "s/o/[&]/")
	assert probe16.text == "f[o]o"
	mut probe17 := fed("a.b", 0, ":")
	submit(probe17, "s#.#\\n#")
	assert probe17.text == "a\nb"
	mut probe18 := fed("a\nb\nc\nd", 0, ":")
	submit(probe18, "2,3d")
	assert probe18.text == "a\nd"
	mut probe19 := fed("a\nb\nc", 4, ":")
	submit(probe19, "m0")
	assert probe19.text == "c\na\nb"
	mut probe20 := fed("a\nb\nc", 0, ":")
	submit(probe20, "m$")
	assert probe20.text == "b\nc\na"
	mut probe21 := fed("a\nb", 0, ":")
	submit(probe21, "t.")
	assert probe21.text == "a\na\nb"
	mut probe22 := fed("c\na\nb", 0, ":")
	submit(probe22, "sort")
	assert probe22.text == "a\nb\nc"
	mut probe23 := fed("c\na\nb", 0, ":")
	submit(probe23, "sort!")
	assert probe23.text == "c\nb\na"
	mut probe24 := fed("a\nb", 0, ":")
	submit(probe24, "%>")
	assert probe24.text == "\ta\n\tb"
	mut probe25 := fed("a\nb\nc", 0, ":")
	submit(probe25, ".,+1j")
	assert probe25.text == "a b\nc"
	mut ranged := fed("a\nb\nc", 0, "Vj:")
	submit(ranged, "'<,'>d")
	assert ranged.text == "c"
	assert fed("a\nb\nc", 0, "Vj:").vim.command == "'<,'>"
	assert fed("a\nb\nc", 0, "3:").vim.command == ".,.+2"
	mut unknown := fed("a", 0, ":")
	submit(unknown, "frobnicate")
	assert unknown.vim.error
	assert unknown.vim.args == ["frobnicate"]
	mut probe26 := fed("a", 0, ":")
	submit(probe26, "5,2d")
	assert probe26.text == "a"
}

test "linha de comando: salvar, fechar, abrir e opções viram efeitos" {
	mut clean := editorFor("a", 0)
	clean.active = 2
	mut dirty := editorFor("a", 0)
	dirty.active = 2
	dirty.dirty = true
	probe27Before := clean
	mut probe27 := probe27Before
	submit(probe27, "w")
	assert probe27.effects == [model.Msg.Save()]
	probe28Before := clean
	mut probe28 := probe28Before
	submit(probe28, "q")
	assert probe28.effects == [model.Msg.CloseDoc(2)]
	probe29Before := clean
	mut probe29 := probe29Before
	submit(probe29, "x")
	assert probe29.effects == [model.Msg.CloseDoc(2)]
	probe30Before := clean
	mut probe30 := probe30Before
	submit(probe30, "wq")
	assert probe30.effects == [model.Msg.Save(), model.Msg.CloseDoc(2)]
	refusedBefore := dirty
	mut refused := refusedBefore
	submit(refused, "q")
	assert refused.vim.error
	assert len(refused.effects) == 0
	probe31Before := dirty
	mut probe31 := probe31Before
	submit(probe31, "q!")
	assert probe31.effects == [model.Msg.CloseDoc(2)]
	probe32Before := dirty
	mut probe32 := probe32Before
	submit(probe32, "x")
	assert probe32.effects == [model.Msg.Save(), model.Msg.CloseDoc(2)]
	probe33Before := clean
	mut probe33 := probe33Before
	submit(probe33, "e lib/novo.hive")
	assert probe33.effects == [model.Msg.VimEdit("lib/novo.hive")]
	probe34Before := dirty
	mut probe34 := probe34Before
	submit(probe34, "e!")
	assert probe34.effects == [model.Msg.VimReload()]
	probe35Before := clean
	mut probe35 := probe35Before
	submit(probe35, "set nonu")
	assert probe35.effects == [model.Msg.ToggleSetting("lineNumbers")]
	probe36Before := clean
	mut probe36 := probe36Before
	submit(probe36, "set nu")
	assert len(probe36.effects) == 0
	probe37Before := clean
	mut probe37 := probe37Before
	submit(probe37, "set ts=2")
	assert probe37.effects == [model.Msg.SetTabSize(2)]
	probe38Before := clean
	mut probe38 := probe38Before
	submit(probe38, "bn")
	assert probe38.effects == [model.Msg.CycleTab(1)]
	probe39Before := clean
	mut probe39 := probe39Before
	submit(probe39, "run")
	assert probe39.effects == [model.Msg.Invoke("run")]
	probe40Before := clean
	mut probe40 := probe40Before
	submit(probe40, "make")
	assert probe40.effects == [model.Msg.Invoke("build")]
	probe41Before := clean
	mut probe41 := probe41Before
	submit(probe41, "check")
	assert probe41.effects == [model.Msg.Invoke("check")]
	probe42Before := clean
	mut probe42 := probe42Before
	submit(probe42, "!ls")
	assert probe42.effects == [model.Msg.ShowPane(model.Pane.TerminalPane()), model.Msg.TermSubmit("ls")]
	probe43Before := clean
	mut probe43 := probe43Before
	submit(probe43, "Ex")
	assert probe43.effects == [model.Msg.FocusExplorer("")]
	probe44Before := clean
	mut probe44 := probe44Before
	submit(probe44, "Vex lib")
	assert probe44.effects == [model.Msg.FocusExplorer("lib")]
	probe45Before := clean
	mut probe45 := probe45Before
	submit(probe45, "Claude")
	assert probe45.effects == [model.Msg.ShowAgent("claude")]
	probe46Before := clean
	mut probe46 := probe46Before
	submit(probe46, "Codex")
	assert probe46.effects == [model.Msg.ShowAgent("codex")]
	probe47Before := clean
	mut probe47 := probe47Before
	submit(probe47, "OpenCode")
	assert probe47.effects == [model.Msg.ShowAgent("opencode")]
	probe48Before := clean
	mut probe48 := probe48Before
	submit(probe48, "Agent Codex")
	assert probe48.effects == [model.Msg.ShowAgent("codex")]
	probe49Before := clean
	mut probe49 := probe49Before
	feed(probe49, "gd")
	assert probe49.effects == [model.Msg.GotoDefinition(0)]
	probe50Before := clean
	mut probe50 := probe50Before
	feed(probe50, "ZZ")
	assert probe50.effects == [model.Msg.CloseDoc(2)]
	historyBefore := clean
	mut history := historyBefore
	feed(history, ":")
	submit(history, "set nu")
	submit(history, "noh")
	mut browsing := history.vim
	browsing.prompt = ":"
	probe51Before := browsing
	mut probe51 := probe51Before
	browseHistory(probe51, -1)
	assert probe51.command == "noh"
	probe52Before := browsing
	mut probe52 := probe52Before
	browseHistory(probe52, -1)
	browseHistory(probe52, -1)
	assert probe52.command == "set nu"
}

test "Ctrl+A, Ctrl+X, rolagem e clique" {
	plus := fed("x = 41", 0, "<C-a>")
	assert plus.text == "x = 42"
	assert plus.caret == 5
	assert fed("x = 41", 0, "5<C-x>").text == "x = 36"
	assert fed("-3", 0, "<C-a>").text == "-2"
	mut Str[dyn] many = []
	for n := 0; n < 100; n++ {
		append(many, "line {n}")
	}
	long := join(many, "\n")
	down := fed(long, 0, "<C-d>")
	assert lineOf(split(long, ""), down.caret) == 10
	assert down.scroll == 10
	mut middle := editorFor(long, lineOffset(split(long, ""), 50))
	middle.top = 45
	probe53Before := middle
	mut probe53 := probe53Before
	feed(probe53, "zz")
	assert probe53.scroll == 40
	probe54Before := middle
	mut probe54 := probe54Before
	feed(probe54, "zt")
	assert probe54.scroll == 50
	probe55Before := middle
	mut probe55 := probe55Before
	feed(probe55, "H")
	assert lineOf(split(long, ""), probe55.caret) == 45
	probe56Before := middle
	mut probe56 := probe56Before
	feed(probe56, "L")
	assert lineOf(split(long, ""), probe56.caret) == 64
	mut selected := editorFor("hello", 0)
	click(selected, 1, 4)
	assert selected.vim.mode == model.VimMode.VisualMode()
	assert selected.vim.anchor == 1
	assert selected.caret == 3
	probe57Before := selected
	mut probe57 := probe57Before
	click(probe57, 2, 2)
	assert probe57.vim.mode == model.VimMode.NormalMode()
	mut probe58 := editorFor("ab\n", 0)
	click(probe58, 3, 3)
	assert probe58.caret == 1
}

test "teclas que chegam atrasadas no modo de inserção viram texto" {
	typed := fed("\tf(", 2, "a<CR>x<BS>y<Esc>")
	assert typed.text == "\tf(\n\t\ty"
	assert typed.vim.mode == model.VimMode.NormalMode()
	assert typed.vim.typed == "\n\t\ty"
	mut v := fed("a", 0, ":").vim
	promptKey(v, "w")
	promptKey(v, "q")
	promptKey(v, "<BS>")
	assert v.command == "w"
	assert fed("abc def", 0, "g_").caret == 6
}

test "macros: q grava, @ repete, e a repetição para no primeiro erro" {
	mut recorded := fed("a\nb\nc", 0, "qaA")
	typeText(recorded, ";")
	feed(recorded, "<Esc>jq")
	assert recorded.text == "a;\nb\nc"
	assert recorded.vim.recordingTo == ""
	if hive.map.get(recorded.vim.macros, "a") is Result.Ok(keys) {
		assert keys == ["A", "<Text>;", "<Esc>", "j"]
	} else {
		assert false
	}
	onceBefore := recorded
	mut once := onceBefore
	feed(once, "@a")
	assert once.text == "a;\nb;\nc"
	assert lineOf(split(once.text, ""), once.caret) == 2
	// No fim, o `j` falha e a macro para, mas o que já fez fica.
	probe59Before := once
	mut probe59 := probe59Before
	feed(probe59, "@@")
	assert probe59.text == "a;\nb;\nc;"
	probe60Before := recorded
	mut probe60 := probe60Before
	feed(probe60, "5@a")
	assert probe60.text == "a;\nb;\nc;"
	probe61Before := recorded
	mut probe61 := probe61Before
	feed(probe61, "u")
	assert probe61.text == "a\nb\nc"
	lines := fed("x\nx\nx\nx", 0, "qb0rYjq100@b")
	assert lines.text == "Y\nY\nY\nY"
	recording := fed("a", 0, "qc")
	assert recording.vim.recordingTo == "c"
	probe62Before := recording
	mut probe62 := probe62Before
	feed(probe62, "vq")
	assert probe62.vim.recordingTo == ""
}

test "macros: comandos de :, visual, maiúscula acrescenta, @: e macro que chama a si mesma" {
	mut started := fed("foo\nfoo\nfoo", 0, "qa:")
	submit(started, "s/o/0/g")
	recordedBefore := started
	mut recorded := recordedBefore
	feed(recorded, "jq")
	assert recorded.text == "f00\nfoo\nfoo"
	if hive.map.get(recorded.vim.macros, "a") is Result.Ok(keys) {
		assert keys == [":", "<Text>s/o/0/g", "<CR>", "j"]
	}
	probe63Before := recorded
	mut probe63 := probe63Before
	feed(probe63, "@a")
	assert probe63.text == "f00\nf00\nfoo"
	probe64Before := recorded
	mut probe64 := probe64Before
	feed(probe64, "@:")
	assert probe64.text == "f00\nf00\nfoo"
	probe65Before := recorded
	mut probe65 := probe65Before
	feed(probe65, "j@:")
	feed(probe65, "")
	assert probe65.caret == 8
	mut visual := fed("a\nb\nc\nd", 0, "qvVj:")
	submit(visual, "'<,'>d")
	feed(visual, "q")
	assert visual.text == "c\nd"
	probe66Before := visual
	mut probe66 := probe66Before
	feed(probe66, "@v")
	assert probe66.text == ""
	appended := fed("abcdef", 0, "qbxqqBxq")
	if hive.map.get(appended.vim.macros, "b") is Result.Ok(keys) {
		assert keys == ["x", "x"]
	}
	probe67Before := appended
	mut probe67 := probe67Before
	feed(probe67, "@b")
	assert probe67.text == "ef"
	mut cancelled := fed("abc", 0, "qd:")
	cancel(cancelled)
	assert cancelled.vim.prompt == ""
	probe68Before := cancelled
	mut probe68 := probe68Before
	feed(probe68, "xq@d")
	assert probe68.text == "c"
	endless := fed("abc", 0, "qeq")
	mut looping := endless
	looping.vim.macros = endless.vim.macros
	mut hive.map.Map<Str, Str[dyn]> macros = endless.vim.macros
	hive.map.set(macros, "e", ["l", "@", "e"])
	looping.vim.macros = macros
	stoppedBefore := looping
	mut stopped := stoppedBefore
	feed(stopped, "@e")
	assert stopped.vim.replaying == 0
	assert len(stopped.vim.pending) == 0
	assert fed("abc", 0, "@z").text == "abc"
	assert fed("abc", 0, "q!").vim.recordingTo == ""
}

test "teclas incompletas esperam, e Esc esquece" {
	waiting := fed("abc", 0, "2d")
	assert waiting.vim.pending == ["2", "d"]
	assert waiting.text == "abc"
	probe69Before := waiting
	mut probe69 := probe69Before
	feed(probe69, "<Esc>")
	assert len(probe69.vim.pending) == 0
	assert len(fed("abc", 0, "dq").vim.pending) == 0
	assert fed("abc", 0, "dq").text == "abc"
	assert modeName(fed("abc", 0, "v").vim) == "visual"
	assert modeLabel(fed("abc", 0, "i").vim) == "-- INSERÇÃO --"
}
