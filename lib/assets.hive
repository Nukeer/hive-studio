// Gerado por tools/embed.hive a partir de assets/. Não edite à mão.

// assets/shell.html
func shell(): Str {
	return `
		<!doctype html>
		<html lang="pt-BR">
		<head>
		<meta charset="utf-8">
		<title>Hive Studio</title>
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2.5 27.7 9.25v13.5L16 29.5 4.3 22.75V9.25z' fill='%23f5a623'/%3E%3Cpath d='M16 10 21.2 13v6L16 22l-5.2-3v-6z' fill='%231b1d23' opacity='.82'/%3E%3C/svg%3E">
		<link rel="stylesheet" href="/vendor/xterm.css?token=__TOKEN__">
		<script src="/vendor/xterm.js?token=__TOKEN__"></script>
		<script src="/vendor/addon-fit.js?token=__TOKEN__"></script>
		<style id="theme"></style>
		<style>
		:root\{--mono:"Cascadia Code","Cascadia Mono",Consolas,"JetBrains Mono","Fira Code",monospace}
		*\{box-sizing:border-box}
		html,body\{margin:0;height:100%;overflow:hidden;background:var(--editor);color:var(--text);font:13px/1.5 "Segoe UI",system-ui,-apple-system,sans-serif}
		::-webkit-scrollbar\{width:10px;height:10px}
		::-webkit-scrollbar-track\{background:transparent}
		::-webkit-scrollbar-thumb\{background-color:color-mix(in srgb,var(--muted) 30%,transparent);border-radius:8px;border:2px solid transparent;background-clip:padding-box}
		::-webkit-scrollbar-thumb:hover\{background-color:color-mix(in srgb,var(--muted) 55%,transparent)}
		::-webkit-scrollbar-thumb:active\{background-color:color-mix(in srgb,var(--accent) 60%,transparent)}
		::-webkit-scrollbar-button\{display:none;width:0;height:0}
		::-webkit-scrollbar-corner\{background:transparent}
		button,input,select\{font:inherit}
		#app\{display:flex;flex-direction:column;height:100vh}
		#title\{display:flex;align-items:center;gap:4px;padding:0 8px 0 6px;height:34px;background:var(--titlebar);border-bottom:1px solid var(--border);flex:none;position:relative;z-index:60}
		#title .logo\{width:18px;height:18px;margin:0 6px 0 2px;flex:none}
		#title .muted\{color:var(--muted);font-size:12px;white-space:nowrap}
		#title .grow\{flex:1}
		#title .caption\{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:40vw}
		.menubar\{display:flex;align-items:center;height:100%}
		.menu\{position:relative;height:100%;display:flex;align-items:center}
		.mlabel\{padding:3px 9px;border-radius:5px;cursor:default;font-size:13px;color:var(--text);user-select:none}
		.menu:hover .mlabel,.menu.open .mlabel\{background:var(--selection)}
		.mdrop\{display:none;position:absolute;top:100%;left:0;min-width:280px;background:var(--side);border:1px solid var(--border);border-radius:6px;box-shadow:0 10px 28px rgba(0,0,0,.38);padding:4px;z-index:100}
		.menu.open .mdrop\{display:block}
		.mi\{display:flex;justify-content:space-between;gap:28px;padding:4px 10px;border-radius:4px;cursor:pointer;white-space:nowrap;font-size:13px}
		.mi:hover\{background:var(--accent);color:var(--status-fg)}
		.mi.disabled\{opacity:.42;pointer-events:none}
		.mk\{color:var(--muted);font-size:12px}
		.mi:hover .mk\{color:inherit}
		.msep\{height:1px;background:var(--border);margin:4px 6px}
		.tools\{display:flex;gap:2px}
		.tb\{background:transparent;border:1px solid transparent;color:var(--text);border-radius:4px;padding:2px 10px;cursor:pointer;font-size:12px;font-family:inherit}
		.tb:hover:not(:disabled)\{background:var(--selection)}
		.tb:disabled\{opacity:.4;cursor:default}
		.tb.run\{color:var(--good)}
		#welcome .big svg\{width:76px;height:76px}
		.msg .big svg\{width:56px;height:56px}
		.about-name\{font-size:18px;font-weight:600;margin:8px 0 4px}
		.about-actions\{margin-top:16px}
		#body\{flex:1;display:flex;min-height:0}
		#activity\{width:48px;flex:none;background:var(--activity);display:flex;flex-direction:column;align-items:center;padding:8px 0;gap:4px;border-right:1px solid var(--border)}
		#activity .ai\{width:48px;height:44px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--muted);cursor:pointer;border-left:2px solid transparent}
		#activity .ai:hover\{color:var(--text)}
		#activity .ai.on\{color:var(--text);border-left-color:var(--accent)}
		#activity .grow\{flex:1}
		#side\{width:270px;flex:none;background:var(--side);overflow:auto;border-right:1px solid var(--border)}
		#app.noside #side\{display:none}
		#side:focus\{outline:none}
		#side:focus .row.focus\{border-color:var(--accent);background:color-mix(in srgb,var(--selection) 75%,transparent)}
		#main\{flex:1;display:flex;flex-direction:column;min-width:0}
		#tabs\{display:flex;background:var(--tabstrip);overflow-x:auto;overflow-y:hidden;flex:none;min-height:36px}
		#tabs::-webkit-scrollbar\{height:3px}
		#crumbs\{flex:none;padding:2px 16px;color:var(--muted);font-size:12px;min-height:24px;display:flex;align-items:center;gap:10px;background:var(--editor)}
		#crumbs .grow\{flex:1}
		#work\{flex:1;min-height:0;display:flex;position:relative;background:var(--editor)}
		#editor,#preview,#settings,#welcome,#commit\{flex:1;min-width:0;display:none}
		.l-commit #commit\{display:block}
		#commit\{overflow:auto;padding:22px 30px}
		.cm\{max-width:1400px}
		.cm-head\{padding-bottom:14px;border-bottom:1px solid var(--border);margin-bottom:14px}
		.cm-subject\{font-size:18px;font-weight:600;margin-bottom:4px}
		.cm-meta\{color:var(--muted);font-size:12px}
		.cm-meta .hash,.logline .hash\{font-family:var(--mono);color:var(--accent)}
		.cm-body\{font-family:inherit;white-space:pre-wrap;margin:10px 0 0;color:var(--text)}
		.cm-stats\{margin-top:10px;font-size:12px;color:var(--muted)}
		.plus\{color:var(--git-new);font-family:var(--mono);font-size:12px}
		.minus\{color:var(--danger);font-family:var(--mono);font-size:12px}
		.cm-files\{margin-bottom:18px;border:1px solid var(--border);border-radius:6px;overflow:hidden}
		.cm-file\{display:flex;gap:8px;align-items:center;padding:5px 12px;cursor:pointer;border-bottom:1px solid color-mix(in srgb,var(--border) 60%,transparent)}
		.cm-file:last-child\{border-bottom:0}
		.cm-file:hover\{background:var(--selection)}
		.cm-file .grow,.df-head .grow\{flex:1}
		.cm-file .ic,.df-head .ic\{width:18px;text-align:center;font-size:11px;font-weight:700}
		.cm-file .st\{font-size:11px;width:72px;text-align:right}
		.df\{border:1px solid var(--border);border-radius:6px;margin-bottom:16px;overflow:hidden}
		.df-head\{display:flex;gap:8px;align-items:center;padding:6px 12px;background:var(--side);cursor:pointer;position:sticky;top:-22px;z-index:1;border-bottom:1px solid var(--border)}
		.df-head .chev\{width:12px;color:var(--muted)}
		.df.collapsed .df-body,.df.collapsed .empty\{display:none}
		.df.collapsed .df-head\{border-bottom:0}
		.df.collapsed .chev\{transform:rotate(-90deg)}
		.df-body\{border-collapse:collapse;width:100%;font-family:var(--mono);font-size:var(--font-size);line-height:var(--line);tab-size:var(--tab)}
		.df-body td\{padding:0 8px;vertical-align:top}
		.df-body td.no\{width:1%;min-width:44px;text-align:right;color:var(--gutter);user-select:none;white-space:nowrap}
		.df-body td.sign\{width:1%;user-select:none;padding:0 4px}
		.df-body td.code\{white-space:pre;width:100%}
		.df-body tr.add td\{background:color-mix(in srgb,var(--git-new) 13%,transparent)}
		.df-body tr.add td.sign\{color:var(--git-new)}
		.df-body tr.del td\{background:color-mix(in srgb,var(--danger) 13%,transparent)}
		.df-body tr.del td.sign\{color:var(--danger)}
		.df-body tr.hunk td\{background:color-mix(in srgb,var(--accent) 9%,transparent);color:var(--muted)}
		.df-body tr.note td\{color:var(--muted);font-style:italic}
		.logline\{cursor:pointer}
		.logline:hover\{background:color-mix(in srgb,var(--selection) 60%,transparent);color:var(--text)}
		.logline.on\{background:var(--selection);color:var(--text)}
		.l-edit #editor,.l-split #editor\{display:flex}
		.l-preview #preview,.l-split #preview\{display:block}
		.l-split #preview\{border-left:1px solid var(--border)}
		.l-settings #settings\{display:block}
		.l-welcome #welcome\{display:flex}
		#editor\{position:relative;background:var(--editor)}
		#gutter\{margin:0;padding:8px 14px 8px 8px;min-width:58px;text-align:right;color:var(--gutter);font-family:var(--mono);font-size:var(--font-size);line-height:var(--line);overflow:hidden;user-select:none;flex:none;white-space:pre}
		#app.nonumbers #gutter\{display:none}
		#code\{position:relative;flex:1;min-width:0}
		#hl,#ta\{position:absolute;inset:0;margin:0;padding:8px 16px 8px 4px;font-family:var(--mono);font-size:var(--font-size);line-height:var(--line);tab-size:var(--tab);-moz-tab-size:var(--tab);white-space:pre;overflow:auto;border:0;letter-spacing:0;font-variant-ligatures:none}
		#hl\{pointer-events:none;color:var(--text);overflow:hidden}
		#hll>div\{min-height:var(--line)}
		#hl .pad\{height:calc(var(--line) * 3)}
		#ta\{background:transparent;color:transparent;caret-color:var(--text);resize:none;outline:none}
		#ta::selection\{background:color-mix(in srgb,var(--accent) 30%,transparent);color:transparent}
		.tk\{color:var(--syn-keyword)}.tt\{color:var(--syn-type)}.ts\{color:var(--syn-string)}.tn\{color:var(--syn-number)}
		.tc\{color:var(--syn-comment);font-style:italic}.tf\{color:var(--syn-call)}.ta\{color:var(--syn-atom)}.tb\{color:var(--syn-literal)}.tm\{color:var(--syn-module)}
		#popup\{position:absolute;display:none;z-index:20;min-width:280px;max-width:460px;max-height:260px;overflow:auto;background:var(--side);border:1px solid var(--border);box-shadow:0 8px 24px rgba(0,0,0,.35);border-radius:4px;font-size:13px;padding:2px 0}
		#popup.open\{display:block}
		.sg\{display:flex;gap:8px;padding:2px 8px;cursor:pointer;align-items:center;white-space:nowrap}
		.sg:hover\{background:color-mix(in srgb,var(--selection) 60%,transparent)}
		.sg.on\{background:var(--selection)}
		.sg .k\{width:18px;text-align:center;font-size:12px}
		.sg .w\{font-family:var(--mono)}
		.sg .d\{margin-left:auto;padding-left:16px;color:var(--muted);font-size:11px}
		#preview\{overflow:auto;padding:28px 44px}
		#settings\{overflow:auto;padding:28px 44px}
		#welcome\{flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--muted)}
		#welcome .big\{font-size:64px;color:var(--accent);line-height:1}
		#welcome h1\{color:var(--text);font-weight:500;margin:0}
		#welcome table\{margin-top:18px;border-collapse:collapse}
		#welcome td\{padding:5px 14px}
		#welcome tr.wl\{cursor:pointer}
		#welcome tr.wl td:first-child\{color:var(--accent);border-radius:5px 0 0 5px}
		#welcome tr.wl td:last-child\{border-radius:0 5px 5px 0;text-align:right}
		#welcome tr.wl:hover td\{background:var(--selection)}
		#welcome tr.wl:hover td:first-child\{text-decoration:underline}
		#panel\{height:260px;flex:none;background:var(--panel);border-top:1px solid var(--border);display:flex;flex-direction:column;min-height:0}
		#app.nopanel #panel,#app.nopanel #grip\{display:none}
		#panelview\{flex:1;display:flex;flex-direction:column;min-height:0}
		#app.agentpane #panelview\{flex:none}
		#agenthost\{display:none;flex:1;min-height:0;position:relative;margin:0 6px 4px 12px}
		#app.agentpane #agenthost\{display:block}
		#agenthost .agentterm\{position:absolute;inset:0}
		#panel .agentbody\{flex:none}
		#panel .agentbody:empty\{display:none}
		#panel .head .seg\{font-size:11px}
		#grip\{height:5px;margin-top:-3px;position:relative;z-index:5;cursor:ns-resize;flex:none}
		#grip:hover,#grip.drag\{background:color-mix(in srgb,var(--accent) 70%,transparent)}
		#app.panelmax #work,#app.panelmax #tabs,#app.panelmax #crumbs\{display:none}
		#app.panelmax #panel\{flex:1;height:auto!important}
		body.dragging,body.dragging *\{cursor:ns-resize!important;user-select:none}
		#code.linkable #ta\{cursor:pointer}
		#marks\{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:1}
		#marks i\{position:absolute;background:color-mix(in srgb,var(--warn) 30%,transparent);border-radius:2px}
		#marks i.cur\{background:color-mix(in srgb,var(--accent) 50%,transparent);box-shadow:0 0 0 1px var(--accent)}
		#find:empty\{display:none}
		#find\{position:absolute;top:6px;right:22px;z-index:25}
		.findbox\{display:flex;align-items:center;gap:4px;background:var(--side);border:1px solid var(--border);border-radius:6px;padding:4px 6px;box-shadow:0 6px 18px rgba(0,0,0,.3)}
		.findbox .field\{width:240px;padding:3px 7px}
		.findbox .count\{min-width:86px;font-size:12px;color:var(--muted);text-align:center}
		.act.toggle\{font-size:12px;font-weight:600;border:1px solid transparent}
		.act.toggle.on\{color:var(--text);background:var(--selection);border-color:var(--accent)}
		#palette:empty\{display:none}
		#palette\{position:fixed;inset:0;z-index:70;display:flex;justify-content:center;align-items:flex-start;padding-top:52px;background:rgba(0,0,0,.2)}
		.palette\{width:min(640px,92vw);background:var(--side);border:1px solid var(--border);border-radius:8px;box-shadow:0 14px 40px rgba(0,0,0,.45);overflow:hidden}
		.palette .field\{width:100%;border:0;border-bottom:1px solid var(--border);border-radius:0;padding:10px 14px;font-size:14px;background:var(--input)}
		.palette .pl\{max-height:420px;overflow:auto;padding:4px}
		.pi\{display:flex;align-items:center;gap:8px;padding:4px 10px;border-radius:4px;cursor:pointer;white-space:nowrap}
		.pi:hover\{background:color-mix(in srgb,var(--selection) 60%,transparent)}
		.pi.on\{background:var(--selection)}
		.pi .ic\{width:20px;text-align:center;font-size:11px;font-weight:700}
		.pi .dir,.sfile .dir\{color:var(--muted);font-size:12px;overflow:hidden;text-overflow:ellipsis}
		.searchbox .act.toggle\{padding:2px 6px}
		.sfile\{padding-left:10px;margin-top:4px}
		.sfile .nm\{font-weight:600}
		.shit\{display:flex;gap:8px;padding:1px 10px 1px 30px;cursor:pointer;font-size:12px;white-space:nowrap;overflow:hidden}
		.shit:hover\{background:var(--selection)}
		.shit .ln\{color:var(--gutter);min-width:26px;text-align:right;font-family:var(--mono)}
		.shit .tx\{overflow:hidden;text-overflow:ellipsis;font-family:var(--mono)}
		.shit mark\{background:color-mix(in srgb,var(--warn) 35%,transparent);color:inherit;border-radius:2px}
		.aicon\{width:24px;height:24px;display:block}
		#vimcur\{position:absolute;display:none;pointer-events:none;background:color-mix(in srgb,var(--text) 45%,transparent);z-index:2;border-radius:1px}
		#vimcur.idle\{background:transparent;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--text) 55%,transparent)}
		#code.vimblock #ta\{caret-color:transparent}
		#vimbar\{flex:none;display:flex;align-items:center;min-height:24px;padding:0 14px;font-family:var(--mono);font-size:12px;background:var(--editor);border-top:1px solid var(--border);white-space:nowrap;overflow:hidden}
		#vimbar:empty,#app.panelmax #vimbar\{display:none}
		#vimbar .vmode\{font-weight:700;color:var(--accent);margin-right:12px}
		#vimbar .vmsg\{overflow:hidden;text-overflow:ellipsis}
		#vimbar .vrec\{color:var(--danger);margin-right:12px}
		#vimbar .vmsg.err\{color:var(--danger)}
		#vimbar .vpend\{margin-left:auto;padding-left:12px;color:var(--muted)}
		#vimbar .vp\{color:var(--accent);font-weight:700}
		#vimbar .vimin\{flex:1;background:transparent;border:0;outline:none;color:var(--text);font:inherit;padding:0 0 0 1px}
		#link\{position:absolute;display:none;pointer-events:none;border-bottom:1px solid var(--syn-call);background:color-mix(in srgb,var(--accent) 20%,transparent);border-radius:2px;z-index:2}
		.g-new\{color:var(--git-new)!important}
		.g-mod\{color:var(--git-mod)!important}
		.g-del\{color:var(--danger)!important;text-decoration:line-through}
		.gb\{margin-left:auto;font-size:11px;font-weight:700;padding-left:8px;min-width:14px;text-align:right}
		.row .dirty+.gb\{margin-left:6px}
		.gitrow .dir\{color:var(--muted);font-size:11px;margin-left:6px;overflow:hidden;text-overflow:ellipsis}
		.gitrow .grow\{flex:1}
		.gitrow .gb\{margin-left:4px}
		.gitrow .acts\{display:none;gap:2px}
		.gitrow:hover .acts\{display:flex}
		.hdr.sub\{padding-top:14px}
		.branch\{padding:2px 14px 8px;font-size:12px;display:flex;gap:8px;align-items:center}
		.muted\{color:var(--muted)}
		.commitbox\{padding:0 12px 6px 14px;display:flex;flex-direction:column;gap:6px}
		.commitbox textarea\{resize:vertical;min-height:54px;font:inherit}
		.logline\{padding:2px 14px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted)}
		.logline .hash\{font-family:var(--mono);color:var(--accent)}
		.btn.danger\{background:var(--danger);border-color:var(--danger);color:#fff}
		#activity .ai\{position:relative}
		#activity .count\{position:absolute;right:6px;bottom:6px;background:var(--accent);color:var(--status-fg);font-size:10px;line-height:15px;min-width:15px;padding:0 3px;border-radius:8px;text-align:center;font-weight:700}
		#panel .termbody\{display:flex;flex-direction:column;padding:0;white-space:normal}
		.term\{margin:0;flex:1;overflow:auto;padding:6px 14px;font-family:var(--mono);font-size:var(--font-size);line-height:1.45;white-space:pre-wrap;word-break:break-all}
		.termline\{display:flex;align-items:center;gap:6px;padding:4px 14px 8px;border-top:1px solid color-mix(in srgb,var(--border) 60%,transparent)}
		.termline .tp\{color:var(--accent);font-family:var(--mono)}
		.termin\{flex:1;background:transparent;border:0;outline:none;color:var(--text);font-family:var(--mono);font-size:var(--font-size)}
		#panel .head\{display:flex;align-items:center;gap:18px;padding:6px 14px;flex:none}
		#panel .ptab\{font-size:11px;letter-spacing:.06em;color:var(--muted);cursor:pointer;padding:4px 0;border-bottom:1px solid transparent}
		#panel .ptab.on\{color:var(--text);border-bottom-color:var(--accent)}
		#panel .grow\{flex:1}
		#panel .body\{flex:1;overflow:auto;padding:4px 14px 10px;font-family:var(--mono);font-size:12px;white-space:pre-wrap}
		.prob\{display:flex;gap:8px;padding:2px 4px;cursor:pointer;font-family:"Segoe UI",system-ui,sans-serif;font-size:13px;white-space:normal}
		.prob:hover\{background:var(--selection)}
		.prob .ic\{color:var(--danger)}
		.prob .where\{color:var(--muted);margin-left:auto;white-space:nowrap}
		.ahead\{padding:2px 4px;font-family:"Segoe UI",system-ui,sans-serif;font-size:13px;color:var(--muted)}
		.ahead .link\{color:var(--accent);cursor:pointer}.ahead .link:hover\{text-decoration:underline}
		.spot .sc\{min-width:28px;text-align:right;font-family:var(--mono);font-weight:600}
		.spot .sc.bad\{color:var(--danger)}.spot .sc.mid\{color:var(--syn-number)}.spot .sc.good\{color:var(--syn-string)}
		.spot .nm\{font-family:var(--mono);white-space:nowrap}
		.spot .det\{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1}
		#status\{height:24px;flex:none;display:flex;align-items:center;gap:4px;padding:0 6px;background:var(--status-bg);color:var(--status-fg);font-size:12px}
		#status .si\{padding:0 7px;height:24px;display:flex;align-items:center;white-space:nowrap}
		#status .si.click:hover\{background:rgba(255,255,255,.14);cursor:pointer}
		#status .grow\{flex:1}
		#overlay:empty\{display:none}
		#overlay\{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:50}
		.dialog\{background:var(--editor);border:1px solid var(--border);border-radius:8px;box-shadow:0 12px 40px rgba(0,0,0,.4);min-width:420px;max-width:86vw;max-height:80vh;overflow:auto}
		.dialog .dh\{display:flex;align-items:center;padding:10px 16px;border-bottom:1px solid var(--border);gap:10px}
		.dialog .dh .grow\{flex:1}
		.dialog pre\{margin:0;padding:10px 0;font-family:var(--mono);font-size:var(--font-size);line-height:var(--line)}
		.dialog .ln\{display:block;padding:0 16px}
		.dialog .ln.hit\{background:var(--selection);box-shadow:inset 3px 0 var(--danger)}
		.dialog .ln .no\{display:inline-block;width:44px;color:var(--gutter);text-align:right;margin-right:14px}
		.dialog .msg\{padding:22px 28px;text-align:center}
		.btn\{background:var(--button);color:var(--button-text);border:1px solid var(--border);border-radius:4px;padding:4px 12px;cursor:pointer;white-space:nowrap}
		.btn:hover:not(:disabled)\{border-color:var(--accent)}
		.btn:disabled\{opacity:.45;cursor:default}
		.btn.run\{color:var(--good)}
		.btn.primary\{background:var(--accent);color:var(--status-fg);border-color:var(--accent)}
		.act\{cursor:pointer;color:var(--muted);padding:1px 5px;border-radius:4px;user-select:none}
		.act:hover\{color:var(--text);background:var(--selection)}
		.hdr\{font-size:11px;letter-spacing:.06em;color:var(--muted);padding:10px 8px 6px 14px;display:flex;align-items:center;gap:2px}
		.hdr .grow\{flex:1}
		.root\{font-size:11px;font-weight:700;letter-spacing:.04em;padding:3px 14px;text-transform:uppercase;color:var(--text)}
		.row\{display:flex;align-items:center;gap:4px;height:22px;padding-right:8px;cursor:pointer;white-space:nowrap;border:1px solid transparent}
		.row:hover\{background:color-mix(in srgb,var(--selection) 55%,transparent)}
		.row.on\{background:var(--selection)}
		.row.focus\{border-color:color-mix(in srgb,var(--accent) 70%,transparent)}
		.row .chev\{width:14px;color:var(--muted);flex:none;text-align:center;font-size:11px}
		.row .ic\{width:20px;text-align:center;font-size:11px;flex:none;font-weight:700}
		.row .nm\{overflow:hidden;text-overflow:ellipsis}
		.row .dirty\{margin-left:auto;color:var(--text);font-size:10px}
		.prompt\{display:flex;gap:4px;padding:4px 10px 6px 14px;align-items:center}
		.field\{background:var(--input);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:5px 8px;outline:none;min-width:0}
		.field:focus\{border-color:var(--accent)}
		.prompt .field\{flex:1;padding:3px 6px}
		.sym\{display:flex;align-items:center;gap:8px;padding:2px 14px;cursor:pointer;white-space:nowrap}
		.sym:hover\{background:var(--selection)}
		.sym .k\{width:16px;text-align:center;font-weight:700}
		.sym .ln\{margin-left:auto;color:var(--muted);font-size:11px}
		.empty\{color:var(--muted);padding:8px 14px;font-size:12px}
		.tab\{display:flex;align-items:center;gap:7px;padding:0 10px 0 12px;height:36px;background:var(--tabidle);color:var(--muted);cursor:pointer;border-right:1px solid var(--border);border-top:1px solid transparent;white-space:nowrap;flex:none}
		.tab.on\{background:var(--editor);color:var(--text);border-top-color:var(--accent)}
		.tab .ic\{font-size:11px;font-weight:700}
		.tab .x\{width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:4px;visibility:hidden}
		.tab:hover .x,.tab.on .x,.tab .x.dirty\{visibility:visible}
		.tab .x:hover\{background:var(--selection)}
		.seg\{display:flex;border:1px solid var(--border);border-radius:4px;overflow:hidden}
		.seg span\{padding:0 10px;cursor:pointer;line-height:20px}
		.seg span.on\{background:var(--selection);color:var(--text)}
		kbd\{background:var(--button);color:var(--button-text);border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:1px 7px;font:12px var(--mono);white-space:nowrap}
		.set h1\{font-weight:500;margin:0 0 4px}
		.set .sub\{color:var(--muted);font-size:12px;margin-bottom:26px}
		.set h2\{font-size:15px;font-weight:600;margin:28px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--border)}
		.set .item\{margin:0 0 16px;max-width:760px}
		.set .item .lbl\{font-weight:600;margin-bottom:2px}
		.set .item .dsc\{color:var(--muted);font-size:12px;margin-bottom:6px}
		.set .check\{display:flex;gap:8px;align-items:center;cursor:pointer}
		.cards\{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}
		.card\{width:176px;padding:12px;border-radius:6px;cursor:pointer;border:2px solid transparent}
		.card.on\{border-color:var(--accent)}
		.card .sw\{display:flex;gap:4px;margin-bottom:8px}
		.card .sw i\{width:18px;height:18px;border-radius:3px;display:block}
		.card .code\{font-family:var(--mono);font-size:12px;margin-top:6px}
		.keys\{border-collapse:collapse;width:100%;max-width:820px}
		.keys th\{text-align:left;font-weight:600;color:var(--muted);font-size:12px;padding:6px 10px;border-bottom:1px solid var(--border)}
		.keys td\{padding:5px 10px;border-bottom:1px solid color-mix(in srgb,var(--border) 60%,transparent)}
		.keys tr:hover td\{background:color-mix(in srgb,var(--selection) 45%,transparent)}
		.keys tr.rec td\{background:var(--selection)}
		.keys .custom\{color:var(--accent);font-size:11px;margin-left:6px}
		.md\{max-width:880px;margin:0 auto;font-size:15px;line-height:1.7}
		.md h1,.md h2\{border-bottom:1px solid var(--border);padding-bottom:.3em;font-weight:600}
		.md code\{font-family:var(--mono);background:var(--input);padding:1px 5px;border-radius:4px;font-size:.88em}
		.md pre.md-code\{background:var(--input);padding:12px 16px;border-radius:6px;overflow:auto;line-height:1.5}
		.md pre code\{background:none;padding:0;font-size:13px}
		.md blockquote\{border-left:4px solid var(--accent);margin:0 0 1em;padding:4px 16px;color:var(--muted)}
		.md table\{border-collapse:collapse;margin:0 0 1em}
		.md th,.md td\{border:1px solid var(--border);padding:6px 12px}
		.md th\{background:var(--side)}
		.md a\{color:var(--accent);text-decoration:none}
		.md a:hover\{text-decoration:underline}
		.md img\{max-width:100%}
		.md hr\{border:0;border-top:1px solid var(--border);margin:1.5em 0}
		.md .md-img\{color:var(--muted)}
		body.gone::after\{content:"conexão encerrada — feche a janela";position:fixed;bottom:34px;left:50%;transform:translateX(-50%);background:var(--danger);color:#fff;padding:6px 14px;border-radius:6px;font-size:12px}
		</style>
		</head>
		<body>
		<div id="app" class="l-welcome">
			<div id="title"></div>
			<div id="body">
				<div id="activity"></div>
				<div id="side" tabindex="-1"></div>
				<div id="main">
					<div id="tabs"></div>
					<div id="crumbs"></div>
					<div id="work">
						<div id="editor">
							<pre id="gutter"></pre>
							<div id="code">
								<pre id="hl"><div id="hll"></div><div class="pad"></div></pre>
								<textarea id="ta" spellcheck="false" wrap="off" autocapitalize="off" autocomplete="off" autocorrect="off"></textarea>
								<div id="marks"></div>
								<div id="link"></div>
								<div id="vimcur"></div>
							</div>
							<div id="popup"></div>
							<div id="find"></div>
						</div>
						<div id="preview"></div>
						<div id="settings"></div>
						<div id="commit"></div>
						<div id="welcome"></div>
					</div>
					<div id="vimbar"></div>
					<div id="grip" title="Arraste para redimensionar — duplo clique maximiza"></div>
					<div id="panel"><div id="panelview"></div><div id="agenthost"></div></div>
				</div>
			</div>
			<div id="status"></div>
			<div id="overlay"></div>
			<div id="palette"></div>
		</div>
		<script>
		(function () \{
			var token = new URLSearchParams(location.search).get("token") || "";
			var app = document.getElementById("app");
			var ta = document.getElementById("ta");
			var hl = document.getElementById("hl");
			var gutter = document.getElementById("gutter");
			var hll = document.getElementById("hll");
			var code = document.getElementById("code");
			var popup = document.getElementById("popup");
			var sheet = document.getElementById("theme");
			var panel = document.getElementById("panel");
			var grip = document.getElementById("grip");
			var ws = null, cache = \{}, serial = -1, keys = [], popupOpen = false, recording = false, charWidth = 0;
			var focusSerial = 0, dragging = null, openMenu = null;
			// Modo Vim: o modo que o programa diz, a seleção que ele mandou aplicar, e
			// quantas teclas do Vim foram mandadas e quantas ele já tratou — enquanto a
			// página estiver atrás, as teclas vão para ele em vez de virarem texto aqui.
			var vimMode = "", vimSerial = -1, vimCaret = 0, vimApplied = [0, 0], vimSent = 0, vimAck = 0;
			var clipSerial = -1, composing = null;
			// O realce: o que o programa já coloriu (hlHtml, uma entrada por linha) e
			// o texto a que ele corresponde (hlSrc); shown é o que está desenhado.
			// Uma linha digitada aparece na hora, sem cor, até o realce dela chegar.
			// sent é o texto que o programa tem, para mandar só a diferença.
			var hlHtml = [], hlSrc = [], hlVersion = -1, shown = [], shownLines = -1, sent = "", lastSeq = -1, resyncing = false;
			var vimCursor = document.getElementById("vimcur");
			var side = document.getElementById("side");
			// Os terminais dos agentes (Claude Code, Codex, OpenCode): um xterm.js por
			// sessão, ligado ao programa por um WebSocket próprio.
			var agentHost = document.getElementById("agenthost"), agentTerms = \{}, agentKeys = [];
		
			// ── menus: abrir e fechar é só da página ──
			function menuIndex(menu) \{
				return Array.prototype.indexOf.call(document.querySelectorAll("#title .menu"), menu);
			}
			function closeMenus() \{
				openMenu = null;
				var open = document.querySelectorAll("#title .menu.open");
				for (var i = 0; i < open.length; i++) \{ open[i].classList.remove("open"); }
			}
			function openMenuOf(menu) \{
				closeMenus();
				menu.classList.add("open");
				openMenu = menuIndex(menu);
			}
			document.addEventListener("mousedown", function (e) \{
				var label = e.target.closest(".mlabel");
				if (label) \{
					e.preventDefault();
					var menu = label.parentNode;
					if (menu.classList.contains("open")) \{ closeMenus(); } else \{ openMenuOf(menu); }
					return;
				}
				if (!e.target.closest(".mdrop")) \{ closeMenus(); }
			});
			document.addEventListener("mouseover", function (e) \{
				if (openMenu === null) \{ return; }
				var label = e.target.closest(".mlabel");
				if (label && !label.parentNode.classList.contains("open")) \{ openMenuOf(label.parentNode); }
			});
		
			// Itens de menu que a página resolve sozinha, no editor.
			function runClient(command) \{
				ta.focus();
				if (command === "paste") \{
					if (navigator.clipboard && navigator.clipboard.readText) \{
						navigator.clipboard.readText().then(function (text) \{ insert(text); });
					}
					return;
				}
				if (command === "selectAll") \{ ta.select(); return; }
				document.execCommand(command);
			}
		
			function send(event) \{
				if (ws && ws.readyState === 1) \{ ws.send(JSON.stringify(event)); }
			}
		
			function region(id, html) \{
				if (cache[id] === html) \{ return; }
				cache[id] = html;
				var el = document.getElementById(id);
				if (!el) \{ return; }
				var focused = document.activeElement, key = null, from = 0, to = 0, before = "";
				if (focused && el.contains(focused) && focused.dataset && focused.dataset.input) \{
					key = focused.dataset.input; from = focused.selectionStart; to = focused.selectionEnd; before = focused.value;
				}
				el.innerHTML = html;
				if (key) \{
					var again = el.querySelector('[data-input="' + key + '"]');
					if (again) \{
						again.focus();
						// A linha de comando do Vim trocada pelo histórico: o cursor vai para o fim.
						if (again.dataset.vimcmd && again.value !== before) \{ from = to = again.value.length; }
						try \{ again.setSelectionRange(from, to); } catch (e) \{}
					}
				}
				var scrolled = el.querySelectorAll("[data-autoscroll]");
				for (var i = 0; i < scrolled.length; i++) \{ scrolled[i].scrollTop = scrolled[i].scrollHeight; }
			}
		
			// Leva o cursor do editor para a vista, alguns linhas abaixo do topo.
			function reveal(caret) \{
				var line = ta.value.slice(0, caret).split("\n").length - 1;
				var height = parseFloat(getComputedStyle(ta).lineHeight) || 20;
				var top = line * height, visible = ta.clientHeight;
				if (top < ta.scrollTop || top > ta.scrollTop + visible - height * 2) \{
					ta.scrollTop = Math.max(0, top - visible / 3);
				}
			}
		
			function escapeHtml(text) \{
				return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
			}
		
			function resync() \{
				if (!resyncing) \{ resyncing = true; send(\{ kind: "resync" }); }
			}
		
			function applyHl(u) \{
				if (!u) \{ return; }
				if (u.mode === "full") \{
					hlHtml = u.lines.slice(); hlSrc = u.source.slice(); hlVersion = u.version; resyncing = false;
				} else if (u.mode === "none") \{
					hlHtml = []; hlSrc = []; hlVersion = -1;
				} else if (u.mode === "patch" && hlVersion === u.version - 1) \{
					hlHtml.splice.apply(hlHtml, [u.from, u.remove].concat(u.lines));
					hlSrc.splice.apply(hlSrc, [u.from, u.remove].concat(u.source));
					hlVersion = u.version;
				} else if (hlVersion !== u.version) \{
					resync();
				}
			}
		
			// Desenha o texto do editor: as linhas iguais ao que o programa coloriu vêm
			// coloridas, as outras (acabaram de ser digitadas) vêm puras. Só as linhas
			// que mudaram desde o último desenho são trocadas.
			function paint() \{
				var lines = ta.value.split("\n"), n = lines.length, m = hlSrc.length, p = 0, s = 0, i;
				while (p < n && p < m && lines[p] === hlSrc[p]) \{ p++; }
				while (s < n - p && s < m - p && lines[n - 1 - s] === hlSrc[m - 1 - s]) \{ s++; }
				var target = new Array(n);
				for (i = 0; i < p; i++) \{ target[i] = hlHtml[i]; }
				for (i = p; i < n - s; i++) \{ target[i] = escapeHtml(lines[i]); }
				for (i = n - s; i < n; i++) \{ target[i] = hlHtml[m - (n - i)]; }
				var k = shown.length, a = 0, b = 0;
				while (a < n && a < k && target[a] === shown[a]) \{ a++; }
				while (b < n - a && b < k - a && target[n - 1 - b] === shown[k - 1 - b]) \{ b++; }
				if (a < k - b || a < n - b) \{
					var nodes = hll.children, after = nodes[k - b] || null;
					for (i = k - b - 1; i >= a; i--) \{ hll.removeChild(nodes[i]); }
					var box = document.createElement("div"), html = "";
					for (i = a; i < n - b; i++) \{ html += "<div>" + target[i] + "</div>"; }
					box.innerHTML = html;
					var bundle = document.createDocumentFragment();
					while (box.firstChild) \{ bundle.appendChild(box.firstChild); }
					hll.insertBefore(bundle, after);
				}
				shown = target;
				if (n !== shownLines) \{
					shownLines = n;
					var numbers = [];
					for (i = 1; i <= n; i++) \{ numbers.push(i); }
					gutter.textContent = numbers.join("\n") + "\n\n\n";
				}
			}
		
			// A edição mandada como diferença do que o programa já tem.
			function sendEdit() \{
				var text = ta.value, caret = ta.selectionStart, p = 0, s = 0;
				var limit = Math.min(text.length, sent.length);
				while (p < limit && text.charCodeAt(p) === sent.charCodeAt(p)) \{ p++; }
				while (s < limit - p && text.charCodeAt(text.length - 1 - s) === sent.charCodeAt(sent.length - 1 - s)) \{ s++; }
				// Índices do JavaScript contam metades de caractere; com emoji e afins
				// antes da mudança, vai o texto inteiro.
				if (/[\uD800-\uDFFF]/.test(text.slice(0, p + 1)) || /[\uD800-\uDFFF]/.test(sent.slice(p, sent.length - s))) \{
					send(\{ kind: "edit", text: text, caret: caret });
				} else \{
					send(\{ kind: "edit", at: p, cut: sent.length - s - p, arg: text.slice(p, text.length - s), caret: caret, seen: serial });
				}
				sent = text;
			}
		
			function apply(frame) \{
				if (frame.seq !== undefined) \{
					if (frame.seq <= lastSeq) \{ return; }
					lastSeq = frame.seq;
				}
				applyHl(frame.hl);
				if (sheet.textContent !== frame.css) \{ sheet.textContent = frame.css; charWidth = 0; restyleAgents(); }
				document.title = frame.title;
				app.className = "l-" + frame.layout + (frame.side ? "" : " noside") + (frame.panel ? "" : " nopanel") +
					(frame.numbers ? "" : " nonumbers") + (frame.panelMax ? " panelmax" : "") + (frame.agentShown ? " agentpane" : "");
				if (!dragging) \{ panel.style.height = frame.panelHeight + "px"; }
				for (var i = 0; i < frame.regions.length; i++) \{ region(frame.regions[i].id, frame.regions[i].html); }
				if (document.activeElement === side) \{
					var chosen = side.querySelector(".row.focus");
					if (chosen) \{ chosen.scrollIntoView(\{ block: "nearest" }); }
				}
				if (openMenu !== null) \{
					var menus = document.querySelectorAll("#title .menu");
					if (menus[openMenu]) \{ menus[openMenu].classList.add("open"); }
				}
				keys = frame.keys; recording = frame.recording; popupOpen = frame.popup;
				agentKeys = frame.agentKeys || [];
				popup.classList.toggle("open", popupOpen);
				vimMode = frame.vim || "";
				vimAck = Math.max(vimAck, frame.vimAck || 0);
				if (vimAck > vimSent) \{ vimSent = vimAck; }
				code.classList.toggle("vimblock", vimMode !== "" && vimMode !== "insert");
				var textChanged = frame.serial !== serial;
				if (textChanged && !frame.hasText) \{ textChanged = false; resync(); }
				if (textChanged) \{ sent = frame.text; }
				if (textChanged && frame.textQuiet) \{
					// Relido do disco (um agente mudou o arquivo): troca o texto sem tirar o
					// foco de ninguém e sem mexer na rolagem nem no cursor.
					serial = frame.serial;
					var top = ta.scrollTop, left = ta.scrollLeft, from = ta.selectionStart, to = ta.selectionEnd;
					ta.value = frame.text;
					try \{ ta.setSelectionRange(Math.min(from, frame.text.length), Math.min(to, frame.text.length)); } catch (e) \{}
					ta.scrollTop = top; ta.scrollLeft = left;
				} else if (textChanged) \{
					serial = frame.serial;
					ta.value = frame.text;
					var typingInAgent = document.activeElement && document.activeElement.closest && document.activeElement.closest("#agenthost");
					if ((frame.layout === "edit" || frame.layout === "split") && !typingInAgent) \{ ta.focus(); }
					try \{ ta.setSelectionRange(frame.caret, frame.caret); } catch (e) \{}
					if (!vimMode) \{ reveal(frame.caret); }
				}
				if (frame.focusSerial !== focusSerial) \{
					focusSerial = frame.focusSerial;
					if (frame.focus === "editor") \{ ta.focus(); }
					if (frame.focus === "explorer") \{ side.focus(\{ preventScroll: true }); }
					if (frame.focus === "agent") \{ focusAgent = true; }
					var wanted = document.querySelector('[data-input="' + frame.focus + '"]');
					if (wanted) \{
						wanted.focus();
						if ((frame.focus === "prompt" || frame.focus === "find") && wanted.select) \{ wanted.select(); }
						if (frame.focus === "vimCommand") \{ try \{ wanted.setSelectionRange(wanted.value.length, wanted.value.length); } catch (e) \{} }
					}
				}
				marks = frame.marks || []; markLength = frame.markLength; markCurrent = frame.markCurrent;
				if (frame.findSerial !== findSerial) \{
					findSerial = frame.findSerial;
					var start = marks[markCurrent];
					if (start !== undefined) \{
						var keep = document.activeElement;
						ta.setSelectionRange(start, start + markLength);
						reveal(start);
						if (keep && keep !== ta && keep.focus) \{ keep.focus(); }
					}
				}
				if (vimMode && (frame.vimSerial > vimSerial || textChanged)) \{
					var quietOnly = textChanged && frame.textQuiet && !(frame.vimSerial > vimSerial);
					vimSerial = frame.vimSerial;
					try \{ ta.setSelectionRange(frame.selStart, frame.selEnd); } catch (e) \{}
					vimApplied = [ta.selectionStart, ta.selectionEnd];
					vimCaret = frame.caret;
					if (!quietOnly) \{
						if (frame.vimScroll >= 0) \{ ta.scrollTop = frame.vimScroll * lineHeight(); } else \{ keepVisible(frame.caret); }
					}
				}
				if (frame.clipSerial !== clipSerial) \{
					// O que o "y" do Vim copiou vai também para a área de transferência.
					if (clipSerial >= 0 && frame.clip && navigator.clipboard && navigator.clipboard.writeText) \{
						navigator.clipboard.writeText(frame.clip).catch(function () \{});
					}
					clipSerial = frame.clipSerial;
				}
				syncAgents(frame);
				paint();
				sync();
				if (popupOpen) \{ place(); }
			}
		
			// ── os terminais dos agentes ──
			var focusAgent = false;
			function cssVar(name) \{ return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
			function agentTheme() \{
				return \{ background: cssVar("--panel"), foreground: cssVar("--text"), cursor: cssVar("--text"), cursorAccent: cssVar("--panel"),
					selectionBackground: "rgba(128,128,128,.4)" };
			}
			function agentFont() \{ return parseInt(cssVar("--font-size"), 10) || 14; }
			function bytesOf(encoded) \{
				var raw = atob(encoded), out = new Uint8Array(raw.length);
				for (var i = 0; i < raw.length; i++) \{ out[i] = raw.charCodeAt(i); }
				return out;
			}
			function restyleAgents() \{
				for (var key in agentTerms) \{
					agentTerms[key].term.options.theme = agentTheme();
					agentTerms[key].term.options.fontSize = agentFont();
					fitAgent(agentTerms[key]);
				}
			}
			function fitAgent(item) \{
				if (!item || item.el.style.display === "none") \{ return; }
				try \{ item.fit.fit(); } catch (e) \{}
				if (item.socket.readyState === 1) \{ item.socket.send("r" + item.term.cols + " " + item.term.rows); }
			}
			function openAgent(session) \{
				var el = document.createElement("div");
				el.className = "agentterm"; el.style.display = "none";
				agentHost.appendChild(el);
