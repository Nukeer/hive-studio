// Tudo o que a janela sabe, tudo o que pode acontecer com ela, e o que
// viaja entre a página e o programa.

import ./settings
import ./i18n

// Um item do explorador: arquivo ou pasta.
type Entry {
	name:   Str
	path:   Str
	folder: Bool
}

// Uma linha visível da árvore: o item, a profundidade e se está expandido.
type TreeRow {
	entry: Entry
	depth: Int
	open:  Bool
}

// Um estado do texto, para desfazer e refazer no modo Vim.
type Snapshot {
	text:  Str
	caret: Int
}

// Um arquivo aberto numa aba. `saved` é o conteúdo em disco, então a aba está
// suja quando `text != saved`. O texto fica sempre com `\n`; `eol` lembra o
// fim de linha do arquivo para salvar do jeito que veio. `html` é o realce
// guardado, refeito só quando o texto muda. `mode` é `edit`, `preview` ou `split`.
// `undo` e `redo` são as pilhas do `u` e do `Ctrl+R` do modo Vim. `gone` diz
// que o arquivo foi apagado do disco (a aba continua aberta, riscada; salvar
// o cria de novo).
type Doc {
	path:  Str
	name:  Str
	text:  Str
	saved: Str
	eol:   Str
	html:  Str
	mode:  Str
	undo:  Snapshot[dyn]
	redo:  Snapshot[dyn]
	gone:  Bool
}

// Uma linha `arquivo:linha: mensagem` do compilador.
type Diagnostic {
	file:    Str
	line:    Int
	message: Str
}

// Uma declaração de topo do arquivo ativo, para o painel de estrutura.
type Symbol {
	kind: Str
	name: Str
	line: Int
}

// Uma sugestão do autocomplete.
type Suggestion {
	word:   Str
	kind:   Str
	detail: Str
}

// Um arquivo que o git vê diferente do último commit. `path` é relativo ao
// topo do repositório e `rel` à pasta aberta (vazio quando fica fora dela).
// `index` e `work` são as duas letras do `git status --porcelain`.
type GitFile {
	path:  Str
	rel:   Str
	index: Str
	work:  Str
}

type GitInfo {
	repo:    Bool
	top:     Str
	prefix:  Str
	branch:  Str
	ahead:   Int
	behind:  Int
	files:   GitFile[dyn]
	log:     Str[dyn]
	message: Str
	busy:    Str
	confirm: Str
}

// O terminal do painel: um shell de verdade (cmd.exe ou $SHELL) aberto por
// lib/native.go. `session` é o número da sessão lá (0 = nenhuma); `log` é o
// que o shell escreveu até agora.
type Terminal {
	session:   Int
	log:       Str
	input:     Str
	history:   Str[dyn]
	historyAt: Int
}

// A caixa de busca do editor (Ctrl+F). `index` é a ocorrência atual; `serial`
// muda quando a página deve selecioná-la.
type FindBox {
	open:          Bool
	text:          Str
	caseSensitive: Bool
	index:         Int
	serial:        Int
}

// Um trecho achado no projeto: o arquivo (relativo à raiz), a linha (a partir
// de 1), a coluna e o texto da linha.
type Hit {
	path:   Str
	line:   Int
	column: Int
	text:   Str
}

// O painel de busca no projeto (Ctrl+Shift+F).
type SearchPanel {
	text:          Str
	caseSensitive: Bool
	hits:          Hit[dyn]
	files:         Int
	truncated:     Bool
	done:          Bool
}

// A busca rápida de arquivos (Ctrl+P). `files` é a lista da pasta, lida ao abrir.
type Palette {
	open:  Bool
	text:  Str
	index: Int
	files: Str[dyn]
}

// O modo Vim do editor. A linha de comando (`:`, `/`, `?`) abre por cima do
// modo normal: é o `prompt` do `Vim` que diz se ela está aberta.
type VimMode {
	NormalMode
	InsertMode
	VisualMode
	VisualLineMode
}

// Tudo o que o modo Vim lembra entre uma tecla e outra.
//
// `pending` são as teclas de um comando ainda incompleto (`2d`, `g`, `f`);
// `anchor` é onde a seleção visual começou; `column` é a coluna que `j` e `k`
// tentam manter, calculada com o cursor em `columnAt`. `register` é o registrador sem nome (`linewise` quando guarda
// linhas inteiras). `prompt`/`command` são a linha de comando; `message` é uma
// chave do i18n com `%1`, `%2` trocados por `args`. `pattern`, `backward` e
// `whole` são a última busca, realçada enquanto `highlight`. `find` é o último
// `f`/`t`/`F`/`T` (tecla e caractere), para `;` e `,`. `change` e `typed` são
// a última alteração, para o `.`; `insertBase`, `insertAt`, `insertKeys` e
// `count` descrevem a inserção em andamento. `serial` muda sempre que a página
// deve aplicar o cursor e a seleção; `scroll` é a linha que vai para o topo
// (-1 = só manter o cursor à vista). `clip` é o último texto copiado com `y`.
// `acked` conta as teclas do Vim já tratadas: enquanto a página estiver atrás,
// ela manda as teclas para cá em vez de digitá-las. `recordingTo` é o
// registrador da macro sendo gravada (`q`), com as teclas em `recorded`;
// `macros` guarda as gravadas, `lastMacro` é a do `@@` e `replaying` conta
// macros dentro de macros. `promptFrom` diz de onde a linha de comando foi
// aberta (`explorer` ou o editor), para o foco voltar para lá.
type Vim {
	mode:         VimMode
	pending:      Str[dyn]
	anchor:       Int
	column:       Int
	columnAt:     Int
	register:     Str
	linewise:     Bool
	prompt:       Str
	command:      Str
	message:      Str
	args:         Str[dyn]
	error:        Bool
	pattern:      Str
	backward:     Bool
	whole:        Bool
	highlight:    Bool
	find:         Str[dyn]
	change:       Str[dyn]
	typed:        Str
	count:        Int
	insertBase:   Str
	insertAt:     Int
	insertKeys:   Str[dyn]
	visualFrom:   Int
	visualTo:     Int
	history:      Str[dyn]
	historyAt:    Int
	serial:       Int
	scroll:       Int
	clip:         Str
	clipSerial:   Int
	searchSerial: Int
	acked:        Int
	recordingTo:  Str
	recorded:     Str[dyn]
	macros:       hive.map.Map<Str, Str[dyn]>
	lastMacro:    Str
	replaying:    Int
	promptFrom:   Str
}

type Pane {
	OutputPane
	ProblemsPane
	TerminalPane
	AgentPane
}

// Um agente do painel AGENTE (Claude Code, Codex, OpenCode) e o terminal de
// verdade (lib/pty.go) onde ele roda. `session` é 0 quando nunca abriu;
// `problem` diz por que não abriu (o programa não está no PATH…).
type AgentSession {
	agent:   Str
	session: Int
	exited:  Bool
	code:    Int
	problem: Str
}

// `current` é o agente mostrado no painel; cada um guarda a própria sessão.
type Agents {
	current:  Str
	sessions: AgentSession[dyn]
}

type SideView {
	ExplorerSide
	SearchSide
	OutlineSide
	GitSide
}

type EditorView {
	DocView
	SettingsView
	CommitPage
}

// A aba que mostra um commit (ou as alterações de um arquivo). O HTML é
// montado uma vez, quando a aba abre — um diff grande não é redesenhado a
// cada tecla. `key` é o hash, ou `work:<caminho>`; vazio = aba fechada.
type CommitTab {
	key:   Str
	title: Str
	html:  Str
}

// A caixa de texto no topo do explorador, e para que ela serve agora.
type Prompt {
	NoPrompt
	NewFilePrompt
	NewFolderPrompt
	OpenFolderPrompt
}

type Msg {
	Toggle           { path: Str }
	Open             { path: Str }
	Refresh
	CollapseAll
	GoUp
	StartPrompt      { prompt: Prompt }
	PromptTyped      { text: Str }
	PromptSubmit     { text: Str }
	PromptCancel
	Focus            { index: Int }
	CloseDoc         { index: Int }
	CycleTab         { step: Int }
	EditAt           { text: Str, caret: Int }
	CaretAt          { caret: Int }
	SuggestAt        { caret: Int }
	PopupKey         { key: Str }
	AcceptSuggestion { index: Int }
	CloseSuggest
	Save
	SaveAll
	PinEntry
	SetMode          { mode: Str }
	TogglePreview
	Invoke           { command: Str }
	Finished         { command: Str, output: Str, ok: Bool }
	ShowPane         { pane: Pane }
	TogglePanel
	ShowSide         { side: SideView }
	ToggleSidebar
	OpenSettings
	CloseSettings
	SetTheme         { name: Str }
	ToggleSetting    { name: Str }
	SetFontSize      { size: Int }
	SetTabSize       { size: Int }
	CompilerTyped    { text: Str }
	BrowserTyped     { text: Str }
	StartRecording   { action: Str }
	CancelRecording
	KeyPressed       { combo: Str }
	ResetKey         { action: Str }
	ResetKeys
	Peek             { file: Str, line: Int }
	ClosePeek
	ClearOutput
	Connected
	Disconnected
	TogglePanelMax
	SetPanelHeight   { height: Int }
	TermTyped        { text: Str }
	TermSubmit       { text: Str }
	TermHistory      { step: Int }
	TermRestart
	TermClear
	TermOutput       { session: Int, text: Str }
	TermExited       { session: Int, code: Int }
	GotoDefinition   { caret: Int }
	GitPoll
	GitRefresh
	GitStage         { path: Str }
	GitUnstage       { path: Str }
	GitStageAll
	GitUnstageAll
	GitAskDiscard    { path: Str }
	GitDiscard       { path: Str }
	GitCancelConfirm
	GitMessageTyped  { text: Str }
	GitCommit
	GitPush
	GitPull
	GitInit
	GitDone          { command: Str, output: Str, ok: Bool }
	FindOpen         { text: Str }
	FindTyped        { text: Str }
	FindNext
	FindPrev
	FindClose
	FindToggleCase
	SearchTyped      { text: Str }
	SearchRun
	SearchToggleCase
	OpenAt           { path: Str, line: Int, column: Int }
	PaletteOpen
	PaletteTyped     { text: Str }
	PaletteMove      { step: Int }
	PaletteAccept    { index: Int }
	PaletteClose
	PickFolder
	PickFile
	Picked           { mode: Str, path: Str }
	PickFailed       { mode: Str, reason: Str }
	SetLanguage      { code: Str }
	ShowAbout
	CloseAbout
	OpenDocs
	Quit
	GitShow          { hash: Str }
	GitShowWork      { path: Str }
	FocusCommit
	CloseCommit
	VimKey           { key: Str, caret: Int, view: Str }
	VimMouse         { start: Int, end: Int }
	VimTyped         { text: Str }
	VimSubmit        { text: Str }
	VimCancel
	VimHistory       { step: Int }
	VimEdit          { path: Str }
	VimReload
	TreeKey          { key: Str }
	FocusExplorer    { path: Str }
	ShowAgent        { agent: Str }
	AgentRestart     { agent: Str }
	AgentExited      { session: Int, code: Int }
	AgentCommand     { agent: Str, text: Str }
	DiskPoll
}

type State {
	root:          Str
	tree:          TreeRow[dyn]
	expanded:      Str[dyn]
	selected:      Str
	prompt:        Prompt
	promptText:    Str
	docs:          Doc[dyn]
	active:        Int
	entrypoint:    Str
	textSerial:    Int
	caret:         Int
	suggestions:   Suggestion[dyn]
	suggestIndex:  Int
	running:       Str
	output:        Str
	diagnostics:   Diagnostic[dyn]
	pane:          Pane
	panelOpen:     Bool
	side:          SideView
	sideOpen:      Bool
	editorView:    EditorView
	settingsOpen:  Bool
	settings:      settings.Settings
	recording:     Str
	peekFile:      Str
	peekLine:      Int
	peekText:      Str
	status:        Str
	pulse:         Int
	clients:       Int
	panelMax:      Bool
	git:           GitInfo
	term:          Terminal
	focus:         Str
	focusSerial:   Int
	commit:        CommitTab
	words:         hive.map.Map<Str, Str>
	about:         Bool
	find:          FindBox
	search:        SearchPanel
	palette:       Palette
	vim:           Vim
	treeKeys:      Str
	agents:        Agents
	quietSerial:   Int
}

// ── o que viaja entre a página e o programa ──────────────────────────────

// Um evento da página, em JSON. `kind` diz o que foi; o resto depende dele.
type Event {
	kind:  Str
	act:   Str -- Default as "";
	arg:   Str -- Default as "";
	text:  Str -- Default as "";
	caret: Int -- Default as 0;
}

// Um pedaço da página, trocado inteiro quando muda.
type Region {
	id:   Str
	html: Str
}

// Tudo o que a página precisa para se desenhar. O texto do editor só é
// aplicado quando `serial` muda — digitar não reescreve o que se digita.
// `textQuiet` diz que o texto novo veio do disco (um agente mudou o arquivo):
// a página o troca sem mexer no foco nem na rolagem.
type Frame {
	regions:   Region[dyn]
	css:       Str
	text:      Str
	serial:    Int
	caret:     Int
	keys:      Str[dyn]
	layout:    Str
	side:      Bool
	panel:     Bool
	popup:     Bool
	numbers:   Bool
	panelHeight: Int
	panelMax:  Bool
	focus:     Str
	focusSerial: Int
	marks:       Int[dyn]
	markLength:  Int
	markCurrent: Int
	findSerial:  Int
	recording: Bool
	title:     Str
	vim:        Str
	vimSerial:  Int
	selStart:   Int
	selEnd:     Int
	vimScroll:  Int
	clip:       Str
	clipSerial: Int
	vimAck:     Int
	agentSessions: Int[dyn]
	agentShown:    Int
	agentKeys:     Str[dyn]
	textQuiet:     Bool
}

// A resposta a "dá para ir à definição do nome em `caret`?", mandada enquanto
// o mouse passa com Ctrl pressionado. Pequena de propósito: não é um frame.
type HoverReply {
	hover: Bool
	caret: Int
	ok:    Bool
}

// A caixa de mensagens do serviço que guarda o estado.
type Cmd {
	Ui         { event: Str }
	Post       { msg: Msg }
	Render
	Pulse
	Clients
	Reply      { frame: Str }
	PulseIs    { n: Int }
	ClientsAre { n: Int }
}

func initial(root: Str, prefs: settings.Settings): State {
	TreeRow[dyn] tree = []
	Str[dyn] expanded = []
	Doc[dyn] docs = []
	Diagnostic[dyn] diagnostics = []
	Suggestion[dyn] suggestions = []
	return State(
		root: root,
		tree: tree,
		expanded: expanded,
		selected: "",
		prompt: Prompt.NoPrompt(),
		promptText: "",
		docs: docs,
		active: -1,
		entrypoint: "",
		textSerial: 0,
		caret: 0,
		suggestions: suggestions,
		suggestIndex: 0,
		running: "",
		output: "",
		diagnostics: diagnostics,
		pane: Pane.OutputPane(),
		panelOpen: true,
		side: SideView.ExplorerSide(),
		sideOpen: true,
		editorView: EditorView.DocView(),
		settingsOpen: false,
		settings: prefs,
		recording: "",
		peekFile: "",
		peekLine: 0,
		peekText: "",
		status: "pronto",
		pulse: 0,
		clients: 0,
		panelMax: false,
		git: emptyGit(),
		term: emptyTerminal(),
		focus: "",
		focusSerial: 0,
		commit: CommitTab("", "", ""),
		words: i18n.words(prefs.language),
		about: false,
		find: FindBox(false, "", false, 0, 0),
		search: emptySearch(),
		palette: emptyPalette(),
		vim: emptyVim(),
		treeKeys: "",
		agents: emptyAgents(),
		quietSerial: -1
	)
}

func emptyAgents(): Agents {
	AgentSession[dyn] none = []
	return Agents("claude", none)
}

func emptyVim(): Vim {
	Str[dyn] none = []
	return Vim(
		mode: VimMode.NormalMode(),
		pending: none,
		anchor: 0,
		column: 0,
		columnAt: -1,
		register: "",
		linewise: false,
		prompt: "",
		command: "",
		message: "",
		args: none,
		error: false,
		pattern: "",
		backward: false,
		whole: false,
		highlight: false,
		find: none,
		change: none,
		typed: "",
		count: 1,
		insertBase: "",
		insertAt: 0,
		insertKeys: none,
		visualFrom: 0,
		visualTo: 0,
		history: none,
		historyAt: 0,
		serial: 0,
		scroll: -1,
		clip: "",
		clipSerial: 0,
		searchSerial: 0,
		acked: 0,
		recordingTo: "",
		recorded: none,
		macros: hive.map.new(),
		lastMacro: "",
		replaying: 0,
		promptFrom: ""
	)
}

// Um documento recém-aberto, sem nada para desfazer.
func newDoc(path: Str, name: Str, text: Str, eol: Str, html: Str, mode: Str): Doc {
	Snapshot[dyn] none = []
	return Doc(path, name, text, text, eol, html, mode, none, none, false)
}

func emptySearch(): SearchPanel {
	Hit[dyn] none = []
	return SearchPanel("", false, none, 0, false, false)
}

func emptyPalette(): Palette {
	Str[dyn] none = []
	return Palette(false, "", 0, none)
}

func emptyGit(): GitInfo {
	GitFile[dyn] files = []
	Str[dyn] log = []
	return GitInfo(false, "", "", "", 0, 0, files, log, "", "", "")
}

func emptyTerminal(): Terminal {
	Str[dyn] history = []
	return Terminal(0, "", "", history, 0)
}

func dirty(doc: Doc): Bool {
	return doc.text != doc.saved
}

func anyDirty(docs: Doc[]): Bool {
	for each doc in docs {
		if dirty(doc) {
			return true
		}
	}
	return false
}

func isMarkdown(path: Str): Bool {
	return path is "{stem}.md" || path is "{stem}.markdown"
}
