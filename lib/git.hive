// Git: o que mudou desde o último commit, e as ações do painel.
//
// Classificação de um arquivo, a partir das duas letras do porcelain:
//   new       ainda não versionado (??) ou adicionado (A) — verde
//   modified  editado (M) — amarelo
//   deleted   removido (D) — vermelho
//   conflict  em conflito (U) — vermelho
// Um arquivo que o git não lista está commitado e fica na cor normal.

import ./model
import ./process
import ./complete

func letterAt(text: Str, index: Int): Str {
	if text bounds index {
		return text[index]
	}
	return " "
}

func startsWith(text: Str, prefix: Str): Bool {
	return complete.startsWith(text, prefix)
}

func numberIn(text: Str): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return 0
}

proc withBranch(info: mut model.GitInfo, header: Str): void {
	if header is "No commits yet on {name}" {
		info.branch = name
	} else if header is "{name}...{rest}" {
		info.branch = name
		if rest is "{a}ahead {n is (\d+)}{b}" {
			info.ahead = numberIn(n)
		}
		if rest is "{a}behind {n is (\d+)}{b}" {
			info.behind = numberIn(n)
		}
	} else {
		info.branch = header
	}
}

func parseFile(line: Str, prefix: Str): Result<model.GitFile, Bool> {
	if line is "{xy is (..)} {path}" {
		mut target := path
		if target is "{old} -> {renamed}" {
			target = renamed
		}
		if target is "\"{inner}\"" {
			target = inner
		}
		mut rel := target
		if prefix != "" {
			if startsWith(target, prefix) {
				rel = complete.skip(target, len(prefix))
			} else {
				rel = ""
			}
		}
		return Result.Ok(model.GitFile(target, rel, letterAt(xy, 0), letterAt(xy, 1)))
	}
	return Result.Error(false)
}

// Lê o estado do repositório que contém `root`. O rascunho da mensagem de
// commit e o que estiver em andamento sobrevivem à releitura.
proc refresh(root: Str, previous: model.GitInfo): model.GitInfo {
	mut info := model.emptyGit()
	info.message = previous.message
	info.busy = previous.busy
	info.confirm = previous.confirm
	top := process.run("git", ["rev-parse", "--show-toplevel"], root)
	if top.code != 0 {
		return info
	}
	info.repo = true
	info.top = process.firstLine(top.text)
	info.prefix = process.firstLine(process.run("git", ["rev-parse", "--show-prefix"], root).text)
	status := process.run("git", ["-c", "core.quotepath=false", "status", "--porcelain=v1", "-b", "--untracked-files=all"], root)
	mut model.GitFile[dyn] files = []
	for each line in split(replaceAll(status.text, "\r", ""), "\n") {
		if line is "## {header}" {
			withBranch(info, header)
		} else if parseFile(line, info.prefix) is Result.Ok(file) {
			append(files, file)
		}
	}
	info.files = files
	history := process.run("git", ["log", "--oneline", "--no-color", "-15"], root)
	if history.code == 0 {
		mut Str[dyn] log = []
		for each line in split(replaceAll(history.text, "\r", ""), "\n") {
			if line != "" {
				append(log, line)
			}
		}
		info.log = log
	}
	return info
}

func kindOf(file: model.GitFile): Str {
	x := file.index
	y := file.work
	if x == "?" || x == "A" {
		return "new"
	} else if x == "U" || y == "U" {
		return "conflict"
	} else if x == "D" || y == "D" {
		return "deleted"
	} else if x == "R" || x == "C" {
		return "new"
	}
	return "modified"
}

func badge(kind: Str, file: model.GitFile): Str {
	if kind == "new" {
		if file.index == "?" {
			return "U"
		}
		return "A"
	} else if kind == "deleted" {
		return "D"
	} else if kind == "conflict" {
		return "!"
	}
	return "M"
}

func cssOf(kind: Str): Str {
	if kind == "new" {
		return "g-new"
	} else if kind == "modified" {
		return "g-mod"
	} else if kind == "deleted" || kind == "conflict" {
		return "g-del"
	}
	return ""
}

func staged(file: model.GitFile): Bool {
	return file.index != " " && file.index != "?"
}

func unstaged(file: model.GitFile): Bool {
	return file.work != " "
}

func fileKind(info: model.GitInfo, rel: Str): Str {
	for each file in info.files {
		if file.rel == rel && rel != "" {
			return kindOf(file)
		}
	}
	return ""
}

// Uma pasta leva a cor do que tem dentro: editado vence novo.
func folderKind(info: model.GitInfo, rel: Str): Str {
	mut found := ""
	for each file in info.files {
		if file.rel != "" && startsWith(file.rel, rel + "/") {
			kind := kindOf(file)
			if kind == "modified" || kind == "conflict" || kind == "deleted" {
				return "modified"
			}
			found = "new"
		}
	}
	return found
}

func count(info: model.GitInfo, wantStaged: Bool): Int {
	mut n := 0
	for each file in info.files {
		if (wantStaged && staged(file)) || (!wantStaged && unstaged(file)) {
			n++
		}
	}
	return n
}

// ── diffs ────────────────────────────────────────────────────────────────

// Uma linha de um diff: `ctx` (igual nos dois lados), `add`, `del`, `hunk`
// (o cabeçalho `@@ … @@`) ou `note` (binário, sem quebra no fim…). `old` e
// `new` são os números da linha em cada lado, 0 onde ela não existe.
type DiffLine {
	kind: Str
	old:  Int
	new:  Int
	text: Str
}

// `status` é A (novo), M (editado), D (removido), R (renomeado) ou B (binário).
type DiffFile {
	path:    Str
	oldPath: Str
	status:  Str
	added:   Int
	removed: Int
	lines:   DiffLine[dyn]
}

type Commit {
	hash:      Str
	short:     Str
	author:    Str
	date:      Str
	subject:   Str
	body:      Str
	files:     DiffFile[dyn]
	truncated: Bool
}

type Diff {
	files:     DiffFile[dyn]
	truncated: Bool
}

func isFileHeader(line: Str): Bool {
	for each prefix in ["--- ", "+++ ", "index ", "similarity ", "old mode", "new mode"] {
		if startsWith(line, prefix) {
			return true
		}
	}
	return false
}

func emptyFile(path: Str, oldPath: Str): DiffFile {
	DiffLine[dyn] none = []
	return DiffFile(path, oldPath, "M", 0, 0, none)
}

// Lê a saída de `git show`/`git diff`. Guarda no máximo `limit` linhas de
// diff; o resto é contado mas não guardado, e `truncated` avisa.
func parseDiff(text: Str, limit: Int): Diff {
	mut DiffFile[dyn] files = []
	mut current := emptyFile("", "")
	mut open := false
	mut oldNo := 0
	mut newNo := 0
	mut kept := 0
	mut truncated := false
	for each raw in split(replaceAll(text, "\r", ""), "\n") {
		if raw is "diff --git a/{a} b/{b}" {
			if open {
				append(files, current)
			}
			current = emptyFile(b, a)
			open = true
		} else if open && raw is "new file mode{rest}" {
			current.status = "A"
		} else if open && raw is "deleted file mode{rest}" {
			current.status = "D"
		} else if open && raw is "rename from {from}" {
			current.status = "R"
			current.oldPath = from
		} else if open && raw is "rename to {to}" {
			current.path = to
		} else if open && raw is "Binary files{rest}" {
			current.status = "B"
		} else if open && raw is "@@ -{a is (\d+)}{r1} +{b is (\d+)}{r2}@@{ctx}" {
			oldNo = numberIn(a)
			newNo = numberIn(b)
			if kept < limit {
				mut lines := current.lines
				append(lines, DiffLine("hunk", 0, 0, raw))
				current.lines = lines
				kept++
			}
		} else if open && isFileHeader(raw) {
			// cabeçalho do arquivo, já lido acima
		} else if open && raw != "" {
			first := complete.take(raw, 1)
			body := complete.skip(raw, 1)
			mut kind := ""
			mut oldAt := 0
			mut newAt := 0
			if first == "+" {
				kind = "add"
				newAt = newNo
				newNo++
				current.added = current.added + 1
			} else if first == "-" {
				kind = "del"
				oldAt = oldNo
				oldNo++
				current.removed = current.removed + 1
			} else if first == " " {
				kind = "ctx"
				oldAt = oldNo
				newAt = newNo
				oldNo++
				newNo++
			} else if first == "\\" {
				kind = "note"
			}
			if kind != "" {
				if kept < limit {
					mut lines := current.lines
					append(lines, DiffLine(kind, oldAt, newAt, body))
					current.lines = lines
					kept++
				} else {
					truncated = true
				}
			}
		}
	}
	if open {
		append(files, current)
	}
	return Diff(files, truncated)
}

func diffLimit(): Int {
	return 8 * 1000
}

// Um commit inteiro: quem, quando, a mensagem e o diff contra o primeiro pai.
proc show(info: model.GitInfo, hash: Str): Result<Commit, Str> {
	meta := process.run("git", ["-c", "core.quotepath=false", "show", "-s", "--date=format:%d/%m/%Y %H:%M",
		"--format=%H%n%h%n%an <%ae>%n%ad%n%s%n%b", hash], info.top)
	if meta.code != 0 {
		return Result.Error(process.firstLine(meta.text))
	}
	fields := split(replaceAll(meta.text, "\r", ""), "\n")
	if fields is [full, short, author, date, subject, ...body] {
		patch := process.run("git", ["-c", "core.quotepath=false", "show", "--no-color", "--format=", "--patch", "-M",
			"--diff-merges=first-parent", hash], info.top)
		parsed := parseDiff(patch.text, diffLimit())
		return Result.Ok(Commit(full, short, author, date, subject, join(body, "\n"), parsed.files, parsed.truncated))
	}
	return Result.Error("não foi possível ler o commit {hash}")
}

// O que mudou num arquivo desde o último commit (preparado ou não).
proc working(info: model.GitInfo, path: Str): Commit {
	mut untracked := false
	for each file in info.files {
		if file.path == path && file.index == "?" {
			untracked = true
		}
	}
	mut patch := process.run("git", ["-c", "core.quotepath=false", "diff", "--no-color", "-M", "HEAD", "--", path], info.top)
	if untracked || patch.code != 0 {
		patch = process.run("git", ["-c", "core.quotepath=false", "diff", "--no-color", "--no-index", "--", "/dev/null", path], info.top)
	}
	parsed := parseDiff(patch.text, diffLimit())
	return Commit("", "", "", "", "Alterações não commitadas", path, parsed.files, parsed.truncated)
}

// ── ações ────────────────────────────────────────────────────────────────

proc stage(info: model.GitInfo, path: Str): process.Output {
	return process.run("git", ["add", "--", path], info.top)
}

proc unstage(info: model.GitInfo, path: Str): process.Output {
	restored := process.run("git", ["restore", "--staged", "--", path], info.top)
	if restored.code != 0 {
		// Sem nenhum commit ainda não há o que restaurar: tira do índice.
		return process.run("git", ["rm", "--cached", "-r", "-q", "--", path], info.top)
	}
	return restored
}

proc stageAll(info: model.GitInfo): process.Output {
	return process.run("git", ["add", "-A"], info.top)
}

proc unstageAll(info: model.GitInfo): process.Output {
	restored := process.run("git", ["restore", "--staged", "--", "."], info.top)
	if restored.code != 0 {
		return process.run("git", ["rm", "--cached", "-r", "-q", "--", "."], info.top)
	}
	return restored
}

// Descarta as alterações de um arquivo. Um arquivo novo é apagado.
proc discard(info: model.GitInfo, path: Str): process.Output {
	for each file in info.files {
		if file.path == path && file.index == "?" {
			return process.run("git", ["clean", "-f", "--", path], info.top)
		}
	}
	return process.run("git", ["restore", "--source=HEAD", "--staged", "--worktree", "--", path], info.top)
}

// Commit, push e pull podem demorar (hooks, rede), então rodam numa thread e
// respondem com `GitDone`.
proc runAsync(db: hive.syslink.Address, directory: Str, label: Str, arguments: Str[dyn]): void {
	result := process.run("git", arguments, directory)
	async db(model.Cmd.Post(model.Msg.GitDone(label, result.text, result.code == 0)))
}

proc commitAsync(db: hive.syslink.Address, directory: Str, message: Str, everything: Bool): void {
	if everything {
		added := process.run("git", ["add", "-A"], directory)
		if added.code != 0 {
			async db(model.Cmd.Post(model.Msg.GitDone("commit", added.text, false)))
			return
		}
	}
	Str[dyn] arguments = ["commit", "-m", message]
	runAsync(db, directory, "commit", arguments)
}

test "o porcelain vira arquivos com caminho relativo à pasta aberta" {
	if parseFile("?? lib/novo.hive", "") is Result.Ok(fresh) {
		assert kindOf(fresh) == "new" && badge("new", fresh) == "U"
		assert fresh.rel == "lib/novo.hive"
	} else {
		assert false
	}
	if parseFile(" M app/lib/x.hive", "app/") is Result.Ok(edited) {
		assert kindOf(edited) == "modified" && edited.rel == "lib/x.hive"
		assert unstaged(edited) && !staged(edited)
	} else {
		assert false
	}
	if parseFile("R  velho.hive -> novo.hive", "") is Result.Ok(renamed) {
		assert renamed.path == "novo.hive" && staged(renamed)
	}
	if parseFile(" M outro/y.hive", "app/") is Result.Ok(outside) {
		assert outside.rel == ""
	}
}

test "um diff vira arquivos com linhas numeradas nos dois lados" {
	patch := "diff --git a/lib/a.hive b/lib/a.hive\nindex 1..2 100644\n--- a/lib/a.hive\n+++ b/lib/a.hive\n@@ -1,3 +1,3 @@ proc main\n linha um\n-velha\n+nova\n fim\ndiff --git a/novo.md b/novo.md\nnew file mode 100644\n--- /dev/null\n+++ b/novo.md\n@@ -0,0 +1 @@\n+# oi\n"
	parsed := parseDiff(patch, 100)
	assert len(parsed.files) == 2
	assert !parsed.truncated
	if parsed.files is [edited, created] {
		assert edited.path == "lib/a.hive" && edited.status == "M"
		assert edited.added == 1 && edited.removed == 1
		assert len(edited.lines) == 5
		if edited.lines is [hunk, same, gone, came, last] {
			assert hunk.kind == "hunk"
			assert same.kind == "ctx" && same.old == 1 && same.new == 1 && same.text == "linha um"
			assert gone.kind == "del" && gone.old == 2 && gone.new == 0
			assert came.kind == "add" && came.new == 2 && came.old == 0
			assert last.old == 3 && last.new == 3
		}
		assert created.status == "A" && created.added == 1
	}
	short := parseDiff(patch, 3)
	assert short.truncated
}

test "o cabeçalho diz o branch e quanto está à frente" {
	mut info := model.emptyGit()
	withBranch(info, "main...origin/main [ahead 2, behind 1]")
	assert info.branch == "main" && info.ahead == 2 && info.behind == 1
	mut empty := model.emptyGit()
	withBranch(empty, "No commits yet on main")
	assert empty.branch == "main"
}

test "pastas herdam a cor dos arquivos" {
	mut info := model.emptyGit()
	info.files = [model.GitFile("lib/a.hive", "lib/a.hive", "?", "?"), model.GitFile("src/b.hive", "src/b.hive", " ", "M")]
	assert folderKind(info, "lib") == "new"
	assert folderKind(info, "src") == "modified"
	assert folderKind(info, "docs") == ""
	assert fileKind(info, "src/b.hive") == "modified"
}
