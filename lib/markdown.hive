// Markdown → HTML para o preview. Cobre o que um README usa: títulos,
// parágrafos, ênfase, código (com realce para blocos `hive`), listas,
// citações, tabelas, links, imagens e linhas horizontais.

import ./highlight

func esc(text: Str): Str {
	return highlight.escape(text)
}

// Só destinos inofensivos viram link: web, e-mail e âncoras.
func safeHref(url: Str): Str {
	if url is "http://{rest}" || url is "https://{rest}" || url is "mailto:{rest}" || url is "#{rest}" {
		return url
	}
	return ""
}

// Um caminho de arquivo, relativo ao .md ou absoluto (C:/…, /…): sem esquema
// como `javascript:`.
func isLocal(url: Str): Bool {
	if url == "" {
		return false
	}
	if url is "{drive}:/{rest}" && len(drive) == 1 {
		return true
	}
	return indexOf(url, ":") is Result.Error(_)
}

// O valor de um atributo de uma tag HTML que chegou escapada; "" sem ele.
func attribute(attrs: Str, name: Str): Str {
	pieces := split(" " + replaceAll(attrs, "\t", " "), " " + name + "=&quot;")
	if pieces bounds 1 {
		if pieces[1] is "{value}&quot;{tail}" {
			return value
		}
	}
	return ""
}

// O texto sem as tags `<tag …>` que abrem uma caixa (o que vem dentro fica).
func dropTag(text: Str, tag: Str): Str {
	pieces := split(text, "&lt;" + tag + " ")
	mut Str[dyn] out = []
	for i := 0; i < len(pieces); i++ {
		if pieces bounds i {
			if i == 0 {
				append(out, pieces[i])
			} else if pieces[i] is "{attrs}&gt;{rest}" {
				append(out, rest)
			} else {
				append(out, "&lt;" + tag + " " + pieces[i])
			}
		}
	}
	return join(out, "")
}

// O HTML que um README costuma ter: `<img>` vira imagem (com a largura dada) e
// as caixas em volta dela (`<p align="center">`, `<div>`, `<br>`) somem.
func rawHtml(text: Str): Str {
	mut out := text
	for each tag in ["p", "div", "center", "picture", "br"] {
		out = replaceAll(out, "&lt;/" + tag + "&gt;", "")
		out = replaceAll(out, "&lt;" + tag + "&gt;", "")
		out = replaceAll(out, "&lt;" + tag + "/&gt;", "")
		out = dropTag(replaceAll(out, "&lt;" + tag + " /&gt;", ""), tag)
	}
	for ;; {
		if out is "{before}&lt;img {attrs}&gt;{rest}" {
			mut tail := ""
			width := attribute(replaceAll(attrs, "/", " "), "width")
			if hive.conv.sti(width) is Result.Ok(_) {
				tail = " width=\"" + width + "\""
			}
			src := attribute(attrs, "src")
			alt := attribute(attrs, "alt")
			href := safeHref(src)
			if href != "" {
				out = before + "<img src=\"" + href + "\" alt=\"" + alt + "\"" + tail + ">" + rest
			} else if isLocal(src) {
				out = before + "<img src=\"local:" + src + "\" alt=\"" + alt + "\"" + tail + ">" + rest
			} else {
				out = before + "<span class=\"md-img\">🖼 " + alt + "</span>" + rest
			}
		} else {
			return out
		}
	}
	return out
}

// Ênfase, links e imagens num trecho que não é código. Já chega escapado.
func emphasis(text: Str): Str {
	mut out := rawHtml(text)
	for ;; {
		if out is "{before}![{alt}]({url}){rest}" {
			href := safeHref(url)
			if href != "" {
				out = before + "<img src=\"" + href + "\" alt=\"" + alt + "\">" + rest
			} else if isLocal(url) {
				// Um arquivo ao lado do .md: quem mostra o preview troca o
				// `local:` pela imagem (studio.localImages).
				out = before + "<img src=\"local:" + url + "\" alt=\"" + alt + "\">" + rest
			} else {
				out = before + "<span class=\"md-img\">🖼 " + alt + "</span>" + rest
			}
		} else if out is "{before}[{label}]({url}){rest}" {
			out = before + "<a href=\"" + safeHref(url) + "\" title=\"" + url + "\">" + label + "</a>" + rest
		} else if out is "{before}**{inner}**{rest}" && inner != "" {
			out = before + "<strong>" + inner + "</strong>" + rest
		} else if out is "{before}__{inner}__{rest}" && inner != "" {
			out = before + "<strong>" + inner + "</strong>" + rest
		} else if out is "{before}*{inner}*{rest}" && inner != "" {
			out = before + "<em>" + inner + "</em>" + rest
		} else if out is "{before}~~{inner}~~{rest}" && inner != "" {
			out = before + "<del>" + inner + "</del>" + rest
		} else {
			return out
		}
	}
	return out
}

// O texto de uma linha: pedaços entre crases são código, o resto tem ênfase.
func inline(text: Str): Str {
	parts := split(text, "`")
	mut Str[dyn] out = []
	for i := 0; i < len(parts); i++ {
		if i % 2 == 1 && i < len(parts) - 1 {
			append(out, "<code>" + esc(parts[i]) + "</code>")
		} else if i % 2 == 1 {
			append(out, "`" + emphasis(esc(parts[i])))
		} else {
			append(out, emphasis(esc(parts[i])))
		}
	}
	return join(out, "")
}

func trimSpaces(text: Str): Str {
	mut rest := text
	for ;; {
		if rest is " {tail}" {
			rest = tail
		} else if rest is "\t{tail}" {
			rest = tail
		} else {
			return rest
		}
	}
	return rest
}

func trimBoth(text: Str): Str {
	mut rest := trimSpaces(text)
	for ;; {
		if rest is "{head} " {
			rest = head
		} else if rest is "{head}	" {
			rest = head
		} else {
			return rest
		}
	}
	return rest
}

func cells(line: Str): Str[dyn] {
	mut body := trimBoth(line)
	if body is "|{inner}" {
		body = inner
	}
	if body is "{inner}|" {
		body = inner
	}
	mut Str[dyn] found = []
	for each cell in split(body, "|") {
		append(found, trimBoth(cell))
	}
	return found
}

func isRule(line: Str): Bool {
	clean := replaceAll(trimSpaces(line), " ", "")
	return clean == "---" || clean == "***" || clean == "___" || clean is "----{rest}"
}

func isTableSeparator(line: Str): Bool {
	clean := replaceAll(replaceAll(replaceAll(replaceAll(trimSpaces(line), "|", ""), "-", ""), ":", ""), " ", "")
	return clean == "" && indexOf(line, "-") is Result.Ok(_) && indexOf(line, "|") is Result.Ok(_)
}

func listItem(line: Str): Result<Str, Bool> {
	clean := trimSpaces(line)
	if clean is "- {item}" {
		return Result.Ok(item)
	} else if clean is "* {item}" {
		return Result.Ok(item)
	} else if clean is "+ {item}" {
		return Result.Ok(item)
	}
	return Result.Error(false)
}

func orderedItem(line: Str): Result<Str, Bool> {
	if trimSpaces(line) is "{n is (\d+)}. {item}" {
		return Result.Ok(item)
	}
	return Result.Error(false)
}

func heading(line: Str): Result<Str, Bool> {
	if line is "###### {t}" {
		return Result.Ok("<h6>" + inline(t) + "</h6>")
	} else if line is "##### {t}" {
		return Result.Ok("<h5>" + inline(t) + "</h5>")
	} else if line is "#### {t}" {
		return Result.Ok("<h4>" + inline(t) + "</h4>")
	} else if line is "### {t}" {
		return Result.Ok("<h3>" + inline(t) + "</h3>")
	} else if line is "## {t}" {
		return Result.Ok("<h2>" + inline(t) + "</h2>")
	} else if line is "# {t}" {
		return Result.Ok("<h1>" + inline(t) + "</h1>")
	}
	return Result.Error(false)
}

func checkbox(item: Str): Str {
	if item is "[ ] {rest}" {
		return "<input type=\"checkbox\" disabled> " + inline(rest)
	} else if item is "[x] {rest}" {
		return "<input type=\"checkbox\" checked disabled> " + inline(rest)
	} else if item is "[X] {rest}" {
		return "<input type=\"checkbox\" checked disabled> " + inline(rest)
	}
	return inline(item)
}

func itemHtml(list: Str, text: Str): Str {
	if list == "ul" {
		return "<li>" + checkbox(text) + "</li>"
	}
	return "<li>" + inline(text) + "</li>"
}

func indented(line: Str): Bool {
	return line is " {rest}" || line is "\t{rest}"
}

// Uma tabela: o HTML e a linha logo depois dela.
type Block {
	html: Str
	next: Int
}

func rowHtml(row: Str, tag: Str): Str {
	mut Str[dyn] out = []
	for each cell in cells(row) {
		append(out, "<" + tag + ">" + inline(cell) + "</" + tag + ">")
	}
	return join(out, "")
}

// A tabela que começa no cabeçalho `head`; as linhas do corpo vêm de `from`
// (depois da linha de separação) até a primeira que não é de tabela.
func tableAt(lines: Str[], head: Str, from: Int): Block {
	mut Str[dyn] table = ["<table><thead><tr>", rowHtml(head, "th"), "</tr></thead><tbody>"]
	mut i := from
	for ; i < len(lines); i++ {
		mut row := ""
		if lines bounds i {
			row = lines[i]
		}
		if row is "{a}|{b}" {
			append(table, "<tr>" + rowHtml(row, "td") + "</tr>")
		} else {
			break
		}
	}
	append(table, "</tbody></table>")
	return Block(join(table, ""), i)
}

func render(text: Str): Str {
	lines := split(replaceAll(text, "\r", ""), "\n")
	mut Str[dyn] out = []
	mut Str[dyn] paragraph = []
	mut list := ""
	mut Str[dyn] pending = []
	mut hasItem := false
	mut fence := false
	mut fenceLang := ""
	mut Str[dyn] code = []
	mut i := 0
	for ; i < len(lines); {
		mut line := ""
		if lines bounds i {
			line = lines[i]
		}
		i++

		if fence {
			if trimSpaces(line) is "```{rest}" {
				body := highlight.joined(code, "\n")
				if fenceLang == "hive" {
					append(out, "<pre class=\"md-code\"><code>" + highlight.highlight(body) + "</code></pre>")
				} else {
					append(out, "<pre class=\"md-code\"><code>" + esc(body) + "</code></pre>")
				}
				Str[dyn] none = []
				code = none
				fence = false
			} else {
				append(code, line)
			}
			continue
		}

		blank := trimSpaces(line) == ""
		item := listItem(line)
		numbered := orderedItem(line)
		isItem := item is Result.Ok(_) || numbered is Result.Ok(_)

		// Uma linha indentada logo depois de um item continua esse item.
		if hasItem && !blank && !isItem && indented(line) {
			append(pending, trimBoth(line))
			continue
		}

		// Fecha o que estiver aberto quando a linha não continua aquilo.
		if len(paragraph) > 0 && (blank || isItem || line is "#{rest}" || line is ">{rest}" || line is "```{rest}" || line is "|{rest}" || isRule(line)) {
			append(out, "<p>" + inline(highlight.joined(paragraph, " ")) + "</p>")
			Str[dyn] none = []
			paragraph = none
		}
		if hasItem {
			append(out, itemHtml(list, highlight.joined(pending, " ")))
			hasItem = false
			Str[dyn] none = []
			pending = none
		}
		if list != "" && !isItem {
			append(out, "</" + list + ">")
			list = ""
		}

		if blank {
			continue
		}
		if trimSpaces(line) is "```{lang}" {
			fence = true
			fenceLang = trimSpaces(lang)
			continue
		}
		if trimSpaces(line) == "```" {
			fence = true
			fenceLang = ""
			continue
		}
		if heading(line) is Result.Ok(html) {
			append(out, html)
			continue
		}
		if isRule(line) {
			append(out, "<hr>")
			continue
		}
		if line is ">{quote}" {
			append(out, "<blockquote>" + inline(trimSpaces(quote)) + "</blockquote>")
			continue
		}
		if item is Result.Ok(content) {
			if list != "ul" {
				if list != "" {
					append(out, "</" + list + ">")
				}
				append(out, "<ul>")
				list = "ul"
			}
			pending = [content]
			hasItem = true
			continue
		}
		if numbered is Result.Ok(content) {
			if list != "ol" {
				if list != "" {
					append(out, "</" + list + ">")
				}
				append(out, "<ol>")
				list = "ol"
			}
			pending = [content]
			hasItem = true
			continue
		}
		mut next := ""
		if lines bounds i {
			next = lines[i]
		}
		if line is "{lead}|{rest}" && isTableSeparator(next) {
			read := tableAt(lines, line, i + 1)
			append(out, read.html)
			i = read.next
			continue
		}
		append(paragraph, trimBoth(line))
	}
	if len(paragraph) > 0 {
		append(out, "<p>" + inline(highlight.joined(paragraph, " ")) + "</p>")
	}
	if hasItem {
		append(out, itemHtml(list, highlight.joined(pending, " ")))
	}
	if list != "" {
		append(out, "</" + list + ">")
	}
	if fence {
		append(out, "<pre class=\"md-code\"><code>" + esc(highlight.joined(code, "\n")) + "</code></pre>")
	}
	return join(out, "\n")
}
