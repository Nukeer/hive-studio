// Lê o que o compilador diz e o que o arquivo declara.

import ./model
import ./highlight
import ./workspace

func trimLeft(text: Str): Str {
	mut rest := text
	for ;; {
		if rest is " {tail}" {
			rest = tail
		} else if rest is "\t{tail}" {
			rest = tail
		} else {
			return rest
		}
	}
	return rest
}

// `arquivo:linha: mensagem`, com continuações indentadas coladas na anterior.
func parseDiagnostics(output: Str): model.Diagnostic[dyn] {
	mut model.Diagnostic[dyn] found = []
	for each raw in split(replaceAll(output, "\r", ""), "\n") {
		continued := raw is " {rest}" || raw is "\t{rest}"
		if continued {
			last := len(found) - 1
			if found bounds last {
				found[last].message = found[last].message + " " + trimLeft(raw)
			}
		} else if raw is "{file}:{digits is (\d+)}: {message}" {
			if hive.conv.sti(digits) is Result.Ok(line) {
				append(found, model.Diagnostic(file, line, message, ""))
			}
		}
	}
	return found
}

func words(line: Str): Str[dyn] {
	mut Str[dyn] found = []
	for each part in split(replaceAll(line, "\t", " "), " ") {
		if part != "" {
			append(found, part)
		}
	}
	return found
}

// O que `hivec analyze` imprime: o resumo (as linhas antes da primeira função)
// e as funções piores, cada uma com o primeiro achado dela. O arquivo de cada
// uma fica para quem chama, que sabe onde os módulos estão.
type AnalyzeReport {
	head:  Str[dyn]
	spots: model.Hotspot[dyn]
}

func parseAnalyze(output: Str): AnalyzeReport {
	mut Str[dyn] head = []
	mut model.Hotspot[dyn] spots = []
	for each raw in split(replaceAll(output, "\r", ""), "\n") {
		parts := words(raw)
		indent := len(raw) - len(trimLeft(raw))
		mut callable := false
		if parts is [scoreText, name, kindText, where, lineText] {
			if where == "line" && kindText is "{kind}," {
				if hive.conv.sti(scoreText) is Result.Ok(score) {
					if hive.conv.sti(lineText) is Result.Ok(line) {
						append(spots, model.Hotspot(score, name, kind, "", line, "", ""))
						callable = true
					}
				}
			}
		}
		last := len(spots) - 1
		if callable || len(parts) == 0 {
			continue
		} else if spots bounds last {
			if indent >= 10 && spots[last].detail == "" {
				spots[last].detail = replaceAll(join(parts, " "), "`", "")
			}
		} else {
			append(head, join(parts, " "))
		}
	}
	return AnalyzeReport(head, spots)
}

// Um erro depois do parser vem na linha da declaração, como "in `f`: …", e,
// num programa com imports, no arquivo de entrada — mas o nome diz de onde:
// `util_0_ruim` é `ruim` do módulo `util`. `module` fica "" no próprio arquivo.
type Located {
	module:  Str
	name:    Str
	message: Str
}

func locate(message: Str): Located {
	if message is "in `{callable}`: {rest}" {
		if callable is "{module}_{digits is (\d+)}_{name}" {
			return Located(module, name, name + ": " + rest)
		}
		return Located("", callable, callable + ": " + rest)
	}
	return Located("", "", message)
}

// Os trechos entre crases da mensagem, que costumam ser código da linha
// errada (`3` em "cannot prove `3` is in range").
func fragments(message: Str): Str[dyn] {
	mut Str[dyn] found = []
	parts := split(message, "`")
	for i := 1; i < len(parts); i = i + 2 {
		if parts bounds i {
			mut piece := parts[i]
			// `settings_0_Settings` é `Settings` no código.
			if piece is "{module}_{digits is (\d+)}_{name}" {
				piece = name
			}
			if piece != "" && len(piece) <= 40 && indexOf(piece, "...") is Result.Error(_) && indexOf(piece, "…") is Result.Error(_) {
				append(found, piece)
			}
		}
	}
	return found
}

// Um trecho que não é só um nome (tem número, símbolo) aponta melhor a linha.
func weight(piece: Str): Int {
	for each c in split(piece, "") {
		if !highlight.isIdent(c) || highlight.isDigit(c) {
			return 2
		}
	}
	return 1
}

// A linha do corpo da declaração (começando em `line`) com mais trechos da
// mensagem; sem nenhum, a própria linha da declaração.
func refineLine(text: Str, line: Int, message: Str): Int {
	pieces := fragments(message)
	if len(pieces) == 0 {
		return line
	}
	lines := split(text, "\n")
	mut best := line
	mut bestScore := 0
	for row := line; row < len(lines); row++ {
		if lines bounds row {
			current := lines[row]
			if current == "}" {
				break
			}
			mut score := 0
			for each piece in pieces {
				if indexOf(current, piece) is Result.Ok(_) {
					score = score + weight(piece)
				}
			}
			if score > bestScore {
				best = row + 1
				bestScore = score
			}
		}
	}
	return best
}

// Um `import` de arquivo: o nome pelo qual o módulo é chamado (o do arquivo,
// ou o do `as`) e o caminho, resolvido a partir da pasta de quem importa.
type ModuleRef {
	name: Str
	path: Str
}

func isLocal(spec: Str): Bool {
	if spec is "./{rest}" {
		return true
	}
	if spec is "../{rest}" {
		return true
	}
	return false
}

// Os imports de arquivo (`./` e `../`, com ou sem aspas e `as`) de um texto;
// os da biblioteca padrão e os de um repositório git ficam de fora.
func importsOf(text: Str, folder: Str): ModuleRef[dyn] {
	mut ModuleRef[dyn] found = []
	for each raw in split(replaceAll(text, "\r", ""), "\n") {
		if raw is "import {rest}" {
			mut spec := ""
			mut alias := ""
			if rest is "\"{quoted}\"{tail}" {
				spec = quoted
				if tail is " as {name}" {
					alias = name
				}
			} else {
				parts := words(rest)
				if parts is [first, ...others] {
					spec = first
					if others is ["as", name] {
						alias = name
					}
				}
			}
			if isLocal(spec) {
				mut file := spec + ".hive"
				mut base := workspace.baseName(spec)
				if spec is "{stem}.go" {
					file = spec
					base = workspace.baseName(stem)
				}
				if alias != "" {
					base = alias
				}
				append(found, ModuleRef(base, workspace.tidy(folder + "/" + file)))
			}
		}
	}
	return found
}

// A linha `line` (a partir de 1) de um texto, sem partir o texto inteiro.
func lineText(text: Str, line: Int): Str {
	if line < 1 {
		return ""
	}
	mut rest := text
	for n := 1; n < line; n++ {
		if indexOf(rest, "\n") is Result.Ok(at) {
			next := at + 1
			if rest bounds next {
				rest = rest[next:]
			} else {
				return ""
			}
		} else {
			return ""
		}
	}
	if indexOf(rest, "\n") is Result.Ok(end) {
		last := end - 1
		if rest bounds last {
			return rest[:last]
		}
		return ""
	}
	return rest
}

// O módulo de `vim.keyStep` é `vim`; o de `update` é o próprio arquivo ("").
func moduleOf(name: Str): Str {
	if name is "{module}.{rest}" {
		return module
	}
	return ""
}

func symbolOf(line: Str, number: Int): Result<model.Symbol, Bool> {
	if line is "func {name is (\w+)}{rest}" {
		return Result.Ok(model.Symbol("func", name, number))
	} else if line is "proc {name is (\w+)}{rest}" {
		return Result.Ok(model.Symbol("proc", name, number))
	} else if line is "type {name is (\w+)}{rest}" {
		return Result.Ok(model.Symbol("type", name, number))
	} else if line is "query {name is (\w+)}{rest}" {
		return Result.Ok(model.Symbol("query", name, number))
	} else if line is `test "{name}"{rest}` {
		return Result.Ok(model.Symbol("test", name, number))
	} else if line is "import {path}" {
		return Result.Ok(model.Symbol("import", trimLeft(path), number))
	}
	return Result.Error(false)
}

// As declarações de topo, com a linha (a partir de 1) onde cada uma começa.
func outline(text: Str): model.Symbol[dyn] {
	lines := split(replaceAll(text, "\r", ""), "\n")
	mut model.Symbol[dyn] found = []
	for i := 0; i < len(lines); i++ {
		if symbolOf(lines[i], i + 1) is Result.Ok(symbol) {
			append(found, symbol)
		}
	}
	return found
}

test "a saída do analyze vira resumo e funções" {
	output := "  studio.hive scores 80/100 over 552 callables\n  422 findings — 272 copies\n\n  0   vim.playMacro                       func, line 2446\n        ×64    e\n             an argument to `vim.keyStep` is deep-copied\n        ·      ed\n             a binding is deep-copied\n\n  35  serve                               proc, line 12\n        ·      next\n             a copy\n"
	report := parseAnalyze(output)
	assert report.head == ["studio.hive scores 80/100 over 552 callables", "422 findings — 272 copies"]
	assert len(report.spots) == 2
	if report.spots bounds 1 {
		assert report.spots[0].name == "vim.playMacro" && report.spots[0].score == 0 && report.spots[0].line == 2446
		assert report.spots[0].kind == "func" && report.spots[0].detail == "an argument to vim.keyStep is deep-copied"
		assert report.spots[1].name == "serve" && report.spots[1].detail == "a copy"
	}
	assert moduleOf("vim.playMacro") == "vim" && moduleOf("serve") == ""
}

test "erro de módulo importado volta para o arquivo e a linha certos" {
	far := locate("in `util_0_ruim`: cannot prove `3` is in range: `v` has no length")
	assert far.module == "util" && far.name == "ruim"
	assert far.message == "ruim: cannot prove `3` is in range: `v` has no length"
	own := locate("in `main`: `z` holds 2, so `5` is not a position it has")
	assert own.module == "" && own.message == "main: `z` holds 2, so `5` is not a position it has"
	assert locate("expected `)` but found `}`").module == ""
	body := "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n\nfunc ruim(v: Int[dyn]): Int \{\n\tmut t := 0\n\tt = v[3]\n\treturn t\n}\n"
	assert refineLine(body, 5, far.message) == 7
	main := "proc main(): void \{\n\tz := [1, 2]\n\techo z[5]\n}\n"
	assert refineLine(main, 1, own.message) == 3
	assert refineLine(main, 1, "main: sem trecho nenhum") == 1
	assert fragments("`settings_0_Settings` has 17 fields") == ["Settings"]
	assert lineText("a\nb\nc", 2) == "b" && lineText("a\nb", 1) == "a" && lineText("a\nb", 3) == "" && lineText("só", 1) == "só"
}

test "os imports de arquivo, com as, aspas e ../" {
	text := "import hive.ui\nimport ./lib/util\nimport ./lib/native.go\nimport ../comum/texto as txt\nimport \"./lib/com espaço\" as esp\nimport https://github.com/a/b/c\n\tfalso := \"import ./nao\"\n"
	found := importsOf(text, "C:/p")
	assert found == [ModuleRef("util", "C:/p/lib/util.hive"), ModuleRef("native", "C:/p/lib/native.go"),
		ModuleRef("txt", "C:/comum/texto.hive"), ModuleRef("esp", "C:/p/lib/com espaço.hive")]
	assert importsOf("import ./b", "lib") == [ModuleRef("b", "lib/b.hive")]
}

func countLines(text: Str): Int {
	return len(split(text, "\n"))
}

func pad(number: Int, width: Int): Str {
	mut label := "{number}"
	for ; len(label) < width; {
		label = " " + label
	}
	return label
}

// As linhas em volta de `line`, numeradas, com a própria linha marcada.
func excerpt(text: Str, line: Int, radius: Int): Str[dyn] {
	lines := split(replaceAll(text, "\r", ""), "\n")
	mut Str[dyn] shown = []
	for i := 0; i < len(lines); i++ {
		number := i + 1
		if number >= line - radius && number <= line + radius {
			mut marker := "  "
			if number == line {
				marker = "> "
			}
			append(shown, marker + pad(number, 4) + "  " + lines[i])
		}
	}
	return shown
}

test "diagnósticos do compilador viram itens" {
	output := "main.hive:12: cannot prove this index is in range: the index is a computed\n    expression. Bind it.\nC:\\p\\lib\\x.hive:3: expected `]` but found `,`\nCompiled nothing"
	found := parseDiagnostics(output)
	assert len(found) == 2
	if found is [first, second] {
		assert first.file == "main.hive"
		assert first.line == 12
		assert first.message == "cannot prove this index is in range: the index is a computed expression. Bind it."
		assert second.file == "C:\\p\\lib\\x.hive"
		assert second.line == 3
	}
}

test "saída sem erros não gera diagnóstico" {
	assert len(parseDiagnostics("No problems found in x.hive (0s)")) == 0
}

test "a estrutura lista as declarações de topo" {
	source := "import ./lib/a\n\ntype User \{\n\tname: Str\n}\n\nfunc greet(u: User): Str \{\n\treturn u.name\n}\n\nproc main(): void \{\n}\n\ntest \"greets\" \{\n}\n"
	found := outline(source)
	assert len(found) == 5
	if found is [imp, ty, fn, pr, te] {
		assert imp.name == "./lib/a"
		assert ty.kind == "type" && ty.name == "User" && ty.line == 3
		assert fn.kind == "func" && fn.name == "greet" && fn.line == 7
		assert pr.name == "main" && pr.line == 11
		assert te.kind == "test" && te.name == "greets"
	}
}

test "o trecho marca a linha pedida" {
	shown := excerpt("a\nb\nc\nd\ne", 3, 1)
	assert len(shown) == 3
	assert shown == ["     2  b", ">    3  c", "     4  d"]
}
