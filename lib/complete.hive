// Autocomplete: o que dá para escrever a partir do cursor.
//
// Palavras-chave, tipos e builtins da linguagem; os módulos `hive.*` e o que
// cada um oferece depois do ponto; e as declarações e nomes do próprio arquivo.

import ./highlight
import ./analysis
import ./model
import ./native.go

// O que está sendo digitado: o pedaço de nome antes do cursor e, se houver,
// o que vem antes do ponto (`hive.file` em `hive.file.re|`).
type Context {
	prefix:    Str
	qualifier: Str
	start:     Int
}

type TextEdit {
	text:  Str
	caret: Int
}

func builtins(): Str[dyn] {
	return ["len", "bytes", "append", "prepend", "drop", "join", "split", "replaceFirst", "replaceAll",
		"indexOf", "row", "column", "toTable", "map", "filter", "filterMap", "sort", "encode", "spawn", "at", "kill"]
}

func modules(): Str[dyn] {
	return ["conv", "math", "map", "file", "term", "json", "crypto", "net", "syslink", "task", "time", "env", "sql", "ui", "codec"]
}

func members(module: Str): Str[dyn] {
	if module == "conv" {
		return ["ceil", "floor", "round", "itf", "its", "fts", "sti", "stf", "ConversionError"]
	} else if module == "math" {
		return ["pi", "sin", "cos", "tan", "asin", "acos", "atan2", "sqrt", "hypot", "abs", "min", "max", "clamp"]
	} else if module == "map" {
		return ["new", "set", "get", "has", "delete", "keys", "values", "fromTable", "toTable", "Map"]
	} else if module == "file" {
		return ["read", "lines", "write", "writeSecret", "append", "size", "copy", "delete", "makeDir", "move", "list", "exists", "csv", "xlsx", "ods", "FileError", "TableError"]
	} else if module == "term" {
		return ["print", "status", "isTerminal", "read", "readSecret", "args", "codec", "exit", "exec", "attach", "execWith", "ExecError", "FlagError"]
	} else if module == "json" {
		return ["codec", "JsonValue", "JsonError"]
	} else if module == "crypto" {
		return ["sha256", "sha512", "hmacSha256", "encrypt", "decrypt", "base64Encode", "base64Decode", "randomHex", "jwtCodec", "jwtDecode", "jwtHeader", "CryptoError", "JwtError"]
	} else if module == "net" {
		return ["httpRequest", "httpServe", "wsConnect", "wsServe", "wsSend", "wsReceive", "wsRequest", "wsClose",
			"socketConnect", "socketServe", "socketSend", "socketReceive", "socketReceiveLine", "socketPeer", "socketClose",
			"resolve", "localAddress", "urlEncode", "queryParamsCodec", "HttpRequest", "HttpResponse", "HttpError", "WsConnection", "WsError"]
	} else if module == "syslink" {
		return ["monitor", "listen", "node", "peers", "setKey", "SyslinkError"]
	} else if module == "task" {
		return ["sleep", "sleepForever", "TimeoutError"]
	} else if module == "time" {
		return ["now", "timezone", "timezoneOffset", "format", "dateFrom", "dateTimeFrom", "year", "month", "day", "weekday", "lastDayOfMonth", "hour", "minute", "second", "millisecond"]
	} else if module == "env" {
		return ["get", "EnvironmentError"]
	} else if module == "sql" {
		return ["run", "raw", "connect", "pool", "close", "DatabaseDriver", "SqlConnection", "SqlError", "Fragment"]
	} else if module == "ui" {
		return ["window", "webview", "html", "page", "row", "column", "spacer", "spinner", "none", "overlay", "text", "image", "link", "icon",
			"button", "input", "textarea", "checkbox", "select", "table", "canvas", "scene", "inset",
			"gap", "pad", "width", "height", "grow", "align", "justify", "scroll", "size", "heading", "tone", "background", "paint",
			"on", "onInput", "onSubmit", "onChoose", "onToggle", "onPick", "onSort", "View", "Tone", "Align", "Justify", "TextSize", "Axis", "Icon"]
	}
	return []
}

func memberKind(word: Str): Str {
	if word bounds 0 {
		if highlight.isUpper(word[0]) {
			return "type"
		}
	}
	return "func"
}

// Os últimos (no máximo) `size` caracteres antes de `caret`, e onde eles começam.
type Window {
	text:  Str
	start: Int
}

func before(text: Str, caret: Int, size: Int): Window {
	if caret <= size {
		return Window(native.slice(text, 0, caret), 0)
	}
	from := caret - size
	return Window(native.slice(text, from, size), from)
}

// O texto perto do cursor (`radius` caracteres para cada lado), para ler os
// nomes de um arquivo grande sem passar por ele todo.
func around(text: Str, caret: Int, radius: Int): Str {
	mut from := caret - radius
	if from < 0 {
		from = 0
	}
	return native.slice(text, from, radius * 2)
}

func context(text: Str, caret: Int): Context {
	// Um nome, com o que vem antes do ponto, cabe folgado em 200 caracteres.
	window := before(text, caret, 200)
	found := contextIn(window.text, len(window.text))
	return Context(found.prefix, found.qualifier, found.start + window.start)
}

func contextIn(text: Str, caret: Int): Context {
	chars := split(text, "")
	mut i := caret - 1
	for ; chars bounds i; i-- {
		if !highlight.isIdent(chars[i]) {
			break
		}
	}
	start := i + 1
	prefix := highlight.piece(chars, start, caret)
	mut qualifier := ""
	if chars bounds i {
		if chars[i] == "." {
			mut k := i - 1
			for ; chars bounds k; k-- {
				c := chars[k]
				if !(highlight.isIdent(c) || c == ".") {
					break
				}
			}
			qualifier = highlight.piece(chars, k + 1, i)
		}
	}
	return Context(prefix, qualifier, start)
}

func startsWith(word: Str, prefix: Str): Bool {
	if prefix == "" {
		return true
	}
	if indexOf(word, prefix) is Result.Ok(at) {
		return at == 0
	}
	return false
}

func contains(values: Str[], value: Str): Bool {
	return indexOf(values, value) is Result.Ok(_)
}

// Os nomes do arquivo que começam com `prefix` (sem ser ele), para completar
// variáveis locais também — no máximo `limit`, na ordem em que aparecem. Só
// as linhas onde `prefix` aparece são lidas caractere a caractere.
func wordsIn(text: Str, prefix: Str, limit: Int): Str[dyn] {
	mut Str[dyn] found = []
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	for each line in split(text, "\n") {
		if len(found) >= limit {
			break
		}
		if highlight.has(line, prefix) {
			wordsOf(line, prefix, limit, found, seen)
		}
	}
	return found
}

// Os nomes de uma linha que começam com `prefix`, sem repetir, até `limit`.
proc wordsOf(line: Str, prefix: Str, limit: Int, found: mut Str[dyn], seen: mut hive.map.Map<Str, Bool>): void {
	for each word in namesIn(line) {
		if len(found) >= limit {
			return
		}
		if len(word) >= 3 && word != prefix && startsWith(word, prefix) && !hive.map.has(seen, word) {
			hive.map.set(seen, word, true)
			append(found, word)
		}
	}
}

// Os nomes de uma linha, na ordem.
func namesIn(line: Str): Str[dyn] {
	chars := split(line, "")
	mut Str[dyn] names = []
	mut start := -1
	for i := 0; i <= len(chars); i++ {
		mut ident := false
		if chars bounds i {
			ident = highlight.isIdent(chars[i])
		}
		if ident && start < 0 {
			start = i
		} else if !ident && start >= 0 {
			append(names, highlight.piece(chars, start, i))
			start = -1
		}
	}
	return names
}

// O que a linguagem oferece no ponto do cursor, antes dos nomes do arquivo.
func fixedCandidates(ctx: Context): model.Suggestion[dyn] {
	mut model.Suggestion[dyn] all = []
	if ctx.qualifier == "hive" {
		for each m in modules() {
			append(all, model.Suggestion(m, "module", "hive.{m}"))
		}
		for each b in builtins() {
			append(all, model.Suggestion(b, "func", "builtin"))
		}
	} else if ctx.qualifier is "hive.{module}" {
		for each m in members(module) {
			append(all, model.Suggestion(m, memberKind(m), "hive.{module}"))
		}
	} else if ctx.qualifier != "" {
		for each m in members(ctx.qualifier) {
			append(all, model.Suggestion(m, memberKind(m), ctx.qualifier))
		}
	} else {
		for each k in highlight.keywords() {
			append(all, model.Suggestion(k, "keyword", "palavra-chave"))
		}
		for each t in highlight.builtinTypes() {
			append(all, model.Suggestion(t, "type", "tipo"))
		}
		append(all, model.Suggestion("true", "keyword", "Bool"))
		append(all, model.Suggestion("false", "keyword", "Bool"))
		append(all, model.Suggestion("hive", "module", "biblioteca padrão"))
		for each b in builtins() {
			append(all, model.Suggestion(b, "func", "builtin"))
		}
	}
	return all
}

func fits(word: Str, prefix: Str): Bool {
	return word != prefix && startsWith(word, prefix)
}

// Para assim que tem `limit` sugestões: o arquivo só é lido se a linguagem não
// bastou, e os nomes dele só até completar a lista.
func suggest(text: Str, caret: Int, limit: Int): model.Suggestion[dyn] {
	ctx := context(text, caret)
	mut model.Suggestion[dyn] found = []
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	for each s in fixedCandidates(ctx) {
		if len(found) >= limit {
			return found
		}
		if fits(s.word, ctx.prefix) && !hive.map.has(seen, s.word) {
			hive.map.set(seen, s.word, true)
			append(found, s)
		}
	}
	if ctx.qualifier != "" {
		return found
	}
	// Num arquivo grande, os nomes vêm do trecho em volta do cursor.
	nearby := around(text, caret, 200000)
	for each symbol in analysis.outline(nearby) {
		if len(found) >= limit {
			return found
		}
		if symbol.kind != "import" && fits(symbol.name, ctx.prefix) && !hive.map.has(seen, symbol.name) {
			hive.map.set(seen, symbol.name, true)
			append(found, model.Suggestion(symbol.name, symbol.kind, "linha {symbol.line}"))
		}
	}
	if ctx.prefix == "" {
		return found
	}
	for each w in wordsIn(nearby, ctx.prefix, limit + len(found)) {
		if len(found) >= limit {
			return found
		}
		if !hive.map.has(seen, w) {
			hive.map.set(seen, w, true)
			append(found, model.Suggestion(w, "word", "no arquivo"))
		}
	}
	return found
}

func take(text: Str, count: Int): Str {
	last := count - 1
	if last < 0 {
		return ""
	}
	if text bounds last {
		return text[:last]
	}
	return text
}

func skip(text: Str, count: Int): Str {
	if count <= 0 {
		return text
	}
	if text bounds count {
		return text[count:]
	}
	return ""
}

// Troca o pedaço digitado pela palavra escolhida e põe o cursor depois dela.
func accept(text: Str, caret: Int, word: Str): TextEdit {
	ctx := context(text, caret)
	before := take(text, ctx.start)
	return TextEdit(before + word + skip(text, caret), len(before) + len(word))
}
