// Idiomas da interface. O texto em português é a chave: `tr` devolve a
// tradução no idioma pedido, ou o próprio texto quando não há uma.

type Language {
	code: Str
	name: Str
}

func languages(): Language[dyn] {
	return [Language("pt-BR", "Português (Brasil)"), Language("en", "English"), Language("es", "Español")]
}

