func column(lang: Str): Int {
	if lang == "en" {
		return 1
	} else if lang == "es" {
		return 2
	}
	return 0
}

// Todas as traduções de um idioma, para `tr` ser só uma consulta.
func words(lang: Str): hive.map.Map<Str, Str> {
	mut hive.map.Map<Str, Str> found = hive.map.new()
	at := column(lang)
	if at == 0 {
		return found
	}
	for each row in table() {
		if at == 1 {
			hive.map.set(found, row[0], row[1])
		} else {
			hive.map.set(found, row[0], row[2])
		}
	}
	return found
}

func tr(dictionary: hive.map.Map<Str, Str>, text: Str): Str {
	if hive.map.get(dictionary, text) is Result.Ok(translated) {
		return translated
	}
	return text
}

func unique(values: Str[]): Bool {
	mut Str[dyn] seen = []
	for each v in values {
		if indexOf(seen, v) is Result.Ok(_) {
			return false
		}
		append(seen, v)
	}
	return true
}

func keyOf(row: Str[]): Str {
	if row bounds 0 {
		return row[0]
	}
	return ""
}

test "traduções existem nos três idiomas e as chaves não repetem" {
	english := words("en")
	assert tr(english, "Configurações") == "Settings"
	assert tr(words("es"), "Configurações") == "Configuración"
	assert tr(words("pt-BR"), "Configurações") == "Configurações"
	assert tr(english, "texto sem tradução") == "texto sem tradução"
	assert unique(map(table(), keyOf))
}
