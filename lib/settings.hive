// Preferências do usuário, guardadas como JSON fora do projeto.

type Settings {
	theme:         Str  -- Default as "Hive Dark";
	lineNumbers:   Bool -- JSON as line_numbers; Default as true;
	showHidden:    Bool -- JSON as show_hidden; Default as false;
	saveBeforeRun: Bool -- JSON as save_before_run; Default as true;
	compiler:      Str  -- Default as "hivec";
	fontSize:      Int  -- JSON as font_size; Default as 14;
	tabSize:       Int  -- JSON as tab_size; Default as 4;
	autocomplete:  Bool -- Default as true;
	keymap:        Str  -- Default as "";
	panelHeight:   Int  -- JSON as panel_height; Default as 260;
	language:      Str  -- Default as "pt-BR";
	vim:           Bool -- Default as false;
	claudeCommand:   Str -- JSON as claude_command; Default as "claude";
	codexCommand:    Str -- JSON as codex_command; Default as "codex";
	opencodeCommand: Str -- JSON as opencode_command; Default as "opencode";
	errorLens:     Bool -- JSON as error_lens; Default as true;
}

func defaults(): Settings {
	return Settings("Hive Dark", true, false, true, "hivec", 14, 4, true, "", 260, "pt-BR", false, "claude", "codex", "opencode", true)
}

func envOr(name: Str, fallback: Str): Str {
	if hive.env.get(name) is Result.Ok(value) {
		if value != "" {
			return replaceAll(value, "\\", "/")
		}
	}
	return fallback
}

// `%APPDATA%/HiveStudio` no Windows, `~/.config/hive-studio` no resto.
func folder(): Str {
	appData := envOr("APPDATA", "")
	if appData != "" {
		return appData + "/HiveStudio"
	}
	home := envOr("HOME", "")
	if home != "" {
		return home + "/.config/hive-studio"
	}
	return "./.hive-studio"
}

func path(): Str {
	return folder() + "/settings.json"
}

func load(): Settings {
	if hive.file.read(path()) is Result.Ok(text) {
		if Settings.decode(text, hive.json.codec()) is Result.Ok(found) {
			return found
		}
	}
	return defaults()
}

func save(value: Settings): Result<Bool, Str> {
	if hive.file.makeDir(folder()) is Result.Error(why) {
		return Result.Error(why.message)
	}
	if hive.file.write(path(), encode(value, hive.json.codec())) is Result.Error(why) {
		return Result.Error(why.message)
	}
	return Result.Ok(true)
}
