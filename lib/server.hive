// A ponte entre o programa e a janela: um servidor HTTP entrega a página, um
// WebSocket leva eventos para o serviço de estado e traz frames de volta, e um
// navegador Chromium em modo aplicativo (perfil próprio) é a janela.
//
// Tudo fica em 127.0.0.1 e exige o token sorteado a cada execução.

import ./model
import ./assets
import ./pty.go

func hasToken(url: Str, token: Str): Bool {
	return indexOf(url, "token=" + token) is Result.Ok(_)
}

// Os arquivos de terceiros da página — o xterm.js do painel AGENTE —, que
// ficam em base64 dentro do executável (tools/embed.hive).
func vendorFile(name: Str): Result<hive.net.HttpResponse, Bool> {
	mut encoded := ""
	mut kind := "text/javascript; charset=utf-8"
	if name == "xterm.js" {
		encoded = assets.vendorXtermJs()
	} else if name == "addon-fit.js" {
		encoded = assets.vendorFitJs()
	} else if name == "xterm.css" {
		encoded = assets.vendorXtermCss()
		kind = "text/css; charset=utf-8"
	} else {
		return Result.Error(false)
	}
	if hive.crypto.base64Decode(encoded) is Result.Ok(body) {
		return Result.Ok(hive.net.HttpResponse(200, [["Content-Type", kind], ["Cache-Control", "no-store"]], body))
	}
	return Result.Error(false)
}

proc page(token: Str, wsPort: Int, request: hive.net.HttpRequest): hive.net.HttpResponse {
	if !hasToken(request.url, token) {
		return hive.net.HttpResponse(403, [], "forbidden")
	}
	if request.url is "/vendor/{name}?{query}" {
		if vendorFile(name) is Result.Ok(file) {
			return file
		}
		return hive.net.HttpResponse(404, [], "not found")
	}
	html := replaceAll(replaceAll(assets.shell(), "__WSPORT__", "{wsPort}"), "__TOKEN__", token)
	return hive.net.HttpResponse(200, [["Content-Type", "text/html; charset=utf-8"], ["Cache-Control", "no-store"]], html)
}

// ── o terminal de um agente ──────────────────────────────────────────────
//
// `/pty?session=N` liga um terminal da página (xterm.js) ao programa rodando
// no pseudoterminal. Da página vêm `i<texto digitado>`, `b<bytes em base64>`
// e `r<colunas> <linhas>`; para ela vão `o<saída em base64>` e, quando o
// programa termina, `x<código>`. Nada disso passa pelo estado da janela.

// Uma leitura do terminal mandada à página; `false` quando acabou (o
// programa saiu ou a página fechou).
proc ptyForward(conn: hive.net.WsConnection, session: Int): Bool {
	chunk := pty.read(session, 40)
	if chunk != "" {
		if hive.net.wsSend(conn, "o" + chunk) is Result.Error(_) {
			return false
		}
	}
	if !pty.alive(session) {
		rest := pty.read(session, 0)
		if rest != "" {
			_last := hive.net.wsSend(conn, "o" + rest)
		}
		_ended := hive.net.wsSend(conn, "x{pty.code(session)}")
		return false
	}
	return true
}

proc ptyOutput(conn: hive.net.WsConnection, session: Int): void {
	for ; ptyForward(conn, session); {
	}
}

proc ptyClient(conn: hive.net.WsConnection, session: Int): void {
	async ptyOutput(conn, session)
	for ; ptyInput(conn, session); {
	}
}

// Uma mensagem da página para o terminal (tecla, bytes ou novo tamanho);
// `false` quando a página fechou.
proc ptyInput(conn: hive.net.WsConnection, session: Int): Bool {
	received := hive.net.wsReceive(conn)
	if received is Result.Ok(message) {
		if message is "i{typed}" {
			_typed := pty.write(session, typed)
		} else if message is "b{encoded}" {
			if hive.crypto.base64Decode(encoded) is Result.Ok(raw) {
				_raw := pty.write(session, raw)
			}
		} else if message is "r{cols} {rows}" {
			if hive.conv.sti(cols) is Result.Ok(width) {
				if hive.conv.sti(rows) is Result.Ok(height) {
					_resized := pty.resize(session, width, height)
				}
			}
		}
		return true
	}
	return false
}

// Manda um frame novo sempre que algo mudou sem a página pedir — um build que
// terminou, por exemplo. Para quando a conexão cai.
// Uma volta do pusher: se o pulso mudou desde `last`, manda o frame. Devolve o
// pulso visto, ou -2 quando a conexão caiu.
proc pushOnce(db: hive.syslink.Address, conn: hive.net.WsConnection, last: Int): Int {
	asked := db(model.Cmd.Pulse())
	if asked is Result.Ok(reply) {
		if reply is model.Cmd.PulseIs(n) {
			if n != last {
				rendered := db(model.Cmd.Render())
				if rendered is Result.Ok(answer) {
					if answer is model.Cmd.Reply(frame) {
						if hive.net.wsSend(conn, frame) is Result.Error(_) {
							return -2
						}
					}
				}
			}
			return n
		}
		return last
	}
	return -2
}

proc pusher(db: hive.syslink.Address, conn: hive.net.WsConnection): void {
	mut last := -1
	for ;; {
		last = pushOnce(db, conn, last)
		if last == -2 {
			return
		}
		hive.task.sleep(200)
	}
}

// Fecha o programa se, pouco depois de uma janela sair, nenhuma outra voltou.
proc closeIfIdle(db: hive.syslink.Address): void {
	hive.task.sleep(2500)
	asked := db(model.Cmd.Clients())
	if asked is Result.Ok(reply) {
		if reply is model.Cmd.ClientsAre(n) {
			if n <= 0 {
				hive.term.exit(0)
			}
		}
	}
}

// Um evento da página, respondido com o frame; `false` quando a página fechou.
proc answerOnce(db: hive.syslink.Address, conn: hive.net.WsConnection): Bool {
	received := hive.net.wsReceive(conn)
	if received is Result.Ok(text) {
		answered := db(model.Cmd.Ui(text))
		if answered is Result.Ok(reply) {
			if reply is model.Cmd.Reply(frame) {
				if hive.net.wsSend(conn, frame) is Result.Error(_) {
					return false
				}
			}
		}
		return true
	}
	return false
}

proc client(db: hive.syslink.Address, token: Str, conn: hive.net.WsConnection): void {
	url := hive.net.wsRequest(conn).url
	if !hasToken(url, token) {
		hive.net.wsClose(conn)
		return
	}
	if url is "/pty?session={number}&{rest}" {
		if hive.conv.sti(number) is Result.Ok(session) {
			ptyClient(conn, session)
		}
		hive.net.wsClose(conn)
		return
	}
	async db(model.Cmd.Post(model.Msg.Connected()))
	async pusher(db, conn)
	for ; answerOnce(db, conn); {
	}
	async db(model.Cmd.Post(model.Msg.Disconnected()))
	async closeIfIdle(db)
}

func envPath(name: Str): Str {
	if hive.env.get(name) is Result.Ok(value) {
		return replaceAll(value, "\\", "/")
	}
	return ""
}

func isWindows(): Bool {
	return envPath("OS") == "Windows_NT"
}

// Navegadores Chromium conhecidos, no lugar onde cada sistema os instala.
func candidates(preferred: Str): Str[dyn] {
	mut Str[dyn] found = []
	if preferred != "" {
		append(found, preferred)
	}
	if isWindows() {
		x86 := envPath("ProgramFiles(x86)")
		programs := envPath("ProgramFiles")
		local := envPath("LOCALAPPDATA")
		append(found, x86 + "/Microsoft/Edge/Application/msedge.exe")
		append(found, programs + "/Microsoft/Edge/Application/msedge.exe")
		append(found, programs + "/Google/Chrome/Application/chrome.exe")
		append(found, x86 + "/Google/Chrome/Application/chrome.exe")
		append(found, local + "/Google/Chrome/Application/chrome.exe")
		append(found, programs + "/BraveSoftware/Brave-Browser/Application/brave.exe")
	} else {
		append(found, "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
		append(found, "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge")
		append(found, "/Applications/Chromium.app/Contents/MacOS/Chromium")
		append(found, "/usr/bin/google-chrome")
		append(found, "/usr/bin/google-chrome-stable")
		append(found, "/usr/bin/chromium")
		append(found, "/usr/bin/chromium-browser")
		append(found, "/usr/bin/microsoft-edge")
		append(found, "/snap/bin/chromium")
		append(found, "/usr/bin/brave-browser")
	}
	return found
}

proc openWith(browser: Str, arguments: Str[]): void {
	_ran := hive.term.exec(browser, arguments, "")
}

// Abre a janela num Chromium conhecido. `""` quando não há nenhum.
proc launch(url: Str, profile: Str, preferred: Str): Str {
	for each browser in candidates(preferred) {
		if hive.file.exists(browser) {
			arguments := ["--app=" + url, "--user-data-dir=" + profile, "--no-first-run", "--no-default-browser-check", "--window-size=1440,900"]
			async openWith(browser, arguments)
			return browser
		}
	}
	return ""
}

// Uma porta livre: tenta algumas e fica com a primeira que ninguém atende.
// A porta está livre se ninguém responde nela.
proc isFree(port: Int): Bool {
	opened := hive.net.socketConnect("127.0.0.1", port)
	if opened is Result.Ok(conn) {
		hive.net.socketClose(conn)
		return false
	}
	return true
}

// Duas portas seguidas livres (a página e o WebSocket).
proc freePort(): Int {
	seed := hive.time.now() + hive.time.millisecond() * 7
	for attempt := 0; attempt < 20; attempt++ {
		candidate := 41000 + ((seed + attempt * 131) % 900) * 2
		if isFree(candidate) && isFree(candidate + 1) {
			return candidate
		}
	}
	return 41777
}
