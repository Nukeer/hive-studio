// A janela desenhada só com os widgets do hive.ui (ver studioui.hive).
//
// O estado é o mesmo do Hive Studio (`model.State`), e cada clique manda à
// dobra o mesmo evento que a página própria (assets/shell.html) mandaria:
// `studio.toMsg` o traduz como sempre. Tudo aqui é `func` — desenhar nunca
// altera o estado — e as cores vêm do tema escolhido, pintadas em cada caixa,
// porque o hive.ui não aceita folha de estilo própria.

import hive.ui
import ./model
import ./render
import ./theme
import ./workspace
import ./git
import ./highlight
import ./analysis
import ./keys
import ./i18n
import ./agents
import ./search
import ./complete
import ./settings
import ./version
import ./vim
import ./native.go
import ./jsonview
import ./pty.go

// O que só a janela do hive.ui lembra, fora do estado do Hive Studio: o menu
// aberto na barra de título e o resto, abaixo.
//
// `top` é a primeira linha da vista realçada quando as setas ▲ ▼ a movem (0:
// seguir o cursor); `caret`, `path` e `findSerial` são o que a vista seguia,
// para voltar a seguir o cursor quando ele (ou o documento, ou a busca) muda.
// `client`/`clientSerial` são o comando do menu Editar que o editor faz
// (desfazer, copiar, colar…), uma vez por serial.
type Chrome {
	menu:       Str
	top:        Int
	caret:      Int
	path:       Str
	findSerial: Int
	client:     Str
	clientSerial: Int
	// Ctrl+mouse sobre um nome que tem definição: o trecho dele (-1: nenhum).
	probeFrom:  Int
	probeTo:    Int
	// As seções do controle de código que estão recolhidas.
	hideStaged:  Bool
	hideChanges: Bool
	hideLog:     Bool
	// O editor: as linhas à vista (`first`, `last`), a âncora da seleção, e o
	// pedido de pôr o cursor (`selA`, `selH`), renovado (`selSerial`) quando o
	// texto, o Vim ou a busca o movem — os seriais que o pedido já viu são
	// `seenText`, `seenVim` e `seenFind`.
	first:      Int
	last:       Int
	anchor:     Int
	selA:       Int
	selH:       Int
	selSerial:  Int
	seenText:   Int
	seenVim:    Int
	seenFind:   Int
	// O puxador do painel: a altura de quando o arraste começou (-1: parado)
	// e a de agora.
	dragBase:   Int
	dragHeight: Int
	// O commit da aba de commit, lido do git quando a aba muda.
	commit:     git.Commit
	// Com HIVE_E2E=1 (tools/e2e): um campo escondido por onde o teste manda
	// eventos (`model.Event`) direto à janela.
	e2e:        Bool
}

func emptyChrome(): Chrome {
	return Chrome("", 0, 0, "", 0, "", 0, -1, -1, false, false, false,
		0, 60, 0, 0, 0, 0, -1, -1, -1, -1, 0, noCommit(), false)
}

// ── eventos: os mesmos que a página própria manda ────────────────────────

func event(kind: Str, act: Str, arg: Str, text: Str, caret: Int): model.Cmd {
	return model.Cmd.Ui(encode(model.Event(kind, act, arg, text, caret, -1, 0, -1), hive.json.codec()))
}

// Um clique: `data-act` e `data-arg`.
func act(action: Str, arg: Str): model.Cmd {
	return event("act", action, arg, "", 0)
}

// Um clique que também leva `data-text`.
func actText(action: Str, arg: Str, text: Str): model.Cmd {
	return event("act", action, arg, text, 0)
}

// Um clique com o cursor, para o que depende dele (ir para a definição).
func actCaret(action: Str, caret: Int): model.Cmd {
	return event("act", action, "", "", caret)
}

// Um campo que mudou (`data-input`).
func field(name: Str, text: Str): model.Cmd {
	return event("field", name, "", text, 0)
}

// Uma ação do teclado ou do menu (`data-act="action"`).
func action(name: Str): model.Cmd {
	return act("action", name)
}

// O texto do editor inteiro. O cursor não vem do navegador: `-1` pede que a
// janela o deduza da diferença para o texto anterior.
func edited(text: Str): model.Cmd {
	return event("edit", "", "", text, -1)
}

// Só da janela do hive.ui: abrir e fechar menus, rolar a vista do código.
func chrome(what: Str, arg: Str): model.Cmd {
	return event("chrome", what, arg, "", 0)
}

// ── o teclado, o editor e o mouse ────────────────────────────────────────

// Uma tecla que a janela tomou para si (`ui.keys`): o Esc é o escape da IDE,
// o resto um atalho, que leva o cursor e o texto selecionado (o Ctrl+F busca ele).
func keyCmd(selected: Str, caret: Int, combo: Str): model.Cmd {
	if combo == "Escape" {
		return act("escape", "")
	}
	return event("key", "", selected, combo, caret)
}

// As teclas da janela inteira: os atalhos do mapa e o Esc. Gravando um atalho
// nas Configurações, todas.
func windowKeys(state: model.State): Str[dyn] {
	if state.recording != "" {
		return ["Any"]
	}
	mut all := keys.combos(state.settings.keymap)
	append(all, "Escape")
	return all
}

// Uma edição do editor: o trecho de `from` a `to` virou `text`, sobre o texto
// do serial `serial`.
func editCmd(serial: Int, from: Int, to: Int, text: Str): model.Cmd {
	return model.Cmd.Ui(encode(model.Event("edit", "", text, "", from + len(text), from, to - from, serial), hive.json.codec()))
}

func caretCmd(anchor: Int, head: Int): model.Cmd {
	return event("caret", "", "{anchor}", "", head)
}

func viewCmd(first: Int, last: Int): model.Cmd {
	return chrome("view", "{first},{last}")
}

// Ctrl+clique num nome: ir para a definição.
func jumpCmd(at: Int): model.Cmd {
	return actCaret("definition", at)
}

func probeCmd(at: Int): model.Cmd {
	return chrome("probe", "{at}")
}

// O pedido de foco do programa (`state.focus`), no campo `name`.
func focusOn(state: model.State, name: Str): hive.ui.Attr[dyn] {
	mut hive.ui.Attr[dyn] out = []
	if state.focus == name {
		append(out, ui.focus(state.focusSerial))
	}
	return out
}

func plus(a: hive.ui.Attr[], b: hive.ui.Attr[]): hive.ui.Attr[dyn] {
	mut hive.ui.Attr[dyn] out = []
	for each x in a {
		append(out, x)
	}
	for each x in b {
		append(out, x)
	}
	return out
}

// As teclas que cada campo toma para si, e o que cada uma faz nele.
func fieldKeys(kind: Str, empty: Bool): Str[dyn] {
	if kind == "find" {
		return ["Shift+Enter"]
	} else if kind == "palette" {
		return ["ArrowUp", "ArrowDown"]
	} else if kind == "term" {
		return ["ArrowUp", "ArrowDown", "Ctrl+C"]
	} else if kind == "commit" {
		return ["Ctrl+Enter"]
	} else if kind == "vim" {
		mut Str[dyn] taken = ["ArrowUp", "ArrowDown", "Tab", "Escape", "Ctrl+[", "Ctrl+C"]
		if empty {
			append(taken, "Backspace")
		}
		return taken
	}
	Str[dyn] none = []
	return none
}

func fieldKeyCmd(kind: Str, combo: Str): model.Cmd {
	mut step := "1"
	if combo == "ArrowUp" {
		step = "-1"
	}
	if kind == "find" {
		return act("findPrev", "")
	} else if kind == "palette" {
		return act("paletteMove", step)
	} else if kind == "term" {
		if combo == "Ctrl+C" {
			return act("termRestart", "")
		}
		return act("termHistory", step)
	} else if kind == "commit" {
		return act("gitCommit", "")
	} else if kind == "vim" {
		if combo == "ArrowUp" || combo == "ArrowDown" {
			return act("vimHistory", step)
		} else if combo == "Tab" {
			return chrome("keep", "")
		}
		return act("vimCancel", "")
	}
	return chrome("keep", "")
}

func keyed(kind: Str, empty: Bool): hive.ui.Attr[dyn] {
	return [ui.keys(fieldKeys(kind, empty)), ui.onKey(fieldKeyCmd(kind, _))]
}

// O explorador com o teclado: as setas, o Enter, o F2, o Delete e, no Vim,
// as letras (j, k, gg…) andam pela árvore.
func treeKeys(state: model.State): Str[dyn] {
	mut Str[dyn] taken = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter", "Delete", "F2", "Escape", "Space",
		"Home", "End", "PageUp", "PageDown"]
	if state.settings.vim {
		for each c in split("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$^", "") {
			append(taken, c)
		}
	}
	return taken
}

func treeCmd(combo: Str): model.Cmd {
	return event("tree", "", "", vimName(combo), 0)
}

// A tecla no jeito do Vim: j, $, <Esc>, <C-r>… ("" quando não é do Vim).
func vimName(combo: Str): Str {
	if combo == "Escape" || combo == "Ctrl+[" {
		return "<Esc>"
	}
	named := [["Enter", "<CR>"], ["Backspace", "<BS>"], ["Delete", "<Del>"], ["Tab", "<Tab>"],
		["ArrowLeft", "<Left>"], ["ArrowRight", "<Right>"], ["ArrowUp", "<Up>"], ["ArrowDown", "<Down>"],
		["Home", "<Home>"], ["End", "<End>"], ["PageUp", "<PageUp>"], ["PageDown", "<PageDown>"], ["F2", "<F2>"],
		["Space", "<Space>"]]
	for each pair in named {
		if pair[0] == combo {
			return pair[1]
		}
	}
	if combo is "Ctrl+{key}" {
		if len(key) == 1 {
			return "<C-" + native.lower(key) + ">"
		}
		return ""
	}
	if len(combo) == 1 {
		return combo
	}
	return ""
}

// O que o editor faz com uma tecla que tomou: as setas e o Enter da lista de
// sugestões, e no Vim o resto (no modo de inserção, ele só toma o Esc) — menos
// os atalhos da IDE com Ctrl, Alt ou F.
func editorKeyCmd(selected: Str, caret: Int, popup: Bool, vimOn: Bool, keymap: Str, combo: Str): model.Cmd {
	if popup && (combo == "ArrowUp" || combo == "ArrowDown" || combo == "Enter" || combo == "Tab" || combo == "Escape") {
		return event("popup", "", "", combo, caret)
	}
	if combo == "Ctrl+X" && selected == "" && !vimOn {
		return chrome("cutLine", "")
	}
	if vimOn {
		name := vimName(combo)
		ide := keys.actionFor(keymap, combo) is Result.Ok(_)
		modified := combo is "Ctrl+{rest}" || combo is "Alt+{rest}" || combo is "F{n}"
		mut vimCtrl := true
		if name is "<C-{k}>" {
			vimCtrl = indexOf(["r", "d", "u", "e", "y", "f", "b", "a", "x", "["], k) is Result.Ok(_)
		}
		if name != "" && vimCtrl && !(ide && modified) {
			return event("vim", "", "", name, caret)
		}
	}
	return keyCmd(selected, caret, combo)
}

// As teclas que o editor toma: as da lista de sugestões, aberta; no Vim, fora
// do modo de inserção, todas — e nele, só o Esc.
func editorKeys(state: model.State, selecting: Bool): Str[dyn] {
	mut Str[dyn] taken = []
	if len(state.suggestions) > 0 {
		taken = ["ArrowUp", "ArrowDown", "Enter", "Tab", "Escape"]
	}
	// Ctrl+X sem seleção recorta a linha inteira (a janela sabe se há seleção:
	// ela só toma a tecla quando não há).
	if !state.settings.vim && !selecting {
		append(taken, "Ctrl+X")
	}
	if state.settings.vim && editorShown(state) {
		if state.vim.mode == model.VimMode.InsertMode() {
			append(taken, "Escape")
			append(taken, "Ctrl+[")
		} else {
			taken = ["Any"]
		}
	}
	return taken
}

// As cores do editor nas linhas perto das que estão à vista: o realce, as
// ocorrências da busca e o Error Lens (sublinhado e marca na margem).
func editorRuns(state: model.State, t: theme.Theme, doc: model.Doc, first: Int, last: Int): hive.ui.Run[dyn] {
	mut hive.ui.Run[dyn] runs = []
	// Só as linhas perto das que estão à vista: o resto do arquivo nem é partido.
	low := maxInt(0, first - 40)
	window := native.lines(doc.text, low, last + 40)
	mut start := 0
	if window bounds 0 {
		start = numberOr(window[0], 0)
	}
	mut at := start
	for k := 1; k < len(window); k++ {
		if window bounds k {
			for each token in tokensOf(lineHtmlOf(doc, window[k], low + k - 1)) {
				size := len(token.text)
				if token.cls != "" {
					append(runs, ui.ink(at, at + size, hex(tokenColor(t, token.cls))))
				}
				at = at + size
			}
			at = at + 1
		}
	}
	if state.find.open && state.find.text != "" {
		matches := render.findMatches(doc.text, state.find)
		size := len(state.find.text)
		for i := 0; i < len(matches); i++ {
			if matches bounds i {
				if matches[i] + size >= start && matches[i] <= at {
					mut color := t.input
					if i == state.find.index {
						color = t.selection
					}
					append(runs, ui.shade(matches[i], matches[i] + size, hex(color)))
				}
			}
		}
	}
	for each lens in lensRuns(state, t, doc) {
		append(runs, lens)
	}
	return runs
}

// O HTML realçado de uma linha (`index` a partir de 0) do documento.
func lineHtmlOf(doc: model.Doc, line: Str, index: Int): Str {
	lang := model.language(doc.path)
	if lang == "hive" {
		return highlight.highlightLine(line, highlight.carryAt(doc.hl, index - 1)).html
	}
	return highlight.plainLine(line, lang)
}

// O Error Lens: a linha de cada erro (ou aviso) com o fundo tingido, a
// mensagem depois do fim dela e a marca na margem. A marca segue a linha pelo
// texto que ela tinha no check (linhas entraram ou saíram antes dela), e some
// se a linha foi editada — até o próximo check.
func lensRuns(state: model.State, t: theme.Theme, doc: model.Doc): hive.ui.Run[dyn] {
	mut hive.ui.Run[dyn] runs = []
	marks := render.lensMarks(state)
	if len(marks) == 0 {
		return runs
	}
	mut Int[dyn] rows = []
	mut Str[dyn] sources = []
	for each mark in marks {
		append(rows, mark.line - 1)
		append(sources, mark.source)
	}
	placed := native.relocate(doc.text, rows, sources, 300)
	mut Int[dyn] shown = []
	for i := 0; i < len(marks); i++ {
		if placed bounds i && marks bounds i {
			row := placed[i]
			if row >= 0 && indexOf(shown, row) is Result.Error(_) {
				append(shown, row)
				// Todas as mensagens da linha juntas; um erro vence um aviso.
				mut error := false
				mut Str[dyn] messages = []
				for j := 0; j < len(marks); j++ {
					if placed bounds j && marks bounds j {
						if placed[j] == row {
							append(messages, marks[j].message)
							error = error || marks[j].severity == "error"
						}
					}
				}
				mut color := t.warn
				mut tint := "1a"
				if error {
					color = t.danger
					tint = "24"
				}
				mut text := join(messages, "  ·  ")
				if len(text) > 240 {
					text = complete.take(text, 240) + "…"
				}
				append(runs, ui.band(row, hex(color + tint)))
				append(runs, ui.note(row, text, hex(color)))
				append(runs, ui.marker(row, hex(color)))
			}
		}
	}
	return runs
}

// O editor: o texto do documento, colorido, com o cursor que o programa pediu.
func codeEditor(state: model.State, t: theme.Theme, doc: model.Doc, extra: Chrome): hive.ui.View {
	selected := native.slice(doc.text, minInt(extra.anchor, state.caret), maxInt(extra.anchor, state.caret) - minInt(extra.anchor, state.caret))
	popup := len(state.suggestions) > 0
	vimOn := state.settings.vim
	mut attrs := plus(paneLook(), [ui.grow(1), fill(t.editor), tone(t.text),
		ui.numbers(state.settings.lineNumbers), ui.tabSize(state.settings.tabSize), ui.fontSize(state.settings.fontSize),
		ui.caret(extra.selA, extra.selH, extra.selSerial), ui.perform(extra.client, extra.clientSerial),
		ui.onEdit(editCmd(state.textSerial, _, _, _)), ui.onCaret(caretCmd(_, _)), ui.onView(viewCmd(_, _)),
		ui.onJump(jumpCmd(_)), ui.onProbe(probeCmd(_)),
		ui.keys(editorKeys(state, extra.anchor != state.caret)), ui.onKey(editorKeyCmd(selected, state.caret, popup, vimOn, state.settings.keymap, _))])
	if state.focus == "editor" {
		append(attrs, ui.focus(state.focusSerial))
	}
	mut runs := editorRuns(state, t, doc, extra.first, extra.last)
	if extra.probeFrom >= 0 && extra.probeTo > extra.probeFrom {
		append(runs, ui.ink(extra.probeFrom, extra.probeTo, hex(t.accent)))
		append(runs, ui.underline(extra.probeFrom, extra.probeTo, hex(t.accent)))
	}
	return ui.code(attrs, doc.text, runs)
}

// ── cores e peças ────────────────────────────────────────────────────────

func tx(state: model.State, text: Str): Str {
	return render.tx(state, text)
}

func hex(color: Str): hive.ui.Tone {
	return ui.Tone.HEX(color)
}

func tone(color: Str): hive.ui.Attr {
	return ui.tone(hex(color))
}

func fill(color: Str): hive.ui.Attr {
	return ui.background(hex(color))
}

func label(color: Str, content: Str): hive.ui.View {
	return ui.text([tone(color)], content)
}

func small(color: Str, content: Str): hive.ui.View {
	return ui.text([tone(color), ui.size(ui.TextSize.Caption())], content)
}

func strong(color: Str, content: Str): hive.ui.View {
	return ui.text([tone(color), ui.size(ui.TextSize.Subtitle())], content)
}

// Um texto clicável na cor dada (o link do hive.ui vem na cor de destaque).
// O fundo de tudo o que se clica, sob o mouse: um cinza meio transparente,
// que aparece igual nos temas claros e escuros.
func hoverTone(): hive.ui.Tone {
	return hex("#80808030")
}

func lit(): hive.ui.Attr[dyn] {
	return [ui.hover(hoverTone()), ui.radius(4)]
}

func clickable(color: Str, content: Str, message: model.Cmd, tip: Str): hive.ui.View {
	return ui.link([ui.on(message), tone(color), ui.hint(tip), ui.hover(hoverTone()), ui.radius(4)], "#", content)
}

// Um link dentro de uma linha que acende inteira (do explorador, de um menu,
// uma aba): ele não acende sozinho.
func plainLink(color: Str, content: Str, message: model.Cmd, tip: Str): hive.ui.View {
	return ui.link([ui.on(message), tone(color), ui.hint(tip)], "#", content)
}

// Os botões e os campos no jeito da janela própria: cantos pequenos, sem o
// anel de foco do hive.ui; um campo com a borda fina do tema, e um botão
// sem borda (ele já tem a cor dele).
func buttonLook(): hive.ui.Attr[dyn] {
	return [ui.radius(4), ui.ring(false)]
}

func fieldLook(t: theme.Theme): hive.ui.Attr[dyn] {
	return [ui.radius(4), ui.ring(false), ui.border(1), ui.borderTone(hex(t.border))]
}

// Um editor, um terminal ou a Saída: rente à caixa, sem borda nem anel.
func paneLook(): hive.ui.Attr[dyn] {
	return [ui.radius(0), ui.ring(false), ui.border(0)]
}

func button(t: theme.Theme, content: Str, message: model.Cmd, enabled: Bool): hive.ui.View {
	return ui.button(plus(buttonLook(), [ui.on(message), ui.disabled(!enabled), fill(t.button), tone(t.buttonText)]), content)
}

func primary(t: theme.Theme, content: Str, message: model.Cmd, enabled: Bool): hive.ui.View {
	return ui.button(plus(buttonLook(), [ui.on(message), ui.disabled(!enabled), fill(t.accent), tone(t.statusFg)]), content)
}

func danger(t: theme.Theme, content: Str, message: model.Cmd): hive.ui.View {
	return ui.button(plus(buttonLook(), [ui.on(message), fill(t.danger), tone("#ffffff")]), content)
}

// Uma ação pequena de cabeçalho (＋, ⟳, ✕…), com a dica ao passar o mouse.
func headerAction(t: theme.Theme, glyph: Str, tip: Str, message: model.Cmd): hive.ui.View {
	return iconButton(t, actionIcon(glyph, tip), glyph, tip, message, 26, 16)
}

// A mesma ação dentro de uma linha (do controle de código, do explorador):
// menor, para a linha não crescer.
func rowAction(t: theme.Theme, glyph: Str, tip: Str, message: model.Cmd): hive.ui.View {
	return iconButton(t, actionIcon(glyph, tip), glyph, tip, message, 22, 14)
}

// O ícone desenhado de uma ação pequena, pelo símbolo que ela sempre teve —
// e, quando o mesmo símbolo serve a duas (↑ é Push e é a pasta acima), pela dica.
func actionIcon(glyph: Str, tip: Str): Str {
	if glyph == "⟳" || glyph == "↻" {
		return "refresh"
	} else if glyph == "↓" && tip == "Pull" {
		return "pull"
	} else if glyph == "↑" && tip == "Push" {
		return "push"
	} else if glyph == "↑" && indexOf(tip, "Pasta acima") is Result.Ok(_) {
		return "parent"
	} else if glyph == "↑" {
		return "up"
	} else if glyph == "↓" {
		return "down"
	} else if glyph == "＋" {
		return "newFile"
	} else if glyph == "⊞" {
		return "newFolder"
	} else if glyph == "🗑" {
		return "trash"
	} else if glyph == "⊟" {
		return "collapse"
	} else if glyph == "…" {
		return "openFolder"
	} else if glyph == "✕" || glyph == "×" {
		return "close"
	} else if glyph == "✓" {
		return "check"
	} else if glyph == "⋯" {
		return "more"
	} else if glyph == "⌫" {
		return "clear"
	} else if glyph == "■" {
		return "stop"
	} else if glyph == "⤢" {
		return "maximize"
	} else if glyph == "⤡" {
		return "restore"
	} else if glyph == "−" {
		return "minus"
	} else if glyph == "+" {
		return "plus"
	} else if glyph == "±" {
		return "diff"
	} else if glyph == "↺" {
		return "discard"
	} else if glyph == "⧉" {
		return "external"
	} else if glyph == "↵" {
		return "enter"
	}
	return ""
}

// Um botão quadrado com o ícone no meio, que acende sob o mouse. Sem ícone
// desenhado para o símbolo, o símbolo mesmo, centrado.
func iconButton(t: theme.Theme, name: Str, glyph: Str, tip: Str, message: model.Cmd, box: Int, size: Int): hive.ui.View {
	mut inside := label(t.muted, glyph)
	if name != "" {
		inside = ui.canvas([ui.region(0.0, 0.0, 24.0, 24.0), ui.width(size), ui.height(size)], actionMarks(name, t.muted))
	}
	return ui.row([ui.width(box), ui.height(box), ui.align(ui.Align.Center()), ui.justify(ui.Justify.Center()),
		ui.on(message), ui.hover(hoverTone()), ui.radius(4), ui.hint(tip)], [inside])
}

func line(color: Str, points: Float[]): hive.ui.Mark {
	return ui.path([ui.paint(hex(color)), ui.thick(2.0)], points)
}

// Uma volta de r em torno de (cx, cy), de um ângulo ao outro, com a ponta de
// seta no fim (o sentido em que ela anda).
func arrowArc(color: Str, cx: Float, cy: Float, r: Float, from: Float, to: Float): hive.ui.Mark[dyn] {
	ex := cx + r * hive.math.cos(to)
	ey := cy + r * hive.math.sin(to)
	mut dx := 0.0 - hive.math.sin(to)
	mut dy := hive.math.cos(to)
	if to < from {
		dx = 0.0 - dx
		dy = 0.0 - dy
	}
	nx := hive.math.cos(to)
	ny := hive.math.sin(to)
	return [
		line(color, circle(cx, cy, r, from, to)),
		line(color, [ex - 3.6 * dx + 2.8 * nx, ey - 3.6 * dy + 2.8 * ny, ex, ey, ex - 3.6 * dx - 2.8 * nx, ey - 3.6 * dy - 2.8 * ny])
	]
}

func actionMarks(name: Str, c: Str): hive.ui.Mark[dyn] {
	folder := [3.0, 5.0, 9.0, 5.0, 11.0, 7.5, 21.0, 7.5, 21.0, 19.0, 3.0, 19.0, 3.0, 5.0]
	if name == "refresh" {
		return arrowArc(c, 12.0, 12.0, 7.5, 0.9, 5.9)
	} else if name == "discard" {
		return arrowArc(c, 12.0, 12.0, 7.5, 6.9, 2.2)
	} else if name == "pull" {
		return [line(c, [12.0, 4.0, 12.0, 15.0]), line(c, [7.5, 10.5, 12.0, 15.0, 16.5, 10.5]), line(c, [5.0, 20.0, 19.0, 20.0])]
	} else if name == "push" {
		return [line(c, [12.0, 20.0, 12.0, 9.0]), line(c, [7.5, 13.5, 12.0, 9.0, 16.5, 13.5]), line(c, [5.0, 4.0, 19.0, 4.0])]
	} else if name == "up" || name == "parent" {
		return [line(c, [12.0, 19.0, 12.0, 6.0]), line(c, [7.0, 11.0, 12.0, 6.0, 17.0, 11.0])]
	} else if name == "down" {
		return [line(c, [12.0, 5.0, 12.0, 18.0]), line(c, [7.0, 13.0, 12.0, 18.0, 17.0, 13.0])]
	} else if name == "newFile" {
		return [line(c, [5.0, 3.0, 13.0, 3.0, 18.0, 8.0, 18.0, 21.0, 5.0, 21.0, 5.0, 3.0]), line(c, [13.0, 3.0, 13.0, 8.0, 18.0, 8.0]),
			line(c, [8.5, 15.0, 14.5, 15.0]), line(c, [11.5, 12.0, 11.5, 18.0])]
	} else if name == "newFolder" {
		return [line(c, folder), line(c, [9.0, 13.5, 15.0, 13.5]), line(c, [12.0, 10.5, 12.0, 16.5])]
	} else if name == "openFolder" {
		return [line(c, folder), line(c, [3.0, 11.0, 21.0, 11.0])]
	} else if name == "trash" {
		return [line(c, [4.0, 6.5, 20.0, 6.5]), line(c, [9.0, 6.5, 9.0, 4.0, 15.0, 4.0, 15.0, 6.5]),
			line(c, [6.0, 6.5, 7.0, 20.0, 17.0, 20.0, 18.0, 6.5]), line(c, [10.0, 10.0, 10.0, 16.5]), line(c, [14.0, 10.0, 14.0, 16.5])]
	} else if name == "collapse" {
		return [line(c, [4.0, 4.0, 20.0, 4.0, 20.0, 20.0, 4.0, 20.0, 4.0, 4.0]), line(c, [8.0, 12.0, 16.0, 12.0])]
	} else if name == "close" {
		return [line(c, [6.5, 6.5, 17.5, 17.5]), line(c, [17.5, 6.5, 6.5, 17.5])]
	} else if name == "check" {
		return [line(c, [5.0, 12.5, 10.0, 17.5, 19.0, 7.0])]
	} else if name == "more" {
		return [ui.dot([ui.paint(hex(c))], 6.0, 12.0, 1.7), ui.dot([ui.paint(hex(c))], 12.0, 12.0, 1.7), ui.dot([ui.paint(hex(c))], 18.0, 12.0, 1.7)]
	} else if name == "clear" {
		return [line(c, [4.0, 7.0, 20.0, 7.0]), line(c, [4.0, 12.0, 13.0, 12.0]), line(c, [4.0, 17.0, 10.0, 17.0]),
			line(c, [15.0, 14.0, 20.0, 19.0]), line(c, [20.0, 14.0, 15.0, 19.0])]
	} else if name == "stop" {
		return [ui.patch([ui.paint(hex(c))], [7.0, 7.0, 17.0, 7.0, 17.0, 17.0, 7.0, 17.0])]
	} else if name == "maximize" {
		return [line(c, [4.0, 9.0, 4.0, 4.0, 9.0, 4.0]), line(c, [15.0, 4.0, 20.0, 4.0, 20.0, 9.0]),
			line(c, [20.0, 15.0, 20.0, 20.0, 15.0, 20.0]), line(c, [9.0, 20.0, 4.0, 20.0, 4.0, 15.0])]
	} else if name == "restore" {
		return [line(c, [9.0, 4.0, 9.0, 9.0, 4.0, 9.0]), line(c, [20.0, 9.0, 15.0, 9.0, 15.0, 4.0]),
			line(c, [15.0, 20.0, 15.0, 15.0, 20.0, 15.0]), line(c, [4.0, 15.0, 9.0, 15.0, 9.0, 20.0])]
	} else if name == "minus" {
		return [line(c, [6.0, 12.0, 18.0, 12.0])]
	} else if name == "plus" {
		return [line(c, [6.0, 12.0, 18.0, 12.0]), line(c, [12.0, 6.0, 12.0, 18.0])]
	} else if name == "diff" {
		return [line(c, [12.0, 4.0, 12.0, 12.0]), line(c, [8.0, 8.0, 16.0, 8.0]), line(c, [8.0, 17.0, 16.0, 17.0])]
	} else if name == "external" {
		return [line(c, [8.0, 4.0, 20.0, 4.0, 20.0, 16.0, 8.0, 16.0, 8.0, 4.0]), line(c, [4.0, 8.0, 4.0, 20.0, 16.0, 20.0])]
	} else if name == "enter" {
		return [line(c, [19.0, 5.0, 19.0, 13.0, 6.0, 13.0]), line(c, [10.0, 9.0, 6.0, 13.0, 10.0, 17.0])]
	}
	hive.ui.Mark[dyn] none = []
	return none
}

func header(t: theme.Theme, title: Str, actions: hive.ui.View[]): hive.ui.View {
	mut hive.ui.View[dyn] items = [small(t.muted, title), ui.spacer()]
	for each a in actions {
		append(items, a)
	}
	return ui.row([ui.gap(2), ui.pad(6), ui.align(ui.Align.Center())], items)
}

func empty(t: theme.Theme, content: Str): hive.ui.View {
	return ui.row([ui.pad(8)], [small(t.muted, content)])
}

func spaceOf(width: Int): hive.ui.View {
	return ui.row([ui.width(width)], [])
}

func rule(t: theme.Theme): hive.ui.View {
	return ui.row([ui.height(1), fill(t.border)], [])
}

func inputField(t: theme.Theme, attrs: hive.ui.Attr[], value: Str): hive.ui.View {
	mut all := plus(fieldLook(t), [fill(t.input), tone(t.text)])
	for each a in attrs {
		append(all, a)
	}
	return ui.input(all, value)
}

func gitColor(t: theme.Theme, kind: Str): Str {
	css := git.cssOf(kind)
	if css == "g-new" {
		return t.gitNew
	} else if css == "g-mod" {
		return t.gitMod
	} else if css == "g-del" {
		return t.danger
	}
	return t.text
}

func fileIcon(name: Str): hive.ui.View {
	icon := theme.iconFor(name)
	return ui.row([ui.width(20), ui.justify(ui.Justify.Center())], [label(icon.color, icon.glyph)])
}

// ── barra de título e menus ──────────────────────────────────────────────

// Uma entrada de menu: o rótulo, o atalho e o que ela faz.
type Entry {
	label:   Str
	keys:    Str
	message: model.Cmd
	enabled: Bool
}

func item(state: model.State, text: Str, name: Str, enabled: Bool): Entry {
	return Entry(tx(state, text), keys.keysFor(state.settings.keymap, name), action(name), enabled)
}

func plain(state: model.State, text: Str, name: Str): Entry {
	return Entry("   " + text, keys.keysFor(state.settings.keymap, name), action(name), true)
}

func checked(state: model.State, text: Str, name: Str, on: Bool): Entry {
	mut mark := ""
	if on {
		mark = "✓ "
	}
	return Entry(mark + tx(state, text), keys.keysFor(state.settings.keymap, name), action(name), true)
}

// Um item que a página resolve no editor (desfazer, copiar…): o programa
// só passa o pedido à ponte.
func clientItem(state: model.State, text: Str, command: Str, hint: Str, enabled: Bool): Entry {
	return Entry(tx(state, text), hint, chrome("client", command), enabled)
}

// Um separador entre grupos do menu.
func gap(): Entry {
	return Entry("", "", chrome("menu", ""), false)
}

func menuEntries(state: model.State, name: Str): Entry[dyn] {
	ready := state.running == "" && render.targetOf(state) != ""
	hasDoc := render.activeDoc(state) is Result.Ok(_)
	canClose := hasDoc || state.settingsOpen || state.commit.key != ""
	path := render.activePath(state)
	isHiveDoc := hasDoc && path is "{stem}.hive"
	mut Entry[dyn] items = []
	if name == "Arquivo" {
		items = [
			item(state, "Novo arquivo", "newFile", true),
			item(state, "Nova pasta", "newFolder", true),
			gap(),
			item(state, "Abrir arquivo…", "openFile", true),
			item(state, "Abrir pasta…", "openFolder", true),
			gap(),
			item(state, "Salvar", "save", hasDoc),
			item(state, "Salvar tudo", "saveAll", model.anyDirty(state.docs)),
			gap(),
			item(state, "Configurações", "settings", true),
			gap(),
			item(state, "Excluir arquivo ou pasta", "deleteFile", render.removable(state) != ""),
			gap(),
			item(state, "Fechar aba", "closeTab", canClose),
			item(state, "Sair", "quit", true)
		]
	} else if name == "Editar" {
		items = [
			clientItem(state, "Desfazer", "undo", "Ctrl+Z", hasDoc),
			clientItem(state, "Refazer", "redo", "Ctrl+Y", hasDoc),
			gap(),
			clientItem(state, "Recortar", "cut", "Ctrl+X", hasDoc),
			clientItem(state, "Copiar", "copy", "Ctrl+C", hasDoc),
			clientItem(state, "Colar", "paste", "Ctrl+V", hasDoc),
			gap(),
			clientItem(state, "Selecionar tudo", "selectAll", "Ctrl+A", hasDoc),
			gap(),
			item(state, "Buscar no arquivo", "find", hasDoc),
			item(state, "Buscar no projeto", "searchProject", true),
			item(state, "Ir para arquivo…", "quickOpen", true),
			gap(),
			item(state, "Sugestões (autocomplete)", "suggest", hasDoc),
			item(state, "Ir para a definição", "definition", hasDoc),
			gap(),
			checked(state, "Modo Vim", "toggleVim", state.settings.vim)
		]
	} else if name == "Ver" {
		items = [
			item(state, "Explorador", "explorer", true),
			item(state, "Buscar", "searchProject", true),
			item(state, "Controle de código", "git", true),
			item(state, "Estrutura", "outline", true),
			item(state, "TODO", "todo", true),
			gap(),
			item(state, "Mostrar/ocultar barra lateral", "toggleSidebar", true),
			item(state, "Mostrar/ocultar painel (Problemas, Saída)", "togglePanel", true),
			item(state, "Maximizar/restaurar painel", "maximizePanel", true),
			gap(),
			item(state, "Problemas", "problems", true),
			item(state, "Saída", "output", true),
			item(state, "Terminal", "terminal", true),
			gap(),
			item(state, "Preview do Markdown", "preview", hasDoc && model.hasPreview(path)),
			item(state, "Tema de cor…", "colorTheme", true)
		]
	} else if name == "Executar" {
		items = [
			item(state, "Check", "check", ready),
			item(state, "Run", "run", ready),
			item(state, "Test", "test", ready),
			item(state, "Build", "build", ready),
			item(state, "Analyze", "analyze", ready),
			gap(),
			item(state, "Fixar arquivo atual como entrada", "pin", isHiveDoc)
		]
	} else if name == "Terminal" {
		items = [
			item(state, "Novo terminal", "newTerminal", true),
			item(state, "Terminal", "terminal", true),
			gap(),
			item(state, "Limpar terminal", "termClear", true),
			item(state, "Encerrar processo", "termRestart", state.term.session != 0),
			gap(),
			item(state, "Agente", "agent", true),
			plain(state, "Claude Code", "agentClaude"),
			plain(state, "Codex", "agentCodex"),
			plain(state, "OpenCode", "agentOpencode")
		]
	} else if name == "Ajuda" {
		items = [
			item(state, "Documentação do Hive", "docs", true),
			item(state, "Atalhos de teclado", "settings", true),
			gap(),
			item(state, "Sobre o Hive Studio", "about", true)
		]
	}
	return items
}

func menuNames(): Str[dyn] {
	return ["Arquivo", "Editar", "Ver", "Executar", "Terminal", "Ajuda"]
}

func menuRow(t: theme.Theme, entry: Entry): hive.ui.View {
	if entry.label == "" {
		return rule(t)
	}
	mut color := t.text
	if !entry.enabled {
		color = t.muted
	}
	mut name := label(color, entry.label)
	mut hive.ui.Attr[dyn] box = [ui.gap(24), ui.pad(4), ui.align(ui.Align.Center())]
	if entry.enabled {
		name = plainLink(color, entry.label, entry.message, "")
		box = plus(box, plus(lit(), [ui.on(entry.message)]))
	}
	return ui.row(box, [name, ui.spacer(), small(t.muted, entry.keys)])
}

// O menu aberto, preso no canto de cima, abaixo da barra de título.
func menuDrop(state: model.State, t: theme.Theme, open: Str): hive.ui.View {
	if open == "" {
		return ui.none()
	}
	mut hive.ui.View[dyn] rows = [
		ui.row([ui.pad(4), ui.align(ui.Align.Center())], [clickable(t.accent, tx(state, open) + "  ▴", chrome("menu", ""), tx(state, "Fechar")), ui.spacer()]),
		rule(t)
	]
	for each entry in menuEntries(state, open) {
		append(rows, menuRow(t, entry))
	}
	return ui.overlay([ui.align(ui.Align.Start()), ui.justify(ui.Justify.Start())],
		ui.row([], [
			spaceOf(menuOffset(state, open)),
			ui.column([ui.width(360), ui.pad(8), ui.gap(2), fill(t.panel), tone(t.text)], rows)
		]))
}

// Mais ou menos onde o rótulo do menu fica na barra de título, para o menu
// abrir embaixo dele (o hive.ui não diz onde um widget foi parar).
func menuOffset(state: model.State, open: Str): Int {
	mut at := 14
	for each name in menuNames() {
		if name == open {
			return at
		}
		at = at + len(tx(state, name)) * 8 + 14
	}
	return at
}

func toolButton(state: model.State, t: theme.Theme, text: Str, command: Str, ready: Bool): hive.ui.View {
	return ui.button(plus(buttonLook(), [ui.on(act("invoke", command)), ui.disabled(!ready), fill(t.button), tone(t.buttonText),
		ui.hint(tx(state, command) + render.keyHint(state, command))]), text)
}

func titleBar(state: model.State, t: theme.Theme, open: Str): hive.ui.View {
	idle := state.running == ""
	ready := idle && render.targetOf(state) != ""
	mut hive.ui.View[dyn] items = [label(t.accent, "⬡")]
	for each name in menuNames() {
		mut color := t.text
		mut next := name
		if name == open {
			color = t.accent
			next = ""
		}
		append(items, clickable(color, tx(state, name), chrome("menu", next), ""))
	}
	mut caption := workspace.baseName(state.root)
	if render.activeDoc(state) is Result.Ok(doc) {
		caption = doc.name + " — " + caption
	}
	append(items, ui.spacer())
	append(items, small(t.muted, caption))
	append(items, ui.spacer())
	if !idle {
		append(items, ui.spinner([]))
		append(items, small(t.muted, state.running + "…"))
	}
	append(items, toolButton(state, t, "Check", "check", ready))
	append(items, toolButton(state, t, "▶ Run", "run", ready))
	append(items, toolButton(state, t, "Test", "test", ready))
	append(items, toolButton(state, t, "Build", "build", ready))
	append(items, toolButton(state, t, "Analyze", "analyze", ready))
	return ui.row([ui.gap(14), ui.pad(6), ui.align(ui.Align.Center()), fill(t.titleBar)], items)
}

// ── barra de atividades ──────────────────────────────────────────────────

// ── os ícones ────────────────────────────────────────────────────────────
//
// Desenhados num quadro de 24 × 24 com traços de 1,6, como os da janela
// própria: todos do mesmo tamanho, na cor que o estado dá a eles.

func circle(cx: Float, cy: Float, r: Float, from: Float, to: Float): Float[dyn] {
	mut Float[dyn] points = []
	steps := 28
	for i := 0; i <= steps; i++ {
		angle := from + (to - from) * hive.conv.itf(i) / hive.conv.itf(steps)
		append(points, cx + r * hive.math.cos(angle))
		append(points, cy + r * hive.math.sin(angle))
	}
	return points
}

func stroke(color: Str, points: Float[]): hive.ui.Mark {
	return ui.path([ui.paint(hex(color)), ui.thick(1.6)], points)
}

func iconMarks(name: Str, color: Str): hive.ui.Mark[dyn] {
	full := 6.2832
	if name == "explorer" {
		return [
			stroke(color, [9.0, 3.0, 15.0, 3.0, 20.0, 8.0, 20.0, 18.0, 9.0, 18.0, 9.0, 3.0]),
			stroke(color, [15.0, 3.0, 15.0, 8.0, 20.0, 8.0]),
			stroke(color, [5.0, 7.0, 5.0, 22.0, 16.0, 22.0])
		]
	} else if name == "search" {
		return [stroke(color, circle(10.5, 10.5, 6.5, 0.0, full)), stroke(color, [15.3, 15.3, 21.0, 21.0])]
	} else if name == "git" {
		return [
			stroke(color, circle(6.0, 5.0, 2.3, 0.0, full)),
			stroke(color, circle(6.0, 19.0, 2.3, 0.0, full)),
			stroke(color, circle(18.0, 7.0, 2.3, 0.0, full)),
			stroke(color, [6.0, 7.3, 6.0, 16.7]),
			stroke(color, [18.0, 9.3, 18.0, 11.0, 16.5, 13.5, 8.0, 16.2])
		]
	} else if name == "outline" {
		return [
			ui.dot([ui.paint(hex(color))], 4.5, 6.0, 1.3), stroke(color, [8.5, 6.0, 20.0, 6.0]),
			ui.dot([ui.paint(hex(color))], 4.5, 12.0, 1.3), stroke(color, [8.5, 12.0, 20.0, 12.0]),
			ui.dot([ui.paint(hex(color))], 4.5, 18.0, 1.3), stroke(color, [8.5, 18.0, 20.0, 18.0])
		]
	} else if name == "todo" {
		return [
			stroke(color, [4.0, 4.0, 20.0, 4.0, 20.0, 20.0, 4.0, 20.0, 4.0, 4.0]),
			stroke(color, [8.0, 12.2, 11.0, 15.2, 16.5, 8.8])
		]
	}
	// A engrenagem: oito dentes em volta de um furo.
	mut Float[dyn] teeth = []
	for i := 0; i <= 32; i++ {
		angle := full * hive.conv.itf(i) / 32.0
		mut r := 7.2
		if (i / 2) % 2 == 0 {
			r = 9.4
		}
		append(teeth, 12.0 + r * hive.math.cos(angle))
		append(teeth, 12.0 + r * hive.math.sin(angle))
	}
	return [stroke(color, teeth), stroke(color, circle(12.0, 12.0, 3.0, 0.0, full))]
}

func icon(name: Str, color: Str): hive.ui.View {
	return ui.canvas([ui.region(0.0, 0.0, 24.0, 24.0), ui.width(24), ui.height(24)], iconMarks(name, color))
}

// Um item da barra de atividades: o ícone, aceso e com a marca à esquerda
// quando o painel dele está aberto, e a contagem (git, TODO) num selo.
func activityItem(state: model.State, t: theme.Theme, iconName: Str, tip: Str, on: Bool, message: model.Cmd, count: Int): hive.ui.View {
	mut color := t.muted
	mut mark := t.activity
	if on {
		color = t.text
		mark = t.accent
	}
	mut hive.ui.View[dyn] inside = [icon(iconName, color)]
	if count > 0 {
		mut shown := "{count}"
		if count > 99 {
			shown = "99+"
		}
		append(inside, ui.text([tone(t.accent), ui.size(ui.TextSize.Caption())], shown))
	}
	return ui.row([ui.height(44), ui.align(ui.Align.Stretch()), ui.on(message), ui.hover(hoverTone()), ui.hint(tip)], [
		ui.column([ui.width(2), fill(mark)], []),
		ui.column([ui.grow(1), ui.align(ui.Align.Center()), ui.justify(ui.Justify.Center()), ui.gap(0)], inside)
	])
}

func activityBar(state: model.State, t: theme.Theme): hive.ui.View {
	return ui.column([ui.width(48), fill(t.activity), ui.gap(2)], [
		activityItem(state, t, "explorer", tx(state, "Explorador") + render.keyHint(state, "explorer"),
			state.sideOpen && state.side == model.SideView.ExplorerSide(), act("side", "explorer"), 0),
		activityItem(state, t, "search", tx(state, "Buscar") + render.keyHint(state, "searchProject"),
			state.sideOpen && state.side == model.SideView.SearchSide(), act("side", "search"), 0),
		activityItem(state, t, "git", tx(state, "Controle de código") + render.keyHint(state, "git"),
			state.sideOpen && state.side == model.SideView.GitSide(), act("side", "git"), len(state.git.files)),
		activityItem(state, t, "outline", tx(state, "Estrutura") + render.keyHint(state, "outline"),
			state.sideOpen && state.side == model.SideView.OutlineSide(), act("side", "outline"), 0),
		activityItem(state, t, "todo", "TODO" + render.keyHint(state, "todo"),
			state.sideOpen && state.side == model.SideView.TodoSide(), act("side", "todo"), len(state.todos)),
		ui.spacer(),
		activityItem(state, t, "settings", tx(state, "Configurações") + render.keyHint(state, "settings"),
			render.showingSettings(state), act("settings", ""), 0)
	])
}

// ── explorador ───────────────────────────────────────────────────────────

func promptRow(state: model.State, t: theme.Theme): hive.ui.View {
	if state.prompt is model.Prompt.NoPrompt {
		return ui.none()
	}
	return ui.row([ui.gap(6), ui.pad(6), ui.align(ui.Align.Center())], [
		ui.column([ui.grow(1)], [
			inputField(t, plus(focusOn(state, "prompt"), [ui.onInput(field("prompt", _)), ui.onSubmit(actText("promptSubmit", "", _)),
				ui.placeholder(render.promptPlaceholder(state, state.prompt))]), state.promptText)
		]),
		headerAction(t, "✓", tx(state, "Confirmar (Enter)"), actText("promptSubmit", "", state.promptText)),
		headerAction(t, "✕", tx(state, "Cancelar (Esc)"), act("promptCancel", ""))
	])
}

// O espaço entre as peças da linha selecionada do explorador: um a mais que o
// das outras, e é por ele que a ponte acha a linha (para destacá-la quando o
// explorador tem o foco do teclado, e para rolá-la para a vista).
func selectedGap(): Int {
	return 5
}

func treeRow(state: model.State, t: theme.Theme, row: model.TreeRow): hive.ui.View {
	entry := row.entry
	current := entry.path == render.activePath(state) && render.showsDoc(state)
	mut gapSize := 4
	if entry.path == state.selected {
		gapSize = selectedGap()
	}
	mut opens := act("open", entry.path)
	if entry.folder {
		opens = act("toggle", entry.path)
	}
	mut box := plus(lit(), [ui.gap(gapSize), ui.align(ui.Align.Center()), ui.on(opens), ui.onMenu(actText("context", entry.path, "0,0"))])
	if current {
		append(box, fill(t.selection))
	} else if entry.path == state.selected {
		append(box, fill(t.input))
	}
	indent := spaceOf(6 + row.depth * 14)
	more := rowAction(t, "⋯", tx(state, "Mais ações"), actText("context", entry.path, "0,0"))
	if entry.folder {
		mut chevron := "›"
		if row.open {
			chevron = "⌄"
		}
		kind := git.folderKind(state.git, render.relPath(state, entry.path))
		mut dot := ui.none()
		if kind != "" {
			dot = label(gitColor(t, kind), "•")
		}
		return ui.row(box, [
			indent,
			ui.row([ui.width(20), ui.justify(ui.Justify.Center())], [plainLink(t.muted, chevron, act("toggle", entry.path), "")]),
			plainLink(gitColor(t, kind), entry.name, act("toggle", entry.path), entry.path),
			dot, ui.spacer(), more
		])
	}
	mut marker := ui.none()
	if render.dirtyPath(state, entry.path) {
		marker = label(t.text, "●")
	}
	mut badge := ui.none()
	rel := render.relPath(state, entry.path)
	for each file in state.git.files {
		if file.rel == rel {
			kind := git.kindOf(file)
			badge = small(gitColor(t, kind), git.badge(kind, file))
		}
	}
	return ui.row(box, [
		indent, spaceOf(20), fileIcon(entry.name),
		plainLink(gitColor(t, render.gitKindOf(state, entry.path)), entry.name, act("open", entry.path), entry.path),
		marker, ui.spacer(), badge, more
	])
}

func explorer(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] rows = [
		header(t, tx(state, "EXPLORADOR"), [
			headerAction(t, "＋", tx(state, "Novo arquivo") + render.keyHint(state, "newFile"), act("prompt", "newFile")),
			headerAction(t, "⊞", tx(state, "Nova pasta") + render.keyHint(state, "newFolder"), act("prompt", "newFolder")),
			headerAction(t, "🗑", tx(state, "Excluir") + " (Delete)", act("askRemove", render.removable(state))),
			headerAction(t, "⟳", tx(state, "Atualizar"), act("refresh", "")),
			headerAction(t, "⊟", tx(state, "Recolher tudo"), act("collapse", "")),
			headerAction(t, "↑", tx(state, "Pasta acima"), act("up", "")),
			headerAction(t, "…", tx(state, "Abrir pasta") + render.keyHint(state, "openFolder"), action("openFolder"))
		]),
		ui.row([ui.pad(4)], [ui.text([tone(t.text), ui.hint(state.root)], "  " + workspace.baseName(state.root))]),
		promptRow(state, t)
	]
	mut hive.ui.View[dyn] tree = []
	for each row in state.tree {
		append(tree, treeRow(state, t, row))
	}
	if len(state.tree) == 0 {
		append(tree, empty(t, tx(state, "Pasta vazia.")))
	}
	mut hive.ui.Attr[dyn] treeBox = [ui.gap(1), ui.keys(treeKeys(state)), ui.onKey(treeCmd(_))]
	if state.focus == "explorer" {
		append(treeBox, ui.focus(state.focusSerial))
	}
	append(rows, ui.column(treeBox, tree))
	return ui.column([ui.gap(1)], rows)
}

func ctxItem(state: model.State, t: theme.Theme, text: Str, name: Str, path: Str, hint: Str): Entry {
	return Entry(tx(state, text), hint, actText("ctx", name, path), true)
}

// O menu de um arquivo ou de uma pasta do explorador: o do botão direito, ou
// o do ⋯ da linha.
func contextMenu(state: model.State, t: theme.Theme): hive.ui.View {
	path := state.context.path
	if path == "" {
		return ui.none()
	}
	folder := render.isFolder(state, path)
	mut Entry[dyn] items = []
	if !folder {
		append(items, ctxItem(state, t, "Abrir", "open", path, "Enter"))
		append(items, gap())
	}
	append(items, ctxItem(state, t, "Novo arquivo…", "newFile", path, ""))
	append(items, ctxItem(state, t, "Nova pasta…", "newFolder", path, ""))
	append(items, gap())
	append(items, ctxItem(state, t, "Renomear…", "rename", path, "F2"))
	append(items, ctxItem(state, t, "Excluir", "delete", path, "Delete"))
	append(items, gap())
	append(items, ctxItem(state, t, "Copiar caminho", "copyPath", path, ""))
	append(items, ctxItem(state, t, "Copiar caminho relativo", "copyRelative", path, ""))
	append(items, gap())
	append(items, ctxItem(state, t, "Mostrar na pasta do sistema", "reveal", path, ""))
	append(items, ctxItem(state, t, "Abrir no terminal", "terminal", path, ""))
	if !folder && path is "{stem}.hive" {
		append(items, gap())
		append(items, ctxItem(state, t, "Fixar como entrada", "entry", path, ""))
	}
	if !folder && render.gitPathOf(state, path) != "" {
		append(items, gap())
		append(items, ctxItem(state, t, "Preparar (stage)", "stage", path, ""))
		append(items, ctxItem(state, t, "Descartar alterações…", "discard", path, ""))
	}
	mut hive.ui.View[dyn] rows = []
	for each entry in items {
		append(rows, menuRow(t, entry))
	}
	// Onde o mouse estava, sem escurecer a página; um clique fora o fecha.
	return ui.overlay([ui.anchor(ui.Anchor.Pointer()), ui.onDismiss(act("closeContext", ""))],
		ui.column([ui.width(380), ui.pad(6), ui.gap(1), fill(t.side), tone(t.text)], rows))
}

// ── buscar no projeto ────────────────────────────────────────────────────

func caseToggle(state: model.State, t: theme.Theme, on: Bool, message: model.Cmd): hive.ui.View {
	mut color := t.muted
	if on {
		color = t.accent
	}
	return clickable(color, "Aa", message, tx(state, "Diferenciar maiúsculas"))
}

// A linha achada, com o trecho em destaque.
func hitLine(state: model.State, t: theme.Theme, hit: model.Hit): hive.ui.View {
	size := len(state.search.text)
	before := complete.take(hit.text, hit.column)
	match := complete.take(complete.skip(hit.text, hit.column), size)
	after := complete.skip(hit.text, hit.column + size)
	mut lead := analysis.trimLeft(before)
	if len(lead) > 40 {
		lead = "…" + complete.skip(lead, len(lead) - 40)
	}
	target := workspace.joinPath(state.root, hit.path)
	open := actText("openAt", target, "{hit.line}:{hit.column}")
	return ui.row(plus(lit(), [ui.gap(6), ui.pad(1), ui.align(ui.Align.Center()), ui.on(open), ui.hint(hit.path)]), [
		spaceOf(22),
		small(t.muted, "{hit.line}"),
		ui.row([], [
			label(t.text, lead),
			ui.text([tone(t.text), fill(t.selection)], match),
			label(t.text, after)
		])
	])
}

func searchPanel(state: model.State, t: theme.Theme): hive.ui.View {
	panel := state.search
	mut hive.ui.View[dyn] rows = [
		header(t, tx(state, "BUSCAR"), []),
		ui.row([ui.gap(6), ui.pad(6), ui.align(ui.Align.Center())], [
			ui.column([ui.grow(1)], [
				inputField(t, plus(focusOn(state, "searchText"), [ui.onInput(field("searchText", _)), ui.onSubmit(actText("searchRun", "", _)),
					ui.placeholder(tx(state, "Buscar no projeto (Enter)"))]), panel.text)
			]),
			caseToggle(state, t, panel.caseSensitive, act("searchCase", "")),
			headerAction(t, "↵", tx(state, "Buscar no projeto (Enter)"), act("searchRun", ""))
		])
	]
	if panel.done {
		if len(panel.hits) == 0 {
			append(rows, empty(t, tx(state, "Nenhum resultado")))
		} else {
			append(rows, empty(t, "{len(panel.hits)} " + tx(state, "resultado(s) em") + " {panel.files} " + tx(state, "arquivo(s)")))
		}
		if panel.truncated {
			append(rows, empty(t, tx(state, "Resultados demais — mostrando os primeiros.")))
		}
	}
	mut current := ""
	for each hit in panel.hits {
		if hit.path != current {
			current = hit.path
			append(rows, ui.row([ui.gap(6), ui.pad(2), ui.align(ui.Align.Center())], [
				fileIcon(workspace.baseName(hit.path)),
				clickable(t.text, workspace.baseName(hit.path), act("open", workspace.joinPath(state.root, hit.path)), hit.path),
				small(t.muted, render.folderOf(hit.path))
			]))
		}
		append(rows, hitLine(state, t, hit))
	}
	return ui.column([ui.gap(2)], rows)
}

// ── estrutura e TODO ─────────────────────────────────────────────────────

func outlinePanel(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] rows = [header(t, tx(state, "ESTRUTURA"), [])]
	if render.activeDoc(state) is Result.Ok(doc) {
		symbols := analysis.outline(doc.text)
		for each symbol in symbols {
			glyph := render.symbolGlyph(symbol.kind)
			goes := actText("openAt", doc.path, "{symbol.line}:0")
			append(rows, ui.row(plus(lit(), [ui.gap(8), ui.pad(2), ui.align(ui.Align.Center()), ui.on(goes)]), [
				spaceOf(6),
				ui.row([ui.width(16)], [label(glyph.color, glyph.glyph)]),
				plainLink(t.text, symbol.name, goes, ""),
				ui.spacer(),
				small(t.muted, "{symbol.line}")
			]))
		}
		if len(symbols) == 0 {
			append(rows, empty(t, tx(state, "Nenhuma declaração.")))
		}
	} else {
		append(rows, empty(t, tx(state, "Nenhum arquivo aberto.")))
	}
	return ui.column([ui.gap(1)], rows)
}

func tagColor(t: theme.Theme, tag: Str): Str {
	if tag == "FIXME" {
		return t.danger
	} else if tag == "HACK" || tag == "XXX" {
		return t.warn
	}
	return t.accent
}

func todoPanel(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] rows = [header(t, "TODO", [headerAction(t, "⟳", tx(state, "Atualizar"), act("todoRefresh", ""))])]
	if !state.todoScanned {
		append(rows, empty(t, tx(state, "Procurando…")))
		return ui.column([], rows)
	}
	mut file := ""
	for each found in state.todos {
		if found.file != file {
			file = found.file
			append(rows, ui.row([ui.gap(6), ui.pad(2), ui.align(ui.Align.Center())], [
				fileIcon(workspace.baseName(file)),
				ui.column([ui.grow(1)], [ui.row([ui.gap(6), ui.align(ui.Align.Center())], [
					ui.text([tone(t.text), ui.hint(file)], workspace.baseName(file)),
					small(t.muted, render.relFolder(state, file))
				])])
			]))
		}
		goes := actText("openAt", found.file, "{found.line}:{found.column}")
		append(rows, ui.row(plus(lit(), [ui.gap(6), ui.pad(1), ui.align(ui.Align.Center()), ui.on(goes)]), [
			spaceOf(16),
			ui.row([ui.width(46)], [small(tagColor(t, found.tag), found.tag)]),
			ui.column([ui.grow(1)], [plainLink(t.text, found.text, goes, found.tag + ": " + found.text)]),
			ui.row([ui.width(34), ui.justify(ui.Justify.End())], [small(t.muted, "{found.line}")]),
			spaceOf(10)
		]))
	}
	if len(state.todos) == 0 {
		append(rows, empty(t, tx(state, "Nenhum TODO no projeto.")))
	}
	return ui.column([ui.gap(1)], rows)
}

// ── controle de código ───────────────────────────────────────────────────

func gitRow(state: model.State, t: theme.Theme, file: model.GitFile, stagedList: Bool): hive.ui.View {
	kind := git.kindOf(file)
	name := workspace.baseName(file.path)
	color := gitColor(t, kind)
	mut title := label(color, name)
	// A linha abre o arquivo; um apagado mostra o que saiu.
	mut goes := act("gitShowWork", file.path)
	if kind != "deleted" {
		goes = act("open", workspace.joinPath(state.git.top, file.path))
		title = plainLink(color, name, goes, file.path)
	}
	mut hive.ui.View[dyn] items = [spaceOf(6), fileIcon(name),
		ui.column([ui.grow(1)], [ui.row([ui.gap(6), ui.align(ui.Align.Center())], [title, small(t.muted, shortFolder(render.folderOf(file.path), 19 - len(name)))])]),
		rowAction(t, "±", tx(state, "Ver alterações"), act("gitShowWork", file.path))]
	if stagedList {
		append(items, rowAction(t, "−", tx(state, "Tirar da preparação (unstage)"), act("gitUnstage", file.path)))
	} else {
		append(items, rowAction(t, "↺", tx(state, "Descartar alterações"), act("gitAskDiscard", file.path)))
		append(items, rowAction(t, "+", tx(state, "Preparar (stage)"), act("gitStage", file.path)))
	}
	append(items, ui.row([ui.width(14), ui.justify(ui.Justify.Center())], [small(color, git.badge(kind, file))]))
	// A barra de rolagem da lista passa por cima da borda direita.
	append(items, spaceOf(8))
	return ui.row(plus(lit(), [ui.gap(6), ui.pad(2), ui.align(ui.Align.Center()), ui.on(goes)]), items)
}

// Uma pasta comprida, pelo fim dela: o nome do arquivo ao lado não quebra.
func shortFolder(folder: Str, most: Int): Str {
	if len(folder) <= most {
		return folder
	}
	if most < 5 {
		return ""
	}
	return "…" + complete.skip(folder, len(folder) - most + 1)
}

func gitPanel(state: model.State, t: theme.Theme, extra: Chrome): hive.ui.View {
	info := state.git
	head := header(t, tx(state, "CONTROLE DE CÓDIGO"), [
		headerAction(t, "⟳", tx(state, "Atualizar"), act("gitRefresh", "")),
		headerAction(t, "↓", "Pull", act("gitPull", "")),
		headerAction(t, "↑", "Push", act("gitPush", ""))
	])
	if !info.repo {
		return ui.column([ui.gap(4)], [
			head,
			empty(t, tx(state, "Esta pasta não está num repositório git.")),
			ui.row([ui.pad(8)], [primary(t, tx(state, "Inicializar repositório"), act("gitInit", ""), true)])
		])
	}
	stagedCount := git.count(info, true)
	changedCount := git.count(info, false)
	mut branch := "⑂ " + info.branch
	if info.ahead > 0 || info.behind > 0 {
		branch = branch + "  ↑{info.ahead} ↓{info.behind}"
	}
	if info.busy != "" {
		branch = branch + "  ⟳ " + info.busy + "…"
	}
	mut commitLabel := tx(state, "✓ Commit")
	if stagedCount == 0 {
		commitLabel = tx(state, "✓ Commit (tudo)")
	}
	canCommit := info.message != "" && len(info.files) > 0 && info.busy == ""
	mut hive.ui.View[dyn] rows = [
		head,
		ui.row([ui.pad(6)], [label(t.text, branch)]),
		ui.column([ui.gap(6), ui.pad(6)], [
			ui.textarea(plus(plus(fieldLook(t), keyed("commit", false)), [ui.onInput(field("gitMessage", _)), fill(t.input), tone(t.text), ui.height(72),
				ui.placeholder(tx(state, "Mensagem do commit (Ctrl+Enter)"))]), info.message),
			primary(t, commitLabel, act("gitCommit", ""), canCommit)
		])
	]
	if stagedCount > 0 {
		append(rows, foldHeader(t, tx(state, "PREPARADAS"), stagedCount, extra.hideStaged, "staged",
			[rowAction(t, "−", tx(state, "Tirar tudo da preparação"), act("gitUnstageAll", ""))]))
		if !extra.hideStaged {
			mut hive.ui.View[dyn] staged = []
			for each file in info.files {
				if git.staged(file) {
					append(staged, gitRow(state, t, file, true))
				}
			}
			append(rows, listBox(staged, 200))
		}
	}
	if changedCount > 0 {
		append(rows, foldHeader(t, tx(state, "ALTERAÇÕES"), changedCount, extra.hideChanges, "changes",
			[rowAction(t, "+", tx(state, "Preparar tudo"), act("gitStageAll", ""))]))
		if !extra.hideChanges {
			mut hive.ui.View[dyn] changed = []
			for each file in info.files {
				if git.unstaged(file) {
					append(changed, gitRow(state, t, file, false))
				}
			}
			if extra.hideLog {
				// Com o histórico recolhido, as alterações ficam com a altura toda.
				append(rows, ui.column([ui.grow(1), ui.gap(1), ui.scroll(ui.Axis.Vertical())], changed))
			} else {
				append(rows, listBox(changed, 280))
			}
		}
	}
	if len(info.files) == 0 {
		append(rows, empty(t, tx(state, "Nada para commitar — tudo em dia.")))
	}
	// Recolhido, o histórico desce para o pé do painel.
	if extra.hideLog && (changedCount == 0 || extra.hideChanges) {
		append(rows, ui.spacer())
	}
	append(rows, foldHeader(t, tx(state, "HISTÓRICO"), len(info.log), extra.hideLog, "log", []))
	if !extra.hideLog {
		mut hive.ui.View[dyn] log = []
		for each line in info.log {
			if line is "{hash} {subject}" {
				mut box := plus(lit(), [ui.gap(8), ui.pad(2), ui.on(act("gitShow", hash)), ui.hint(line + " — " + tx(state, "clique para ver as alterações"))])
				if state.commit.key != "" && git.startsWith(state.commit.key, hash) {
					append(box, fill(t.selection))
				}
				append(log, ui.row(box, [
					spaceOf(6),
					ui.row([ui.width(64)], [small(t.accent, hash)]),
					ui.column([ui.grow(1)], [label(t.text, subject)])
				]))
			}
		}
		// O histórico fica com o resto da altura, e rola dentro dela.
		append(rows, ui.column([ui.grow(1), ui.gap(2), ui.scroll(ui.Axis.Vertical())], log))
	}
	return ui.column([ui.gap(2), ui.grow(1)], rows)
}

// O cabeçalho de uma seção que recolhe: um clique em qualquer parte dela abre
// ou fecha a lista, e as ações dela ficam à direita.
func foldHeader(t: theme.Theme, title: Str, count: Int, hidden: Bool, fold: Str, actions: hive.ui.View[]): hive.ui.View {
	mut chevron := "⌄"
	if hidden {
		chevron = "›"
	}
	mut hive.ui.View[dyn] items = [
		ui.row([ui.width(14), ui.justify(ui.Justify.Center())], [label(t.muted, chevron)]),
		small(t.muted, title),
		small(t.muted, "{count}"),
		ui.spacer()
	]
	for each a in actions {
		append(items, a)
	}
	return ui.row(plus(lit(), [ui.gap(6), ui.pad(4), ui.align(ui.Align.Center()), ui.on(chrome("gitFold", fold))]), items)
}

// Uma lista que rola sozinha, até `most` de altura: com poucas linhas, só a
// altura delas.
func listBox(rows: hive.ui.View[], most: Int): hive.ui.View {
	tall := minInt(len(rows) * 27 + 4, most)
	return ui.column([ui.height(tall), ui.gap(1), ui.scroll(ui.Axis.Vertical())], rows)
}

func sidePanel(state: model.State, t: theme.Theme, extra: Chrome): hive.ui.View {
	mut body := explorer(state, t)
	if state.side is model.SideView.OutlineSide {
		body = outlinePanel(state, t)
	} else if state.side is model.SideView.TodoSide {
		body = todoPanel(state, t)
	} else if state.side is model.SideView.GitSide {
		// O controle de código rola por seção (alterações, histórico), não inteiro.
		return ui.column([ui.width(300), fill(t.side)], [gitPanel(state, t, extra)])
	} else if state.side is model.SideView.SearchSide {
		body = searchPanel(state, t)
	}
	return ui.column([ui.width(300), fill(t.side), ui.scroll(ui.Axis.Vertical())], [body])
}

// ── abas e breadcrumb ────────────────────────────────────────────────────

func tabBox(t: theme.Theme, on: Bool): hive.ui.Attr[dyn] {
	mut hive.ui.Attr[dyn] box = [ui.gap(6), ui.pad(8), ui.align(ui.Align.Center())]
	if on {
		append(box, fill(t.editor))
	} else {
		append(box, fill(t.tabIdle))
	}
	return box
}

func tab(state: model.State, t: theme.Theme, index: Int, doc: model.Doc): hive.ui.View {
	on := index == state.active && render.showsDoc(state)
	mut color := gitColor(t, render.gitKindOf(state, doc.path))
	mut tip := doc.path
	if doc.gone {
		color = t.danger
		tip = doc.path + " — " + tx(state, "apagado do disco (salvar cria de novo)")
	}
	if !on && color == t.text {
		color = t.muted
	}
	mut closer := iconButton(t, "close", "×", tx(state, "Fechar") + render.keyHint(state, "closeTab"), act("close", "{index}"), 20, 12)
	if model.dirty(doc) {
		closer = clickable(t.text, "●", act("close", "{index}"), tx(state, "Não salvo — fechar"))
	}
	mut box := plus(tabBox(t, on), [ui.onMiddle(act("close", "{index}")), ui.hover(hoverTone())])
	return ui.row(box, [fileIcon(doc.name), plainLink(color, doc.name, act("focus", "{index}"), tip), closer])
}

func tabStrip(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] items = []
	for i := 0; i < len(state.docs); i++ {
		append(items, tab(state, t, i, state.docs[i]))
	}
	if state.settingsOpen {
		on := render.showingSettings(state)
		append(items, ui.row(tabBox(t, on), [label(t.muted, "⚙"), clickable(t.text, tx(state, "Configurações"), act("settings", ""), ""),
			iconButton(t, "close", "×", tx(state, "Fechar"), act("closeSettings", ""), 20, 12)]))
	}
	if state.commit.key != "" {
		on := render.showingCommit(state)
		append(items, ui.row(tabBox(t, on), [label(t.accent, "⑂"), clickable(t.text, state.commit.title, act("focusCommit", ""), state.commit.title),
			iconButton(t, "close", "×", tx(state, "Fechar"), act("closeCommit", ""), 20, 12)]))
	}
	return ui.row([ui.gap(1), fill(t.tabStrip), ui.scroll(ui.Axis.Horizontal())], items)
}

// Como o documento aparece: `edit` (o editor, colorido pela ponte), `split`
// (o editor e a vista ao lado) ou `preview` (no código, só a vista realçada,
// de nomes clicáveis).
func modeOf(doc: model.Doc): Str {
	return doc.mode
}

// Editor · Dividir · Preview (no código, o terceiro é a vista realçada, só leitura).
func modeSwitch(state: model.State, t: theme.Theme, doc: model.Doc): hive.ui.View {
	mut third := "Preview"
	if !model.hasPreview(doc.path) {
		third = "Realce"
	}
	mut hive.ui.View[dyn] items = []
	for each option in [["edit", "Editor"], ["split", "Dividir"], ["preview", third]] {
		mut color := t.muted
		if option[0] == modeOf(doc) {
			color = t.accent
		}
		append(items, clickable(color, tx(state, option[1]), act("mode", option[0]), ""))
	}
	return ui.row([ui.gap(10)], items)
}

func breadcrumb(state: model.State, t: theme.Theme): hive.ui.View {
	if render.showingCommit(state) {
		return ui.row([ui.pad(6), fill(t.editor)], [small(t.muted, tx(state, "Controle de código") + "  ›  " + state.commit.title)])
	}
	if render.showingSettings(state) {
		return ui.row([ui.pad(6), fill(t.editor)], [small(t.muted, tx(state, "Configurações") + "  ›  " + tx(state, "Usuário"))])
	}
	if render.activeDoc(state) is Result.Ok(doc) {
		mut hive.ui.View[dyn] items = [small(t.muted, join(workspace.crumbs(state.root, doc.path), "  ›  "))]
		if doc.path == state.entrypoint {
			append(items, small(t.muted, "📌 " + tx(state, "entrada")))
		}
		append(items, ui.spacer())
		if model.hasPreview(doc.path) {
			append(items, modeSwitch(state, t, doc))
		}
		return ui.row([ui.gap(12), ui.pad(6), ui.align(ui.Align.Center()), fill(t.editor)], items)
	}
	return ui.none()
}

// ── o código realçado ────────────────────────────────────────────────────
//
// O realce é o mesmo do editor da página própria (lib/highlight): o HTML de
// cada linha é lido de volta em pedaços com a classe de cada um, e cada
// pedaço vira um texto na cor que o tema dá àquela classe.

type Token {
	cls:  Str
	text: Str
}

func unescape(text: Str): Str {
	return replaceAll(replaceAll(replaceAll(replaceAll(text, "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&amp;", "&")
}

func topOf(stack: Str[]): Str {
	last := len(stack) - 1
	if stack bounds last {
		return stack[last]
	}
	return ""
}

proc emit(out: mut Token[dyn], cls: Str, text: Str): void {
	if text != "" {
		append(out, Token(cls, unescape(text)))
	}
}

// Os pedaços de uma linha realçada: `<span class="x">…</span>` e texto solto.
func tokensOf(html: Str): Token[dyn] {
	mut Token[dyn] out = []
	mut Str[dyn] stack = []
	parts := split(html, "<")
	for i := 0; i < len(parts); i++ {
		part := parts[i]
		if i == 0 {
			emit(out, "", part)
		} else if part is "/span>{text}" {
			workspace.popLast(stack)
			emit(out, topOf(stack), text)
		} else if part is "span class=\"{cls}\">{text}" {
			append(stack, cls)
			emit(out, cls, text)
		} else {
			emit(out, topOf(stack), "<" + part)
		}
	}
	return out
}

func tokenColor(t: theme.Theme, cls: Str): Str {
	if cls == "tk" {
		return t.synKeyword
	} else if cls == "tt" {
		return t.synType
	} else if cls == "ts" {
		return t.synString
	} else if cls == "tn" {
		return t.synNumber
	} else if cls == "tc" {
		return t.synComment
	} else if cls == "tf" {
		return t.synCall
	} else if cls == "ta" {
		return t.synAtom
	} else if cls == "tb" {
		return t.synLiteral
	} else if cls == "tm" {
		return t.synModule
	} else if cls == "td" {
		return t.warn
	}
	return t.text
}

func isNameChar(c: Str): Bool {
	return highlight.isIdent(c)
}

// Um texto sem classe partido em nomes e o resto, para cada nome poder ser
// clicado (ir para a definição).
func words(text: Str): Str[dyn] {
	mut Str[dyn] out = []
	mut Str[dyn] run = []
	mut inName := false
	for each c in split(text, "") {
		name := isNameChar(c)
		if name != inName && len(run) > 0 {
			append(out, join(run, ""))
			run = []
		}
		inName = name
		append(run, c)
	}
	if len(run) > 0 {
		append(out, join(run, ""))
	}
	return out
}

func expandTabs(text: Str, size: Int): Str {
	mut Str[dyn] spaces = []
	for i := 0; i < size; i++ {
		append(spaces, " ")
	}
	return replaceAll(text, "\t", join(spaces, ""))
}

// O HTML realçado da linha `index` (a partir de 0) do documento.
func lineHtml(doc: model.Doc, lines: Str[], index: Int): Str {
	if lines bounds index {
		lang := model.language(doc.path)
		if lang == "hive" {
			return highlight.highlightLine(lines[index], highlight.carryAt(doc.hl, index - 1)).html
		}
		return highlight.plainLine(lines[index], lang)
	}
	return ""
}

// Uma linha de código: os pedaços coloridos; com `start` >= 0, os nomes são
// clicáveis e levam o cursor (`start` é onde a linha começa no texto).
func codeLine(t: theme.Theme, html: Str, start: Int, tabSize: Int): hive.ui.View {
	mut hive.ui.View[dyn] pieces = []
	mut column := 0
	for each token in tokensOf(html) {
		color := tokenColor(t, token.cls)
		clickableKind := token.cls == "" || token.cls == "tf" || token.cls == "tt" || token.cls == "tm"
		if start >= 0 && clickableKind {
			for each word in words(token.text) {
				if isNameChar(complete.take(word, 1)) && !highlight.isDigit(complete.take(word, 1)) {
					append(pieces, ui.link([ui.on(actCaret("definition", start + column)), tone(color)], "#", word))
				} else {
					append(pieces, ui.text([tone(color)], expandTabs(word, tabSize)))
				}
				column = column + len(word)
			}
		} else {
			append(pieces, ui.text([tone(color)], expandTabs(token.text, tabSize)))
			column = column + len(token.text)
		}
	}
	if len(pieces) == 0 {
		append(pieces, ui.text([], " "))
	}
	return ui.row([], pieces)
}

func minInt(a: Int, b: Int): Int {
	if a < b {
		return a
	}
	return b
}

func maxInt(a: Int, b: Int): Int {
	if a > b {
		return a
	}
	return b
}

// Onde cada linha começa no texto.
func lineStarts(lines: Str[]): Int[dyn] {
	mut Int[dyn] starts = []
	mut at := 0
	for each line in lines {
		append(starts, at)
		at = at + len(line) + 1
	}
	return starts
}

// Em que linha (a partir de 1) fica a posição `offset`, por busca binária.
func lineAt(starts: Int[], offset: Int): Int {
	mut low := 0
	mut high := len(starts) - 1
	for ; low < high; {
		mid := (low + high + 1) / 2
		if starts bounds mid {
			if starts[mid] <= offset {
				low = mid
			} else {
				high = mid - 1
			}
		} else {
			return low + 1
		}
	}
	return low + 1
}

// A linha que a vista põe no topo: a pedida pelas setas da vista, ou uma
// um pouco acima do cursor (ou da ocorrência da busca).
func topLine(state: model.State, starts: Int[], asked: Int, matches: Int[]): Int {
	if asked > 0 {
		return asked
	}
	mut focus := lineAt(starts, state.caret)
	if state.find.open && matches bounds state.find.index {
		focus = lineAt(starts, matches[state.find.index])
	}
	top := focus - 12
	if top < 1 {
		return 1
	}
	return top
}

func viewLines(): Int {
	return 160
}

// O documento realçado, com números de linha, os erros na própria linha
// (Error Lens), as linhas da busca em destaque e os nomes clicáveis.
func codeView(state: model.State, t: theme.Theme, doc: model.Doc, asked: Int): hive.ui.View {
	lines := split(doc.text, "\n")
	total := len(lines)
	starts := lineStarts(lines)
	matches := render.findMatches(doc.text, state.find)
	top := topLine(state, starts, asked, matches)
	last := minInt(total, top + viewLines() - 1)
	marks := render.lensMarks(state)
	mut Int[dyn] matchLines = []
	for each at in matches {
		append(matchLines, lineAt(starts, at))
	}
	mut current := -1
	if matches bounds state.find.index {
		current = lineAt(starts, matches[state.find.index])
	}
	caretLine := lineAt(starts, state.caret)
	mut start := 0
	first := top - 1
	if starts bounds first {
		start = starts[first]
	}
	mut hive.ui.View[dyn] rows = []
	if top > 1 {
		up := maxInt(1, top - viewLines() + 20)
		append(rows, ui.row([ui.pad(4)], [clickable(t.muted, "▲ " + tx(state, "linhas") + " {up}–{top - 1}", chrome("top", "{up}"), "")]))
	}
	for n := top; n <= last; n++ {
		index := n - 1
		mut hive.ui.Attr[dyn] box = [ui.gap(12)]
		if current == n {
			append(box, fill(t.selection))
		} else if indexOf(matchLines, n) is Result.Ok(_) {
			append(box, fill(t.input))
		} else if n == caretLine {
			append(box, fill(t.tabIdle))
		}
		mut Str[dyn] errors = []
		mut Str[dyn] warnings = []
		for each mark in marks {
			if mark.line == n {
				if mark.severity == "error" {
					append(errors, mark.message)
				} else {
					append(warnings, mark.message)
				}
			}
		}
		mut hive.ui.View[dyn] items = []
		if state.settings.lineNumbers {
			mut numberColor := t.gutter
			if len(errors) > 0 {
				numberColor = t.danger
			}
			append(items, ui.row([ui.width(52), ui.justify(ui.Justify.End())], [ui.text([tone(numberColor)], "{n}")]))
		}
		append(items, codeLine(t, lineHtml(doc, lines, index), start, state.settings.tabSize))
		for each message in errors {
			append(items, small(t.danger, "  ● " + message))
		}
		for each message in warnings {
			append(items, small(t.warn, "  ▲ " + message))
		}
		append(rows, ui.row(box, items))
		if lines bounds index {
			start = start + len(lines[index]) + 1
		}
	}
	if last < total {
		down := last + 1
		append(rows, ui.row([ui.pad(4)], [clickable(t.muted, "▼ " + tx(state, "linhas") + " {down}–{minInt(total, last + viewLines() - 20)}", chrome("top", "{maxInt(1, last - 20)}"), "")]))
	}
	return ui.column([ui.grow(1), ui.pad(codePad()), fill(t.editor), ui.scroll(ui.Axis.Both())], rows)
}

// O recuo das caixas de código: a folha de estilo da ponte (lib/bridge.go)
// põe em fonte monoespaçada o texto de toda caixa com esse recuo.
func codePad(): Int {
	return 9
}

// ── Markdown, JSON e commit em widgets ───────────────────────────────────

func noCommit(): git.Commit {
	git.DiffFile[dyn] none = []
	return git.Commit("", "", "", "", "", "", none, false)
}

// O texto de um trecho de HTML, sem as marcas.
func stripTags(html: Str): Str {
	mut Str[dyn] out = []
	parts := split(html, "<")
	for i := 0; i < len(parts); i++ {
		part := parts[i]
		if i == 0 {
			append(out, part)
		} else if part is "{tag}>{text}" {
			if tag is "input{rest}" {
				if rest is "{a}checked{b}" {
					append(out, "☑ ")
				} else {
					append(out, "☐ ")
				}
			}
			append(out, text)
		} else {
			append(out, "<" + part)
		}
	}
	return unescape(join(out, ""))
}

// Um parágrafo: o texto corrido (um link fica no texto), ou — com imagens — os
// pedaços lado a lado.
func mdInline(t: theme.Theme, html: Str, attrs: hive.ui.Attr[]): hive.ui.View {
	if indexOf(html, "<img ") is Result.Error(_) {
		return ui.text(attrs, stripTags(html))
	}
	mut hive.ui.View[dyn] pieces = []
	mut rest := html
	for ;; {
		if rest is "{before}<img src=\"{src}\" alt=\"{alt}\">{after}" {
			if before != "" {
				append(pieces, ui.text(attrs, stripTags(before)))
			}
			append(pieces, ui.image([], src, unescape(alt)))
			rest = after
		} else {
			break
		}
	}
	if rest != "" {
		append(pieces, ui.text(attrs, stripTags(rest)))
	}
	return ui.row([ui.gap(4), ui.align(ui.Align.Center())], pieces)
}

// Um bloco de código: o texto colorido como no editor, só para ler.
func codeBlock(t: theme.Theme, html: Str): hive.ui.View {
	mut hive.ui.Run[dyn] runs = []
	mut Str[dyn] text = []
	mut at := 0
	for each token in tokensOf(html) {
		size := len(token.text)
		if token.cls != "" {
			append(runs, ui.ink(at, at + size, hex(tokenColor(t, token.cls))))
		}
		append(text, token.text)
		at = at + size
	}
	body := join(text, "")
	lines := len(split(body, "\n"))
	return ui.code([ui.readOnly(true), ui.radius(6), ui.ring(false), ui.border(0), fill(t.input), tone(t.text), ui.height(minInt(lines, 30) * 20 + 20)], body, runs)
}

// O preview do Markdown, bloco a bloco, a partir do HTML de lib/markdown.
func markdownView(state: model.State, t: theme.Theme, doc: model.Doc): hive.ui.View {
	mut hive.ui.View[dyn] blocks = []
	mut Str[dyn] pre = []
	mut inPre := false
	mut ordered := false
	mut number := 0
	mut html := doc.view
	if html is "<div class=\"md\">{inner}</div>" {
		html = inner
	}
	for each line in split(html, "\n") {
		if inPre {
			if line is "{last}</code></pre>" {
				append(pre, last)
				append(blocks, codeBlock(t, join(pre, "\n")))
				inPre = false
			} else {
				append(pre, line)
			}
			continue
		}
		if line is "<pre class=\"md-code\"><code>{first}" {
			if first is "{only}</code></pre>" {
				append(blocks, codeBlock(t, only))
			} else {
				pre = [first]
				inPre = true
			}
		} else if line is "<h{n}>{text}</h{m}>" {
			size := numberOr(n, 2)
			append(blocks, ui.text([ui.heading(size), tone(t.text)], stripTags(text)))
		} else if line is "<p>{text}</p>" {
			append(blocks, mdInline(t, text, [tone(t.text)]))
		} else if line == "<ul>" {
			ordered = false
		} else if line == "<ol>" {
			ordered = true
			number = 0
		} else if line is "<li>{text}</li>" {
			number = number + 1
			mut mark := "•"
			if ordered {
				mark = "{number}."
			}
			append(blocks, ui.row([ui.gap(8)], [ui.row([ui.width(24), ui.justify(ui.Justify.End())], [label(t.muted, mark)]), mdInline(t, text, [tone(t.text)])]))
		} else if line is "<blockquote>{text}</blockquote>" {
			append(blocks, ui.row([ui.gap(10)], [ui.column([ui.width(4), fill(t.accent)], []), mdInline(t, text, [tone(t.muted)])]))
		} else if line == "<hr>" {
			append(blocks, rule(t))
		} else if line is "<table>{rows}</table>" {
			append(blocks, mdTable(t, rows))
		}
	}
	return ui.column([ui.grow(1), ui.gap(12), ui.pad(28), fill(t.editor), ui.scroll(ui.Axis.Vertical())], [
		ui.column([ui.gap(12)], blocks)
	])
}

func mdTable(t: theme.Theme, html: Str): hive.ui.View {
	mut hive.ui.View[dyn] rows = []
	for each row in split(replaceAll(replaceAll(html, "<thead>", ""), "</tbody>", ""), "<tr>") {
		mut hive.ui.View[dyn] cells = []
		for each cell in split(row, "</t") {
			if cell is "{lead}<th>{text}" {
				append(cells, ui.row([ui.width(180), ui.pad(6)], [strong(t.text, stripTags(text))]))
			} else if cell is "{lead}<td>{text}" {
				append(cells, ui.row([ui.width(180), ui.pad(6)], [label(t.text, stripTags(text))]))
			}
		}
		if len(cells) > 0 {
			append(rows, ui.row([ui.gap(1), fill(t.border)], cells))
		}
	}
	return ui.column([ui.gap(1)], rows)
}

// O JSON: o texto colorido, só para ler, com o erro (se houver) marcado na linha.
func jsonView(state: model.State, t: theme.Theme, doc: model.Doc, extra: Chrome): hive.ui.View {
	mut runs := editorRuns(state, t, doc, extra.first, extra.last)
	mut hive.ui.View[dyn] items = []
	if jsonview.problem(doc.text) is Result.Ok(problem) {
		lines := split(doc.text, "\n")
		starts := lineStarts(lines)
		line := problem.line - 1
		if starts bounds line && lines bounds line {
			append(runs, ui.squiggle(starts[line], starts[line] + len(lines[line]), hex(t.danger)))
			append(runs, ui.marker(line, hex(t.danger)))
		}
		append(items, ui.row([ui.pad(8), fill(t.panel)], [label(t.danger, tx(state, "JSON inválido") + " — " + tx(state, "linha") + " {problem.line}, " + tx(state, "coluna") + " {problem.column}: " + problem.message)]))
	}
	append(items, ui.code(plus(paneLook(), [ui.grow(1), ui.readOnly(true), ui.numbers(true), fill(t.editor), tone(t.text), ui.onView(viewCmd(_, _))]), doc.text, runs))
	return ui.column([ui.grow(1)], items)
}

// A aba de commit: o assunto, quem e quando, os arquivos e o diff de cada um.
func commitView(state: model.State, t: theme.Theme, c: git.Commit): hive.ui.View {
	mut added := 0
	mut removed := 0
	for each file in c.files {
		added = added + file.added
		removed = removed + file.removed
	}
	mut hive.ui.View[dyn] rows = [ui.text([ui.size(ui.TextSize.Subtitle()), tone(t.text)], tx(state, c.subject))]
	if c.short != "" {
		append(rows, ui.row([ui.gap(6)], [label(t.accent, c.short), small(t.muted, "· " + c.author + " · " + c.date)]))
	}
	if c.body != "" {
		append(rows, label(t.text, c.body))
	}
	append(rows, ui.row([ui.gap(8)], [small(t.muted, "{len(c.files)} " + tx(state, "arquivo(s)")), label(t.gitNew, "+{added}"), label(t.danger, "−{removed}")]))
	for each file in c.files {
		mut shown := file.path
		if file.status == "R" {
			shown = file.oldPath + " → " + file.path
		}
		append(rows, ui.row([ui.gap(8), ui.pad(6), ui.align(ui.Align.Center()), fill(t.side)], [
			fileIcon(workspace.baseName(file.path)), label(statusColor(t, file.status), shown), ui.spacer(),
			label(t.gitNew, "+{file.added}"), label(t.danger, "−{file.removed}")
		]))
		if file.status == "B" {
			append(rows, empty(t, tx(state, "Arquivo binário — sem diff de texto.")))
		} else if len(file.lines) == 0 {
			append(rows, empty(t, tx(state, "Sem alterações de conteúdo.")))
		} else {
			append(rows, diffCode(t, file))
		}
	}
	if c.truncated {
		append(rows, empty(t, tx(state, "O diff é grande demais e foi cortado; use o terminal para vê-lo inteiro.")))
	}
	return ui.column([ui.grow(1), ui.gap(10), ui.pad(24), fill(t.editor), ui.scroll(ui.Axis.Vertical())], rows)
}

func statusColor(t: theme.Theme, status: Str): Str {
	if status == "A" {
		return t.gitNew
	} else if status == "M" || status == "R" {
		return t.gitMod
	} else if status == "D" {
		return t.danger
	}
	return t.text
}

// O diff de um arquivo: as linhas com o sinal, e o fundo verde ou vermelho.
func diffCode(t: theme.Theme, file: git.DiffFile): hive.ui.View {
	mut Str[dyn] text = []
	mut hive.ui.Run[dyn] runs = []
	mut at := 0
	for each line in file.lines {
		mut sign := "  "
		mut shade := ""
		mut ink := ""
		if line.kind == "add" {
			sign = "+ "
			shade = t.gitNew + "22"
			ink = t.gitNew
		} else if line.kind == "del" {
			sign = "- "
			shade = t.danger + "22"
			ink = t.danger
		} else if line.kind == "hunk" {
			sign = ""
			ink = t.accent
		} else if line.kind == "note" {
			sign = ""
			ink = t.muted
		}
		shown := sign + line.text
		if shade != "" {
			append(runs, ui.shade(at, at + len(shown), hex(shade)))
		}
		if ink != "" {
			append(runs, ui.ink(at, at + len(sign), hex(ink)))
			if line.kind == "hunk" || line.kind == "note" {
				append(runs, ui.ink(at, at + len(shown), hex(ink)))
			}
		}
		append(text, shown)
		at = at + len(shown) + 1
	}
	return ui.code([ui.readOnly(true), ui.radius(6), ui.ring(false), ui.border(1), ui.borderTone(hex(t.border)), fill(t.editor), tone(t.text), ui.height(minInt(len(file.lines), 40) * 20 + 20)], join(text, "\n"), runs)
}

// ── (antes) Markdown, JSON e commit: o HTML da página própria ────────────
//
// O preview do Markdown, a árvore do JSON e a aba de commit são o mesmo HTML
// que o Hive Studio monta para a página própria (`doc.view`, `commit.html`).
// Aqui fica só a caixa (de recuo 15) sobre a qual a ponte o mostra.

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

func previewOf(state: model.State, t: theme.Theme, doc: model.Doc, extra: Chrome): hive.ui.View {
	if model.isMarkdown(doc.path) {
		return markdownView(state, t, doc)
	} else if model.isJson(doc.path) {
		return jsonView(state, t, doc, extra)
	}
	return codeView(state, t, doc, extra.top)
}

// ── editor ───────────────────────────────────────────────────────────────

func findBox(state: model.State, t: theme.Theme): hive.ui.View {
	if !state.find.open || !render.showsDoc(state) {
		return ui.none()
	}
	matches := render.findMatches(render.searched(state), state.find)
	mut count := tx(state, "Nenhum resultado")
	if len(matches) > 0 {
		count = "{state.find.index + 1} " + tx(state, "de") + " {len(matches)}"
	} else if state.find.text == "" {
		count = ""
	}
	return ui.row([ui.gap(8), ui.pad(6), ui.align(ui.Align.Center()), fill(t.panel)], [
		ui.spacer(),
		ui.column([ui.width(260)], [
			inputField(t, plus(plus(focusOn(state, "find"), keyed("find", false)), [ui.onInput(field("find", _)), ui.onSubmit(actText("findNext", "", _)), ui.placeholder(tx(state, "Buscar"))]), state.find.text)
		]),
		caseToggle(state, t, state.find.caseSensitive, act("findCase", "")),
		small(t.muted, count),
		headerAction(t, "↑", tx(state, "Anterior (Shift+Enter)"), act("findPrev", "")),
		headerAction(t, "↓", tx(state, "Próximo (Enter)"), act("findNext", "")),
		headerAction(t, "✕", tx(state, "Fechar (Esc)"), act("findClose", ""))
	])
}

// As sugestões do autocomplete, junto do cursor.
func suggestions(state: model.State, t: theme.Theme): hive.ui.View {
	if len(state.suggestions) == 0 {
		return ui.none()
	}
	mut hive.ui.View[dyn] items = []
	for i := 0; i < len(state.suggestions); i++ {
		s := state.suggestions[i]
		glyph := render.kindGlyph(s.kind)
		mut hive.ui.Attr[dyn] box = [ui.gap(6), ui.pad(4), ui.align(ui.Align.Center())]
		if i == state.suggestIndex {
			append(box, fill(t.selection))
		}
		append(items, ui.row(box, [ui.row([ui.width(18)], [label(glyph.color, glyph.glyph)]), clickable(t.text, s.word, act("accept", "{i}"), s.detail), ui.spacer(), small(t.muted, s.detail)]))
	}
	return ui.overlay([ui.anchor(ui.Anchor.Caret()), ui.onDismiss(act("closeSuggest", ""))],
		ui.column([ui.width(440), ui.gap(0), ui.pad(4), fill(t.side), tone(t.text), ui.scroll(ui.Axis.Vertical())], items))
}

func docBody(state: model.State, t: theme.Theme, doc: model.Doc, extra: Chrome): hive.ui.View {
	// Código não tem preview: é sempre o editor.
	if !model.hasPreview(doc.path) {
		return ui.column([ui.grow(1)], [codeEditor(state, t, doc, extra)])
	}
	mode := modeOf(doc)
	if mode == "preview" {
		return previewOf(state, t, doc, extra)
	} else if mode == "split" {
		return ui.row([ui.grow(1), ui.gap(1), fill(t.border)], [
			ui.column([ui.grow(1)], [codeEditor(state, t, doc, extra)]),
			ui.column([ui.grow(1)], [previewOf(state, t, doc, extra)])
		])
	}
	return ui.column([ui.grow(1)], [codeEditor(state, t, doc, extra)])
}

func welcome(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] rows = []
	for each option in [["newFile", "Novo arquivo"], ["openFile", "Abrir arquivo…"], ["openFolder", "Abrir pasta…"],
		["terminal", "Terminal"], ["git", "Controle de código"], ["settings", "Configurações"], ["docs", "Documentação do Hive"]] {
		append(rows, ui.row([ui.width(360), ui.gap(24)], [
			clickable(t.accent, tx(state, option[1]), action(option[0]), ""),
			ui.spacer(),
			small(t.muted, keys.keysFor(state.settings.keymap, option[0]))
		]))
	}
	mut hive.ui.View[dyn] all = [
		ui.text([tone(t.accent), ui.size(ui.TextSize.Title())], "⬡"),
		ui.text([tone(t.text), ui.size(ui.TextSize.Title()), ui.heading(1)], "Hive Studio"),
		label(t.muted, tx(state, "Abra um arquivo no explorador para começar.")),
		ui.row([ui.height(12)], [])
	]
	for each row in rows {
		append(all, row)
	}
	return ui.column([ui.grow(1), ui.gap(10), ui.pad(40), ui.align(ui.Align.Center()), ui.justify(ui.Justify.Center()), fill(t.editor)], all)
}

// ── configurações ────────────────────────────────────────────────────────

func toggled(name: Str, on: Bool): model.Cmd {
	return act("setting", name)
}

func setting(t: theme.Theme, title: Str, description: Str, control: hive.ui.View): hive.ui.View {
	mut hive.ui.View[dyn] items = [label(t.text, title)]
	if description != "" {
		append(items, small(t.muted, description))
	}
	append(items, control)
	return ui.column([ui.gap(4), ui.pad(8)], items)
}

func check(state: model.State, t: theme.Theme, name: Str, text: Str, on: Bool): hive.ui.View {
	return ui.checkbox([ui.onToggle(toggled(name, _)), tone(t.text)], tx(state, text), on)
}

func section(t: theme.Theme, title: Str): hive.ui.View {
	return ui.column([ui.gap(4), ui.pad(4)], [ui.text([tone(t.text), ui.size(ui.TextSize.Subtitle()), ui.heading(2)], title), rule(t)])
}

func swatch(color: Str): hive.ui.View {
	return ui.row([ui.width(14), ui.height(14), fill(color)], [])
}

func themeCard(state: model.State, current: Str, t: theme.Theme): hive.ui.View {
	mut border := t.border
	if t.name == current {
		border = t.accent
	}
	return ui.column([ui.width(190), ui.pad(2), fill(border)], [
		ui.column([ui.gap(4), ui.pad(10), fill(t.editor)], [
			ui.row([ui.gap(4)], [swatch(t.side), swatch(t.selection), swatch(t.accent), swatch(t.statusBg)]),
			clickable(t.text, t.name, act("theme", t.name), ""),
			ui.row([], [label(t.synKeyword, "proc "), label(t.synCall, "main"), label(t.text, "(): "), label(t.synKeyword, "void")]),
			ui.row([], [label(t.synComment, "// olá "), label(t.synString, "\"hive\"")])
		])
	])
}

func keyRow(state: model.State, t: theme.Theme, a: keys.Action): hive.ui.View {
	combo := keys.keysFor(state.settings.keymap, a.id)
	mut shown := combo
	if combo == "" {
		shown = "—"
	}
	if state.recording == a.id {
		shown = tx(state, "pressione as teclas…")
	}
	mut hive.ui.View[dyn] items = [ui.row([ui.width(320)], [label(t.text, tx(state, a.label))]), ui.row([ui.width(180)], [label(t.accent, shown)]),
		button(t, tx(state, "Gravar"), act("record", a.id), true)]
	if !keys.isDefault(a.id, combo) {
		append(items, small(t.muted, tx(state, "personalizado")))
		append(items, button(t, tx(state, "Padrão"), act("resetKey", a.id), true))
	}
	return ui.row([ui.gap(8), ui.pad(2), ui.align(ui.Align.Center())], items)
}

func settingsPage(state: model.State, t: theme.Theme): hive.ui.View {
	prefs := state.settings
	mut hive.ui.View[dyn] languages = []
	for each language in i18n.languages() {
		mut color := t.muted
		if language.code == prefs.language {
			color = t.accent
		}
		append(languages, clickable(color, language.name, field("language", language.code), language.code))
	}
	mut hive.ui.View[dyn] cards = []
	mut hive.ui.View[dyn] moreCards = []
	mut count := 0
	for each option in theme.themes() {
		if count < 4 {
			append(cards, themeCard(state, prefs.theme, option))
		} else {
			append(moreCards, themeCard(state, prefs.theme, option))
		}
		count++
	}
	mut hive.ui.View[dyn] keyRows = []
	for each a in keys.actions() {
		append(keyRows, keyRow(state, t, a))
	}
	mut hive.ui.View[dyn] page = [
		ui.text([tone(t.text), ui.size(ui.TextSize.Title()), ui.heading(1)], tx(state, "Configurações")),
		small(t.muted, tx(state, "Salvas em") + " " + settings.path()),
		section(t, tx(state, "Aparência")),
		setting(t, tx(state, "Idioma"), tx(state, "Idioma da interface. Muda na hora."), ui.row([ui.gap(16)], languages)),
		setting(t, tx(state, "Tema de cor"), tx(state, "Muda a janela inteira: painéis, barras de rolagem e cores do código."),
			ui.column([ui.gap(8)], [
				ui.select(plus(fieldLook(t), [ui.onChoose(field("theme", _)), fill(t.input), tone(t.text)]), theme.names(), prefs.theme),
				ui.row([ui.gap(10)], cards),
				ui.row([ui.gap(10)], moreCards)
			])),
		setting(t, tx(state, "Tamanho da fonte"), tx(state, "Do editor, em pixels."),
			ui.select(plus(fieldLook(t), [ui.onChoose(field("fontSize", _)), fill(t.input), tone(t.text)]), ["11", "12", "13", "14", "15", "16", "18", "20", "22"], "{prefs.fontSize}")),
		section(t, tx(state, "Editor")),
		setting(t, tx(state, "Números de linha"), "", check(state, t, "lineNumbers", "Mostrar números de linha", prefs.lineNumbers)),
		setting(t, tx(state, "Autocomplete"), tx(state, "Sugere palavras-chave, builtins, módulos hive.* e nomes do arquivo enquanto você digita."),
			check(state, t, "autocomplete", "Sugerir enquanto digito", prefs.autocomplete)),
		setting(t, tx(state, "Error Lens"), tx(state, "Confere o código pouco depois de você parar de digitar (e a cada Check, Run, Test e Build) e mostra o erro na própria linha, em vermelho; as funções caras do último Analyze aparecem em amarelo."),
			check(state, t, "errorLens", "Mostrar erros e avisos na linha", prefs.errorLens)),
		setting(t, tx(state, "Largura do tab"), tx(state, "Quantos espaços um tab ocupa na tela."),
			ui.select(plus(fieldLook(t), [ui.onChoose(field("tabSize", _)), fill(t.input), tone(t.text)]), ["2", "4", "8"], "{prefs.tabSize}")),
		setting(t, tx(state, "Modo Vim"), tx(state, "Modos normal, inserção e visual, movimentos, operadores, objetos de texto, desfazer, busca com / e a linha de comando (:w, :q, :s…)."),
			check(state, t, "vim", "Usar as teclas do Vim no editor", prefs.vim)),
		section(t, tx(state, "Explorador")),
		setting(t, tx(state, "Arquivos ocultos"), "", check(state, t, "showHidden", "Mostrar arquivos ocultos e artefatos de build", prefs.showHidden)),
		section(t, tx(state, "Agentes")),
		small(t.muted, tx(state, "Programas que rodam no painel AGENTE, num terminal de verdade, na pasta aberta. Cada um usa o próprio login (a sua assinatura); o Hive Studio não vê nem guarda credenciais.")),
		setting(t, agents.labelOf("claude"), tx(state, "Comando (com argumentos, se precisar)."),
			inputField(t, [ui.onInput(field("claudeCommand", _)), ui.placeholder("claude")], prefs.claudeCommand)),
		setting(t, agents.labelOf("codex"), tx(state, "Comando (com argumentos, se precisar)."),
			inputField(t, [ui.onInput(field("codexCommand", _)), ui.placeholder("codex")], prefs.codexCommand)),
		setting(t, agents.labelOf("opencode"), tx(state, "Comando (com argumentos, se precisar)."),
			inputField(t, [ui.onInput(field("opencodeCommand", _)), ui.placeholder("opencode")], prefs.opencodeCommand)),
		section(t, tx(state, "Execução")),
		setting(t, tx(state, "Salvar antes de rodar"), "", check(state, t, "saveBeforeRun", "Salvar arquivos antes de Check, Run, Test e Build", prefs.saveBeforeRun)),
		setting(t, tx(state, "Compilador"), tx(state, "Caminho do hivec. A variável HIVEC, se existir, tem prioridade."),
			inputField(t, [ui.onInput(field("compiler", _)), ui.placeholder("hivec")], prefs.compiler)),
		setting(t, tx(state, "Navegador da janela"), tx(state, "Executável Chromium (Edge, Chrome, Brave) usado para a janela. Vazio = automático. Vale na próxima abertura."),
			inputField(t, [ui.onInput(field("browser", _)), ui.placeholder(tx(state, "automático"))], prefs.browser)),
		section(t, tx(state, "Atalhos de teclado")),
		small(t.muted, tx(state, "Clique em Gravar e pressione a combinação. Uma tecla já usada sai da outra ação. Esc cancela.")),
		button(t, tx(state, "Restaurar todos os padrões"), act("resetKeys", ""), true)
	]
	for each row in keyRows {
		append(page, row)
	}
	return ui.column([ui.grow(1), fill(t.editor), ui.scroll(ui.Axis.Vertical())], [ui.column([ui.gap(6), ui.pad(28), ui.width(900)], page)])
}

// ── um commit, ou as alterações de um arquivo ────────────────────────────

// A linha do Vim embaixo do editor: o modo, a macro sendo gravada, a última
// mensagem e as teclas pendentes — ou, aberta, a linha de comando (`:`, `/`, `?`).
func vimBar(state: model.State, t: theme.Theme): hive.ui.View {
	v := state.vim
	if !state.settings.vim || (!editorShown(state) && v.prompt == "") {
		return ui.none()
	}
	if v.prompt != "" {
		return ui.row([ui.gap(4), ui.pad(4), ui.align(ui.Align.Center()), fill(t.editor)], [
			ui.text([tone(t.accent), ui.size(ui.TextSize.Subtitle())], v.prompt),
			ui.column([ui.grow(1)], [
				ui.input(plus(plus(focusOn(state, "vimCommand"), keyed("vim", v.command == "")), [ui.onInput(field("vimCommand", _)), ui.onSubmit(actText("vimSubmit", "", _)), ui.placeholder(vimMark()),
					fill(t.editor), tone(t.text)]), v.command)
			])
		])
	}
	mut hive.ui.View[dyn] items = []
	label := vim.modeLabel(v)
	if label != "" {
		append(items, ui.text([tone(t.accent), ui.size(ui.TextSize.Caption())], tx(state, label)))
	}
	if v.recordingTo != "" {
		append(items, small(t.danger, tx(state, "gravando") + " @" + v.recordingTo))
	}
	if v.message != "" {
		mut color := t.text
		if v.error {
			color = t.danger
		}
		append(items, small(color, render.vimMessage(state)))
	}
	append(items, ui.spacer())
	append(items, small(t.muted, join(v.pending, "")))
	return ui.row([ui.gap(12), ui.pad(6), ui.align(ui.Align.Center()), fill(t.editor), ui.height(30)], items)
}

func editorArea(state: model.State, t: theme.Theme, extra: Chrome): hive.ui.View {
	layout := render.layoutOf(state)
	mut body := welcome(state, t)
	if layout == "settings" {
		body = settingsPage(state, t)
	} else if layout == "commit" {
		body = commitView(state, t, extra.commit)
	} else if render.activeDoc(state) is Result.Ok(doc) {
		body = docBody(state, t, doc, extra)
	}
	return ui.column([ui.grow(1), fill(t.editor), ui.scroll(ui.Axis.Vertical())], [
		tabStrip(state, t),
		breadcrumb(state, t),
		findBox(state, t),
		body,
		suggestions(state, t),
		vimBar(state, t)
	])
}

// ── painel inferior ──────────────────────────────────────────────────────

func paneTab(t: theme.Theme, text: Str, message: model.Cmd, on: Bool): hive.ui.View {
	mut color := t.muted
	if on {
		color = t.text
	}
	return clickable(color, text, message, "")
}

// A Saída e o Terminal: o texto só para ler, com o cursor no fim — e o editor
// rola até o cursor, então a caixa acompanha o fim quando chega texto novo.
func preText(t: theme.Theme, text: Str): hive.ui.View {
	end := len(text)
	return ui.code(plus(paneLook(), [ui.grow(1), ui.readOnly(true), fill(t.panel), tone(t.text), ui.caret(end, end, end)]), text, [])
}

func terminalBody(state: model.State, t: theme.Theme): hive.ui.View {
	term := state.term
	mut hive.ui.View[dyn] items = [preText(t, term.log)]
	if term.session == 0 {
		append(items, empty(t, tx(state, "Terminal encerrado — Enter abre um novo.")))
	}
	append(items, ui.row([ui.gap(6), ui.pad(6), ui.align(ui.Align.Center())], [
		label(t.accent, "›"),
		ui.column([ui.grow(1)], [
			inputField(t, plus(plus(focusOn(state, "termInput"), keyed("term", false)), [ui.onInput(field("termInput", _)), ui.onSubmit(actText("termSubmit", "", _)),
				ui.placeholder(terminalHint(state))]), term.input)
		]),
		headerAction(t, "↑", tx(state, "Anterior"), act("termHistory", "-1")),
		headerAction(t, "↓", tx(state, "Próximo"), act("termHistory", "1"))
	]))
	return ui.column([ui.grow(1)], items)
}

func agentPicker(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] items = []
	for each preset in agents.presets() {
		mut color := t.muted
		if preset.id == state.agents.current {
			color = t.accent
		}
		append(items, clickable(color, preset.label, act("agent", preset.id), ""))
	}
	return ui.row([ui.gap(12)], items)
}

func agentBody(state: model.State, t: theme.Theme): hive.ui.View {
	current := agents.sessionOf(state.agents, state.agents.current)
	mut hive.ui.View[dyn] items = []
	if current.problem != "" {
		mut problem := current.problem
		if problem is "{program}: não encontrado no PATH" {
			problem = program + ": " + tx(state, "não encontrado no PATH")
		}
		append(items, ui.row([ui.gap(8), ui.pad(8), ui.align(ui.Align.Center())], [
			label(t.danger, problem + ". " + tx(state, "Instale o programa ou ajuste o comando em Configurações → Agentes.")),
			clickable(t.accent, tx(state, "Configurações"), act("settings", ""), "")
		]))
	} else if current.exited {
		append(items, ui.row([ui.gap(8), ui.pad(8), ui.align(ui.Align.Center())], [
			label(t.muted, tx(state, "O agente terminou") + " (" + tx(state, "código") + " {current.code})."),
			clickable(t.accent, "↻ " + tx(state, "Abrir de novo"), act("agentRestart", current.agent), "")
		]))
	}
	if current.session != 0 && !current.exited {
		append(items, agentScreen(state, t, current.session))
	}
	return ui.column([ui.grow(1)], items)
}

// ── o terminal dos agentes ───────────────────────────────────────────────
//
// A tela é a do emulador de lib/pty.go (vt10x): o texto, linha a linha, e os
// trechos com cor; desenhada num `ui.code` só de leitura, que toma todas as
// teclas e as manda ao programa — menos os atalhos que saem do agente.

type TermRun {
	from: Int
	to:   Int
	fg:   Str
	bg:   Str
	line: Bool
}

type TermScreen {
	x:      Int
	y:      Int
	cursor: Bool
	cols:   Int
	rows:   Int
	text:   Str
	runs:   TermRun[dyn]
}

func termColor(t: theme.Theme, color: Str): Str {
	if color == "fg" {
		return t.text
	} else if color == "bg" {
		return t.panel
	}
	return color
}

func agentKeyCmd(session: Int, ide: Str[], combo: Str): model.Cmd {
	if indexOf(ide, combo) is Result.Ok(_) {
		return keyCmd("", 0, combo)
	}
	return chrome("pty", "{session}|" + combo)
}

func agentPasteCmd(session: Int, text: Str): model.Cmd {
	return chrome("ptyPaste", "{session}|" + text)
}

func agentFitCmd(session: Int, cols: Int, rows: Int): model.Cmd {
	return chrome("ptyFit", "{session}|{cols},{rows}")
}

func agentScreen(state: model.State, t: theme.Theme, session: Int): hive.ui.View {
	TermRun[dyn] none = []
	mut screen := TermScreen(0, 0, false, 80, 24, "", none)
	if TermScreen.decode(pty.screen(session), hive.json.codec()) is Result.Ok(read) {
		screen = read
	}
	mut hive.ui.Run[dyn] runs = []
	for each r in screen.runs {
		if r.bg != "bg" {
			append(runs, ui.shade(r.from, r.to, hex(termColor(t, r.bg))))
		}
		if r.fg != "fg" {
			append(runs, ui.ink(r.from, r.to, hex(termColor(t, r.fg))))
		}
		if r.line {
			append(runs, ui.underline(r.from, r.to, hex(termColor(t, r.fg))))
		}
	}
	lines := split(screen.text, "\n")
	starts := lineStarts(lines)
	mut at := 0
	if starts bounds screen.y {
		at = starts[screen.y] + screen.x
	}
	mut attrs := plus(paneLook(), [ui.grow(1), ui.readOnly(true), fill(t.panel), tone(t.text),
		ui.caret(at, at, pty.serial(session)),
		ui.keys(["Any"]), ui.onKey(agentKeyCmd(session, render.agentKeys(state.settings.keymap), _)),
		ui.onPaste(agentPasteCmd(session, _)), ui.onFit(agentFitCmd(session, _, _))])
	if state.focus == "agent" {
		append(attrs, ui.focus(state.focusSerial))
	}
	return ui.code(attrs, screen.text, runs)
}

func scoreColor(t: theme.Theme, score: Int): Str {
	if score <= 40 {
		return t.danger
	} else if score <= 70 {
		return t.warn
	}
	return t.good
}

func analysisBody(state: model.State, t: theme.Theme): hive.ui.View {
	if len(state.analysisHead) == 0 {
		return empty(t, tx(state, "Rode Executar → Analyze para ver o custo de cada função."))
	}
	mut hive.ui.View[dyn] rows = []
	for each line in state.analysisHead {
		append(rows, label(t.text, line))
	}
	if state.analysisReport != "" {
		append(rows, clickable(t.accent, tx(state, "Abrir o relatório completo"), act("openReport", ""), ""))
	}
	for each spot in state.hotspots {
		append(rows, ui.row([ui.gap(10), ui.align(ui.Align.Center())], [
			ui.row([ui.width(32)], [label(scoreColor(t, spot.score), "{spot.score}")]),
			clickable(t.text, spot.name, actText("openAt", spot.file, "{spot.line}:0"), spot.detail),
			small(t.muted, spot.detail),
			ui.spacer(),
			small(t.muted, workspace.baseName(spot.file) + " [{spot.line}]")
		]))
	}
	return ui.column([ui.gap(4), ui.pad(8)], rows)
}

func problemsBody(state: model.State, t: theme.Theme): hive.ui.View {
	if len(state.diagnostics) == 0 {
		return empty(t, tx(state, "Nenhum problema foi detectado."))
	}
	mut hive.ui.View[dyn] rows = []
	for each d in state.diagnostics {
		append(rows, ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
			label(t.danger, "⊗"),
			clickable(t.text, d.message, actText("openAt", d.file, "{d.line}:0"), d.file),
			ui.spacer(),
			clickable(t.muted, workspace.baseName(d.file) + " [{d.line}]", actText("peek", d.file, "{d.line}"), tx(state, "Espiar"))
		]))
	}
	return ui.column([ui.gap(4), ui.pad(8)], rows)
}

func gripCmd(dx: Int, dy: Int, done: Bool): model.Cmd {
	mut end := "0"
	if done {
		end = "1"
	}
	return chrome("drag", "{dy},{end}")
}

func panel(state: model.State, t: theme.Theme, extra: Chrome): hive.ui.View {
	problems := state.pane is model.Pane.ProblemsPane
	analyzing := state.pane is model.Pane.AnalysisPane
	terminal := state.pane is model.Pane.TerminalPane
	agent := state.pane is model.Pane.AgentPane
	mut body := preText(t, state.output)
	mut hive.ui.View[dyn] actions = [headerAction(t, "⌫", tx(state, "Limpar"), act("clear", ""))]
	if terminal {
		body = terminalBody(state, t)
		actions = [
			headerAction(t, "⌫", tx(state, "Limpar"), act("termClear", "")),
			headerAction(t, "■", tx(state, "Encerrar o processo (reinicia o shell)"), act("termRestart", ""))
		]
	} else if agent {
		body = agentBody(state, t)
		actions = [
			agentPicker(state, t),
			headerAction(t, "↻", tx(state, "Reiniciar o agente") + render.keyHint(state, "agentRestart"), act("agentRestart", state.agents.current))
		]
	} else if problems {
		body = problemsBody(state, t)
	} else if analyzing {
		body = analysisBody(state, t)
		actions = []
		if state.analysisReport != "" {
			actions = [headerAction(t, "⧉", tx(state, "Abrir o relatório completo"), act("openReport", ""))]
		}
	}
	mut maxGlyph := "⤢"
	mut maxTip := tx(state, "Maximizar painel")
	if state.panelMax {
		maxGlyph = "⤡"
		maxTip = tx(state, "Restaurar painel")
	}
	mut hive.ui.View[dyn] head = [
		paneTab(t, tx(state, "PROBLEMAS") + "  {len(state.diagnostics)}", act("pane", "problems"), problems)
	]
	if len(state.analysisHead) > 0 || analyzing {
		append(head, paneTab(t, tx(state, "ANÁLISE"), act("pane", "analysis"), analyzing))
	}
	append(head, paneTab(t, tx(state, "SAÍDA"), act("pane", "output"), !problems && !analyzing && !terminal && !agent))
	append(head, paneTab(t, tx(state, "TERMINAL"), act("pane", "terminal"), terminal))
	append(head, paneTab(t, tx(state, "AGENTE"), act("pane", "agent"), agent))
	append(head, ui.spacer())
	for each a in actions {
		append(head, a)
	}
	append(head, headerAction(t, maxGlyph, maxTip + render.keyHint(state, "maximizePanel"), act("panelMax", "")))
	append(head, headerAction(t, "✕", tx(state, "Fechar painel") + render.keyHint(state, "togglePanel"), act("togglePanel", "")))
	mut hive.ui.Attr[dyn] box = [fill(t.panel), ui.scroll(ui.Axis.Vertical())]
	if state.panelMax {
		append(box, ui.grow(3))
	} else if extra.dragBase >= 0 {
		append(box, ui.height(extra.dragHeight))
	} else {
		append(box, ui.height(state.settings.panelHeight))
	}
	mut hive.ui.Attr[dyn] bodyBox = [ui.grow(1), ui.scroll(ui.Axis.Vertical())]
	if agent {
		bodyBox = [ui.grow(1)]
	}
	return ui.column(box, [
		// O puxador: arrastar muda a altura do painel; o duplo clique maximiza.
		ui.row([ui.height(5), fill(t.border), ui.onDrag(gripCmd(_, _, _)), ui.onDouble(act("panelMax", ""))], []),
		ui.row([ui.gap(16), ui.pad(8), ui.align(ui.Align.Center())], head),
		ui.column(bodyBox, [body])
	])
}

// ── barra de status ──────────────────────────────────────────────────────

func statusText(t: theme.Theme, text: Str): hive.ui.View {
	return small(t.statusFg, text)
}

func statusClick(t: theme.Theme, text: Str, message: model.Cmd, tip: Str): hive.ui.View {
	return ui.link([ui.on(message), tone(t.statusFg), ui.size(ui.TextSize.Caption()), ui.hint(tip), ui.hover(hex("#00000022")), ui.radius(3)], "#", text)
}

func statusBar(state: model.State, t: theme.Theme): hive.ui.View {
	mut hive.ui.View[dyn] items = [
		statusText(t, "⬡ Hive"),
		statusClick(t, "⊗ {len(state.diagnostics)}", act("pane", "problems"), tx(state, "Problemas"))
	]
	if state.git.repo {
		append(items, statusClick(t, "⑂ " + state.git.branch, act("side", "git"), tx(state, "Controle de código")))
	}
	append(items, statusText(t, state.status))
	append(items, ui.spacer())
	if render.activeDoc(state) is Result.Ok(doc) {
		if render.showsDoc(state) {
			append(items, statusText(t, render.caretPosition(doc.text, state.caret)))
			append(items, statusText(t, "Tab: {state.settings.tabSize}"))
			mut language := tx(state, "Texto")
			if doc.path is "{stem}.hive" {
				language = "Hive"
			} else if model.isMarkdown(doc.path) {
				language = "Markdown"
			} else if doc.path is "{stem}.go" {
				language = "Go"
			} else if model.isJson(doc.path) {
				language = "JSON"
			}
			append(items, statusText(t, language))
			if doc.eol == "\r\n" {
				append(items, statusText(t, "CRLF"))
			} else {
				append(items, statusText(t, "LF"))
			}
			if doc.path != state.entrypoint && doc.path is "{stem}.hive" {
				append(items, statusClick(t, tx(state, "📌 Fixar como entrada"), act("pin", ""), tx(state, "Check/Run/Test/Build passam a usar este arquivo")))
			}
		}
	}
	if state.entrypoint != "" {
		append(items, statusText(t, "▶ " + workspace.baseName(state.entrypoint)))
	}
	if state.settings.vim {
		mut recording := ""
		if state.vim.recordingTo != "" {
			recording = " ● @" + state.vim.recordingTo
		}
		append(items, statusClick(t, "VIM " + render.vimModeText(state) + recording, action("toggleVim"), tx(state, "Modo Vim — clique para desligar")))
	}
	append(items, statusClick(t, "◐ " + t.name, act("settings", ""), tx(state, "Trocar tema")))
	append(items, statusClick(t, "▭", act("togglePanel", ""), tx(state, "Painel") + render.keyHint(state, "togglePanel")))
	return ui.row([ui.gap(14), ui.pad(4), ui.align(ui.Align.Center()), fill(t.statusBg)], items)
}

// ── janelas por cima ─────────────────────────────────────────────────────

func dialog(t: theme.Theme, children: hive.ui.View[], dismiss: model.Cmd): hive.ui.View {
	return ui.overlay([ui.onDismiss(dismiss)], ui.column([ui.width(480), ui.gap(10), ui.pad(20), fill(t.panel), tone(t.text)], children))
}

func question(state: model.State, t: theme.Theme, title: Str, detail: Str, buttons: hive.ui.View[], dismiss: model.Cmd): hive.ui.View {
	return dialog(t, [strong(t.text, title), small(t.muted, detail), ui.row([ui.gap(8), ui.justify(ui.Justify.Center())], buttons)], dismiss)
}

func overlays(state: model.State, t: theme.Theme): hive.ui.View {
	if state.recording != "" {
		mut name := state.recording
		for each a in keys.actions() {
			if a.id == state.recording {
				name = tx(state, a.label)
			}
		}
		return dialog(t, [strong(t.text, name), small(t.muted, tx(state, "Pressione a nova combinação de teclas. Esc cancela."))], act("escape", ""))
	}
	if state.about {
		return dialog(t, [
			ui.text([tone(t.accent), ui.size(ui.TextSize.Title())], "⬡"),
			strong(t.text, "Hive Studio"),
			label(t.text, tx(state, "Uma IDE para Hive, escrita em Hive.")),
			small(t.muted, tx(state, "Versão") + " " + version.current() + " · hive.ui"),
			small(t.muted, tx(state, "Configurações em") + " " + settings.path()),
			ui.row([ui.justify(ui.Justify.Center())], [button(t, tx(state, "Fechar"), act("closeAbout", ""), true)])
		], act("closeAbout", ""))
	}
	if state.closing != "" {
		return question(state, t, tx(state, "Salvar as alterações de") + " " + workspace.baseName(state.closing) + "?",
			tx(state, "Se você não salvar, as alterações se perdem."), [
				button(t, tx(state, "Cancelar"), act("cancelDialog", ""), true),
				danger(t, tx(state, "Fechar sem salvar"), act("closeDiscard", state.closing)),
				primary(t, tx(state, "Salvar e fechar"), act("closeSave", state.closing), true)
			], act("cancelDialog", ""))
	}
	if state.removing != "" {
		mut warning := tx(state, "O arquivo é apagado do disco. Isto não pode ser desfeito.")
		if render.isFolder(state, state.removing) {
			warning = tx(state, "A pasta e tudo o que ela tem dentro são apagados do disco. Isto não pode ser desfeito.")
		}
		return question(state, t, tx(state, "Excluir") + " " + workspace.baseName(state.removing) + "?", warning, [
			button(t, tx(state, "Cancelar"), act("cancelDialog", ""), true),
			danger(t, tx(state, "Excluir"), act("remove", state.removing))
		], act("cancelDialog", ""))
	}
	if state.git.confirm != "" {
		return question(state, t, tx(state, "Descartar as alterações de") + " " + state.git.confirm + "?",
			tx(state, "Isto não pode ser desfeito. Um arquivo novo é apagado."), [
				button(t, tx(state, "Cancelar"), act("gitCancel", ""), true),
				danger(t, tx(state, "Descartar"), act("gitDiscard", state.git.confirm))
			], act("gitCancel", ""))
	}
	if state.peekFile != "" {
		mut hive.ui.View[dyn] lines = []
		for each line in analysis.excerpt(state.peekText, state.peekLine, 7) {
			mut body := line
			mut hit := false
			if line is "> {rest}" {
				hit = true
				body = rest
			} else if line is "  {rest}" {
				body = rest
			}
			mut hive.ui.Attr[dyn] box = [ui.gap(10)]
			if hit {
				append(box, fill(t.selection))
			}
			if body is "{number is ( *\d+)}  {source}" {
				append(lines, ui.row(box, [small(t.gutter, number), codeLine(t, highlight.highlight(source), -1, 4)]))
			} else {
				append(lines, ui.row(box, [label(t.text, body)]))
			}
		}
		return ui.overlay([ui.onDismiss(act("closePeek", ""))], ui.column([ui.width(760), ui.gap(8), ui.pad(16), fill(t.panel), tone(t.text)], [
			ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
				strong(t.text, workspace.baseName(state.peekFile) + ":{state.peekLine}"),
				ui.spacer(),
				button(t, tx(state, "Abrir"), actText("openAt", state.peekFile, "{state.peekLine}:0"), true),
				button(t, tx(state, "Fechar"), act("closePeek", ""), true)
			]),
			ui.column([ui.pad(codePad()), fill(t.editor)], lines)
		]))
	}
	return ui.none()
}

// Ctrl+P: achar um arquivo da pasta pelo nome.
func palette(state: model.State, t: theme.Theme): hive.ui.View {
	if !state.palette.open {
		return ui.none()
	}
	found := render.paletteMatches(state.palette)
	mut hive.ui.View[dyn] items = []
	for i := 0; i < len(found); i++ {
		rel := vim.at(state.palette.files, found[i])
		name := workspace.baseName(rel)
		mut hive.ui.Attr[dyn] box = [ui.gap(8), ui.pad(4), ui.align(ui.Align.Center())]
		if i == state.palette.index {
			append(box, fill(t.selection))
		}
		append(items, ui.row(box, [fileIcon(name), clickable(t.text, name, act("paletteAccept", "{i}"), rel), small(t.muted, render.folderOf(rel))]))
	}
	if len(found) == 0 {
		append(items, empty(t, tx(state, "Nenhum arquivo encontrado")))
	}
	return ui.overlay([ui.onDismiss(act("escape", ""))], ui.column([ui.width(620), ui.gap(8), ui.pad(12), fill(t.panel), tone(t.text)], [
		inputField(t, plus(plus(focusOn(state, "palette"), keyed("palette", false)), [ui.onInput(field("palette", _)), ui.onSubmit(actText("paletteAccept", "{state.palette.index}", _)),
			ui.placeholder(tx(state, "Buscar arquivo pelo nome"))]), state.palette.text),
		ui.column([ui.gap(1), ui.height(380), ui.scroll(ui.Axis.Vertical())], items)
	]))
}

// O placeholder da linha de comando do Vim: invisível (U+2800), e é por ele
// que a ponte a acha.
func vimMark(): Str {
	return "⠀"
}

// O editor de texto está à vista (e não só a vista realçada, nem outra tela).
func editorShown(state: model.State): Bool {
	if render.showsDoc(state) {
		if render.activeDoc(state) is Result.Ok(doc) {
			mode := modeOf(doc)
			return mode == "edit" || mode == "split"
		}
	}
	return false
}

// O título da janela, como o da janela própria: "● nome — pasta — Hive Studio".
func windowTitle(state: model.State): Str {
	if render.activeDoc(state) is Result.Ok(doc) {
		mut mark := ""
		if model.dirty(doc) {
			mark = "● "
		}
		return mark + doc.name + " — " + workspace.baseName(state.root) + " — Hive Studio"
	}
	return "Hive Studio"
}

func terminalHint(state: model.State): Str {
	return tx(state, "comando (↑ ↓ histórico, Ctrl+C encerra o processo)")
}

// ── tudo junto ───────────────────────────────────────────────────────────

func window(state: model.State, extra: Chrome): hive.ui.View {
	t := theme.byName(state.settings.theme)
	mut hive.ui.View[dyn] body = [activityBar(state, t)]
	if state.sideOpen {
		append(body, sidePanel(state, t, extra))
	}
	mut hive.ui.View[dyn] main = [editorArea(state, t, extra)]
	if state.panelOpen {
		append(main, panel(state, t, extra))
	}
	append(body, ui.column([ui.grow(1), ui.scroll(ui.Axis.Vertical())], main))
	selected := native.slice(render.searched(state), minInt(extra.anchor, state.caret), maxInt(extra.anchor, state.caret) - minInt(extra.anchor, state.caret))
	mut hive.ui.View[dyn] top = []
	if extra.e2e {
		append(top, ui.input([ui.placeholder("hive-event"), ui.onInput(model.Cmd.Ui(_)), ui.width(1)], ""))
	}
	append(top, titleBar(state, t, extra.menu))
	return ui.column([ui.grow(1), fill(t.editor), tone(t.text), ui.scroll(ui.Axis.Vertical()), ui.title(windowTitle(state)),
		ui.keys(windowKeys(state)), ui.onKey(keyCmd(selected, state.caret, _)), ui.clip(state.vim.clip, state.vim.clipSerial)], [
		ui.column([], top),
		ui.row([ui.grow(1), ui.scroll(ui.Axis.Both())], body),
		statusBar(state, t),
		menuDrop(state, t, extra.menu),
		contextMenu(state, t),
		palette(state, t),
		overlays(state, t)
	])
}
