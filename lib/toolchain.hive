// Chama o compilador fora da janela e devolve o resultado como mensagem.

import ./model
import ./process
import ./settings
import ./search
import ./workspace
import ./complete
import ./analysis
import ./native.go

// `HIVEC` no ambiente (ou num `.env` ao lado) vence a configuração.
func compilerPath(configured: Str): Str {
	if hive.env.get("HIVEC") is Result.Ok(path) {
		if path != "" {
			return path
		}
	}
	if configured != "" {
		return configured
	}
	return "hivec"
}

// Roda numa thread própria: a janela continua respondendo enquanto isso.
proc invoke(window: hive.syslink.Address, compiler: Str, command: Str, entrypoint: Str): void {
	result := process.run(compilerPath(compiler), [command, entrypoint], "")
	mut output := result.text
	if result.code == -1 {
		output = "não foi possível iniciar {compilerPath(compiler)}: {result.text}\nInstale o Hive ou ajuste o compilador nas Configurações."
	}
	async window(model.Cmd.Post(model.Msg.Finished(command, output, result.code == 0)))
}

// Um documento com alterações por salvar: o check do Error Lens usa o texto dele.
type Overlay {
	path: Str
	text: Str
}

// Onde fica a cópia do projeto que o Error Lens confere.
func lensFolder(): Str {
	return settings.folder() + "/lens"
}

// `path` relativo a `root`, ou "" quando está fora dela.
func inside(root: Str, path: Str): Str {
	base := workspace.normalize(root) + "/"
	clean := workspace.normalize(path)
	if complete.startsWith(clean, base) {
		return complete.skip(clean, len(base))
	}
	return ""
}

// Um arquivo na cópia do Error Lens: o carimbo (tamanho e data) de quando
// foi copiado — "overlay" quando veio do editor — e os arquivos que ele importa.
type Copied {
	rel:     Str
	stamp:   Str
	imports: Str[dyn]
}

func manifestText(entries: Copied[]): Str {
	mut Str[dyn] lines = []
	for each e in entries {
		append(lines, e.rel + "\t" + e.stamp + "\t" + join(e.imports, "|"))
	}
	return join(lines, "\n")
}

func parseManifest(text: Str): hive.map.Map<Str, Copied> {
	mut hive.map.Map<Str, Copied> found = hive.map.new()
	for each line in split(text, "\n") {
		if line is "{rel}\t{stamp}\t{deps}" {
			mut Str[dyn] imports = []
			if deps != "" {
				imports = split(deps, "|")
			}
			hive.map.set(found, rel, Copied(rel, stamp, imports))
		}
	}
	return found
}

func relOf(path: Str): Str {
	if path is "./{rest}" {
		return rest
	}
	return path
}

// Os arquivos (relativos à pasta do projeto) que `rel` importa; os de fora
// da pasta ficam de fora da cópia.
func localImports(text: Str, rel: Str): Str[dyn] {
	mut Str[dyn] found = []
	for each i in analysis.importsOf(text, workspace.parentOf(rel)) {
		path := relOf(i.path)
		if !complete.startsWith(path, "../") {
			append(found, path)
		}
	}
	return found
}

proc put(copy: Str, text: Str): void {
	_made := hive.file.makeDir(workspace.parentOf(copy))
	_written := hive.file.write(copy, text)
}

// Um arquivo do programa na cópia: o texto do editor (se tem alterações por
// salvar), ou o do disco, que só é relido e regravado se mudou de tamanho ou
// de data. `Error` quando ele não existe mais.
proc syncOne(mirror: Str, root: Str, rel: Str, edited: hive.map.Map<Str, Str>, before: hive.map.Map<Str, Copied>): Result<Copied, Bool> {
	copy := mirror + "/" + rel
	if hive.map.get(edited, rel) is Result.Ok(text) {
		put(copy, text)
		return Result.Ok(Copied(rel, "overlay", localImports(text, rel)))
	}
	path := workspace.joinPath(root, rel)
	if native.stamp(path) is Result.Ok(current) {
		if hive.map.get(before, rel) is Result.Ok(old) {
			if old.stamp == current {
				return Result.Ok(Copied(rel, current, old.imports))
			}
		}
		mut Str[dyn] imports = []
		if hive.file.read(path) is Result.Ok(content) {
			put(copy, content)
			if rel is "{stem}.hive" {
				imports = localImports(content, rel)
			}
		}
		return Result.Ok(Copied(rel, current, imports))
	}
	return Result.Error(false)
}

// Apaga da cópia os arquivos da lista que não fazem mais parte do programa.
proc dropStale(mirror: Str, files: Str[], kept: hive.map.Map<Str, Bool>): void {
	for each rel in files {
		if !hive.map.has(kept, rel) {
			_gone := hive.file.delete(mirror + "/" + rel)
		}
	}
}

// Deixa em `mirror` só o programa que `target` importa, em cadeia, com o texto
// não salvo dos documentos abertos. Um arquivo que não mudou desde a última
// vez (mesmo tamanho e data) não é relido nem regravado; o que saiu do
// programa, ou do disco, sai da cópia. Devolve `target` relativo à pasta, ou
// "" quando ele está fora dela.
proc lensSync(mirror: Str, root: Str, target: Str, overlays: Overlay[]): Str {
	targetRel := inside(root, target)
	if targetRel == "" {
		return ""
	}
	manifest := mirror + "/.copiados"
	mut first := true
	mut hive.map.Map<Str, Copied> before = hive.map.new()
	if hive.file.read(manifest) is Result.Ok(text) {
		before = parseManifest(text)
		first = false
	}
	mut hive.map.Map<Str, Str> edited = hive.map.new()
	for each o in overlays {
		rel := inside(root, o.path)
		if rel != "" {
			hive.map.set(edited, rel, o.text)
		}
	}
	mut Copied[dyn] now = []
	mut hive.map.Map<Str, Bool> kept = hive.map.new()
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	mut Str[dyn] pending = [targetRel]
	for ; len(pending) > 0 && len(now) < 5000; {
		last := len(pending) - 1
		mut rel := ""
		if pending bounds last {
			rel = pending[last]
			drop(pending, last, last)
		}
		if rel == "" || hive.map.has(seen, rel) {
			continue
		}
		hive.map.set(seen, rel, true)
		if syncOne(mirror, root, rel, edited, before) is Result.Ok(copied) {
			append(now, copied)
			hive.map.set(kept, rel, true)
			for each i in copied.imports {
				append(pending, i)
			}
		}
	}
	dropStale(mirror, hive.map.keys(before), kept)
	// Sem registro (a primeira vez, ou uma cópia antiga): o que sobrar sai.
	if first {
		mut Str[dyn] copies = []
		for each rel in search.allFiles(mirror, true, 20000) {
			if rel is "{stem}.hive" || rel is "{stem}.go" {
				append(copies, rel)
			}
		}
		dropStale(mirror, copies, kept)
	}
	_made := hive.file.makeDir(mirror)
	_saved := hive.file.write(manifest, manifestText(now))
	return targetRel
}

// O check do Error Lens: confere a cópia do programa (ver `lensSync`), com o
// texto ainda não salvo — assim o erro aparece enquanto se digita, sem salvar
// nada. A saída volta com os caminhos do projeto.
proc lensCheck(window: hive.syslink.Address, compiler: Str, root: Str, target: Str, overlays: Overlay[]): void {
	mirror := lensFolder()
	rel := lensSync(mirror, root, target, overlays)
	mut output := ""
	if rel != "" {
		result := process.run(compilerPath(compiler), ["check", mirror + "/" + rel], "")
		output = replaceAll(replaceAll(result.text, "\\", "/"), mirror + "/", workspace.normalize(root) + "/")
	}
	async window(model.Cmd.Post(model.Msg.LensDone(output)))
}

// Espera a digitação parar: só o último pedido (`n`) vira um check.
proc lensTimer(window: hive.syslink.Address, n: Int): void {
	hive.task.sleep(700)
	async window(model.Cmd.Post(model.Msg.LensDue(n)))
}

test "a cópia do Error Lens tem só o programa, e só regrava o que mudou" {
	root := "./lens-test"
	mirror := "./lens-test-copia"
	_made := hive.file.makeDir(root + "/lib")
	_a := hive.file.write(root + "/main.hive", "import ./lib/util\n\nproc main(): void \{\n\techo util.dobro(2)\n}\n")
	_b := hive.file.write(root + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n")
	_c := hive.file.write(root + "/solto.hive", "proc main(): void \{\n}\n")
	Overlay[dyn] none = []
	assert lensSync(mirror, root, root + "/main.hive", none) == "main.hive"
	assert hive.file.exists(mirror + "/main.hive") && hive.file.exists(mirror + "/lib/util.hive")
	assert !hive.file.exists(mirror + "/solto.hive")
	if hive.file.read(mirror + "/.copiados") is Result.Ok(text) {
		entries := parseManifest(text)
		if hive.map.get(entries, "main.hive") is Result.Ok(main) {
			assert main.imports == ["lib/util.hive"]
		} else {
			assert false
		}
	} else {
		assert false
	}
	// A cópia não é regravada se o arquivo não mudou: um texto trocado só na cópia fica.
	_touched := hive.file.write(mirror + "/lib/util.hive", "copia")
	_again := lensSync(mirror, root, root + "/main.hive", none)
	if hive.file.read(mirror + "/lib/util.hive") is Result.Ok(kept) {
		assert kept == "copia"
	}
	// O texto não salvo que para de importar o módulo tira o módulo da cópia.
	_edited := lensSync(mirror, root, root + "/main.hive", [Overlay(root + "/main.hive", "proc main(): void \{\n}\n")])
	assert !hive.file.exists(mirror + "/lib/util.hive")
	if hive.file.read(mirror + "/main.hive") is Result.Ok(copied) {
		assert copied == "proc main(): void \{\n}\n"
	}
	// Voltou a ser o do disco: é copiado de novo.
	_back := lensSync(mirror, root, root + "/main.hive", none)
	assert hive.file.exists(mirror + "/lib/util.hive")
	assert lensSync(mirror, root, "C:/fora/main.hive", none) == ""
}

test "um caminho relativo à pasta do projeto" {
	assert inside("C:/p", "C:/p/lib/a.hive") == "lib/a.hive"
	assert inside("C:/p/", "C:/p/a.hive") == "a.hive"
	assert inside("C:/p", "C:/outra/a.hive") == ""
}
