// Estado → página. Cada região da janela é um pedaço de HTML; a página troca
// só as regiões que mudaram. Tudo aqui é `func`: desenhar nunca altera o estado.
//
// Um clique volta como `data-act` (+ `data-arg`), um campo como `data-input`.

import ./model
import ./analysis
import ./workspace
import ./theme
import ./settings
import ./highlight
import ./markdown
import ./keys
import ./git
import ./i18n

// O texto da interface no idioma escolhido.
func tx(state: model.State, text: Str): Str {
	return i18n.tr(state.words, text)
}

func esc(text: Str): Str {
	return highlight.escape(text)
}

func attr(name: Str, value: Str): Str {
	return " " + name + "=\"" + esc(value) + "\""
}

func act(action: Str, arg: Str): Str {
	if arg == "" {
		return attr("data-act", action)
	}
	return attr("data-act", action) + attr("data-arg", arg)
}

func activeDoc(state: model.State): Result<model.Doc, Bool> {
	index := state.active
	if state.docs bounds index {
		return Result.Ok(state.docs[index])
	}
	return Result.Error(false)
}

func activePath(state: model.State): Str {
	if activeDoc(state) is Result.Ok(doc) {
		return doc.path
	}
	return ""
}

func showingCommit(state: model.State): Bool {
	return state.commit.key != "" && state.editorView == model.EditorView.CommitPage()
}

// O editor mostra um documento (e não Configurações nem um commit).
func showsDoc(state: model.State): Bool {
	return !showingSettings(state) && !showingCommit(state)
}

func showingSettings(state: model.State): Bool {
	return state.settingsOpen && state.editorView == model.EditorView.SettingsView()
}

// O arquivo que Check/Run/Test/Build recebem: o fixado, senão o ativo —
// desde que seja um `.hive`.
func targetOf(state: model.State): Str {
	if state.entrypoint != "" {
		return state.entrypoint
	}
	path := activePath(state)
	if path is "{stem}.hive" {
		return path
	}
	return ""
}

func layoutOf(state: model.State): Str {
	if showingCommit(state) {
		return "commit"
	}
	if showingSettings(state) {
		return "settings"
	}
	if activeDoc(state) is Result.Ok(doc) {
		if model.isMarkdown(doc.path) {
			return doc.mode
		}
		return "edit"
	}
	return "welcome"
}

func keyHint(state: model.State, action: Str): Str {
	combo := keys.keysFor(state.settings.keymap, action)
	if combo == "" {
		return ""
	}
	return " (" + combo + ")"
}

// ── barra de título e menus ──────────────────────────────────────────────

// O hexágono do Hive — o mesmo desenho do ícone da janela.
func logo(): Str {
	return "<svg class=\"logo\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M16 2.5 27.7 9.25v13.5L16 29.5 4.3 22.75V9.25z\" fill=\"#f5a623\"/>" +
		"<path d=\"M16 10 21.2 13v6L16 22l-5.2-3v-6z\" fill=\"#1b1d23\" opacity=\".82\"/></svg>"
}

func toolButton(state: model.State, label: Str, command: Str, cls: Str, ready: Bool): Str {
	mut disabled := ""
	if !ready {
		disabled = " disabled"
	}
	return "<button class=\"tb " + cls + "\"" + act("invoke", command) + attr("title", tx(state, command) + keyHint(state, command)) + disabled + ">" + label + "</button>"
}

// Um item de menu que dispara uma ação (a mesma dos atalhos de teclado).
func menuItem(state: model.State, label: Str, action: Str, enabled: Bool): Str {
	mut cls := "mi"
	if !enabled {
		cls = "mi disabled"
	}
	return "<div class=\"" + cls + "\"" + act("action", action) + "><span>" + esc(tx(state, label)) + "</span><span class=\"mk\">" +
		esc(keys.keysFor(state.settings.keymap, action)) + "</span></div>"
}

// Um item que a própria página resolve (desfazer, copiar…).
func menuClient(state: model.State, label: Str, command: Str, hint: Str): Str {
	return "<div class=\"mi\"" + attr("data-client", command) + "><span>" + esc(tx(state, label)) + "</span><span class=\"mk\">" + esc(hint) + "</span></div>"
}

func separator(): Str {
	return "<div class=\"msep\"></div>"
}

func menu(state: model.State, label: Str, items: Str[]): Str {
	return "<div class=\"menu\"><span class=\"mlabel\">" + esc(tx(state, label)) + "</span><div class=\"mdrop\">" + join(items, "") + "</div></div>"
}

func menuBar(state: model.State): Str {
	ready := state.running == "" && targetOf(state) != ""
	hasDoc := activeDoc(state) is Result.Ok(_)
	canClose := hasDoc || state.settingsOpen || state.commit.key != ""
	path := activePath(state)
	isHiveDoc := hasDoc && path is "{stem}.hive"
	return "<div class=\"menubar\">" +
		menu(state, "Arquivo", [
			menuItem(state, "Novo arquivo", "newFile", true),
			menuItem(state, "Nova pasta", "newFolder", true),
			separator(),
			menuItem(state, "Abrir arquivo…", "openFile", true),
			menuItem(state, "Abrir pasta…", "openFolder", true),
			separator(),
			menuItem(state, "Salvar", "save", hasDoc),
			menuItem(state, "Salvar tudo", "saveAll", model.anyDirty(state.docs)),
			separator(),
			menuItem(state, "Configurações", "settings", true),
			separator(),
			menuItem(state, "Fechar aba", "closeTab", canClose),
			menuItem(state, "Sair", "quit", true)
		]) +
		menu(state, "Editar", [
			menuClient(state, "Desfazer", "undo", "Ctrl+Z"),
			menuClient(state, "Refazer", "redo", "Ctrl+Y"),
			separator(),
			menuClient(state, "Recortar", "cut", "Ctrl+X"),
			menuClient(state, "Copiar", "copy", "Ctrl+C"),
			menuClient(state, "Colar", "paste", "Ctrl+V"),
			separator(),
			menuClient(state, "Selecionar tudo", "selectAll", "Ctrl+A"),
			separator(),
			menuItem(state, "Sugestões (autocomplete)", "suggest", hasDoc),
			menuItem(state, "Ir para a definição", "definition", hasDoc)
		]) +
		menu(state, "Ver", [
			menuItem(state, "Explorador", "explorer", true),
			menuItem(state, "Controle de código", "git", true),
			menuItem(state, "Estrutura", "outline", true),
			separator(),
			menuItem(state, "Mostrar/ocultar barra lateral", "toggleSidebar", true),
			menuItem(state, "Mostrar/ocultar painel (Problemas, Saída)", "togglePanel", true),
			menuItem(state, "Maximizar/restaurar painel", "maximizePanel", true),
			separator(),
			menuItem(state, "Problemas", "problems", true),
			menuItem(state, "Saída", "output", true),
			menuItem(state, "Terminal", "terminal", true),
			separator(),
			menuItem(state, "Preview do Markdown", "preview", hasDoc && model.isMarkdown(path)),
			menuItem(state, "Tema de cor…", "colorTheme", true)
		]) +
		menu(state, "Executar", [
			menuItem(state, "Check", "check", ready),
			menuItem(state, "Run", "run", ready),
			menuItem(state, "Test", "test", ready),
			menuItem(state, "Build", "build", ready),
			separator(),
			menuItem(state, "Fixar arquivo atual como entrada", "pin", isHiveDoc)
		]) +
		menu(state, "Terminal", [
			menuItem(state, "Novo terminal", "newTerminal", true),
			menuItem(state, "Terminal", "terminal", true),
			separator(),
			menuItem(state, "Limpar terminal", "termClear", true),
			menuItem(state, "Encerrar processo", "termRestart", state.term.session != 0)
		]) +
		menu(state, "Ajuda", [
			menuItem(state, "Documentação do Hive", "docs", true),
			menuItem(state, "Atalhos de teclado", "settings", true),
			separator(),
			menuItem(state, "Sobre o Hive Studio", "about", true)
		]) +
		"</div>"
}

func titleBar(state: model.State): Str {
	idle := state.running == ""
	ready := idle && targetOf(state) != ""
	mut busy := ""
	if !idle {
		busy = "<span class=\"muted\">⟳ " + esc(state.running) + "…</span>"
	}
	mut caption := workspace.baseName(state.root)
	if activeDoc(state) is Result.Ok(doc) {
		caption = doc.name + " — " + caption
	}
	return logo() + menuBar(state) +
		"<span class=\"grow\"></span><span class=\"caption\">" + esc(caption) + "</span><span class=\"grow\"></span>" + busy +
		"<div class=\"tools\">" +
		toolButton(state, "Check", "check", "", ready) +
		toolButton(state, "▶ Run", "run", "run", ready) +
		toolButton(state, "Test", "test", "", ready) +
		toolButton(state, "Build", "build", "", ready) + "</div>"
}

// ── barra de atividades ──────────────────────────────────────────────────

func activityItem(state: model.State, glyph: Str, tip: Str, side: model.SideView, arg: Str, action: Str): Str {
	mut cls := "ai"
	if state.sideOpen && state.side == side {
		cls = "ai on"
	}
	return "<div class=\"" + cls + "\"" + act("side", arg) + attr("title", tip + keyHint(state, action)) + ">" + glyph + "</div>"
}

func activityBar(state: model.State): Str {
	mut settingsCls := "ai"
	if showingSettings(state) {
		settingsCls = "ai on"
	}
	changes := len(state.git.files)
	mut gitGlyph := "⑂"
	if changes > 0 {
		gitGlyph = "⑂<span class=\"count\">{changes}</span>"
	}
	return activityItem(state, "❐", tx(state, "Explorador"), model.SideView.ExplorerSide(), "explorer", "explorer") +
		activityItem(state, gitGlyph, tx(state, "Controle de código"), model.SideView.GitSide(), "git", "git") +
		activityItem(state, "☰", tx(state, "Estrutura"), model.SideView.OutlineSide(), "outline", "outline") +
		"<div class=\"grow\"></div>" +
		"<div class=\"" + settingsCls + "\"" + act("settings", "") + attr("title", tx(state, "Configurações") + keyHint(state, "settings")) + ">⚙</div>"
}

// ── explorador ───────────────────────────────────────────────────────────

func headerAction(glyph: Str, tip: Str, action: Str, arg: Str): Str {
	return "<span class=\"act\"" + act(action, arg) + attr("title", tip) + ">" + glyph + "</span>"
}

func promptPlaceholder(state: model.State, prompt: model.Prompt): Str {
	if prompt is model.Prompt.NewFilePrompt {
		return tx(state, "nome do arquivo (ex.: main.hive)")
	} else if prompt is model.Prompt.NewFolderPrompt {
		return tx(state, "nome da pasta")
	} else if prompt is model.Prompt.OpenFolderPrompt {
		return tx(state, "caminho da pasta")
	} else if prompt is model.Prompt.NoPrompt {
		return ""
	}
}

func promptRow(state: model.State): Str {
	if state.prompt is model.Prompt.NoPrompt {
		return ""
	}
	return "<div class=\"prompt\"><input class=\"field\" data-input=\"prompt\" data-submit=\"promptSubmit\"" +
		attr("placeholder", promptPlaceholder(state, state.prompt)) + attr("value", state.promptText) + ">" +
		headerAction("✓", tx(state, "Confirmar (Enter)"), "promptSubmit", "") +
		headerAction("✕", tx(state, "Cancelar (Esc)"), "promptCancel", "") + "</div>"
}

func isOpenDoc(state: model.State, path: Str): Bool {
	for each doc in state.docs {
		if doc.path == path {
			return true
		}
	}
	return false
}

func dirtyPath(state: model.State, path: Str): Bool {
	for each doc in state.docs {
		if doc.path == path {
			return model.dirty(doc)
		}
	}
	return false
}

// O caminho de um item visto da pasta aberta, como o git o chama.
func relPath(state: model.State, path: Str): Str {
	return join(workspace.crumbs(state.root, path), "/")
}

func gitKindOf(state: model.State, path: Str): Str {
	return git.fileKind(state.git, relPath(state, path))
}

func gitBadge(state: model.State, path: Str): Str {
	rel := relPath(state, path)
	for each file in state.git.files {
		if file.rel == rel {
			kind := git.kindOf(file)
			return "<span class=\"gb " + git.cssOf(kind) + "\">" + git.badge(kind, file) + "</span>"
		}
	}
	return ""
}

func treeRow(state: model.State, row: model.TreeRow): Str {
	entry := row.entry
	current := entry.path == activePath(state) && showsDoc(state)
	mut cls := "row"
	if current {
		cls = "row on"
	}
	if entry.path == state.selected {
		cls = cls + " focus"
	}
	indent := attr("style", "padding-left:{8 + row.depth * 14}px")
	if entry.folder {
		mut chevron := "›"
		if row.open {
			chevron = "⌄"
		}
		kind := git.folderKind(state.git, relPath(state, entry.path))
		mut dot := ""
		if kind != "" {
			dot = "<span class=\"gb " + git.cssOf(kind) + "\">•</span>"
		}
		return "<div class=\"" + cls + "\"" + act("toggle", entry.path) + indent + ">" +
			"<span class=\"chev\">" + chevron + "</span><span class=\"nm " + git.cssOf(kind) + "\">" + esc(entry.name) + "</span>" + dot + "</div>"
	}
	icon := theme.iconFor(entry.name)
	mut marker := ""
	if dirtyPath(state, entry.path) {
		marker = "<span class=\"dirty\">●</span>"
	}
	return "<div class=\"" + cls + "\"" + act("open", entry.path) + indent + ">" +
		"<span class=\"chev\"></span><span class=\"ic\"" + attr("style", "color:" + icon.color) + ">" + esc(icon.glyph) + "</span>" +
		"<span class=\"nm " + git.cssOf(gitKindOf(state, entry.path)) + "\">" + esc(entry.name) + "</span>" + marker + gitBadge(state, entry.path) + "</div>"
}

func explorer(state: model.State): Str {
	mut Str[dyn] rows = []
	for each row in state.tree {
		append(rows, treeRow(state, row))
	}
	if len(state.tree) == 0 {
		append(rows, "<div class=\"empty\">" + tx(state, "Pasta vazia.") + "</div>")
	}
	return "<div class=\"hdr\">" + tx(state, "EXPLORADOR") + "<span class=\"grow\"></span>" +
		headerAction("＋", tx(state, "Novo arquivo") + keyHint(state, "newFile"), "prompt", "newFile") +
		headerAction("⊞", tx(state, "Nova pasta") + keyHint(state, "newFolder"), "prompt", "newFolder") +
		headerAction("⟳", tx(state, "Atualizar"), "refresh", "") +
		headerAction("⊟", tx(state, "Recolher tudo"), "collapse", "") +
		headerAction("↑", tx(state, "Pasta acima"), "up", "") +
		headerAction("…", tx(state, "Abrir pasta") + keyHint(state, "openFolder"), "action", "openFolder") + "</div>" +
		"<div class=\"root\"" + attr("title", state.root) + ">⌄ " + esc(workspace.baseName(state.root)) + "</div>" +
		promptRow(state) + join(rows, "")
}

func symbolGlyph(kind: Str): theme.FileIcon {
	if kind == "func" {
		return theme.FileIcon("ƒ", "#b180d7")
	} else if kind == "proc" {
		return theme.FileIcon("◉", "#75beff")
	} else if kind == "type" {
		return theme.FileIcon("T", "#ee9d28")
	} else if kind == "query" {
		return theme.FileIcon("Q", "#f55385")
	} else if kind == "test" {
		return theme.FileIcon("✓", "#89d185")
	}
	return theme.FileIcon("↳", "#8a8a8a")
}

func outlinePanel(state: model.State): Str {
	mut Str[dyn] rows = ["<div class=\"hdr\">" + tx(state, "ESTRUTURA") + "</div>"]
	if activeDoc(state) is Result.Ok(doc) {
		symbols := analysis.outline(doc.text)
		for each symbol in symbols {
			glyph := symbolGlyph(symbol.kind)
			append(rows, "<div class=\"sym\"" + act("peek", doc.path) + attr("data-text", "{symbol.line}") + ">" +
				"<span class=\"k\"" + attr("style", "color:" + glyph.color) + ">" + glyph.glyph + "</span>" +
				"<span>" + esc(symbol.name) + "</span><span class=\"ln\">{symbol.line}</span></div>")
		}
		if len(symbols) == 0 {
			append(rows, "<div class=\"empty\">" + tx(state, "Nenhuma declaração.") + "</div>")
		}
	} else {
		append(rows, "<div class=\"empty\">" + tx(state, "Nenhum arquivo aberto.") + "</div>")
	}
	return join(rows, "")
}

func gitRow(state: model.State, file: model.GitFile, stagedList: Bool): Str {
	kind := git.kindOf(file)
	name := workspace.baseName(file.path)
	parts := split(file.path, "/")
	mut folder := ""
	last := len(parts) - 2
	if parts bounds 0 && parts bounds last {
		folder = join(parts[0:last], "/")
	}
	icon := theme.iconFor(name)
	mut open := ""
	if kind != "deleted" {
		open = act("open", workspace.joinPath(state.git.top, file.path))
	}
	see := headerAction("±", tx(state, "Ver alterações"), "gitShowWork", file.path)
	mut actions := see + headerAction("↺", tx(state, "Descartar alterações"), "gitAskDiscard", file.path) + headerAction("+", tx(state, "Preparar (stage)"), "gitStage", file.path)
	if stagedList {
		actions = see + headerAction("−", tx(state, "Tirar da preparação (unstage)"), "gitUnstage", file.path)
	}
	return "<div class=\"row gitrow\"" + open + attr("title", file.path) + ">" +
		"<span class=\"ic\"" + attr("style", "color:" + icon.color) + ">" + esc(icon.glyph) + "</span>" +
		"<span class=\"nm " + git.cssOf(kind) + "\">" + esc(name) + "</span>" +
		"<span class=\"dir\">" + esc(folder) + "</span><span class=\"grow\"></span>" +
		"<span class=\"acts\">" + actions + "</span>" +
		"<span class=\"gb " + git.cssOf(kind) + "\">" + git.badge(kind, file) + "</span></div>"
}

func gitPanel(state: model.State): Str {
	info := state.git
	head := "<div class=\"hdr\">" + tx(state, "CONTROLE DE CÓDIGO") + "<span class=\"grow\"></span>" +
		headerAction("⟳", tx(state, "Atualizar"), "gitRefresh", "") +
		headerAction("↓", "Pull", "gitPull", "") +
		headerAction("↑", "Push", "gitPush", "") + "</div>"
	if !info.repo {
		return head + "<div class=\"empty\">" + tx(state, "Esta pasta não está num repositório git.") + "</div>" +
			"<div class=\"prompt\"><button class=\"btn primary\"" + act("gitInit", "") + ">" + tx(state, "Inicializar repositório") + "</button></div>"
	}
	stagedCount := git.count(info, true)
	changedCount := git.count(info, false)
	mut sync := ""
	if info.ahead > 0 || info.behind > 0 {
		sync = " <span class=\"muted\">↑{info.ahead} ↓{info.behind}</span>"
	}
	mut busy := ""
	if info.busy != "" {
		busy = "<span class=\"muted\">⟳ " + esc(info.busy) + "…</span>"
	}
	mut commitLabel := tx(state, "✓ Commit")
	if stagedCount == 0 {
		commitLabel = tx(state, "✓ Commit (tudo)")
	}
	mut disabled := ""
	if info.message == "" || len(info.files) == 0 || info.busy != "" {
		disabled = " disabled"
	}
	mut Str[dyn] stagedRows = []
	mut Str[dyn] changedRows = []
	for each file in info.files {
		if git.staged(file) {
			append(stagedRows, gitRow(state, file, true))
		}
		if git.unstaged(file) {
			append(changedRows, gitRow(state, file, false))
		}
	}
	mut body := ""
	if stagedCount > 0 {
		body = body + "<div class=\"hdr sub\">" + tx(state, "PREPARADAS") + "  {stagedCount}<span class=\"grow\"></span>" +
			headerAction("−", tx(state, "Tirar tudo da preparação"), "gitUnstageAll", "") + "</div>" + join(stagedRows, "")
	}
	if changedCount > 0 {
		body = body + "<div class=\"hdr sub\">" + tx(state, "ALTERAÇÕES") + "  {changedCount}<span class=\"grow\"></span>" +
			headerAction("+", tx(state, "Preparar tudo"), "gitStageAll", "") + "</div>" + join(changedRows, "")
	}
	if len(info.files) == 0 {
		body = "<div class=\"empty\">" + tx(state, "Nada para commitar — tudo em dia.") + "</div>"
	}
	mut Str[dyn] history = []
	for each line in info.log {
		if line is "{hash} {subject}" {
			mut cls := "logline"
			if state.commit.key != "" && git.startsWith(state.commit.key, hash) {
				cls = "logline on"
			}
			append(history, "<div class=\"" + cls + "\"" + act("gitShow", hash) + attr("title", line + " — " + tx(state, "clique para ver as alterações")) + ">" +
				"<span class=\"hash\">" + esc(hash) + "</span> " + esc(subject) + "</div>")
		}
	}
	return head +
		"<div class=\"branch\">⑂ " + esc(info.branch) + sync + busy + "</div>" +
		"<div class=\"commitbox\"><textarea class=\"field\" rows=\"3\" data-input=\"gitMessage\" data-ctrlsubmit=\"gitCommit\"" + attr("placeholder", tx(state, "Mensagem do commit (Ctrl+Enter)")) + ">" + esc(info.message) + "</textarea>" +
		"<button class=\"btn primary\"" + act("gitCommit", "") + disabled + ">" + commitLabel + "</button></div>" +
		body +
		"<div class=\"hdr sub\">" + tx(state, "HISTÓRICO") + "</div>" + join(history, "")
}

func sidePanel(state: model.State): Str {
	if state.side is model.SideView.OutlineSide {
		return outlinePanel(state)
	} else if state.side is model.SideView.GitSide {
		return gitPanel(state)
	}
	return explorer(state)
}

// ── abas e breadcrumb ────────────────────────────────────────────────────

func tab(state: model.State, index: Int, doc: model.Doc): Str {
	mut cls := "tab"
	if index == state.active && showsDoc(state) {
		cls = "tab on"
	}
	mut closer := "<span class=\"x\"" + act("close", "{index}") + attr("title", tx(state, "Fechar") + keyHint(state, "closeTab")) + ">×</span>"
	if model.dirty(doc) {
		closer = "<span class=\"x dirty\"" + act("close", "{index}") + attr("title", tx(state, "Não salvo — fechar")) + ">●</span>"
	}
	icon := theme.iconFor(doc.name)
	return "<div class=\"" + cls + "\"" + act("focus", "{index}") + attr("title", doc.path) + ">" +
		"<span class=\"ic\"" + attr("style", "color:" + icon.color) + ">" + esc(icon.glyph) + "</span>" +
		"<span class=\"" + git.cssOf(gitKindOf(state, doc.path)) + "\">" + esc(doc.name) + "</span>" + closer + "</div>"
}

func tabStrip(state: model.State): Str {
	mut Str[dyn] items = []
	for i := 0; i < len(state.docs); i++ {
		append(items, tab(state, i, state.docs[i]))
	}
	if state.settingsOpen {
		mut cls := "tab"
		if showingSettings(state) {
			cls = "tab on"
		}
		append(items, "<div class=\"" + cls + "\"" + act("settings", "") + "><span class=\"ic\">⚙</span><span>" + tx(state, "Configurações") + "</span>" +
			"<span class=\"x\"" + act("closeSettings", "") + ">×</span></div>")
	}
	if state.commit.key != "" {
		mut cls := "tab"
		if showingCommit(state) {
			cls = "tab on"
		}
		append(items, "<div class=\"" + cls + "\"" + act("focusCommit", "") + attr("title", state.commit.title) + ">" +
			"<span class=\"ic\" style=\"color:var(--accent)\">⑂</span><span>" + esc(state.commit.title) + "</span>" +
			"<span class=\"x\"" + act("closeCommit", "") + ">×</span></div>")
	}
	return join(items, "")
}

func modeSwitch(state: model.State, doc: model.Doc): Str {
	mut Str[dyn] items = []
	for each option in [["edit", "Editor"], ["split", "Dividir"], ["preview", "Preview"]] {
		mut cls := ""
		if option[0] == doc.mode {
			cls = " class=\"on\""
		}
		append(items, "<span" + cls + act("mode", option[0]) + ">" + tx(state, option[1]) + "</span>")
	}
	return "<div class=\"seg\">" + join(items, "") + "</div>"
}

func breadcrumb(state: model.State): Str {
	if showingCommit(state) {
		return "<span>" + tx(state, "Controle de código") + "  ›  " + esc(state.commit.title) + "</span>"
	}
	if showingSettings(state) {
		return "<span>" + tx(state, "Configurações") + "  ›  " + tx(state, "Usuário") + "</span>"
	}
	if activeDoc(state) is Result.Ok(doc) {
		mut Str[dyn] parts = []
		for each crumb in workspace.crumbs(state.root, doc.path) {
			append(parts, esc(crumb))
		}
		mut extra := ""
		if doc.path == state.entrypoint {
			extra = "<span>📌 " + tx(state, "entrada") + "</span>"
		}
		mut switch := ""
		if model.isMarkdown(doc.path) {
			switch = modeSwitch(state, doc)
		}
		return "<span>" + join(parts, "  ›  ") + "</span>" + extra + "<span class=\"grow\"></span>" + switch
	}
	return ""
}

// ── editor ───────────────────────────────────────────────────────────────

func gutter(text: Str): Str {
	lines := analysis.countLines(text)
	mut Str[dyn] numbers = []
	for n := 1; n <= lines; n++ {
		append(numbers, "{n}")
	}
	return join(numbers, "\n") + "\n\n\n"
}

func highlighted(state: model.State): Str {
	if activeDoc(state) is Result.Ok(doc) {
		return doc.html + "\n\n\n"
	}
	return ""
}

func preview(state: model.State): Str {
	if activeDoc(state) is Result.Ok(doc) {
		if model.isMarkdown(doc.path) && doc.mode != "edit" {
			return "<div class=\"md\">" + markdown.render(doc.text) + "</div>"
		}
	}
	return ""
}

func kindGlyph(kind: Str): theme.FileIcon {
	if kind == "keyword" {
		return theme.FileIcon("⌘", "#c586c0")
	} else if kind == "module" {
		return theme.FileIcon("\{}", "#e5c07b")
	} else if kind == "word" {
		return theme.FileIcon("ab", "#8a8a8a")
	}
	return symbolGlyph(kind)
}

func popup(state: model.State): Str {
	mut Str[dyn] items = []
	for i := 0; i < len(state.suggestions); i++ {
		s := state.suggestions[i]
		mut cls := "sg"
		if i == state.suggestIndex {
			cls = "sg on"
		}
		glyph := kindGlyph(s.kind)
		append(items, "<div class=\"" + cls + "\"" + act("accept", "{i}") + ">" +
			"<span class=\"k\"" + attr("style", "color:" + glyph.color) + ">" + esc(glyph.glyph) + "</span>" +
			"<span class=\"w\">" + esc(s.word) + "</span><span class=\"d\">" + esc(s.detail) + "</span></div>")
	}
	return join(items, "")
}

func welcome(state: model.State): Str {
	mut Str[dyn] rows = []
	for each id in ["newFile", "openFolder", "save", "run", "terminal", "togglePanel", "suggest", "settings"] {
		for each a in keys.actions() {
			if a.id == id {
				combo := keys.keysFor(state.settings.keymap, id)
				if combo != "" {
					append(rows, "<tr><td>" + esc(tx(state, a.label)) + "</td><td><kbd>" + esc(combo) + "</kbd></td></tr>")
				}
			}
		}
	}
	return "<div class=\"big\">" + logo() + "</div><h1>Hive Studio</h1><div>" + tx(state, "Abra um arquivo no explorador para começar.") + "</div>" +
		"<table>" + join(rows, "") + "</table>"
}

// ── configurações ────────────────────────────────────────────────────────

func option(value: Str, current: Str): Str {
	mut selected := ""
	if value == current {
		selected = " selected"
	}
	return "<option" + attr("value", value) + selected + ">" + esc(value) + "</option>"
}

// Um `select` cujas opções mostram um rótulo e mandam outro valor.
func selectLabeled(input: Str, values: Str[], labels: Str[], current: Str): Str {
	mut Str[dyn] options = []
	for i := 0; i < len(values); i++ {
		mut label := values[i]
		if labels bounds i {
			label = labels[i]
		}
		mut selected := ""
		if values[i] == current {
			selected = " selected"
		}
		append(options, "<option" + attr("value", values[i]) + selected + ">" + esc(label) + "</option>")
	}
	return "<select class=\"field\"" + attr("data-input", input) + ">" + join(options, "") + "</select>"
}

func languageCode(language: i18n.Language): Str {
	return language.code
}

func languageName(language: i18n.Language): Str {
	return language.name
}

func select(input: Str, values: Str[], current: Str): Str {
	mut Str[dyn] options = []
	for each v in values {
		append(options, option(v, current))
	}
	return "<select class=\"field\"" + attr("data-input", input) + ">" + join(options, "") + "</select>"
}

func check(name: Str, label: Str, on: Bool): Str {
	mut checked := ""
	if on {
		checked = " checked"
	}
	return "<label class=\"check\"" + act("setting", name) + "><input type=\"checkbox\"" + checked + "> " + esc(label) + "</label>"
}

func item(label: Str, description: Str, control: Str): Str {
	return "<div class=\"item\"><div class=\"lbl\">" + esc(label) + "</div><div class=\"dsc\">" + esc(description) + "</div>" + control + "</div>"
}

func swatch(color: Str): Str {
	return "<i" + attr("style", "background:" + color) + "></i>"
}

func themeCard(current: Str, t: theme.Theme): Str {
	mut cls := "card"
	if t.name == current {
		cls = "card on"
	}
	return "<div class=\"" + cls + "\"" + act("theme", t.name) + attr("style", "background:" + t.editor + ";color:" + t.text) + ">" +
		"<div class=\"sw\">" + swatch(t.side) + swatch(t.selection) + swatch(t.accent) + swatch(t.statusBg) + "</div>" +
		"<div>" + esc(t.name) + "</div>" +
		"<div class=\"code\"><span" + attr("style", "color:" + t.synKeyword) + ">proc</span> " +
		"<span" + attr("style", "color:" + t.synCall) + ">main</span>(): " +
		"<span" + attr("style", "color:" + t.synKeyword) + ">void</span></div>" +
		"<div class=\"code\"><span" + attr("style", "color:" + t.synComment) + ">// olá</span> " +
		"<span" + attr("style", "color:" + t.synString) + ">\"hive\"</span></div></div>"
}

func keyRow(state: model.State, a: keys.Action): Str {
	combo := keys.keysFor(state.settings.keymap, a.id)
	mut shown := "<kbd>" + esc(combo) + "</kbd>"
	if combo == "" {
		shown = "<span class=\"empty\">—</span>"
	}
	mut custom := ""
	mut resetButton := ""
	if !keys.isDefault(a.id, combo) {
		custom = "<span class=\"custom\">" + tx(state, "personalizado") + "</span>"
		resetButton = " <button class=\"btn\"" + act("resetKey", a.id) + ">" + tx(state, "Padrão") + "</button>"
	}
	mut cls := ""
	if state.recording == a.id {
		cls = " class=\"rec\""
		shown = "<span class=\"empty\">" + tx(state, "pressione as teclas…") + "</span>"
	}
	return "<tr" + cls + "><td>" + esc(tx(state, a.label)) + custom + "</td><td>" + shown + "</td>" +
		"<td style=\"text-align:right\"><button class=\"btn\"" + act("record", a.id) + ">" + tx(state, "Gravar") + "</button>" + resetButton + "</td></tr>"
}

func settingsPage(state: model.State): Str {
	prefs := state.settings
	mut Str[dyn] cards = []
	for each t in theme.themes() {
		append(cards, themeCard(prefs.theme, t))
	}
	mut Str[dyn] keyRows = []
	for each a in keys.actions() {
		append(keyRows, keyRow(state, a))
	}
	return "<div class=\"set\"><h1>" + tx(state, "Configurações") + "</h1><div class=\"sub\">" + tx(state, "Salvas em") + " " + esc(settings.path()) + "</div>" +
		"<h2>" + tx(state, "Aparência") + "</h2>" +
		item(tx(state, "Idioma"), tx(state, "Idioma da interface. Muda na hora."),
			selectLabeled("language", map(i18n.languages(), languageCode), map(i18n.languages(), languageName), prefs.language)) +
		item(tx(state, "Tema de cor"), tx(state, "Muda a janela inteira: painéis, barras de rolagem e cores do código."),
			select("theme", theme.names(), prefs.theme) + "<div class=\"cards\">" + join(cards, "") + "</div>") +
		item(tx(state, "Tamanho da fonte"), tx(state, "Do editor, em pixels."),
			select("fontSize", ["11", "12", "13", "14", "15", "16", "18", "20", "22"], "{prefs.fontSize}")) +
		"<h2>" + tx(state, "Editor") + "</h2>" +
		item(tx(state, "Números de linha"), "", check("lineNumbers", tx(state, "Mostrar números de linha"), prefs.lineNumbers)) +
		item(tx(state, "Autocomplete"), tx(state, "Sugere palavras-chave, builtins, módulos hive.* e nomes do arquivo enquanto você digita."),
			check("autocomplete", tx(state, "Sugerir enquanto digito"), prefs.autocomplete)) +
		item(tx(state, "Largura do tab"), tx(state, "Quantos espaços um tab ocupa na tela."), select("tabSize", ["2", "4", "8"], "{prefs.tabSize}")) +
		"<h2>" + tx(state, "Explorador") + "</h2>" +
		item(tx(state, "Arquivos ocultos"), "", check("showHidden", tx(state, "Mostrar arquivos ocultos e artefatos de build"), prefs.showHidden)) +
		"<h2>" + tx(state, "Execução") + "</h2>" +
		item(tx(state, "Salvar antes de rodar"), "", check("saveBeforeRun", tx(state, "Salvar arquivos antes de Check, Run, Test e Build"), prefs.saveBeforeRun)) +
		item(tx(state, "Compilador"), tx(state, "Caminho do hivec. A variável HIVEC, se existir, tem prioridade."),
			"<input class=\"field\" style=\"width:420px\" data-input=\"compiler\" placeholder=\"hivec\"" + attr("value", prefs.compiler) + ">") +
		item(tx(state, "Navegador da janela"), tx(state, "Executável Chromium (Edge, Chrome, Brave) usado para a janela. Vazio = automático. Vale na próxima abertura."),
			"<input class=\"field\" style=\"width:420px\" data-input=\"browser\"" + attr("placeholder", tx(state, "automático")) + attr("value", prefs.browser) + ">") +
		"<h2>" + tx(state, "Atalhos de teclado") + "</h2>" +
		"<div class=\"item\"><div class=\"dsc\">" + tx(state, "Clique em Gravar e pressione a combinação. Uma tecla já usada sai da outra ação. Esc cancela.") + "</div>" +
		"<button class=\"btn\"" + act("resetKeys", "") + ">" + tx(state, "Restaurar todos os padrões") + "</button></div>" +
		"<table class=\"keys\"><tr><th>" + tx(state, "Ação") + "</th><th>" + tx(state, "Atalho") + "</th><th></th></tr>" + join(keyRows, "") + "</table></div>"
}

// ── um commit, ou as alterações de um arquivo ────────────────────────────

func statusName(words: hive.map.Map<Str, Str>, status: Str): Str {
	if status == "A" {
		return i18n.tr(words, "novo")
	} else if status == "D" {
		return i18n.tr(words, "removido")
	} else if status == "R" {
		return i18n.tr(words, "renomeado")
	} else if status == "B" {
		return i18n.tr(words, "binário")
	}
	return i18n.tr(words, "editado")
}

func statusClass(status: Str): Str {
	if status == "A" || status == "R" {
		return "g-new"
	} else if status == "D" {
		return "g-del"
	}
	return "g-mod"
}

func counts(added: Int, removed: Int): Str {
	return "<span class=\"plus\">+{added}</span> <span class=\"minus\">−{removed}</span>"
}

func lineNumber(n: Int): Str {
	if n == 0 {
		return ""
	}
	return "{n}"
}

// O conteúdo da linha, com realce quando o arquivo é Hive (ou Go).
func diffCode(path: Str, text: Str): Str {
	if path is "{stem}.hive" || path is "{stem}.go" {
		return highlight.highlight(text)
	}
	return esc(text)
}

func diffRow(path: Str, line: git.DiffLine): Str {
	if line.kind == "hunk" {
		return "<tr class=\"hunk\"><td class=\"no\"></td><td class=\"no\"></td><td class=\"code\" colspan=\"2\">" + esc(line.text) + "</td></tr>"
	}
	if line.kind == "note" {
		return "<tr class=\"note\"><td class=\"no\"></td><td class=\"no\"></td><td class=\"code\" colspan=\"2\">" + esc(line.text) + "</td></tr>"
	}
	mut sign := " "
	if line.kind == "add" {
		sign = "+"
	} else if line.kind == "del" {
		sign = "−"
	}
	return "<tr class=\"" + line.kind + "\"><td class=\"no\">" + lineNumber(line.old) + "</td><td class=\"no\">" + lineNumber(line.new) +
		"</td><td class=\"sign\">" + sign + "</td><td class=\"code\">" + diffCode(path, line.text) + "</td></tr>"
}

func commitPage(commit: git.Commit, words: hive.map.Map<Str, Str>): Str {
	mut added := 0
	mut removed := 0
	mut Str[dyn] list = []
	mut Str[dyn] blocks = []
	for i := 0; i < len(commit.files); i++ {
		file := commit.files[i]
		added = added + file.added
		removed = removed + file.removed
		cls := statusClass(file.status)
		mut shown := esc(file.path)
		if file.status == "R" {
			shown = esc(file.oldPath) + " → " + esc(file.path)
		}
		icon := theme.iconFor(workspace.baseName(file.path))
		append(list, "<div class=\"cm-file\" data-scrollto=\"df{i}\">" +
			"<span class=\"ic\"" + attr("style", "color:" + icon.color) + ">" + esc(icon.glyph) + "</span>" +
			"<span class=\"" + cls + "\">" + shown + "</span><span class=\"grow\"></span>" +
			counts(file.added, file.removed) + "<span class=\"st " + cls + "\">" + statusName(words, file.status) + "</span></div>")
		mut Str[dyn] rows = []
		for each line in file.lines {
			append(rows, diffRow(file.path, line))
		}
		mut body := "<table class=\"df-body\">" + join(rows, "") + "</table>"
		if file.status == "B" {
			body = "<div class=\"empty\">" + i18n.tr(words, "Arquivo binário — sem diff de texto.") + "</div>"
		} else if len(file.lines) == 0 {
			body = "<div class=\"empty\">" + i18n.tr(words, "Sem alterações de conteúdo.") + "</div>"
		}
		append(blocks, "<div class=\"df\" id=\"df{i}\"><div class=\"df-head\" data-collapse>" +
			"<span class=\"chev\">⌄</span><span class=\"ic\"" + attr("style", "color:" + icon.color) + ">" + esc(icon.glyph) + "</span>" +
			"<span class=\"" + cls + "\">" + shown + "</span><span class=\"grow\"></span>" + counts(file.added, file.removed) + "</div>" +
			body + "</div>")
	}
	mut meta := ""
	if commit.short != "" {
		meta = "<div class=\"cm-meta\"><span class=\"hash\">" + esc(commit.short) + "</span> · " + esc(commit.author) + " · " + esc(commit.date) + "</div>"
	}
	mut body := ""
	if commit.body != "" {
		body = "<pre class=\"cm-body\">" + esc(commit.body) + "</pre>"
	}
	mut truncated := ""
	if commit.truncated {
		truncated = "<div class=\"empty\">" + i18n.tr(words, "O diff é grande demais e foi cortado; use o terminal para vê-lo inteiro.") + "</div>"
	}
	return "<div class=\"cm\"><div class=\"cm-head\"><div class=\"cm-subject\">" + esc(i18n.tr(words, commit.subject)) + "</div>" + meta + body +
		"<div class=\"cm-stats\">{len(commit.files)} " + i18n.tr(words, "arquivo(s)") + " · " + counts(added, removed) + "</div></div>" +
		"<div class=\"cm-files\">" + join(list, "") + "</div>" + truncated + join(blocks, "") + "</div>"
}

// ── painel inferior ──────────────────────────────────────────────────────

func paneTab(label: Str, arg: Str, on: Bool): Str {
	mut cls := "ptab"
	if on {
		cls = "ptab on"
	}
	return "<span class=\"" + cls + "\"" + act("pane", arg) + ">" + label + "</span>"
}

func terminalBody(state: model.State): Str {
	term := state.term
	mut status := ""
	if term.session == 0 {
		status = "<div class=\"empty\">" + tx(state, "Terminal encerrado — Enter abre um novo.") + "</div>"
	}
	return "<pre class=\"term\" data-autoscroll data-focus=\"termInput\">" + esc(term.log) + "</pre>" + status +
		"<div class=\"termline\"><span class=\"tp\">›</span>" +
		"<input class=\"termin\" data-input=\"termInput\" data-submit=\"termSubmit\" data-history=\"1\" spellcheck=\"false\" autocomplete=\"off\"" +
		attr("placeholder", tx(state, "comando (↑ ↓ histórico, Ctrl+C encerra o processo)")) + attr("value", term.input) + "></div>"
}

func panel(state: model.State): Str {
	problems := state.pane is model.Pane.ProblemsPane
	terminal := state.pane is model.Pane.TerminalPane
	mut body := esc(state.output)
	mut bodyClass := "body"
	mut actions := headerAction("⌫", tx(state, "Limpar"), "clear", "")
	if terminal {
		body = terminalBody(state)
		bodyClass = "body termbody"
		actions = headerAction("⌫", tx(state, "Limpar"), "termClear", "") +
			headerAction("■", tx(state, "Encerrar o processo (reinicia o shell)"), "termRestart", "")
	}
	mut maxGlyph := "⤢"
	mut maxTip := tx(state, "Maximizar painel")
	if state.panelMax {
		maxGlyph = "⤡"
		maxTip = tx(state, "Restaurar painel")
	}
	if problems {
		mut Str[dyn] rows = []
		for each d in state.diagnostics {
			append(rows, "<div class=\"prob\"" + act("peek", d.file) + attr("data-text", "{d.line}") + ">" +
				"<span class=\"ic\">⊗</span><span>" + esc(d.message) + "</span>" +
				"<span class=\"where\">" + esc(workspace.baseName(d.file)) + " [" + "{d.line}" + "]</span></div>")
		}
		body = join(rows, "")
		if len(state.diagnostics) == 0 {
			body = "<div class=\"empty\">" + tx(state, "Nenhum problema foi detectado.") + "</div>"
		}
	}
	return "<div class=\"head\">" +
		paneTab(tx(state, "PROBLEMAS") + "  {len(state.diagnostics)}", "problems", problems) +
		paneTab(tx(state, "SAÍDA"), "output", !problems && !terminal) +
		paneTab(tx(state, "TERMINAL"), "terminal", terminal) +
		"<span class=\"grow\"></span>" + actions +
		headerAction(maxGlyph, maxTip + keyHint(state, "maximizePanel"), "panelMax", "") +
		headerAction("✕", tx(state, "Fechar painel") + keyHint(state, "togglePanel"), "togglePanel", "") +
		"</div><div class=\"" + bodyClass + "\">" + body + "</div>"
}

// ── barra de status ──────────────────────────────────────────────────────

func statusItem(label: Str, action: Str, arg: Str, tip: Str): Str {
	if action == "" {
		return "<span class=\"si\">" + label + "</span>"
	}
	return "<span class=\"si click\"" + act(action, arg) + attr("title", tip) + ">" + label + "</span>"
}

func caretPosition(text: Str, caret: Int): Str {
	chars := split(text, "")
	mut line := 1
	mut column := 1
	for i := 0; i < caret; i++ {
		if chars bounds i {
			if chars[i] == "\n" {
				line++
				column = 1
			} else {
				column++
			}
		}
	}
	return "Ln {line}, Col {column}"
}

func statusBar(state: model.State): Str {
	t := theme.byName(state.settings.theme)
	mut Str[dyn] items = [
		statusItem("⬡ Hive", "", "", ""),
		statusItem("⊗ {len(state.diagnostics)}", "pane", "problems", tx(state, "Problemas")),
		statusItem(esc(state.status), "", "", ""),
		"<span class=\"grow\"></span>"
	]
	if activeDoc(state) is Result.Ok(doc) {
		if showsDoc(state) {
			append(items, statusItem(caretPosition(doc.text, state.caret), "", "", ""))
			append(items, statusItem("Tab: {state.settings.tabSize}", "", "", ""))
			mut language := tx(state, "Texto")
			if doc.path is "{stem}.hive" {
				language = "Hive"
			} else if model.isMarkdown(doc.path) {
				language = "Markdown"
			} else if doc.path is "{stem}.go" {
				language = "Go"
			}
			append(items, statusItem(language, "", "", ""))
			if doc.path != state.entrypoint && doc.path is "{stem}.hive" {
				append(items, statusItem(tx(state, "📌 Fixar como entrada"), "pin", "", tx(state, "Check/Run/Test/Build passam a usar este arquivo")))
			}
		}
	}
	if state.entrypoint != "" {
		append(items, statusItem("▶ " + esc(workspace.baseName(state.entrypoint)), "", "", ""))
	}
	append(items, statusItem("◐ " + esc(t.name), "settings", "", tx(state, "Trocar tema")))
	append(items, statusItem("▭", "togglePanel", "", tx(state, "Painel") + keyHint(state, "togglePanel")))
	return join(items, "")
}

// ── janelas por cima ─────────────────────────────────────────────────────

func overlay(state: model.State): Str {
	if state.recording != "" {
		mut label := state.recording
		for each a in keys.actions() {
			if a.id == state.recording {
				label = tx(state, a.label)
			}
		}
		return "<div class=\"dialog\"><div class=\"msg\"><div style=\"font-size:15px;margin-bottom:8px\">" + esc(label) + "</div>" +
			"<div class=\"empty\">" + tx(state, "Pressione a nova combinação de teclas. Esc cancela.") + "</div></div></div>"
	}
	if state.about {
		return "<div class=\"dialog\"><div class=\"msg about\"><div class=\"big\">" + logo() + "</div>" +
			"<div class=\"about-name\">Hive Studio</div>" +
			"<div>" + tx(state, "Uma IDE para Hive, escrita em Hive.") + "</div>" +
			"<div class=\"empty\">" + tx(state, "Configurações em") + " " + esc(settings.path()) + "</div>" +
			"<div class=\"about-actions\"><button class=\"btn\"" + act("closeAbout", "") + ">" + tx(state, "Fechar") + "</button></div></div></div>"
	}
	if state.git.confirm != "" {
		return "<div class=\"dialog\"><div class=\"msg\"><div style=\"font-size:15px;margin-bottom:8px\">" + tx(state, "Descartar as alterações de") + " <b>" +
			esc(state.git.confirm) + "</b>?</div><div class=\"empty\">" + tx(state, "Isto não pode ser desfeito. Um arquivo novo é apagado.") + "</div>" +
			"<div style=\"margin-top:16px;display:flex;gap:8px;justify-content:center\">" +
			"<button class=\"btn\"" + act("gitCancel", "") + ">" + tx(state, "Cancelar") + "</button>" +
			"<button class=\"btn danger\"" + act("gitDiscard", state.git.confirm) + ">" + tx(state, "Descartar") + "</button></div></div></div>"
	}
	if state.peekFile == "" {
		return ""
	}
	mut Str[dyn] lines = []
	for each line in analysis.excerpt(state.peekText, state.peekLine, 7) {
		mut cls := "ln"
		mut body := line
		if line is "> {rest}" {
			cls = "ln hit"
			body = rest
		} else if line is "  {rest}" {
			body = rest
		}
		if body is "{number is ( *\d+)}  {source}" {
			append(lines, "<span class=\"" + cls + "\"><span class=\"no\">" + number + "</span>" + highlight.highlight(source) + "</span>")
		} else {
			append(lines, "<span class=\"" + cls + "\">" + esc(body) + "</span>")
		}
	}
	return "<div class=\"dialog\"><div class=\"dh\"><b>" + esc(workspace.baseName(state.peekFile)) + ":{state.peekLine}</b>" +
		"<span class=\"grow\"></span><button class=\"btn\"" + act("closePeek", "") + ">" + tx(state, "Fechar") + "</button></div>" +
		"<pre>" + join(lines, "") + "</pre></div>"
}

// ── tudo junto ───────────────────────────────────────────────────────────

func region(id: Str, html: Str): model.Region {
	return model.Region(id, html)
}

func frame(state: model.State): model.Frame {
	prefs := state.settings
	layout := layoutOf(state)
	mut text := ""
	mut editing := ""
	mut hl := ""
	if activeDoc(state) is Result.Ok(doc) {
		text = doc.text
		editing = gutter(doc.text)
		hl = highlighted(state)
	}
	mut settingsHtml := ""
	if layout == "settings" {
		settingsHtml = settingsPage(state)
	}
	mut commitHtml := ""
	if layout == "commit" {
		commitHtml = state.commit.html
	}
	mut welcomeHtml := ""
	if layout == "welcome" {
		welcomeHtml = welcome(state)
	}
	mut title := "Hive Studio"
	if activeDoc(state) is Result.Ok(doc) {
		mut mark := ""
		if model.dirty(doc) {
			mark = "● "
		}
		title = mark + doc.name + " — " + workspace.baseName(state.root) + " — Hive Studio"
	}
	regions := [
		region("title", titleBar(state)),
		region("activity", activityBar(state)),
		region("side", sidePanel(state)),
		region("tabs", tabStrip(state)),
		region("crumbs", breadcrumb(state)),
		region("gutter", editing),
		region("hl", hl),
		region("preview", preview(state)),
		region("settings", settingsHtml),
		region("commit", commitHtml),
		region("welcome", welcomeHtml),
		region("popup", popup(state)),
		region("panel", panel(state)),
		region("status", statusBar(state)),
		region("overlay", overlay(state))
	]
	model.Region[dyn] all = regions
	return model.Frame(
		regions: all,
		css: theme.css(theme.byName(prefs.theme), prefs.fontSize, prefs.tabSize),
		text: text,
		serial: state.textSerial,
		caret: state.caret,
		keys: keys.combos(prefs.keymap),
		layout: layout,
		side: state.sideOpen,
		panel: state.panelOpen,
		popup: len(state.suggestions) > 0 && (layout == "edit" || layout == "split"),
		numbers: prefs.lineNumbers,
		panelHeight: prefs.panelHeight,
		panelMax: state.panelMax,
		focus: state.focus,
		focusSerial: state.focusSerial,
		recording: state.recording != "",
		title: title
	)
}

func encodeFrame(state: model.State): Str {
	return encode(frame(state), hive.json.codec())
}
