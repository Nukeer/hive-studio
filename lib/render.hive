// O que a janela pergunta ao estado: o texto no idioma escolhido, o
// documento à vista, as ocorrências da busca, o Ctrl+P, o git de um arquivo,
// a posição do cursor… Tudo aqui é `func`: perguntar nunca altera o estado.
//
// Quem desenha é lib/uiview.hive.

import ./model
import ./analysis
import ./workspace
import ./theme
import ./settings
import ./highlight
import ./markdown
import ./jsonview
import ./keys
import ./git
import ./i18n
import ./search
import ./complete
import ./version
import ./vim
import ./agents
import ./native.go

// O texto da interface no idioma escolhido.
func tx(state: model.State, text: Str): Str {
	return i18n.tr(state.words, text)
}

func activeDoc(state: model.State): Result<model.Doc, Bool> {
	index := state.active
	if state.docs bounds index {
		return Result.Ok(state.docs[index])
	}
	return Result.Error(false)
}

func activePath(state: model.State): Str {
	if activeDoc(state) is Result.Ok(doc) {
		return doc.path
	}
	return ""
}

func showingCommit(state: model.State): Bool {
	return state.commit.key != "" && state.editorView == model.EditorView.CommitPage()
}

// O editor mostra um documento (e não Configurações nem um commit).
func showsDoc(state: model.State): Bool {
	return !showingSettings(state) && !showingCommit(state)
}

func showingSettings(state: model.State): Bool {
	return state.settingsOpen && state.editorView == model.EditorView.SettingsView()
}

// O arquivo que Check/Run/Test/Build recebem: o fixado, senão o ativo —
// desde que seja um `.hive`.
func targetOf(state: model.State): Str {
	if state.entrypoint != "" {
		return state.entrypoint
	}
	path := activePath(state)
	if path is "{stem}.hive" {
		return path
	}
	return ""
}

func layoutOf(state: model.State): Str {
	if showingCommit(state) {
		return "commit"
	}
	if showingSettings(state) {
		return "settings"
	}
	if activeDoc(state) is Result.Ok(doc) {
		if model.hasPreview(doc.path) {
			return doc.mode
		}
		return "edit"
	}
	return "welcome"
}

func keyHint(state: model.State, action: Str): Str {
	combo := keys.keysFor(state.settings.keymap, action)
	if combo == "" {
		return ""
	}
	return " (" + combo + ")"
}

// ── barra de título e menus ──────────────────────────────────────────────

// As ocorrências do texto da caixa de busca no documento aberto.
func findMatches(text: Str, find: model.FindBox): Int[dyn] {
	if find.open {
		return search.occurrences(text, find.text, find.caseSensitive, 5000)
	}
	Int[dyn] none = []
	return none
}

// O texto onde a caixa de busca procura: o do documento aberto.
func searched(state: model.State): Str {
	if activeDoc(state) is Result.Ok(doc) {
		return doc.text
	}
	return ""
}

// Os arquivos que o Ctrl+P mostra, como posições em `palette.files`.
func paletteMatches(palette: model.Palette): Int[dyn] {
	return palette.found
}

// Quantas letras a busca do Ctrl+P espera antes de procurar: com menos, quase
// todo arquivo casa, e o trabalho não vale a lista.
func paletteMinimum(): Int {
	return 3
}

// Os arquivos que casam com o que foi digitado, quando já há o bastante.
func paletteSearch(files: Str[], text: Str): Int[dyn] {
	if len(trimPalette(text)) < paletteMinimum() {
		Int[dyn] none = []
		return none
	}
	return search.quickOpen(files, text, 60)
}

func trimPalette(text: Str): Str {
	return replaceAll(text, " ", "")
}

func promptPlaceholder(state: model.State, prompt: model.Prompt): Str {
	if prompt is model.Prompt.NewFilePrompt {
		return tx(state, "nome do arquivo (ex.: main.hive)")
	} else if prompt is model.Prompt.NewFolderPrompt {
		return tx(state, "nome da pasta")
	} else if prompt is model.Prompt.OpenFolderPrompt {
		return tx(state, "caminho da pasta")
	} else if prompt is model.Prompt.RenamePrompt(_) {
		return tx(state, "novo nome")
	} else if prompt is model.Prompt.NoPrompt {
		return ""
	}
}

func dirtyPath(state: model.State, path: Str): Bool {
	for each doc in state.docs {
		if doc.path == path {
			return model.dirty(doc)
		}
	}
	return false
}

// O caminho de um item visto da pasta aberta, como o git o chama.
func relPath(state: model.State, path: Str): Str {
	return join(workspace.crumbs(state.root, path), "/")
}

func gitKindOf(state: model.State, path: Str): Str {
	return git.fileKind(state.git, relPath(state, path))
}

// O que "Excluir" apaga: o que está selecionado no explorador, ou o
// arquivo aberto. "" quando não há nada.
func removable(state: model.State): Str {
	if state.selected != "" {
		return state.selected
	}
	return activePath(state)
}

// O caminho do arquivo no git (o que `git.stage` recebe), ou "" quando ele não
// tem alterações.
func gitPathOf(state: model.State, path: Str): Str {
	rel := relPath(state, path)
	for each file in state.git.files {
		if file.rel == rel {
			return file.path
		}
	}
	return ""
}

// Se o caminho é uma pasta da árvore.
func isFolder(state: model.State, path: Str): Bool {
	for each row in state.tree {
		if row.entry.path == path {
			return row.entry.folder
		}
	}
	return false
}

func symbolGlyph(kind: Str): theme.FileIcon {
	if kind == "func" {
		return theme.FileIcon("ƒ", "#b180d7")
	} else if kind == "proc" {
		return theme.FileIcon("◉", "#75beff")
	} else if kind == "type" {
		return theme.FileIcon("T", "#ee9d28")
	} else if kind == "query" {
		return theme.FileIcon("Q", "#f55385")
	} else if kind == "test" {
		return theme.FileIcon("✓", "#89d185")
	}
	return theme.FileIcon("↳", "#8a8a8a")
}

// A pasta de um arquivo, relativa à raiz ("" na raiz).
func relFolder(state: model.State, path: Str): Str {
	parts := split(relPath(state, path), "/")
	last := len(parts) - 2
	if parts bounds 0 && parts bounds last {
		return join(parts[0:last], "/")
	}
	return ""
}

func kindGlyph(kind: Str): theme.FileIcon {
	if kind == "keyword" {
		return theme.FileIcon("⌘", "#c586c0")
	} else if kind == "module" {
		return theme.FileIcon("\{}", "#e5c07b")
	} else if kind == "word" {
		return theme.FileIcon("ab", "#8a8a8a")
	}
	return symbolGlyph(kind)
}

// A linha e a coluna do cursor, contadas numa passada só pelo texto antes dele.
func caretPosition(text: Str, caret: Int): Str {
	return native.caretLabel(text, caret)
}

func vimModeText(state: model.State): Str {
	name := vim.modeName(state.vim)
	if name == "insert" {
		return tx(state, "INSERÇÃO")
	} else if name == "visual" {
		return "VISUAL"
	} else if name == "visualLine" {
		return tx(state, "VISUAL LINHA")
	}
	return "NORMAL"
}

// A mensagem do Vim no idioma da interface, com `%1`, `%2` preenchidos.
func vimMessage(state: model.State): Str {
	parts := split(tx(state, state.vim.message), "%")
	mut Str[dyn] out = []
	for i := 0; i < len(parts); i++ {
		if parts bounds i {
			if i == 0 {
				append(out, parts[i])
			} else {
				append(out, argPiece(parts[i], state.vim.args))
			}
		}
	}
	return join(out, "")
}

// O pedaço depois de um `%`: `%1`, `%2`… viram o argumento; o resto fica.
func argPiece(part: Str, args: Str[]): Str {
	if part is "{n is (\d)}{rest}" {
		if hive.conv.sti(n) is Result.Ok(k) {
			index := k - 1
			if args bounds index {
				return args[index] + rest
			}
		}
	}
	return "%" + part
}

// A pasta de um caminho relativo, para mostrar ao lado do nome.
func folderOf(rel: Str): Str {
	parts := split(rel, "/")
	last := len(parts) - 2
	if parts bounds 0 && parts bounds last {
		return join(parts[0:last], "/")
	}
	return ""
}

// As marcas do Error Lens no documento à vista: os erros do último check e,
// como aviso, as funções que o último Analyze achou caras.
func lensMarks(state: model.State): model.LensMark[dyn] {
	mut model.LensMark[dyn] marks = []
	if !state.settings.errorLens {
		return marks
	}
	if activeDoc(state) is Result.Ok(doc) {
		path := workspace.normalize(doc.path)
		if model.isJson(doc.path) && doc.problem.line > 0 {
			append(marks, model.LensMark(doc.problem.line, "error", doc.problem.message, doc.problem.source))
		}
		for each d in state.diagnostics {
			if workspace.normalize(d.file) == path {
				append(marks, model.LensMark(d.line, "error", d.message, d.source))
			}
		}
		for each spot in state.hotspots {
			if spot.score <= 30 && workspace.normalize(spot.file) == path {
				append(marks, model.LensMark(spot.line, "warning", tx(state, "custo") + " {spot.score}/100 — " + spot.detail, spot.source))
			}
		}
	}
	return marks
}

// Os atalhos que ainda valem com o foco no terminal de um agente; o resto das
// teclas é do programa (Esc, Ctrl+C, Ctrl+R…).
func agentKeys(keymap: Str): Str[dyn] {
	mut Str[dyn] found = []
	for each action in ["agent", "togglePanel", "maximizePanel"] {
		combo := keys.keysFor(keymap, action)
		if combo != "" {
			append(found, combo)
		}
	}
	return found
}
