// Realce de sintaxe: transforma código Hive em HTML com uma classe por token.
// As cores ficam no CSS do tema (`.tk` palavra-chave, `.tt` tipo, `.ts` texto,
// `.tn` número, `.tc` comentário, `.tf` chamada, `.ta` átomo, `.tb` literal,
// `.tm` módulo), então o realce não sabe nada de tema.

func keywords(): Str[dyn] {
	return [
		"import", "proc", "func", "query", "test", "type",
		"if", "else", "return", "is", "with",
		"void", "echo", "assert", "panic",
		"dyn", "mut", "async", "await", "for", "in",
		"each", "bounds", "break", "continue", "as", "timeout"
	]
}

func builtinTypes(): Str[dyn] {
	return ["Str", "Int", "Float", "Bool", "Atom", "Result", "Table"]
}

func escape(text: Str): Str {
	return replaceAll(replaceAll(replaceAll(replaceAll(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")
}

func isDigit(c: Str): Bool {
	return c >= "0" && c <= "9"
}

func isUpper(c: Str): Bool {
	return c >= "A" && c <= "Z"
}

func isIdentStart(c: Str): Bool {
	return (c >= "a" && c <= "z") || isUpper(c) || c == "_"
}

func isIdent(c: Str): Bool {
	return isIdentStart(c) || isDigit(c)
}

func piece(chars: Str[], from: Int, to: Int): Str {
	mut Str[dyn] taken = []
	for k := from; k < to; k++ {
		if chars bounds k {
			append(taken, chars[k])
		}
	}
	return join(taken, "")
}

// A classe CSS de uma palavra, olhando o que vem depois dela.
func wordClass(word: Str, next: Str): Str {
	if indexOf(keywords(), word) is Result.Ok(_) {
		return "tk"
	}
	if word == "true" || word == "false" {
		return "tb"
	}
	if word == "hive" {
		return "tm"
	}
	if indexOf(builtinTypes(), word) is Result.Ok(_) {
		return "tt"
	}
	if next == "(" {
		return "tf"
	}
	if word bounds 0 {
		if isUpper(word[0]) {
			return "tt"
		}
	}
	return ""
}

func span(cls: Str, text: Str): Str {
	if cls == "" {
		return escape(text)
	}
	return "<span class=\"{cls}\">{escape(text)}</span>"
}

// Um comentário, com TODO, FIXME, HACK e XXX em destaque.
func commentSpan(text: Str): Str {
	mut html := escape(text)
	for each tag in ["TODO", "FIXME", "HACK", "XXX"] {
		html = replaceAll(html, tag, "<span class=\"td\">" + tag + "</span>")
	}
	return "<span class=\"tc\">" + html + "</span>"
}

// O primeiro caractere que não é espaço a partir de `from`.
func nextVisible(chars: Str[], from: Int): Str {
	for k := from; k < len(chars); k++ {
		if chars bounds k {
			c := chars[k]
			if c != " " && c != "\t" {
				return c
			}
		}
	}
	return ""
}

func highlight(text: Str): Str {
	chars := split(text, "")
	total := len(chars)
	mut Str[dyn] out = []
	mut i := 0
	for ; i < total; {
		mut c := ""
		if chars bounds i {
			c = chars[i]
		}
		mut after := ""
		ahead := i + 1
		if chars bounds ahead {
			after = chars[ahead]
		}
		mut j := i + 1
		if c == "/" && after == "/" {
			for ; j < total; j++ {
				if chars bounds j {
					if chars[j] == "\n" {
						break
					}
				}
			}
			append(out, commentSpan(piece(chars, i, j)))
		} else if c == "\"" {
			for ; j < total; j++ {
				if chars bounds j {
					if chars[j] == "\\" {
						j++
					} else if chars[j] == "\"" {
						j++
						break
					}
				}
			}
			append(out, span("ts", piece(chars, i, j)))
		} else if c == "`" {
			for ; j < total; j++ {
				if chars bounds j {
					if chars[j] == "`" {
						j++
						break
					}
				}
			}
			append(out, span("ts", piece(chars, i, j)))
		} else if c == "#" && isUpper(after) {
			for ; j < total; j++ {
				if chars bounds j {
					if !isIdent(chars[j]) {
						break
					}
				}
			}
			append(out, span("ta", piece(chars, i, j)))
		} else if isDigit(c) {
			for ; j < total; j++ {
				if chars bounds j {
					d := chars[j]
					if !(isDigit(d) || d == "." || d == "_") {
						break
					}
				}
			}
			append(out, span("tn", piece(chars, i, j)))
		} else if isIdentStart(c) {
			for ; j < total; j++ {
				if chars bounds j {
					if !isIdent(chars[j]) {
						break
					}
				}
			}
			word := piece(chars, i, j)
			append(out, span(wordClass(word, nextVisible(chars, j)), word))
		} else {
			append(out, escape(c))
		}
		i = j
	}
	return join(out, "")
}

// ── realce por linha, para refazer só o que mudou ────────────────────────

// Uma linha realçada, e o texto que ela deixa aberto para a próxima (`carry`):
// 0 nenhum, 1 entre crases, 2 entre aspas — os únicos tokens que atravessam linhas.
type HlLine {
	html:  Str
	carry: Int
}

// O que o programa guarda do realce de um texto: quantas linhas ele tem e as
// linhas que terminam com um texto aberto (`open`, em pares linha, carry, em
// ordem) — quase sempre nenhuma. O HTML das linhas não fica guardado: sai na
// hora para as que mudaram (`rehighlight`) ou para o texto todo (`htmlLines`),
// e o documento fica leve de copiar mesmo com centenas de milhares de linhas.
type Highlighted {
	count: Int
	open:  Int[dyn]
}

// O que mudou no realce: a partir da linha `from`, sai `remove` e entra `lines`.
type Patch {
	from:   Int
	remove: Int
	lines:  Str[dyn]
	source: Str[dyn]
}

type Rehighlight {
	result: Highlighted
	patch:  Patch
}

func noPatch(): Patch {
	Str[dyn] none = []
	return Patch(0, 0, none, none)
}

// Onde fecha o texto que veio aberto da linha anterior (-1: não fecha aqui).
func closingAt(chars: Str[], carry: Int): Int {
	for i := 0; i < len(chars); i++ {
		if chars bounds i {
			c := chars[i]
			if carry == 1 && c == "`" {
				return i
			} else if carry == 2 && c == "\\" {
				i++
			} else if carry == 2 && c == "\"" {
				return i
			}
		}
	}
	return -1
}

func highlightLine(line: Str, carry: Int): HlLine {
	mut rest := line
	mut Str[dyn] out = []
	if carry != 0 {
		chars := split(line, "")
		at := closingAt(chars, carry)
		if at < 0 {
			return HlLine(span("ts", line), carry)
		}
		append(out, span("ts", piece(chars, 0, at + 1)))
		rest = piece(chars, at + 1, len(chars))
	}
	append(out, highlight(rest))
	return HlLine(join(out, ""), leftOpen(rest))
}

// O texto que a linha deixa aberto, lida como `highlight` lê: uma crase num
// comentário ou entre aspas não abre nada, nem aspas entre crases.
func leftOpen(line: Str): Int {
	chars := split(line, "")
	total := len(chars)
	mut open := 0
	for i := 0; i < total; i++ {
		if chars bounds i {
			c := chars[i]
			if open == 1 {
				if c == "`" {
					open = 0
				}
			} else if open == 2 {
				if c == "\\" {
					i++
				} else if c == "\"" {
					open = 0
				}
			} else if c == "`" {
				open = 1
			} else if c == "\"" {
				open = 2
			} else if c == "/" {
				ahead := i + 1
				if chars bounds ahead {
					if chars[ahead] == "/" {
						return 0
					}
				}
			}
		}
	}
	return open
}

// Uma linha de JSON: chaves, textos, números e true/false/null.
func jsonLine(line: Str): Str {
	chars := split(line, "")
	total := len(chars)
	mut Str[dyn] out = []
	mut i := 0
	for ; i < total; {
		mut c := ""
		if chars bounds i {
			c = chars[i]
		}
		mut after := ""
		ahead := i + 1
		if chars bounds ahead {
			after = chars[ahead]
		}
		mut j := i + 1
		if c == "\"" {
			for ; j < total; j++ {
				if chars bounds j {
					if chars[j] == "\\" {
						j++
					} else if chars[j] == "\"" {
						j++
						break
					}
				}
			}
			mut cls := "ts"
			if nextVisible(chars, j) == ":" {
				cls = "tt"
			}
			append(out, span(cls, piece(chars, i, j)))
		} else if isDigit(c) || (c == "-" && isDigit(after)) {
			for ; j < total; j++ {
				if chars bounds j {
					d := chars[j]
					if !(isDigit(d) || d == "." || d == "e" || d == "E" || d == "+" || d == "-") {
						break
					}
				}
			}
			append(out, span("tn", piece(chars, i, j)))
		} else if isIdentStart(c) {
			for ; j < total; j++ {
				if chars bounds j {
					if !isIdent(chars[j]) {
						break
					}
				}
			}
			word := piece(chars, i, j)
			if word == "true" || word == "false" || word == "null" {
				append(out, span("tb", word))
			} else {
				append(out, escape(word))
			}
		} else {
			append(out, escape(c))
		}
		i = j
	}
	return join(out, "")
}

// Uma linha sem o realce do Hive: JSON, ou só texto.
func plainLine(line: Str, lang: Str): Str {
	if lang == "json" {
		return jsonLine(line)
	}
	return escape(line)
}

// O texto que a linha seguinte herda, sem montar o HTML desta.
func carryAfter(line: Str, carry: Int): Int {
	mut rest := line
	if carry != 0 {
		chars := split(line, "")
		at := closingAt(chars, carry)
		if at < 0 {
			return carry
		}
		rest = piece(chars, at + 1, len(chars))
	}
	return leftOpen(rest)
}

// O texto aberto no fim da linha `line` (a partir de 0; -1 é antes da primeira).
func carryAt(h: Highlighted, line: Int): Int {
	mut low := 0
	mut high := len(h.open) / 2 - 1
	for ; low <= high; {
		mid := (low + high) / 2
		at := mid * 2
		next := at + 1
		if h.open bounds at && h.open bounds next {
			found := h.open[at]
			if found == line {
				return h.open[next]
			} else if found < line {
				low = mid + 1
			} else {
				high = mid - 1
			}
		} else {
			return 0
		}
	}
	return 0
}

func highlightText(text: Str, lang: Str): Highlighted {
	lines := split(text, "\n")
	mut Int[dyn] open = []
	if lang == "hive" {
		mut carry := 0
		for i := 0; i < len(lines); i++ {
			if lines bounds i {
				carry = carryAfter(lines[i], carry)
				if carry != 0 {
					append(open, i)
					append(open, carry)
				}
			}
		}
	}
	return Highlighted(len(lines), open)
}

// O HTML de todas as linhas de um texto (ao abrir, ou quando a página pede tudo).
func htmlLines(text: Str, lang: Str): Str[dyn] {
	mut Str[dyn] out = []
	mut carry := 0
	for each line in split(text, "\n") {
		if lang == "hive" {
			done := highlightLine(line, carry)
			append(out, done.html)
			carry = done.carry
		} else {
			append(out, plainLine(line, lang))
		}
	}
	return out
}

// Refaz o realce só das linhas que mudaram entre `before` e `after`, e segue
// adiante enquanto um texto entre crases ou aspas aberto ou fechado mudar o que
// vem depois.
func rehighlight(old: Highlighted, before: Str, after: Str, lang: Str): Rehighlight {
	oldLines := split(before, "\n")
	newLines := split(after, "\n")
	oldCount := len(oldLines)
	newCount := len(newLines)
	mut prefix := 0
	for ; prefix < oldCount && prefix < newCount; prefix++ {
		if oldLines bounds prefix && newLines bounds prefix {
			if oldLines[prefix] != newLines[prefix] {
				break
			}
		}
	}
	mut suffix := 0
	for ; suffix < oldCount - prefix && suffix < newCount - prefix; suffix++ {
		o := oldCount - 1 - suffix
		n := newCount - 1 - suffix
		if oldLines bounds o && newLines bounds n {
			if oldLines[o] != newLines[n] {
				break
			}
		}
	}
	mut open := carryAt(old, prefix - 1)
	mut Str[dyn] changed = []
	mut Str[dyn] changedSource = []
	mut Int[dyn] changedCarry = []
	mut newEnd := newCount - suffix
	mut oldEnd := oldCount - suffix
	for i := prefix; i < newEnd; i++ {
		if newLines bounds i {
			append(changedSource, newLines[i])
			if lang == "hive" {
				done := highlightLine(newLines[i], open)
				append(changed, done.html)
				append(changedCarry, done.carry)
				open = done.carry
			} else {
				append(changed, plainLine(newLines[i], lang))
				append(changedCarry, 0)
			}
		}
	}
	// Se o estado no fim do trecho mudou, as linhas seguintes também mudam.
	for ; lang == "hive" && newEnd < newCount && oldEnd < oldCount; {
		if carryAt(old, oldEnd - 1) == open {
			break
		}
		if newLines bounds newEnd {
			append(changedSource, newLines[newEnd])
			done := highlightLine(newLines[newEnd], open)
			append(changed, done.html)
			append(changedCarry, done.carry)
			open = done.carry
		}
		newEnd++
		oldEnd++
	}
	// As linhas abertas: as de antes do trecho, as do trecho e as de depois,
	// deslocadas pelo que o trecho cresceu ou encolheu.
	mut Int[dyn] kept = []
	shift := newEnd - oldEnd
	for k := 0; k + 1 < len(old.open); k = k + 2 {
		next := k + 1
		if old.open bounds k && old.open bounds next {
			if old.open[k] < prefix {
				append(kept, old.open[k])
				append(kept, old.open[next])
			}
		}
	}
	for i := 0; i < len(changedCarry); i++ {
		if changedCarry bounds i {
			if changedCarry[i] != 0 {
				append(kept, prefix + i)
				append(kept, changedCarry[i])
			}
		}
	}
	for k := 0; k + 1 < len(old.open); k = k + 2 {
		next := k + 1
		if old.open bounds k && old.open bounds next {
			if old.open[k] >= oldEnd {
				append(kept, old.open[k] + shift)
				append(kept, old.open[next])
			}
		}
	}
	return Rehighlight(Highlighted(newCount, kept), Patch(prefix, oldEnd - prefix, changed, changedSource))
}

// O HTML de `lines` com o patch aplicado (para os testes conferirem).
func applyPatch(lines: Str[], patch: Patch): Str[dyn] {
	mut Str[dyn] out = []
	for i := 0; i < patch.from && i < len(lines); i++ {
		if lines bounds i {
			append(out, lines[i])
		}
	}
	for each line in patch.lines {
		append(out, line)
	}
	for i := patch.from + patch.remove; i < len(lines); i++ {
		if lines bounds i {
			append(out, lines[i])
		}
	}
	return out
}

test "realce por linha carrega o texto entre crases" {
	first := highlightLine("x := `abre", 0)
	assert first.carry == 1
	second := highlightLine("meio", 1)
	assert second.carry == 1 && second.html == "<span class=\"ts\">meio</span>"
	third := highlightLine("fecha` + 1", 1)
	assert third.carry == 0
	assert indexOf(third.html, "<span class=\"tn\">1</span>") is Result.Ok(_)
	assert highlightLine("// uma crase ` num comentário", 0).carry == 0
	assert highlightLine("if c == \"`\" \{", 0).carry == 0
	assert highlightLine("x := \"a\\\"`\"", 0).carry == 0
	assert highlightLine("x := \"a\" + `abre // não é comentário", 0).carry == 1
	assert highlightLine("render(\"- **um", 0).carry == 2
	assert highlightLine("  dois \\\" ` três\") + 1", 2).carry == 0
}

test "rehighlight muda só as linhas editadas e devolve o patch" {
	before := "proc a(): void \{\n\techo 1\n}\n"
	after := "proc a(): void \{\n\techo 2\n\techo 3\n}\n"
	old := highlightText(before, "hive")
	done := rehighlight(old, before, after, "hive")
	assert done.patch.from == 1
	assert done.patch.remove == 1
	assert len(done.patch.lines) == 2
	assert applyPatch(htmlLines(before, "hive"), done.patch) == htmlLines(after, "hive")
	assert done.result == highlightText(after, "hive")
	opening := "a\nb := `x\nc\nd` + 1\n"
	closed := highlightText(opening, "hive")
	assert closed.open == [1, 1, 2, 1] && carryAt(closed, 2) == 1 && carryAt(closed, 3) == 0 && carryAt(closed, -1) == 0
	closedAfter := replaceAll(opening, "`x", "x")
	edited := rehighlight(closed, opening, closedAfter, "hive")
	assert applyPatch(htmlLines(opening, "hive"), edited.patch) == htmlLines(closedAfter, "hive")
	assert edited.result == highlightText(closedAfter, "hive")
	quoted := "a\nb := \"x\nc\nd\" + 1\n"
	quotedAfter := replaceAll(quoted, "\"x", "x")
	unquoted := rehighlight(highlightText(quoted, "hive"), quoted, quotedAfter, "hive")
	assert applyPatch(htmlLines(quoted, "hive"), unquoted.patch) == htmlLines(quotedAfter, "hive")
	assert unquoted.result == highlightText(quotedAfter, "hive")
	// Linhas abertas depois do trecho são deslocadas quando ele cresce.
	shifted := "x := 1\nb := `y\nz`\n"
	grown := "x := 1\nnova\noutra\nb := `y\nz`\n"
	moved := rehighlight(highlightText(shifted, "hive"), shifted, grown, "hive")
	assert moved.result == highlightText(grown, "hive") && moved.result.open == [3, 1]
}

test "palavras-chave, tipos, textos e comentários ganham classes" {
	html := highlight("proc main(): void \{ // oi\n\tx := \"a<b\" + 1\n}")
	assert indexOf(html, "<span class=\"tk\">proc</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tf\">main</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tk\">void</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tc\">// oi</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"ts\">&quot;a&lt;b&quot;</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tn\">1</span>") is Result.Ok(_)
}

test "JSON ganha cores de chave, texto, número e literal; TODO se destaca no comentário" {
	line := jsonLine("  \"nome\": \"Ada\", \"n\": -3.5, \"ok\": true, \"x\": null")
	assert indexOf(line, "<span class=\"tt\">&quot;nome&quot;</span>") is Result.Ok(_)
	assert indexOf(line, "<span class=\"ts\">&quot;Ada&quot;</span>") is Result.Ok(_)
	assert indexOf(line, "<span class=\"tn\">-3.5</span>") is Result.Ok(_)
	assert indexOf(line, "<span class=\"tb\">true</span>") is Result.Ok(_)
	assert htmlLines("\{\"a\": 1}", "json") == ["\{<span class=\"tt\">&quot;a&quot;</span>: <span class=\"tn\">1</span>}"]
	assert htmlLines("x <y>", "") == ["x &lt;y&gt;"]
	assert indexOf(highlight("x := 1 // TODO: isto"), "<span class=\"tc\">// <span class=\"td\">TODO</span>: isto</span>") is Result.Ok(_)
}

test "tipos, átomos e o módulo hive" {
	html := highlight("hive.file.read(p) is Result.Ok(#Ready)")
	assert indexOf(html, "<span class=\"tm\">hive</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tt\">Result</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"ta\">#Ready</span>") is Result.Ok(_)
	assert indexOf(html, "<span class=\"tf\">read</span>") is Result.Ok(_)
}

test "o texto sai igual, só com marcação em volta" {
	source := "type A \{ x: Int }\n"
	html := highlight(source)
	plain := replaceAll(replaceAll(html, "<span class=\"tk\">", ""), "</span>", "")
	assert replaceAll(replaceAll(plain, "<span class=\"tt\">", ""), "&lt;", "<") == source
}
