// Caminhos e listagem de pastas. Tudo usa `/`, que o Windows também aceita.

import ./model
import ./native.go

func normalize(path: Str): Str {
	clean := replaceAll(path, "\\", "/")
	if clean == "" {
		return "."
	}
	// Uma barra final sai, menos na raiz (`/`, `C:/`).
	if clean is "{head}/" && head != "" {
		if head is "{drive}:" {
			return clean
		}
		return head
	}
	return clean
}

func joinPath(folder: Str, name: Str): Str {
	base := normalize(folder)
	if base is "{head}/" {
		return tidy(base + name)
	}
	return tidy(base + "/" + name)
}

func isDrive(part: Str): Bool {
	return part is "{letter}:"
}

// Resolve os `.` e `..` do meio de um caminho, para um arquivo ter um nome só.
proc popLast(list: mut Str[dyn]): void {
	last := len(list) - 1
	if list bounds last {
		drop(list, last, last)
	}
}

func tidy(path: Str): Str {
	mut Str[dyn] kept = []
	parts := split(replaceAll(path, "\\", "/"), "/")
	for i := 0; i < len(parts); i++ {
		part := parts[i]
		last := len(kept) - 1
		if part == "." && i > 0 {
			continue
		}
		if part == ".." && kept bounds last {
			previous := kept[last]
			if previous != ".." && previous != "." && previous != "" && !isDrive(previous) {
				popLast(kept)
				continue
			}
		}
		append(kept, part)
	}
	return join(kept, "/")
}

func baseName(path: Str): Str {
	parts := split(normalize(path), "/")
	last := len(parts) - 1
	if parts bounds last {
		return parts[last]
	}
	return path
}

// A pasta que contém `path`. Um caminho relativo sem pai sobe com `..`.
func parentOf(path: Str): Str {
	clean := normalize(path)
	if clean == "." {
		return ".."
	}
	if clean is ".." || clean is "{up}/.." {
		return clean + "/.."
	}
	parts := split(clean, "/")
	last := len(parts) - 2
	if parts bounds 0 && parts bounds last {
		up := join(parts[0:last], "/")
		if up == "" {
			return "/"
		}
		if up is "{drive}:" {
			return up + "/"
		}
		return up
	}
	return "."
}

func isHive(path: Str): Bool {
	return path is "{stem}.hive"
}

func entryOrder(a: model.Entry, b: model.Entry): Bool {
	if a.folder != b.folder {
		return a.folder
	}
	return a.name < b.name
}

// O conteúdo de uma pasta: pastas primeiro, e tudo o que há nela — ocultos e
// artefatos de build inclusive —, menos a pasta .git.
func listEntries(folder: Str): Result<model.Entry[dyn], Str> {
	listed := hive.file.list(folder)
	if listed is Result.Error(why) {
		return Result.Error(why.message)
	}
	mut model.Entry[dyn] found = []
	if listed is Result.Ok(names) {
		for each name in names {
			if name != ".git" {
				path := joinPath(folder, name)
				append(found, model.Entry(name, path, native.isDir(path)))
			}
		}
	}
	return Result.Ok(sort(found, entryOrder))
}

func isExpanded(expanded: Str[], path: Str): Bool {
	return indexOf(expanded, path) is Result.Ok(_)
}

// As linhas visíveis da árvore: cada pasta expandida mostra seus filhos logo abaixo.
proc buildTree(folder: Str, depth: Int, expanded: mut Str[dyn], rows: mut model.TreeRow[dyn]): void {
	if listEntries(folder) is Result.Ok(entries) {
		for each entry in entries {
			open := entry.folder && isExpanded(expanded, entry.path)
			append(rows, model.TreeRow(entry, depth, open))
			if open {
				buildTree(entry.path, depth + 1, expanded, rows)
			}
		}
	}
}

// `path` visto a partir de `root`, em pedaços — o breadcrumb.
func crumbs(root: Str, path: Str): Str[dyn] {
	base := normalize(root)
	full := normalize(path)
	if base == "." && full is "./{rest}" {
		return split(rest, "/")
	}
	if indexOf(full, base + "/") is Result.Ok(at) {
		if at == 0 {
			start := len(base) + 1
			if full bounds start {
				return split(full[start:], "/")
			}
		}
	}
	return split(full, "/")
}
