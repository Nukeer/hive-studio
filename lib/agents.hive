// Os agentes do painel AGENTE: Claude Code, Codex e OpenCode. Cada um é o
// programa que o próprio usuário instalou, rodando num terminal de verdade
// (lib/pty.go) na pasta aberta. O login é o de cada programa — `/login` no
// Claude Code, "Sign in with ChatGPT" no Codex… —, e o Hive Studio nunca lê,
// guarda nem repassa credenciais.

import ./settings
import ./model
import ./pty.go

type Preset {
	id:    Str
	label: Str
}

func presets(): Preset[dyn] {
	return [Preset("claude", "Claude Code"), Preset("codex", "Codex"), Preset("opencode", "OpenCode")]
}

func labelOf(agent: Str): Str {
	for each p in presets() {
		if p.id == agent {
			return p.label
		}
	}
	return agent
}

func isAgent(agent: Str): Bool {
	for each p in presets() {
		if p.id == agent {
			return true
		}
	}
	return false
}

// A sessão de um agente (vazia quando ele nunca abriu).
func sessionOf(all: model.Agents, agent: Str): model.AgentSession {
	for each s in all.sessions {
		if s.agent == agent {
			return s
		}
	}
	return model.AgentSession(agent, 0, false, 0, "")
}

// O comando configurado para um agente, como foi escrito nas Configurações.
func commandOf(prefs: settings.Settings, agent: Str): Str {
	if agent == "codex" {
		return prefs.codexCommand
	} else if agent == "opencode" {
		return prefs.opencodeCommand
	}
	return prefs.claudeCommand
}

// O comando partido em programa e argumentos, nos espaços
// (`npx @anthropic-ai/claude-code` → `npx` e `[@anthropic-ai/claude-code]`).
func words(command: Str): Str[dyn] {
	mut Str[dyn] found = []
	for each part in split(command, " ") {
		if part != "" {
			append(found, part)
		}
	}
	return found
}

// O que vai no ambiente do agente, por cima do do Hive Studio.
func environment(): Str[dyn] {
	return ["TERM=xterm-256color", "COLORTERM=truecolor"]
}

// Abre o agente na pasta `folder`. O terminal começa em 80×24; a página manda o
// tamanho de verdade assim que se conecta.
func start(prefs: settings.Settings, agent: Str, folder: Str): Result<Int, Str> {
	parts := words(commandOf(prefs, agent))
	if parts is [program, ...args] {
		return pty.start(folder, program, args, environment(), 80, 24)
	}
	return Result.Error(labelOf(agent) + ": comando vazio")
}

// O que o programa escreveu até agora, esperando até `ms` por ele.
proc output(session: Int, wanted: Str, ms: Int): Str {
	return outputFrom(session, wanted, ms, "")
}

// Lê o terminal em pedaços de 50 ms até aparecer `wanted` ou o tempo acabar.
proc outputFrom(session: Int, wanted: Str, left: Int, seen: Str): Str {
	if left <= 0 {
		return seen
	}
	chunk := pty.read(session, 50)
	mut now := seen
	if hive.crypto.base64Decode(chunk) is Result.Ok(raw) {
		now = seen + raw
	}
	if indexOf(now, wanted) is Result.Ok(_) {
		return now
	}
	return outputFrom(session, wanted, left - 50, now)
}
