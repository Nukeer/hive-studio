}

func themeName(t: Theme): Str {
	return t.name
}

func names(): Str[dyn] {
	return map(themes(), themeName)
}

// O tema com esse nome; um nome desconhecido cai no primeiro.
func byName(name: Str): Theme {
	all := themes()
	for each t in all {
		if t.name == name {
			return t
		}
	}
	if all bounds 0 {
		return all[0]
	}
	panic "não há temas"
}

func variable(name: Str, value: Str): Str {
	return "--{name}:{value};"
}

// As variáveis CSS do tema. Tudo na folha de estilo lê daqui, inclusive a
// barra de rolagem, então trocar de tema troca a janela inteira.
func css(t: Theme, fontSize: Int, tabSize: Int): Str {
	mut scheme := "light"
	if t.dark {
		scheme = "dark"
	}
	return ":root\{color-scheme:" + scheme + ";" +
		variable("editor", t.editor) + variable("text", t.text) + variable("side", t.side) +
		variable("activity", t.activity) + variable("panel", t.panel) + variable("tabstrip", t.tabStrip) +
		variable("tabidle", t.tabIdle) + variable("titlebar", t.titleBar) + variable("status-bg", t.statusBg) +
		variable("status-fg", t.statusFg) + variable("muted", t.muted) + variable("accent", t.accent) +
		variable("selection", t.selection) + variable("input", t.input) + variable("button", t.button) +
		variable("button-text", t.buttonText) + variable("border", t.border) + variable("danger", t.danger) +
		variable("warn", t.warn) + variable("good", t.good) + variable("gutter", t.gutter) + variable("git-new", t.gitNew) + variable("git-mod", t.gitMod) +
		variable("syn-keyword", t.synKeyword) + variable("syn-type", t.synType) + variable("syn-string", t.synString) +
		variable("syn-number", t.synNumber) + variable("syn-comment", t.synComment) + variable("syn-call", t.synCall) +
		variable("syn-atom", t.synAtom) + variable("syn-literal", t.synLiteral) + variable("syn-module", t.synModule) +
		variable("font-size", "{fontSize}px") + variable("line", "{fontSize * 3 / 2}px") + variable("tab", "{tabSize}") +
		"}"
}

// Glifo e cor do ícone de um arquivo, pela extensão — no espírito do Seti.
type FileIcon {
	glyph: Str
	color: Str
}

func iconFor(name: Str): FileIcon {
	if name is "{stem}.hive" {
		return FileIcon("⬡", "#f5a623")
	} else if name is "{stem}.go" {
		return FileIcon("◆", "#00add8")
	} else if name is "{stem}.md" {
		return FileIcon("M↓", "#519aba")
	} else if name is "{stem}.json" || name is "{stem}.hive-lock" {
		return FileIcon("\{}", "#cbcb41")
	} else if name is "{stem}.csv" || name is "{stem}.tsv" || name is "{stem}.xlsx" || name is "{stem}.ods" {
		return FileIcon("▦", "#89e051")
	} else if name is "{stem}.html" {
		return FileIcon("<>", "#e44d26")
	} else if name is "{stem}.css" {
		return FileIcon("#", "#42a5f5")
	} else if name is "{stem}.js" || name is "{stem}.ts" {
		return FileIcon("JS", "#cbcb41")
	} else if name is "{stem}.png" || name is "{stem}.jpg" || name is "{stem}.svg" || name is "{stem}.ico" {
		return FileIcon("▣", "#a074c4")
	} else if name is "{stem}.db" || name is "{stem}.sqlite" || name is "{stem}.sql" {
		return FileIcon("⛁", "#f55385")
	} else if name is "{stem}.exe" {
		return FileIcon("⚙", "#8a8a8a")
	} else if name is ".env" || name is ".gitignore" || name is "{stem}.toml" || name is "{stem}.yml" || name is "{stem}.yaml" {
		return FileIcon("⚙", "#6d8086")
	}
	return FileIcon("≡", "#8a8a8a")
}

func isSame(a: Str, b: Str): Bool {
	return a == b
}

test "todo tema tem nome único e um desconhecido cai no primeiro" {
	all := names()
	assert len(all) == 7
	assert byName("Dracula").name == "Dracula"
	assert byName("não existe").name == "Hive Dark"
	for each name in all {
		assert len(filter(all, isSame(_, name))) == 1
	}
}

test "o CSS do tema traz interface, sintaxe e fonte" {
	sheet := css(byName("Monokai"), 14, 4)
	assert indexOf(sheet, "--syn-keyword:#f92672;") is Result.Ok(_)
	assert indexOf(sheet, "--line:21px;") is Result.Ok(_)
	assert indexOf(sheet, "color-scheme:dark") is Result.Ok(_)
}

test "ícones por extensão" {
	assert iconFor("app.hive").glyph == "⬡"
	assert iconFor("util.go").glyph == "◆"
	assert iconFor("LEIAME").glyph == "≡"
}
