// Temas de cor. Cada tema é só um valor; `css(t)` o transforma nas variáveis
// que a folha de estilo da janela usa — interface, barras de rolagem e sintaxe.

type Theme {
	name:       Str
	dark:       Bool
	editor:     Str
	text:       Str
	side:       Str
	activity:   Str
	panel:      Str
	tabStrip:   Str
	tabIdle:    Str
	titleBar:   Str
	statusBg:   Str
	statusFg:   Str
	muted:      Str
	accent:     Str
	selection:  Str
	input:      Str
	button:     Str
	buttonText: Str
	border:     Str
	danger:     Str
	warn:       Str
	good:       Str
	gutter:     Str
	gitNew:     Str
	gitMod:     Str
	synKeyword: Str
	synType:    Str
	synString:  Str
	synNumber:  Str
	synComment: Str
	synCall:    Str
	synAtom:    Str
	synLiteral: Str
	synModule:  Str
}

