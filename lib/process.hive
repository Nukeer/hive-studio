// Rodar outro programa sem abrir janela de console — o `hive.term.exec` abre
// uma a cada chamada quando o Hive Studio roda compilado no Windows.

import ./native.go

type Output {
	code: Int
	text: Str
}

func codeOf(text: Str): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return -1
}

// `code` é o código de saída (-1 quando nem deu para começar) e `text` tudo o
// que o programa escreveu, saída e erro juntos.
func run(command: Str, arguments: Str[], directory: Str): Output {
	mut Str[dyn] args = []
	for each a in arguments {
		append(args, a)
	}
	return outputOf(native.run(command, args, directory))
}

// O `run` com prazo: passados `limit` ms o programa (e o que ele abriu) é
// encerrado e `code` é -2; parado por `stop(tag)` antes disso, -3.
func runFor(command: Str, arguments: Str[], directory: Str, limit: Int, tag: Str): Output {
	mut Str[dyn] args = []
	for each a in arguments {
		append(args, a)
	}
	return outputOf(native.runFor(command, args, directory, limit, tag))
}

// Encerra o que `runFor` roda com `tag`; false quando não há nada rodando.
func stop(tag: Str): Bool {
	return native.stopRun(tag)
}

// A resposta do native.go — o código numa linha, e depois a saída — como `Output`.
func outputOf(result: Result<Str, Str>): Output {
	if result is Result.Ok(raw) {
		if raw is "{code}\n{text}" {
			return Output(codeOf(code), text)
		}
		return Output(codeOf(raw), "")
	} else if result is Result.Error(why) {
		return Output(-1, why)
	}
}

// A primeira linha da saída, sem espaços nem quebras nas pontas.
func firstLine(text: Str): Str {
	for each line in split(replaceAll(text, "\r", ""), "\n") {
		return line
	}
	return ""
}
