// Os TODO do projeto: comentários marcados com TODO, FIXME, HACK ou XXX, para
// o painel TODO da barra lateral.

import ./model
import ./highlight
import ./complete
import ./search
import ./workspace

func tags(): Str[dyn] {
	return ["TODO", "FIXME", "HACK", "XXX"]
}

// O que vem antes da marca abre um comentário (de Hive, Go, JS, shell,
// SQL, HTML…) ou continua um bloco `/* … */`.
func inComment(before: Str): Bool {
	for each marker in ["//", "#", "/*", "<!--", "--", ";"] {
		if highlight.has(before, marker) {
			return true
		}
	}
	trimmed := replaceAll(replaceAll(before, " ", ""), "\t", "")
	return trimmed == "*"
}

func lastChar(text: Str): Str {
	last := len(text) - 1
	if text bounds last {
		return text[last:]
	}
	return ""
}

func firstChar(text: Str): Str {
	if text bounds 0 {
		return text[:0]
	}
	return ""
}

// O texto depois da marca, sem o `:` e sem o fim de um comentário de bloco.
func charAt(chars: Str[], i: Int): Str {
	if chars bounds i {
		return chars[i]
	}
	return ""
}

func tidyText(after: Str): Str {
	chars := split(after, "")
	mut from := 0
	for ; from < len(chars); from++ {
		c := charAt(chars, from)
		if c != ":" && c != " " && c != "\t" {
			break
		}
	}
	mut to := len(chars)
	if to - from >= 2 && charAt(chars, to - 2) == "*" && charAt(chars, to - 1) == "/" {
		to = to - 2
	} else if to - from >= 3 && charAt(chars, to - 3) == "-" && charAt(chars, to - 2) == "-" && charAt(chars, to - 1) == ">" {
		to = to - 3
	}
	for ; to > from; to-- {
		c := charAt(chars, to - 1)
		if c != " " && c != "\t" {
			break
		}
	}
	return highlight.piece(chars, from, to)
}

// Os TODO de um texto, um por linha, na ordem em que aparecem.
func todosIn(file: Str, text: Str): model.Todo[dyn] {
	mut model.Todo[dyn] found = []
	mut any := false
	for each tag in tags() {
		if highlight.has(text, tag) {
			any = true
		}
	}
	if !any {
		return found
	}
	lines := split(replaceAll(text, "\r", ""), "\n")
	for i := 0; i < len(lines); i++ {
		if lines bounds i {
			marked := todoOf(lines[i])
			if marked.tag != "" {
				append(found, model.Todo(file, i + 1, marked.column, marked.tag, marked.text))
			}
		}
	}
	return found
}

// A marca de uma linha, se ela tem uma num comentário (`tag` vazio: nenhuma).
type Mark {
	tag:    Str
	column: Int
	text:   Str
}

func todoOf(line: Str): Mark {
	for each tag in tags() {
		at := highlight.position(line, tag)
		if at >= 0 {
			before := complete.take(line, at)
			after := complete.skip(line, at + len(tag))
			// Uma palavra inteira: TODOS e XXXL não contam.
			if !highlight.isIdent(lastChar(before)) && !highlight.isIdent(firstChar(after)) && inComment(before) {
				return Mark(tag, at, tidyText(after))
			}
		}
	}
	return Mark("", 0, "")
}

// Troca os TODO de `file` pelos do texto novo, no mesmo lugar da lista.
func withTodosOf(todos: model.Todo[], file: Str, text: Str): model.Todo[dyn] {
	fresh := todosIn(file, text)
	mut model.Todo[dyn] out = []
	mut placed := false
	for each t in todos {
		if t.file == file {
			if !placed {
				appendAll(out, fresh)
				placed = true
			}
		} else {
			append(out, t)
		}
	}
	if !placed {
		appendAll(out, fresh)
	}
	return out
}

proc appendAll(out: mut model.Todo[dyn], items: model.Todo[]): void {
	for each t in items {
		append(out, t)
	}
}

// O texto de um arquivo no disco (até 1 MB).
proc textFor(path: Str): Str {
	if hive.file.size(path) is Result.Ok(bytes) {
		if bytes >= 1000000 {
			return ""
		}
	}
	if hive.file.read(path) is Result.Ok(content) {
		return content
	}
	return ""
}

// Procura em todos os arquivos de texto da pasta (até 1 MB cada), numa thread
// própria, e manda o que achou de volta para a janela.
proc scan(window: hive.syslink.Address, root: Str, showHidden: Bool): void {
	mut model.Todo[dyn] found = []
	for each rel in search.allFiles(root, showHidden, 20000) {
		if search.isTextFile(rel) {
			path := workspace.joinPath(root, rel)
			appendAll(found, todosIn(path, textFor(path)))
		}
	}
	async window(model.Cmd.Post(model.Msg.TodosFound(found)))
}
