// Testes de lib/git.hive.

import ../lib/git
import ../lib/model
import ../lib/process
import ../lib/complete

test "o porcelain vira arquivos com caminho relativo à pasta aberta" {
	if git.parseFile("?? lib/novo.hive", "") is Result.Ok(fresh) {
		assert git.kindOf(fresh) == "new" && git.badge("new", fresh) == "U"
		assert fresh.rel == "lib/novo.hive"
	} else {
		assert false
	}
	if git.parseFile(" M app/lib/x.hive", "app/") is Result.Ok(edited) {
		assert git.kindOf(edited) == "modified" && edited.rel == "lib/x.hive"
		assert git.unstaged(edited) && !git.staged(edited)
	} else {
		assert false
	}
	if git.parseFile("R  velho.hive -> novo.hive", "") is Result.Ok(renamed) {
		assert renamed.path == "novo.hive" && git.staged(renamed)
	}
	if git.parseFile(" M outro/y.hive", "app/") is Result.Ok(outside) {
		assert outside.rel == ""
	}
}

test "um diff vira arquivos com linhas numeradas nos dois lados" {
	patch := "diff --git a/lib/a.hive b/lib/a.hive\nindex 1..2 100644\n--- a/lib/a.hive\n+++ b/lib/a.hive\n@@ -1,3 +1,3 @@ proc main\n linha um\n-velha\n+nova\n fim\ndiff --git a/novo.md b/novo.md\nnew file mode 100644\n--- /dev/null\n+++ b/novo.md\n@@ -0,0 +1 @@\n+# oi\n"
	parsed := git.parseDiff(patch, 100)
	assert len(parsed.files) == 2
	assert !parsed.truncated
	if parsed.files is [edited, created] {
		assert edited.path == "lib/a.hive" && edited.status == "M"
		assert edited.added == 1 && edited.removed == 1
		assert len(edited.lines) == 5
		if edited.lines is [hunk, same, gone, came, last] {
			assert hunk.kind == "hunk"
			assert same.kind == "ctx" && same.old == 1 && same.new == 1 && same.text == "linha um"
			assert gone.kind == "del" && gone.old == 2 && gone.new == 0
			assert came.kind == "add" && came.new == 2 && came.old == 0
			assert last.old == 3 && last.new == 3
		}
		assert created.status == "A" && created.added == 1
	}
	short := git.parseDiff(patch, 3)
	assert short.truncated
}

test "o cabeçalho diz o branch e quanto está à frente" {
	mut info := model.emptyGit()
	git.withBranch(info, "main...origin/main [ahead 2, behind 1]")
	assert info.branch == "main" && info.ahead == 2 && info.behind == 1
	mut empty := model.emptyGit()
	git.withBranch(empty, "No commits yet on main")
	assert empty.branch == "main"
}

test "pastas herdam a cor dos arquivos" {
	mut info := model.emptyGit()
	info.files = [model.GitFile("lib/a.hive", "lib/a.hive", "?", "?"), model.GitFile("src/b.hive", "src/b.hive", " ", "M")]
	assert git.folderKind(info, "lib") == "new"
	assert git.folderKind(info, "src") == "modified"
	assert git.folderKind(info, "docs") == ""
	assert git.fileKind(info, "src/b.hive") == "modified"
}

test "o que o .gitignore tira do repositório: o próprio item ou uma pasta acima" {
	folder := "./ignore-test"
	if hive.file.makeDir(folder + "/dist/sub") is Result.Error(why) {
		panic why
	}
	_init := process.run("git", ["init", "-q"], folder)
	for each file in [".gitignore", "dist/sub/a.js", "app.log", "main.hive"] {
		mut text := "x"
		if file == ".gitignore" {
			text = "dist/\n*.log\n"
		}
		if hive.file.write(folder + "/" + file, text) is Result.Error(why) {
			panic why
		}
	}
	mut info := model.emptyGit()
	git.refresh(folder, info)
	assert info.ignored == ["app.log", "dist/"]
	assert git.ignored(info, "dist") && git.ignored(info, "dist/sub") && git.ignored(info, "dist/sub/a.js")
	assert git.ignored(info, "app.log")
	assert !git.ignored(info, "main.hive") && !git.ignored(info, "distante") && !git.ignored(info, "")
}
