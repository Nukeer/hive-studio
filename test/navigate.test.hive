// Testes de lib/navigate.hive.

import ../lib/navigate
import ../lib/highlight
import ../lib/analysis
import ../lib/workspace
import ../lib/complete

test "o nome sob o cursor e seu qualificador" {
	w := navigate.wordAt("x := model.Msg.Toggle(p)", 18)
	assert w.name == "Toggle"
	assert w.qualifier == "model.Msg"
	plain := navigate.wordAt("return reload(next)", 9)
	assert plain.name == "reload" && plain.qualifier == ""
}

test "acha declarações, variantes e variáveis locais no próprio arquivo" {
	source := "type Msg \{\n\tOpen \{ path: Str }\n\tSave\n}\n\nfunc total(v: Int): Int \{\n\tsum := v + 1\n\treturn sum\n}\n"
	if navigate.findIn(source, "total") is Result.Ok(line) {
		assert line == 6
	} else {
		assert false
	}
	if navigate.findIn(source, "Save") is Result.Ok(line) {
		assert line == 3
	}
	if navigate.findLocal(source, "sum", 8) is Result.Ok(line) {
		assert line == 7
	}
	assert navigate.offsetOf(source, 3, 1) == len("type Msg \{\n\tOpen \{ path: Str }\n") + 1
}

test "só é clicável o que tem para onde ir" {
	source := "proc run(state: Int, name: Str): void \{\n\tif hive.file.read(name) is Result.Ok(text) \{\n\t\techo text\n\t}\n\tfor each item in [1, 2] \{\n\t\techo item + state\n\t}\n\tif name == \"\" \{\n\t\treturn\n\t}\n}\n"
	ifAt := navigate.offsetOf(source, 2, 2)
	assert navigate.locate("x.hive", source, ifAt) is Result.Error(_)
	strAt := navigate.offsetOf(source, 1, 36)
	assert navigate.locate("x.hive", source, strAt) is Result.Error(_)
	if navigate.locate("x.hive", source, navigate.offsetOf(source, 3, 8)) is Result.Ok(target) {
		assert target.line == 2
	} else {
		assert false
	}
	if navigate.locate("x.hive", source, navigate.offsetOf(source, 6, 8)) is Result.Ok(target) {
		assert target.line == 5
	} else {
		assert false
	}
	if navigate.locate("x.hive", source, navigate.offsetOf(source, 6, 17)) is Result.Ok(target) {
		assert target.line == 1
	} else {
		assert false
	}
	assert navigate.locate("x.hive", source, navigate.offsetOf(source, 9, 4)) is Result.Error(_)
}

test "valor.campo acha o campo no módulo importado" {
	if hive.file.makeDir("./nav-field/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write("./nav-field/lib/model.hive", "type State \{\n\troot: Str\n\tdocs: Str[dyn]\n}\n") is Result.Error(why) {
		panic why
	}
	main := "import ./lib/model\n\nfunc f(state: model.State): Str \{\n\treturn state.root\n}\n"
	if navigate.locate("./nav-field/main.hive", main, navigate.offsetOf(main, 4, 15)) is Result.Ok(target) {
		assert target.file == "./nav-field/lib/model.hive"
		assert target.line == 2
	} else {
		assert false
	}
}

test "resolve módulos importados, inclusive Go" {
	if hive.file.makeDir("./nav-test/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write("./nav-test/lib/util.hive", "func helper(): Int \{\n\treturn 1\n}\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write("./nav-test/lib/native.go", "package native\n\nfunc Start(dir string) (int, error) \{ return 0, nil }\n") is Result.Error(why) {
		panic why
	}
	main := "import ./lib/util\nimport ./lib/native.go\n\nproc main(): void \{\n\techo util.helper()\n\tx := native.start(\".\")\n}\n"
	caretHelper := navigate.offsetOf(main, 5, 11)
	if navigate.locate("./nav-test/main.hive", main, caretHelper) is Result.Ok(target) {
		assert target.file == "./nav-test/lib/util.hive"
		assert target.line == 1
	} else {
		assert false
	}
	caretStart := navigate.offsetOf(main, 6, 16)
	if navigate.locate("./nav-test/main.hive", main, caretStart) is Result.Ok(target) {
		assert target.file == "./nav-test/lib/native.go"
		assert target.line == 3
	} else {
		assert false
	}
}
