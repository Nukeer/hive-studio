// Ajudantes dos testes de studioui.hive: um arquivo `.test.hive` importado
// por test/suite.hive só pode ter imports e blocos `test`.

// Uma pasta de projeto de mentira, escrita pelo próprio teste.
proc fixture(): Str {
	folder := "./ui-test"
	if hive.file.makeDir(folder + "/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\r\n\techo 1\r\n}\r\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n") is Result.Error(why) {
		panic why
	}
	return folder
}
