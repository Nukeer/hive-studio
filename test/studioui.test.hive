// Testes de studioui.hive e lib/uiview.hive: o Hive Studio desenhado só com
// os widgets do hive.ui.

import ../studioui as studioUi
import ../lib/model
import ../lib/uiview
import ../lib/highlight
import ./support/studioui as support

test "o cursor fica no fim do trecho que a edição mudou" {
	assert studioUi.caretAfter("abc", "abXc") == 3
	assert studioUi.caretAfter("abc", "ab") == 2
	assert studioUi.caretAfter("", "x") == 1
	assert studioUi.caretAfter("proc main", "proc mainx") == 10
	assert studioUi.caretAfter("igual", "igual") == 5
}

test "o realce volta em pedaços com a classe de cada um, e o texto sai igual" {
	source := "proc main(): void \{ echo \"a<b\" } // TODO x"
	tokens := uiview.tokensOf(highlight.highlight(source))
	mut Str[dyn] texts = []
	mut keyword := false
	mut todo := false
	mut quoted := false
	for each token in tokens {
		append(texts, token.text)
		if token.cls == "tk" && token.text == "proc" {
			keyword = true
		}
		if token.cls == "td" && token.text == "TODO" {
			todo = true
		}
		if token.cls == "ts" && token.text == "\"a<b\"" {
			quoted = true
		}
	}
	assert join(texts, "") == source
	assert keyword && todo && quoted
	assert uiview.words("util.dobro(2)") == ["util", ".", "dobro", "(", "2", ")"]
}

test "a linha de uma posição sai do começo de cada linha" {
	starts := uiview.lineStarts(["ab", "", "cde"])
	assert starts == [0, 3, 4]
	assert uiview.lineAt(starts, 0) == 1
	assert uiview.lineAt(starts, 2) == 1
	assert uiview.lineAt(starts, 3) == 2
	assert uiview.lineAt(starts, 4) == 3
	assert uiview.lineAt(starts, 99) == 3
}

test "o código abre no editor colorido, e o Markdown no preview" {
	code := model.newDoc("a.hive", "a.hive", "", "
", "edit")
	assert uiview.modeOf(code) == "edit"
	notes := model.newDoc("a.md", "a.md", "", "
", "preview")
	assert uiview.modeOf(notes) == "preview"
}

test "abrir, digitar, salvar e fechar pelos widgets" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	assert support.shows(win, "Hive Studio")
	assert support.shows(win, "main.hive")
	_opened := studioUi.update(win, uiview.act("open", folder + "/main.hive"), sink)
	assert len(win.core.docs) == 1
	// O realce que vai à ponte: `proc` como palavra-chave, o TODO em destaque.
	assert indexOf(support.hlText(win), ">proc</span>") is Result.Ok(_)
	assert indexOf(support.hlText(win), ">TODO</span>") is Result.Ok(_)
	text := support.docText(win)
	_typed := studioUi.update(win, uiview.edited(text + "// fim\n"), sink)
	assert support.docDirty(win)
	assert win.core.caret == len(text + "// fim\n")
	assert support.shows(win, "●")
	_closing := studioUi.update(win, uiview.act("close", "0"), sink)
	assert support.shows(win, "Salvar e fechar")
	_saved := studioUi.update(win, uiview.act("closeSave", folder + "/main.hive"), sink)
	assert len(win.core.docs) == 0
	if hive.file.read(folder + "/main.hive") is Result.Ok(disk) {
		assert indexOf(disk, "// fim\r\n") is Result.Ok(_)
	} else {
		assert false
	}
}

test "menus abrem e fecham, e qualquer outro clique fecha o menu" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	assert !support.shows(win, "Fechar aba")
	_open := studioUi.update(win, uiview.chrome("menu", "Arquivo"), sink)
	assert win.extra.menu == "Arquivo"
	assert support.shows(win, "Fechar aba")
	_other := studioUi.update(win, uiview.act("side", "git"), sink)
	assert win.extra.menu == ""
	assert win.core.side == model.SideView.GitSide()
}

test "cada tela desenha: configurações, preview, busca, painel e a paleta" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	_settings := studioUi.update(win, uiview.act("settings", ""), sink)
	assert support.shows(win, "Tema de cor")
	assert support.shows(win, "Hive Dark")
	_closed := studioUi.update(win, uiview.act("closeSettings", ""), sink)
	_md := studioUi.update(win, uiview.act("open", folder + "/LEIAME.md"), sink)
	assert support.shows(win, "Título")
	assert support.shows(win, "☑")
	_code := studioUi.update(win, uiview.act("open", folder + "/lib/util.hive"), sink)
	_find := studioUi.update(win, uiview.action("find"), sink)
	_typed := studioUi.update(win, uiview.field("find", "n"), sink)
	assert support.shows(win, "1 de")
	_problems := studioUi.update(win, uiview.act("pane", "problems"), sink)
	assert support.shows(win, "PROBLEMAS")
	_palette := studioUi.update(win, uiview.action("quickOpen"), sink)
	assert support.shows(win, "Buscar arquivo pelo nome")
	_side := studioUi.update(win, uiview.act("side", "outline"), sink)
	assert support.shows(win, "dobro")
}

test "as setas da vista realçada a movem, e o cursor volta a mandar nela" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	_open := studioUi.update(win, uiview.act("open", folder + "/main.hive"), sink)
	_moved := studioUi.update(win, uiview.chrome("top", "3"), sink)
	assert win.extra.top == 3
	_caret := studioUi.update(win, uiview.edited(support.docText(win) + "x"), sink)
	assert win.extra.top == 0
}

test "a ponte leva ao script os atalhos, o cursor, a busca e o que copiar" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	_open := studioUi.update(win, uiview.act("open", folder + "/lib/util.hive"), sink)
	_find := studioUi.update(win, uiview.action("find"), sink)
	_typed := studioUi.update(win, uiview.field("find", "dobro"), sink)
	sent := uiview.bridgeState(win.core, win.extra)
	assert indexOf(sent.keys, "Ctrl+S") is Result.Ok(_)
	assert sent.serial == win.core.textSerial
	assert sent.findFrom == 5 && sent.findTo == 10
	assert sent.focus == "Buscar"
	assert support.shows(win, "hive-state")
	assert support.shows(win, "hive-bridge")
	// O cursor chega no formato da página própria.
	_caret := studioUi.update(win, model.Cmd.Ui("\{\"kind\":\"caret\",\"caret\":7}"), sink)
	assert win.core.caret == 7
	_ctx := studioUi.update(win, uiview.actText("ctx", "copyRelative", folder + "/lib/util.hive"), sink)
	assert uiview.bridgeState(win.core, win.extra).clip == "lib/util.hive"
}

test "o painel AGENTE abre o agente num terminal de verdade e a ponte o mostra" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	win.core.settings.claudeCommand = "sh"
	win.core.settings.codexCommand = "programa-que-nao-existe-hive --flag"
	_opened := studioUi.update(win, uiview.act("pane", "agent"), sink)
	sent := uiview.bridgeState(win.core, win.extra)
	assert sent.agentShown != 0
	assert sent.agentSessions == [sent.agentShown]
	assert sent.focus == "@agent"
	assert len(sent.agentKeys) == 3
	assert support.shows(win, "OpenCode")
	assert support.shows(win, "padding:11px")
	_missing := studioUi.update(win, uiview.act("agent", "codex"), sink)
	assert uiview.bridgeState(win.core, win.extra).agentShown == 0
	assert support.shows(win, "programa-que-nao-existe-hive: não encontrado no PATH")
}

test "o olá da ponte põe os vigias para rodar, e o painel tem o puxador da altura" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	win.started = false
	_hello := studioUi.update(win, uiview.chrome("hello", ""), sink)
	assert win.started
	assert support.shows(win, "height:5px")
	_drag := studioUi.update(win, uiview.field("panelHeight", "333"), sink)
	assert win.core.settings.panelHeight == 333
	assert support.shows(win, "height:333px")
}

test "o modo Vim: as teclas vão ao motor e a ponte leva o modo, a seleção e a linha de comando" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	win.core.settings.vim = true
	_open := studioUi.update(win, uiview.act("open", folder + "/lib/util.hive"), sink)
	assert uiview.bridgeState(win.core, win.extra).vim == "normal"
	assert support.shows(win, "VIM NORMAL")
	_j := studioUi.update(win, model.Cmd.Ui("\{\"kind\":\"vim\",\"text\":\"j\",\"caret\":-1,\"arg\":\"0 30\"}"), sink)
	moved := uiview.bridgeState(win.core, win.extra)
	assert moved.caret == 26 && moved.selStart == 26 && moved.vimAck == 1
	_v := studioUi.update(win, model.Cmd.Ui("\{\"kind\":\"vim\",\"text\":\"v\",\"caret\":-1,\"arg\":\"0 30\"}"), sink)
	assert uiview.bridgeState(win.core, win.extra).vim == "visual"
	_esc := studioUi.update(win, model.Cmd.Ui("\{\"kind\":\"vim\",\"text\":\"<Esc>\",\"caret\":-1,\"arg\":\"0 30\"}"), sink)
	_colon := studioUi.update(win, model.Cmd.Ui("\{\"kind\":\"vim\",\"text\":\":\",\"caret\":-1,\"arg\":\"0 30\"}"), sink)
	assert uiview.bridgeState(win.core, win.extra).focus == uiview.vimMark()
	assert support.shows(win, "placeholder=\"" + uiview.vimMark() + "\"")
}

test "o realce vai inteiro ao abrir, só as linhas mudadas ao digitar, e nada quando nada muda" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	_open := studioUi.update(win, uiview.act("open", folder + "/lib/util.hive"), sink)
	if model.HlUpdate.decode(win.extra.hl, hive.json.codec()) is Result.Ok(full) {
		assert full.mode == "full"
		assert len(full.lines) == 4
		assert indexOf(join(full.lines, "
"), "<span class=\"tk\">func</span>") is Result.Ok(_)
	} else {
		assert false
	}
	_typed := studioUi.update(win, uiview.edited("// novo
" + support.docText(win)), sink)
	if model.HlUpdate.decode(win.extra.hl, hive.json.codec()) is Result.Ok(patch) {
		assert patch.mode == "patch"
		assert patch.from == 0
	} else {
		assert false
	}
	_idle := studioUi.update(win, uiview.chrome("menu", ""), sink)
	if model.HlUpdate.decode(win.extra.hl, hive.json.codec()) is Result.Ok(kept) {
		assert kept.mode == "keep"
	} else {
		assert false
	}
	_lost := studioUi.update(win, uiview.chrome("hlFull", ""), sink)
	if model.HlUpdate.decode(win.extra.hl, hive.json.codec()) is Result.Ok(again) {
		assert again.mode == "full"
	} else {
		assert false
	}
}

test "o editor só leva o texto quando o programa o troca, e de novo se a página pedir" {
	folder := support.fixture()
	sink := hive.syslink.spawn(support.sink, 0)
	mut win := support.window(folder)
	_open := studioUi.update(win, uiview.act("open", folder + "/lib/util.hive"), sink)
	assert win.extra.showText
	assert uiview.bridgeState(win.core, win.extra).textShown
	_typed := studioUi.update(win, uiview.edited("// a\n" + support.docText(win)), sink)
	assert !win.extra.showText
	assert !support.shows(win, "return n * 2")
	_lost := studioUi.update(win, uiview.chrome("text", ""), sink)
	assert win.extra.showText
	assert support.shows(win, "return n * 2")
}
