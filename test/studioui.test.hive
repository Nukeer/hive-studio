// Testes de studioui.hive, o protótipo desenhado só com o hive.ui.

import ../studioui as studioUi
import ./support/studioui as support

test "a saída do compilador vira problemas, com as continuações juntadas" {
	output := "./main.hive:3: in `main`: `+` wants two of one type\n    and these are Int and Str\nC:/proj/lib/u.hive:12: unexpected `}`\nlinha solta sem posição\n"
	problems := studioUi.parseProblems(output)
	assert len(problems) == 2
	if problems is [first, second] {
		assert first.file == "./main.hive"
		assert first.line == 3
		assert first.message == "in `main`: `+` wants two of one type and these are Int and Str"
		assert second.file == "C:/proj/lib/u.hive"
		assert second.line == 12
	}
	assert len(studioUi.parseProblems("No problems found in main.hive (1s)")) == 0
}

test "fechar uma aba escolhe a vizinha certa" {
	assert studioUi.activeAfterClose(0, 0, 0) == -1
	assert studioUi.activeAfterClose(2, 2, 2) == 1
	assert studioUi.activeAfterClose(1, 1, 3) == 1
	assert studioUi.activeAfterClose(3, 1, 3) == 2
	assert studioUi.activeAfterClose(0, 2, 2) == 0
}

test "o texto some das pontas e as linhas se contam" {
	assert studioUi.strip("  \tx y\t ") == "x y"
	assert studioUi.strip("") == ""
	assert studioUi.lineCount("a\nb\nc") == 3
	assert studioUi.lineOf("a\nb\nc", 2) == "b"
	assert studioUi.lineOf("a", 5) == ""
	assert studioUi.languageName("x.hive") == "Hive"
	assert studioUi.languageName("x.go") == "Go"
	assert studioUi.languageName("LEIAME.md") == "Markdown"
}

test "o fim de linha do arquivo volta ao salvar" {
	doc := studioUi.OpenDoc("a.hive", "a.hive", "x\ny", "x\ny", "\r\n")
	assert studioUi.toDisk(doc) == "x\r\ny"
	assert studioUi.eolOf("a\r\nb") == "\r\n"
	assert studioUi.eolOf("a\nb") == "\n"
	assert !studioUi.dirty(doc)
}

test "abrir, editar, fechar com alterações pergunta, e salvar grava no disco" {
	folder := support.fixture()
	mut state := studioUi.initial(folder)
	window := hive.syslink.spawnAddressed(studioUi.update, state)
	assert state.entry == folder + "/main.hive"
	assert len(state.rows) == 2

	studioUi.update(state, studioUi.Msg.Toggle(folder + "/lib"), window)
	assert len(state.rows) == 3

	studioUi.update(state, studioUi.Msg.Open(folder + "/main.hive"), window)
	studioUi.update(state, studioUi.Msg.Open(folder + "/lib/util.hive"), window)
	studioUi.update(state, studioUi.Msg.Open(folder + "/main.hive"), window)
	assert len(state.docs) == 2
	assert state.active == 0

	studioUi.update(state, studioUi.Msg.Edit("proc main(): void \{\n\techo 2\n}\n"), window)
	assert studioUi.anyDirty(state.docs)
	studioUi.update(state, studioUi.Msg.Close(0), window)
	assert state.closing == 0 && len(state.docs) == 2
	studioUi.update(state, studioUi.Msg.CloseCancel(), window)
	assert state.closing == -1

	studioUi.update(state, studioUi.Msg.Close(0), window)
	studioUi.update(state, studioUi.Msg.CloseSaving(), window)
	assert len(state.docs) == 1 && state.active == 0
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "proc main(): void \{\r\n\techo 2\r\n}\r\n"
	}

	// Um problema do Check abre o arquivo dele.
	studioUi.update(state, studioUi.Msg.Checked("{folder}/main.hive:2: algo errado\n", false), window)
	assert len(state.problems) == 1 && state.checked == "✗ 1 problema(s)"
	studioUi.update(state, studioUi.Msg.Jump(0), window)
	assert len(state.docs) == 2 && state.status == "linha 2: echo 2"

	// A vista é uma árvore do hive.ui; o HTML dela mostra abas, árvore e problema.
	page := hive.ui.html(studioUi.view(state))
	assert indexOf(page, "util.hive") is Result.Ok(_)
	assert indexOf(page, "algo errado") is Result.Ok(_)
	assert indexOf(page, "Check") is Result.Ok(_)
}
