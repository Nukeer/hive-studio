test "Ctrl+F acha ocorrências e Ctrl+P lista arquivos da pasta" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	state.find = model.FindBox(true, "ECHO", false, 0, 0)
	assert len(render.findMatches(render.searched(state), state.find)) == 1
	assert indexOf(render.findBox(state), "1 de 1") is Result.Ok(_)
	state.find.caseSensitive = true
	assert len(render.findMatches(render.searched(state), state.find)) == 0
	state.palette = model.Palette(true, "main", 0, search.allFiles(folder, false, 100))
	assert len(render.paletteMatches(state.palette)) == 1
	assert studio.paletteChoice(state, 0) == "main.hive"
	assert indexOf(render.palette(state), "main.hive") is Result.Ok(_)
	if studio.actionMsg(state, "quickOpen", 0) is Result.Ok(message) {
		assert message == model.Msg.PaletteOpen()
	} else {
		assert false
	}
	mut moved := state
	studio.jumpTo(moved, folder + "/main.hive", 2, 1)
	assert moved.caret == len("proc main(): void \{") + 2
}

test "o frame só leva o texto e o realce que a página ainda não tem" {
	folder := support.scratch()
	mut opened := support.fresh(folder)
	studio.openDoc(opened, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(studio.serve, opened)
	first := support.answer(db, support.event("hello", "", "", "", 0))
	assert first.hasText && first.text == "proc main(): void \{\n\techo 1\n}\n"
	assert first.hl.mode == "full" && len(first.hl.lines) == 4 && first.lineCount == 4
	typed := support.answer(db, model.Event("edit", "", "x", "", 1, 0, 0, first.serial))
	assert !typed.hasText && typed.text == ""
	assert typed.hl.mode == "patch" && typed.hl.from == 0 && typed.hl.remove == 1
	assert typed.hl.source == ["xproc main(): void \{"] && typed.hl.version == first.hl.version + 1
	quiet := support.answer(db, support.event("caret", "", "", "", 3))
	assert !quiet.hasText && quiet.hl.mode == "keep"
	stale := support.answer(db, model.Event("edit", "", "y", "", 1, 0, 0, first.serial + 7))
	assert stale.hl.mode == "keep"
	again := support.answer(db, support.event("resync", "", "", "", 0))
	assert again.hasText && again.text == "xproc main(): void \{\n\techo 1\n}\n" && again.hl.mode == "full"
}

test "modo Vim: as teclas passam pelo serviço e voltam como texto, cursor e barra" {
	folder := support.scratch()
	mut start := support.fresh(folder)
	start.settings.vim = true
	studio.openDoc(start, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(studio.serve, start)

	first := support.vimKeys(db, "")
	assert first.vim == "normal"
	assert support.regionOf(first, "vimbar") != ""
	assert indexOf(support.regionOf(first, "status"), "VIM NORMAL") is Result.Ok(_)

	moved := support.vimKeys(db, "j")
	assert moved.caret == 20
	assert moved.vimSerial > first.vimSerial
	assert moved.vimAck == first.vimAck + 1

	deleted := support.vimKeys(db, "dd")
	assert deleted.text == "proc main(): void \{\n}\n"
	assert deleted.serial > moved.serial
	assert support.vimKeys(db, "u").text == "proc main(): void \{\n\techo 1\n}\n"

	// `o` abre a linha; o que se digita chega como edição, e Esc volta ao normal.
	opened := support.vimKeys(db, "o")
	assert opened.vim == "insert"
	assert indexOf(support.regionOf(opened, "vimbar"), "-- INSERÇÃO --") is Result.Ok(_)
	typed := replaceAll(opened.text, "\techo 1\n\t\n", "\techo 1\n\techo 2\n")
	_edited := support.ask(db, support.event("edit", "", "", typed, opened.caret + 6))
	back := support.vimKeys(db, "<Esc>")
	assert back.vim == "normal"
	assert back.text == "proc main(): void \{\n\techo 1\n\techo 2\n}\n"

	// Uma tecla que chega antes da página saber da inserção vira texto.
	late := support.vimKeys(db, "Ax<Esc>")
	assert late.text == "proc main(): void \{\n\techo 1\n\techo 2x\n}\n"
	assert support.vimKeys(db, "u").text == back.text

	// A linha de comando: `:` põe o foco nela, e `:w` salva com o fim de linha do arquivo.
	prompt := support.vimKeys(db, ":")
	assert prompt.focus == "vimCommand"
	assert indexOf(support.regionOf(prompt, "vimbar"), "data-vimcmd") is Result.Ok(_)
	saved := support.ask(db, support.event("act", "vimSubmit", "", "w", 0))
	assert saved.focus == "editor"
	assert indexOf(support.regionOf(saved, "vimbar"), "main.hive") is Result.Ok(_)
	if hive.file.read(folder + "/main.hive") is Result.Ok(disk) {
		assert disk == "proc main(): void \{\r\n\techo 1\r\n\techo 2\r\n}\r\n"
	} else {
		assert false
	}

	// `/` realça enquanto se digita e, com Enter, leva o cursor à ocorrência.
	_searching := support.vimKeys(db, "gg/")
	typing := support.ask(db, support.event("field", "vimCommand", "", "echo", 0))
	assert len(typing.marks) == 2
	assert typing.markLength == 4
	found := support.ask(db, support.event("act", "vimSubmit", "", "echo", 0))
	assert found.caret == 21
	assert len(found.marks) == 2
	assert found.markCurrent == 0
	assert len(support.ask(db, support.event("act", "vimSubmit", "", "", 0)).marks) == 2
	cleared := support.vimKeys(db, ":")
	assert len(support.ask(db, support.event("act", "vimSubmit", "", "noh", 0)).marks) == 0
	assert cleared.focus == "vimCommand"

	// Uma seleção com o mouse vira o modo visual.
	selected := support.ask(db, support.event("vimMouse", "", "5", "", 0))
	assert selected.vim == "visual"
	assert selected.selStart == 0 && selected.selEnd == 5
	assert support.vimKeys(db, "<Esc>").vim == "normal"

	// Colar no modo normal (Ctrl+V) também se desfaz com `u`.
	pasted := support.ask(db, support.event("edit", "", "", "// colado\n" + back.text, 10))
	assert pasted.vim == "normal"
	assert support.vimKeys(db, "u").text == back.text

	// Esc sem nada pendente fecha a busca do Ctrl+F.
	withFind := support.ask(db, support.event("key", "", "", "Ctrl+F", 0))
	assert support.regionOf(withFind, "find") != ""
	assert support.regionOf(support.vimKeys(db, "<Esc>"), "find") == ""

	// `:e` abre (e cria) um arquivo relativo à pasta aberta, e volta ao modo normal.
	_again := support.vimKeys(db, ":")
	other := support.ask(db, support.event("act", "vimSubmit", "", "e lib/outro.hive", 0))
	assert hive.file.exists(folder + "/lib/outro.hive")
	assert indexOf(other.title, "outro.hive") is Result.Ok(_)
	assert other.vim == "normal"
	assert other.text == ""
	_removed := hive.file.delete(folder + "/lib/outro.hive")
}

test "o modo Vim se liga pelo menu Editar, pelas Configurações e por um atalho gravável" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	menu := render.titleBar(state)
	assert indexOf(menu, ">Modo Vim<") is Result.Ok(_)
	assert indexOf(menu, "data-arg=\"toggleVim\"") is Result.Ok(_)
	assert indexOf(menu, "✓ Modo Vim") is Result.Error(_)
	state.settingsOpen = true
	state.editorView = model.EditorView.SettingsView()
	page := render.settingsPage(state)
	assert indexOf(page, "Usar as teclas do Vim no editor") is Result.Ok(_)
	assert indexOf(page, "data-arg=\"vim\"") is Result.Ok(_)
	assert indexOf(page, "Modo Vim (ligar/desligar)") is Result.Ok(_)
	assert indexOf(render.statusBar(state), "VIM") is Result.Error(_)
	if studio.clickMsg(state, support.event("act", "setting", "vim", "", 0)) is Result.Ok(message) {
		assert message == model.Msg.ToggleSetting("vim")
