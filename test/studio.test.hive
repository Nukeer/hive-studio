test "o analyze enche o painel ANÁLISE e cada função aponta para o arquivo dela" {
	folder := support.scratch()
	if hive.file.write(folder + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n") is Result.Error(why) {
		panic why
	}
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	output := "  main.hive scores 90/100 over 2 callables\n  1 finding — 1 copy\n\n  50  util.dobro                          func, line 1\n        ·      n\n             a copy\n\n  60  main                                proc, line 1\n"
	mut next := state
	studio.withAnalysis(next, output)
	assert next.pane == model.Pane.AnalysisPane() && next.panelOpen
	assert len(next.hotspots) == 2
	if next.hotspots bounds 1 {
		assert next.hotspots[0].file == folder + "/lib/util.hive"
		assert next.hotspots[1].file == folder + "/main.hive"
		assert next.hotspots[0].detail == "a copy"
	}
	assert next.analysisReport == folder + "/main-analysis.html"
	assert indexOf(render.panel(next), "util.dobro") is Result.Ok(_)
	assert indexOf(render.titleBar(next), "Analyze") is Result.Ok(_)
}

test "o Error Lens põe o erro de um módulo no arquivo e na linha dele" {
	folder := support.scratch()
	if hive.file.write(folder + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n\nfunc ruim(v: Int[dyn]): Int \{\n\tmut t := 0\n\tt = v[3]\n\treturn t\n}\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/main.hive", "import ./lib/util\n\nproc main(): void \{\n\techo util.dobro(2)\n}\n") is Result.Error(why) {
		panic why
	}
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/lib/util.hive")
	state.entrypoint = folder + "/main.hive"
	output := folder + "/main.hive:5: in `util_0_ruim`: cannot prove `3` is in range: `v` has no length\n"
	found := studio.located(state, analysis.parseDiagnostics(output))
	assert found == [model.Diagnostic(folder + "/lib/util.hive", 7, "ruim: cannot prove `3` is in range: `v` has no length", "\tt = v[3]")]
	state.diagnostics = found
	assert render.lensMarks(state) == [model.LensMark(7, "error", "ruim: cannot prove `3` is in range: `v` has no length", "\tt = v[3]")]
	mut spot := model.Hotspot(0, "util.dobro", "func", folder + "/lib/util.hive", 1, "a copy", "func dobro(n: Int): Int \{")
	state.hotspots = [spot]
	marks := render.lensMarks(state)
	assert len(marks) == 2
	if marks bounds 1 {
		assert marks[1].severity == "warning" && marks[1].line == 1 && marks[1].source == "func dobro(n: Int): Int \{"
	}
	state.settings.errorLens = false
	assert len(render.lensMarks(state)) == 0
}

test "a visualização fica guardada: o frame só a manda quando muda, e ela é refeita quando a digitação para" {
	folder := support.explorerFolder("view-test")
	if hive.file.write(folder + "/dados.json", "\{\"a\": 1}\n") is Result.Error(why) {
		panic why
	}
	mut opened := support.fresh(folder)
	studio.openDoc(opened, folder + "/dados.json")
	db := hive.syslink.spawnAddressed(studio.serve, opened)
	first := support.answer(db, support.event("hello", "", "", "", 0))
	assert indexOf(support.regionOf(first, "preview"), "<span class=\"jk\">&quot;a&quot;</span>") is Result.Ok(_)
	quiet := support.answer(db, support.event("caret", "", "", "", 1))
	assert !support.hasRegion(quiet, "preview")
	typed := support.answer(db, model.Event("edit", "", "x", "", 1, 0, 0, first.serial))
	assert !support.hasRegion(typed, "preview") && len(typed.lens) == 0
	hive.task.sleep(1200)
	answered := db(model.Cmd.Render())
	mut later := first
	if answered is Result.Ok(reply) {
		if reply is model.Cmd.Reply(text) {
			if model.Frame.decode(text, hive.json.codec()) is Result.Ok(frame) {
				later = frame
			}
		}
	}
	assert indexOf(support.regionOf(later, "preview"), "JSON inválido") is Result.Ok(_)
	assert len(later.lens) == 1
	if later.lens bounds 0 {
		assert later.lens[0].line == 1 && later.lens[0].source == "x\{\"a\": 1}"
	}
}

test "abrir, editar, salvar e fechar mantém o fim de linha do arquivo" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	assert len(state.tree) == 3
	studio.openDoc(state, folder + "/main.hive")
	assert state.active == 0
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.eol == "\r\n"
		assert indexOf(doc.text, "\r") is Result.Error(_)
		assert indexOf(join(highlight.htmlLines(doc.text, "hive"), "\n"), "<span class=\"tk\">proc</span>") is Result.Ok(_)
	}
	studio.withText(state, "proc main(): void \{\n\techo 2\n}\n")
	assert model.anyDirty(state.docs)
	studio.saveAll(state)
	assert !model.anyDirty(state.docs)
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "proc main(): void \{\r\n\techo 2\r\n}\r\n"
	}
	studio.closeDoc(state, 0)
	assert len(state.docs) == 0
	assert state.active == -1
}

test "expandir uma pasta e criar um arquivo dentro dela" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	studio.toggle(state, folder + "/lib")
	assert studio.targetFolder(state) == folder + "/lib"
	studio.create(state, "novo.hive", false)
	assert hive.file.exists(folder + "/lib/novo.hive")
	assert len(state.docs) == 1
	studio.toggle(state, folder + "/lib")
	assert len(state.tree) == 3
	if hive.file.delete(folder + "/lib/novo.hive") is Result.Error(why) {
		panic why
	}
}

test "digitar sugere, e aceitar completa e reenvia o texto" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	typed := "proc main(): void \{\n\thive.file.re"
	if studio.toMsg(state, support.event("edit", "", "", typed, len(typed))) is Result.Ok(message) {
		assert message == model.Msg.EditAt(typed, len(typed))
	}
	studio.withText(state, typed)
	state.caret = len(typed)
	studio.autoSuggest(state)
	assert len(state.suggestions) > 0
	serial := state.textSerial
	studio.acceptSuggestion(state, 0)
	assert len(state.suggestions) == 0
	assert state.textSerial == serial + 1
	assert studio.activeText(state) == "proc main(): void \{\n\thive.file.read"
}

test "atalhos viram ações e podem ser regravados" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	if studio.toMsg(state, support.event("key", "", "", "Ctrl+`", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	} else {
		assert false
	}
	state.recording = "togglePanel"
	if studio.toMsg(state, support.event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.KeyPressed("Ctrl+J")
	}
	state.settings.keymap = keys.assign("", "togglePanel", "Ctrl+J")
	state.recording = ""
	if studio.toMsg(state, support.event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	}
}

