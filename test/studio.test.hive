		assert false
	}
	state.settings.vim = true
	assert indexOf(render.titleBar(state), "✓ Modo Vim") is Result.Ok(_)
	assert indexOf(render.statusBar(state), "VIM NORMAL") is Result.Ok(_)
	state.words = i18n.words("en")
	assert indexOf(render.titleBar(state), "Vim Mode") is Result.Ok(_)
}

test "o explorador anda pelo teclado, :Ex põe o foco nele e a linha de comando funciona lá" {
	folder := support.explorerFolder("explorer-test")
	if hive.file.write(folder + "/lib/util.hive", "func one(): Int \{ return 1 }\n") is Result.Error(why) {
		panic why
	}
	mut start := support.fresh(folder)
	start.settings.vim = true
	studio.openDoc(start, folder + "/lib/util.hive")
	db := hive.syslink.spawnAddressed(studio.serve, start)

	// O explorador começa aberto: `:Ex` o fecha e deixa o foco no código.
	_toClose := support.vimKeys(db, ":")
	hidden := support.ask(db, support.event("act", "vimSubmit", "", "Ex", 0))
	assert !hidden.side
	assert hidden.focus == "editor"
	// Fechado, `:Ex` o abre com as pastas até o arquivo atual, seleciona-o e leva o foco.
	_prompt := support.vimKeys(db, ":")
	shown := support.ask(db, support.event("act", "vimSubmit", "", "Ex", 0))
	assert shown.focus == "explorer"
	assert support.selectedName(shown) == "util.hive"
	assert shown.side

	assert support.selectedName(support.treeKeys(db, "k")) == "lib"
	assert support.selectedName(support.treeKeys(db, "h")) == "lib"
	collapsed := support.treeKeys(db, "")
	assert indexOf(support.regionOf(collapsed, "side"), "util.hive") is Result.Error(_)
	assert support.selectedName(support.treeKeys(db, "l")) == "lib"
	assert support.selectedName(support.treeKeys(db, "l")) == "util.hive"
	assert support.selectedName(support.treeKeys(db, "h")) == "lib"
	assert support.selectedName(support.treeKeys(db, "G")) == "main.hive"
	assert support.selectedName(support.treeKeys(db, "gg")) == "lib"
	assert support.selectedName(support.treeKeys(db, "2j")) == "LEIAME.md"
	assert support.selectedName(support.treeKeys(db, "<Up><Down><Down>")) == "main.hive"
	assert support.selectedName(support.treeKeys(db, "3G")) == "LEIAME.md"

	// `:` no explorador abre a linha de comando; Esc volta o foco para ele.
	command := support.treeKeys(db, ":")
	assert command.focus == "vimCommand"
	assert indexOf(support.regionOf(command, "vimbar"), "data-vimcmd") is Result.Ok(_)
	assert support.ask(db, support.event("act", "vimCancel", "", "", 0)).focus == "explorer"
	_again := support.treeKeys(db, ":")
	stayed := support.ask(db, support.event("act", "vimSubmit", "", "noh", 0))
	assert stayed.focus == "explorer"

	// Enter num arquivo abre e leva o foco ao editor.
	opened := support.treeKeys(db, "G<CR>")
	assert indexOf(opened.title, "main.hive") is Result.Ok(_)
	assert opened.focus == "editor"
	// `:e .` volta ao explorador, com o arquivo aberto selecionado.
	_edit := support.vimKeys(db, ":")
	back := support.ask(db, support.event("act", "vimSubmit", "", "e .", 0))
	assert back.focus == "explorer"
	assert support.selectedName(back) == "main.hive"
	// Um comando que abre arquivo, vindo do explorador, leva o foco ao editor.
	_open := support.treeKeys(db, ":")
	util := support.ask(db, support.event("act", "vimSubmit", "", "e lib/util.hive", 0))
	assert util.focus == "editor"
	assert indexOf(util.title, "util.hive") is Result.Ok(_)
	assert support.treeKeys(db, "<Esc>").focus == "editor"

	// `:Ex` com o explorador aberto o fecha e volta ao código — do editor ou do
	// próprio explorador; fechado, abre de novo com o foco nele.
	_closing := support.vimKeys(db, ":")
	closed := support.ask(db, support.event("act", "vimSubmit", "", "Ex", 0))
	assert !closed.side
	assert closed.focus == "editor"
	_opening := support.vimKeys(db, ":")
	reopened := support.ask(db, support.event("act", "vimSubmit", "", "Ex", 0))
	assert reopened.side
	assert reopened.focus == "explorer"
	_fromTree := support.treeKeys(db, ":")
	fromTree := support.ask(db, support.event("act", "vimSubmit", "", "Lex", 0))
	assert !fromTree.side
	assert fromTree.focus == "editor"
	// Com uma pasta, `:Ex` vai até ela em vez de fechar.
	_folder := support.vimKeys(db, ":")
	_shown := support.ask(db, support.event("act", "vimSubmit", "", "Ex", 0))
	_lib := support.vimKeys(db, ":")
	lib := support.ask(db, support.event("act", "vimSubmit", "", "Ex lib", 0))
	assert lib.side
	assert lib.focus == "explorer"
	assert support.selectedName(lib) == "lib"
	_removed := hive.file.delete(folder + "/lib/util.hive")
}

test "sem o modo Vim, as setas andam no explorador mas j e k não" {
	folder := support.explorerFolder("explorer-plain-test")
	mut start := support.fresh(folder)
	start.selected = folder + "/lib"
	db := hive.syslink.spawnAddressed(studio.serve, start)
	assert support.selectedName(support.treeKeys(db, "")) == "lib"
	assert support.selectedName(support.treeKeys(db, "j")) == "lib"
	assert support.selectedName(support.treeKeys(db, "<Down>")) == "LEIAME.md"
	assert support.selectedName(support.treeKeys(db, "<End>")) == "main.hive"
	opened := support.treeKeys(db, "<CR>")
	assert indexOf(opened.title, "main.hive") is Result.Ok(_)
	assert support.treeKeys(db, ":").focus != "vimCommand"
}

test "o painel AGENTE abre cada agente num terminal de verdade, troca entre eles e reinicia" {
	folder := support.explorerFolder("agent-test")
	mut start := support.fresh(folder)
	start.settings.claudeCommand = "sh"
	start.settings.codexCommand = "programa-que-nao-existe-hive --flag"
	studio.openDoc(start, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(studio.serve, start)

	opened := support.ask(db, support.event("act", "agent", "claude", "", 0))
	session := opened.agentShown
	assert session != 0
	assert opened.agentSessions == [session]
	assert opened.focus == "agent"
	assert opened.panel
	assert indexOf(support.regionOf(opened, "panelview"), "AGENTE") is Result.Ok(_)
	assert indexOf(support.regionOf(opened, "panelview"), "OpenCode") is Result.Ok(_)
	assert len(opened.agentKeys) == 3
	_typed := pty.write(session, "pwd; stty size\r")
	seen := agents.output(session, "24 80", 3000)
	assert indexOf(seen, "agent-test") is Result.Ok(_)

	// Um agente que não está instalado diz o que fazer, e o outro continua vivo.
	missing := support.ask(db, support.event("act", "agent", "codex", "", 0))
	assert missing.agentShown == 0
	assert indexOf(support.regionOf(missing, "panelview"), "programa-que-nao-existe-hive: não encontrado no PATH") is Result.Ok(_)
	assert indexOf(support.regionOf(missing, "panelview"), "Configurações") is Result.Ok(_)
	back := support.ask(db, support.event("act", "agent", "claude", "", 0))
	assert back.agentShown == session
	assert pty.alive(session)

	// Reiniciar troca a sessão; a antiga termina.
	restarted := support.ask(db, support.event("act", "agentRestart", "claude", "", 0))
	assert restarted.agentShown != session
	assert restarted.agentSessions == [restarted.agentShown]
	for waited := 0; waited < 2000; waited = waited + 50 {
		if !pty.alive(session) {
			break
		}
		hive.task.sleep(50)
	}
	assert !pty.alive(session)

	// Quando o programa termina, o painel diz o código e oferece abrir de novo.
	_quit := pty.write(restarted.agentShown, "exit 5\r")
	mut notice := ""
	for waited := 0; waited < 3000; waited = waited + 100 {
		if indexOf(notice, "(código 5)") is Result.Ok(_) {
			break
		}
		hive.task.sleep(100)
		notice = support.regionOf(support.ask(db, support.event("hello", "", "", "", 0)), "panelview")
	}
	assert indexOf(notice, "O agente terminou (código 5)") is Result.Ok(_)
	assert indexOf(notice, "agentRestart") is Result.Ok(_)

	// O atalho do agente fecha o painel quando ele está à vista, e abre de novo.
	combo := keys.keysFor("", "agent")
	hidden := support.ask(db, support.event("key", "", "", combo, 0))
	assert !hidden.panel
	assert hidden.agentShown == 0
	assert support.ask(db, support.event("key", "", "", combo, 0)).panel
}

test "a busca de TODO lê o disco, e um documento não salvo entra com o texto do editor" {
	folder := support.explorerFolder("todo-test")
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	studio.withText(state, "// TODO: não salvo\n")
	db := hive.syslink.spawnAddressed(studio.serve, support.fresh(folder))
	disk := [model.Todo(folder + "/LEIAME.md", 1, 5, "TODO", "do disco")]
	studio.update(state, model.Msg.TodosFound(disk), db)
	assert state.todoScanned && !state.todoScanning
	assert len(state.todos) == 2
	if state.todos bounds 1 {
		assert state.todos[0].text == "do disco"
		assert state.todos[1].file == folder + "/main.hive" && state.todos[1].text == "não salvo"
	}
	packed := toolchain.packOverlays(state.docs)
	if toolchain.Overlays.decode(packed, hive.json.codec()) is Result.Ok(overlays) {
		assert overlays.items == [toolchain.Overlay(folder + "/main.hive", "// TODO: não salvo\n")]
	} else {
		assert false
	}
}

test "fechar um arquivo alterado pergunta: salvar e fechar, fechar sem salvar ou cancelar" {
	folder := support.explorerFolder("close-test")
	db := hive.syslink.spawnAddressed(studio.serve, support.fresh(folder))
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	studio.update(state, model.Msg.CloseDoc(0), db)
	assert len(state.docs) == 0 && state.closing == ""
	studio.openDoc(state, folder + "/main.hive")
	studio.withText(state, "// um\n")
	studio.update(state, model.Msg.CloseDoc(0), db)
	assert len(state.docs) == 1
	assert state.closing == folder + "/main.hive"
	dialog := render.overlay(state)
	assert indexOf(dialog, "Salvar e fechar") is Result.Ok(_) && indexOf(dialog, "Fechar sem salvar") is Result.Ok(_)
	assert studio.escapeKind(state) == "dialog"
	studio.update(state, model.Msg.CancelDialog(), db)
	assert state.closing == "" && len(state.docs) == 1 && studio.activeText(state) == "// um\n"
	studio.update(state, model.Msg.CloseDoc(0), db)
	studio.update(state, model.Msg.CloseDiscard(folder + "/main.hive"), db)
	assert len(state.docs) == 0 && state.closing == ""
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "\n"
	}
	studio.openDoc(state, folder + "/main.hive")
	studio.withText(state, "// dois\n")
	studio.update(state, model.Msg.CloseDoc(0), db)
	studio.update(state, model.Msg.CloseSave(folder + "/main.hive"), db)
	assert len(state.docs) == 0 && state.closing == ""
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "// dois\n"
	}
	// `:q!` fecha sem perguntar.
	studio.openDoc(state, folder + "/main.hive")
	studio.withText(state, "// três\n")
	studio.update(state, model.Msg.CloseDocNow(0), db)
	assert len(state.docs) == 0 && state.closing == ""
}

test "excluir um arquivo ou uma pasta pergunta antes e fecha o que estava aberto" {
	folder := support.explorerFolder("remove-test")
	if hive.file.write(folder + "/lib/util.hive", "\n") is Result.Error(why) {
		panic why
	}
	db := hive.syslink.spawnAddressed(studio.serve, support.fresh(folder))
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/LEIAME.md")
	studio.update(state, model.Msg.AskRemove(folder + "/LEIAME.md"), db)
	assert state.removing == folder + "/LEIAME.md"
	assert indexOf(render.overlay(state), "O arquivo é apagado do disco") is Result.Ok(_)
	studio.update(state, model.Msg.CancelDialog(), db)
	assert state.removing == "" && hive.file.exists(folder + "/LEIAME.md")
	studio.update(state, model.Msg.AskRemove(folder + "/LEIAME.md"), db)
	studio.update(state, model.Msg.Remove(folder + "/LEIAME.md"), db)
	assert !hive.file.exists(folder + "/LEIAME.md")
	assert len(state.docs) == 0 && state.removing == ""
	assert len(state.tree) == 2
	// Uma pasta vai com o que tem dentro; o arquivo aberto dela fecha.
	studio.openDoc(state, folder + "/lib/util.hive")
	studio.update(state, model.Msg.AskRemove(folder + "/lib"), db)
	assert indexOf(render.overlay(state), "A pasta e tudo o que ela tem dentro") is Result.Ok(_)
	studio.update(state, model.Msg.Remove(folder + "/lib"), db)
	assert !hive.file.exists(folder + "/lib")
	assert len(state.docs) == 0
	assert len(state.tree) == 1
	// A raiz não se exclui, e Delete no explorador pergunta pelo selecionado.
	studio.update(state, model.Msg.AskRemove(folder), db)
	assert state.removing == ""
	studio.treeKey(state, "<Down>")
	studio.treeKey(state, "<Del>")
	assert state.removing == folder + "/main.hive"
}

test "o botão direito no explorador abre o menu do arquivo, e renomear leva junto o que está aberto" {
	folder := support.explorerFolder("context-test")
	if hive.file.write(folder + "/lib/util.hive", "func um(): Int \{\n\treturn 1\n}\n") is Result.Error(why) {
		panic why
	}
	db := hive.syslink.spawnAddressed(studio.serve, support.fresh(folder))
	mut state := support.fresh(folder)
	studio.update(state, model.Msg.OpenContext(folder + "/main.hive", 40, 60), db)
	assert state.selected == folder + "/main.hive"
	menu := render.contextMenu(state)
	assert indexOf(menu, "left:40px;top:60px") is Result.Ok(_)
	for each label in ["Abrir", "Renomear…", "Excluir", "Copiar caminho relativo", "Mostrar na pasta do sistema", "Abrir no terminal", "Fixar como entrada"] {
		assert indexOf(menu, label) is Result.Ok(_)
	}
	assert studio.escapeKind(state) == "context"
	studio.update(state, model.Msg.CloseContext(), db)
	assert render.contextMenu(state) == ""
	// Uma pasta não tem "Abrir" nem "Fixar como entrada".
	studio.update(state, model.Msg.OpenContext(folder + "/lib", 0, 0), db)
	folderMenu := render.contextMenu(state)
	assert indexOf(folderMenu, ">Abrir<") is Result.Error(_) && indexOf(folderMenu, "Fixar como entrada") is Result.Error(_)
	studio.update(state, model.Msg.ContextPick("copyRelative", folder + "/lib/util.hive"), db)
	assert state.vim.clip == "lib/util.hive" && state.context.path == ""
	// Novo arquivo pelo menu de uma pasta cria dentro dela.
	studio.update(state, model.Msg.ContextPick("newFile", folder + "/lib"), db)
	assert state.prompt == model.Prompt.NewFilePrompt()
	studio.update(state, model.Msg.PromptSubmit("novo.hive"), db)
	assert hive.file.exists(folder + "/lib/novo.hive")
	// Renomear um arquivo aberto troca o caminho e o nome da aba.
	studio.openDoc(state, folder + "/lib/util.hive")
	studio.withText(state, "// não salvo\n")
	studio.update(state, model.Msg.ContextPick("rename", folder + "/lib/util.hive"), db)
	assert state.prompt == model.Prompt.RenamePrompt(folder + "/lib/util.hive") && state.promptText == "util.hive"
	studio.update(state, model.Msg.PromptSubmit("apoio.hive"), db)
	assert hive.file.exists(folder + "/lib/apoio.hive") && !hive.file.exists(folder + "/lib/util.hive")
	assert render.activePath(state) == folder + "/lib/apoio.hive" && studio.activeName(state) == "apoio.hive"
	assert studio.activeText(state) == "// não salvo\n"
	// Renomear a pasta leva junto o arquivo aberto dentro dela.
	studio.update(state, model.Msg.ContextPick("rename", folder + "/lib"), db)
	studio.update(state, model.Msg.PromptSubmit("fonte"), db)
	assert hive.file.exists(folder + "/fonte/apoio.hive")
	assert render.activePath(state) == folder + "/fonte/apoio.hive"
	assert workspace.isExpanded(state.expanded, folder + "/fonte")
	// Um nome que já existe, ou com barra, não renomeia.
	studio.update(state, model.Msg.ContextPick("rename", folder + "/LEIAME.md"), db)
	studio.update(state, model.Msg.PromptSubmit("main.hive"), db)
	assert hive.file.exists(folder + "/LEIAME.md") && indexOf(state.status, "já existe") is Result.Ok(_)
	studio.update(state, model.Msg.ContextPick("rename", folder + "/LEIAME.md"), db)
	studio.update(state, model.Msg.PromptSubmit("a/b.md"), db)
	assert hive.file.exists(folder + "/LEIAME.md")
	// F2 no explorador renomeia o selecionado.
	state.selected = folder + "/main.hive"
	studio.treeKey(state, "<F2>")
	assert state.prompt == model.Prompt.RenamePrompt(folder + "/main.hive")
	assert studio.movedPath("./a/b/c.hive", "./a/b", "./a/x") == "./a/x/c.hive"
	assert studio.movedPath("./a/bc.hive", "./a/b", "./a/x") == "./a/bc.hive"
}

test "um arquivo aberto que muda no disco é relido; um com alteração por salvar, não" {
	folder := support.explorerFolder("disk-test")
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\n\techo 42\n}\n") is Result.Error(why) {
		panic why
	}
	serial := state.textSerial
	studio.refreshFromDisk(state)
	assert studio.activeText(state) == "proc main(): void \{\n\techo 42\n}\n"
	assert state.textSerial == serial + 1
	assert !model.anyDirty(state.docs)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert len(doc.undo) == 1
	}
	mut again := state
	studio.refreshFromDisk(again)
	assert again.textSerial == state.textSerial
	studio.withText(state, "// meu\n")
	if hive.file.write(folder + "/main.hive", "// do agente\n") is Result.Error(why) {
		panic why
	}
	mut kept := state
	studio.refreshFromDisk(kept)
	assert studio.activeText(kept) == "// meu\n"
	assert indexOf(kept.status, "mudou no disco") is Result.Ok(_)
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
}

test "o vigia do disco avisa quando algo muda nas pastas vigiadas, e só nelas" {
	folder := support.explorerFolder("watch-test")
	_quiet := watch.set([folder])
	_drained := watch.wait(100)
	assert len(watch.watched()) == 1
	if hive.file.write(folder + "/novo.txt", "oi") is Result.Error(why) {
		panic why
	}
	assert watch.wait(2000)
	assert !watch.wait(150)
	if hive.file.write(folder + "/lib/fora.txt", "oi") is Result.Error(why) {
		panic why
	}
	assert !watch.wait(300)
	_again := watch.set([folder, folder + "/lib"])
	_gone := hive.file.delete(folder + "/lib/fora.txt")
	assert watch.wait(2000)
	_cleanup := hive.file.delete(folder + "/novo.txt")
	_settled := watch.wait(200)
	_off := watch.set([])
}

test "arquivos criados e apagados por fora aparecem e somem da árvore; um aberto apagado fica riscado" {
	folder := support.explorerFolder("tree-live-test")
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	names := state.tree | map(support.rowName) | join(",")
	assert names == "lib,LEIAME.md,main.hive"
	if hive.file.write(folder + "/agente.hive", "proc main(): void \{}\n") is Result.Error(why) {
		panic why
	}
	studio.refreshFromDisk(state)
	studio.refreshTree(state)
	assert (state.tree | map(support.rowName) | join(",")) == "lib,LEIAME.md,agente.hive,main.hive"
	_removed := hive.file.delete(folder + "/agente.hive")
	studio.refreshTree(state)
	assert (state.tree | map(support.rowName) | join(",")) == "lib,LEIAME.md,main.hive"
	// Uma pasta expandida que some sai da árvore e da lista das expandidas.
	if hive.file.makeDir(folder + "/tmp") is Result.Error(why) {
		panic why
	}
	studio.refreshTree(state)
	studio.toggle(state, folder + "/tmp")
	assert workspace.isExpanded(state.expanded, folder + "/tmp")
	mut Str[dyn] watched = []
	studio.watchedFolders(state, watched)
	assert indexOf(watched, folder + "/tmp") is Result.Ok(_)
	_rmdir := hive.file.delete(folder + "/tmp")
	studio.refreshTree(state)
	assert !workspace.isExpanded(state.expanded, folder + "/tmp")
	// O arquivo aberto é apagado: a aba fica, riscada; volta quando ele volta.
	_gone := hive.file.delete(folder + "/main.hive")
	studio.refreshFromDisk(state)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.gone
	}
	assert indexOf(render.tabStrip(state), "g-del") is Result.Ok(_)
	assert indexOf(state.status, "foi apagado do disco") is Result.Ok(_)
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
	studio.refreshFromDisk(state)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert !doc.gone
	}
	assert indexOf(render.tabStrip(state), "g-del") is Result.Error(_)
}

test "o texto relido do disco vem quieto; abrir um arquivo, não" {
	folder := support.explorerFolder("quiet-test")
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/LEIAME.md")
	studio.openDoc(state, folder + "/main.hive")
	assert !render.frame(state).textQuiet
	// Mudou o que não está à vista: o documento é relido, o editor não muda.
	if hive.file.write(folder + "/LEIAME.md", "# Novo\n") is Result.Error(why) {
		panic why
	}
	serial := state.textSerial
	studio.refreshFromDisk(state)
	assert state.textSerial == serial
	if state.docs bounds 0 {
		assert state.docs[0].text == "# Novo\n"
	}
	// Mudou o que está à vista: o editor recebe o texto, quieto.
	if hive.file.write(folder + "/main.hive", "proc main(): void \{}\n") is Result.Error(why) {
		panic why
	}
	studio.refreshFromDisk(state)
	assert state.textSerial == serial + 1
	frame := render.frame(state)
	assert frame.textQuiet
	assert frame.text == "proc main(): void \{}\n"
	studio.openDoc(state, folder + "/LEIAME.md")
	state.textSerial = state.textSerial + 1
	assert !render.frame(state).textQuiet
	mut Str[dyn] watchedNow = []
	studio.watchedFolders(state, watchedNow)
	assert watchedNow == [folder]
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/LEIAME.md", "\n") is Result.Error(why) {
		panic why
	}
}

test "sem o modo Vim, as teclas do Vim não fazem nada e o frame não mostra a barra" {
	folder := support.scratch()
	mut state := support.fresh(folder)
	studio.openDoc(state, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(studio.serve, state)
	frame := support.vimKeys(db, "dd")
	assert frame.vim == ""
	assert support.regionOf(frame, "vimbar") == ""
	assert frame.text == "proc main(): void \{\n\techo 1\n}\n"
	if studio.toMsg(state, support.event("vim", "", "0 30", "j", -1)) is Result.Ok(message) {
		assert message == model.Msg.VimKey("j", -1, "0 30")
	} else {
		assert false
	}
	if studio.actionMsg(state, "toggleVim", 0) is Result.Ok(message) {
		assert message == model.Msg.ToggleSetting("vim")
	} else {
		assert false
	}
}
