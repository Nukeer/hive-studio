// Testes de lib/toolchain.hive.

import ../lib/toolchain
import ../lib/model
import ../lib/process
import ../lib/settings
import ../lib/search
import ../lib/workspace
import ../lib/complete
import ../lib/analysis
import ../lib/native.go

test "a cópia do Error Lens tem só o programa, e só regrava o que mudou" {
	root := "./lens-test"
	mirror := "./lens-test-copia"
	_made := hive.file.makeDir(root + "/lib")
	_a := hive.file.write(root + "/main.hive", "import ./lib/util\n\nproc main(): void \{\n\techo util.dobro(2)\n}\n")
	_b := hive.file.write(root + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n")
	_c := hive.file.write(root + "/solto.hive", "proc main(): void \{\n}\n")
	toolchain.Overlay[dyn] none = []
	assert toolchain.lensSync(mirror, root, root + "/main.hive", none) == "main.hive"
	assert hive.file.exists(mirror + "/main.hive") && hive.file.exists(mirror + "/lib/util.hive")
	assert !hive.file.exists(mirror + "/solto.hive")
	if hive.file.read(mirror + "/.copiados") is Result.Ok(text) {
		entries := toolchain.parseManifest(text)
		if hive.map.get(entries, "main.hive") is Result.Ok(main) {
			assert main.imports == ["lib/util.hive"]
		} else {
			assert false
		}
	} else {
		assert false
	}
	// A cópia não é regravada se o arquivo não mudou: um texto trocado só na cópia fica.
	_touched := hive.file.write(mirror + "/lib/util.hive", "copia")
	_again := toolchain.lensSync(mirror, root, root + "/main.hive", none)
	if hive.file.read(mirror + "/lib/util.hive") is Result.Ok(kept) {
		assert kept == "copia"
	}
	// O texto não salvo que para de importar o módulo tira o módulo da cópia.
	_edited := toolchain.lensSync(mirror, root, root + "/main.hive", [toolchain.Overlay(root + "/main.hive", "proc main(): void \{\n}\n")])
	assert !hive.file.exists(mirror + "/lib/util.hive")
	if hive.file.read(mirror + "/main.hive") is Result.Ok(copied) {
		assert copied == "proc main(): void \{\n}\n"
	}
	// Voltou a ser o do disco: é copiado de novo.
	_back := toolchain.lensSync(mirror, root, root + "/main.hive", none)
	assert hive.file.exists(mirror + "/lib/util.hive")
	assert toolchain.lensSync(mirror, root, "C:/fora/main.hive", none) == ""
}

test "um caminho relativo à pasta do projeto" {
	assert toolchain.inside("C:/p", "C:/p/lib/a.hive") == "lib/a.hive"
	assert toolchain.inside("C:/p/", "C:/p/a.hive") == "a.hive"
	assert toolchain.inside("C:/p", "C:/outra/a.hive") == ""
}
