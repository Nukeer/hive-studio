func area(width: Int, height: Int): Int {
	return width * height
}

// A function may call itself: recursion.
func factorial(n: Int): Int {
	if n <= 1 {
		return 1
	}
	return n * factorial(n - 1)
}

// A proc may change its caller's variable through a `mut` parameter.
proc addHoney(jars: mut Int, more: Int): void {
	jars = jars + more
}

proc main(): void {
	echo area(3, 4)
	echo area(height: 2, width: 10)
	echo factorial(5)

	mut jars := 1
	addHoney(jars, 2)
	echo "jars: {jars}"
}
