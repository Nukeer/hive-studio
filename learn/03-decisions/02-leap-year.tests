test "2024 é bissexto" {
	assert isLeap(2024) == true
}

test "2023 não é" {
	assert isLeap(2023) == false
}

test "1900 é divisível por 100, então não é" {
	assert isLeap(1900) == false
}

test "2000 é divisível por 400, então é" {
	assert isLeap(2000) == true
}

test "1996 e 2100" {
	assert isLeap(1996) == true
	assert isLeap(2100) == false
}
