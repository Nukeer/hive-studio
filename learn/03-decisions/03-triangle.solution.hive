// "equilátero", "isósceles", "escaleno" ou "impossível".
func triangle(a: Int, b: Int, c: Int): Str {
	if a <= 0 || b <= 0 || c <= 0 {
		return "impossível"
	}
	if a + b <= c || a + c <= b || b + c <= a {
		return "impossível"
	}
	if a == b && b == c {
		return "equilátero"
	} else if a == b || b == c || a == c {
		return "isósceles"
	}
	return "escaleno"
}
