// "equilateral", "isosceles", "scalene" or "impossible".
func triangle(a: Int, b: Int, c: Int): Str {
	if a <= 0 || b <= 0 || c <= 0 {
		return "impossible"
	}
	if a + b <= c || a + c <= b || b + c <= a {
		return "impossible"
	}
	if a == b && b == c {
		return "equilateral"
	} else if a == b || b == c || a == c {
		return "isosceles"
	}
	return "scalene"
}
