// Lenta de propósito, como uma chamada a um servidor.
func slowSquare(n: Int): Int {
	hive.task.sleep(300)
	return n * n
}

proc main(): void {
	// As três ao mesmo tempo: uns 300 ms, não 900.
	squares := await [slowSquare(1), slowSquare(2), slowSquare(3)]
	echo squares

	// Começa duas, lê depois.
	a := async slowSquare(4)
	b := async slowSquare(5)
	echo "4² + 5² = {a + b}"

	// Para de esperar depois de 100 ms.
	result := slowSquare(6) with timeout 100
	if result is Result.Ok(n) {
		echo n
	} else if result is Result.Error(late) {
		echo "desisti depois de {late.waited} ms"
	}
}
