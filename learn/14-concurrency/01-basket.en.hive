// Slow on purpose: every call takes 300 ms.
func price(item: Str): Int {
	hive.task.sleep(300)
	if item == "honey" {
		return 12
	} else if item == "wax" {
		return 5
	} else if item == "pollen" {
		return 3
	}
	return 0
}

// The three prices added up — in well under 900 ms.
func basketTotal(a: Str, b: Str, c: Str): Int {
	return price(a) + price(b) + price(c)
}
