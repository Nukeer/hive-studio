test "primos pequenos" {
	assert isPrime(2) == true
	assert isPrime(3) == true
	assert isPrime(5) == true
}

test "9 é 3 vezes 3" {
	assert isPrime(9) == false
}

test "97 é primo" {
	assert isPrime(97) == true
}

test "1, 0 e os negativos não são primos" {
	assert isPrime(1) == false
	assert isPrime(0) == false
	assert isPrime(-7) == false
}

test "um primo grande e um quadrado grande" {
	assert isPrime(7919) == true
	assert isPrime(7921) == false
}
