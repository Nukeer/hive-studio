proc main(): void {
	// Start; keep going while; step.
	for i := 1; i <= 3; i++ {
		echo "bee number {i}"
	}

	// Only a condition: a while loop.
	mut n := 27
	mut steps := 0
	for ; n != 1; {
		if n % 2 == 0 {
			n = n / 2
		} else {
			n = 3 * n + 1
		}
		steps++
	}
	echo "27 reaches 1 in {steps} steps"

	// `continue` skips a turn, `break` leaves the loop.
	mut total := 0
	for i := 1; i <= 100; i++ {
		if i % 2 == 0 {
			continue
		}
		if total > 50 {
			break
		}
		total += i
	}
	echo "odd numbers added up to {total}"

	// `for each` walks a list of values.
	for each flower in ["clover", "lavender", "thyme"] {
		echo "visiting the {flower}"
	}
}
