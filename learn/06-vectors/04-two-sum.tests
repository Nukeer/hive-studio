test "2 + 7 é 9" {
	Int[dyn] expected = [0, 1]
	assert twoSum([2, 7, 11, 15], 9) == expected
}

test "2 + 4 é 6" {
	Int[dyn] expected = [1, 2]
	assert twoSum([3, 2, 4], 6) == expected
}

test "o mesmo número duas vezes" {
	Int[dyn] expected = [0, 1]
	assert twoSum([3, 3], 6) == expected
}

test "um número não faz par consigo mesmo" {
	assert len(twoSum([3, 5], 6)) == 0
}

test "nenhum par soma" {
	assert len(twoSum([1, 2], 7)) == 0
}

test "números negativos" {
	Int[dyn] expected = [2, 4]
	assert twoSum([1, 2, -3, 4, 5], 2) == expected
}
