test "1 + 2 + 3" {
	assert sum([1, 2, 3]) == 6
}

test "an empty vector" {
	Int[dyn] none = []
	assert sum(none) == 0
}

test "they can cancel out" {
	assert sum([-5, 5]) == 0
}

test "a vector built by a loop" {
	mut Int[dyn] many = []
	for i := 1; i <= 100; i++ {
		append(many, i)
	}
	assert sum(many) == 5050
}
