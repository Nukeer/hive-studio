// true when the letters of `a`, rearranged, make `b`.
func isAnagram(a: Str, b: Str): Bool {
	mut hive.map.Map<Str, Int> counts = hive.map.new()
	for each c in split(a, "") {
		mut n := 0
		if hive.map.get(counts, c) is Result.Ok(seen) {
			n = seen
		}
		hive.map.set(counts, c, n + 1)
	}
	for each c in split(b, "") {
		mut n := 0
		if hive.map.get(counts, c) is Result.Ok(seen) {
			n = seen
		}
		hive.map.set(counts, c, n - 1)
	}
	for each c in hive.map.keys(counts) {
		if hive.map.get(counts, c) is Result.Ok(n) && n != 0 {
			return false
		}
	}
	return true
}
