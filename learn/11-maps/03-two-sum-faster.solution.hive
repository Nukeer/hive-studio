// As posições [i, j] (i < j) de dois números que somam `target`; [] se não houver.
// Desta vez numa passada só, com um mapa.
func twoSum(numbers: Int[], target: Int): Int[dyn] {
	mut hive.map.Map<Int, Int> seen = hive.map.new()
	for j := 0; j < len(numbers); j++ {
		if hive.map.get(seen, target - numbers[j]) is Result.Ok(i) {
			return [i, j]
		}
		hive.map.set(seen, numbers[j], j)
	}
	Int[dyn] none = []
	return none
}
