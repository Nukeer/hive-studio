type Player {
	name:  Str
	score: Int
}

func higher(a: Player, b: Player): Bool {
	return a.score > b.score
}

func nameOf(player: Player): Str {
	return player.name
}

// Os nomes, maior pontuação primeiro; um empate mantém a ordem.
func ranking(players: Player[]): Str[dyn] {
	return players | sort(higher) | map(nameOf)
}
