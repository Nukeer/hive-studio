func isEven(n: Int): Bool {
	return n % 2 == 0
}

func square(n: Int): Int {
	return n * n
}

func times(n: Int, factor: Int): Int {
	return n * factor
}

func shorter(a: Str, b: Str): Bool {
	return len(a) < len(b)
}

proc main(): void {
	numbers := [1, 2, 3, 4, 5, 6]
	echo map(numbers, square)
	echo filter(numbers, isEven)

	// `_` leaves a hole: this is a function of one Int.
	echo map(numbers, times(_, 10))

	// A function is a value, with a type.
	func(Int): Int f = square
	echo f(9)

	// `|` passes the value on its left as the first argument.
	echo numbers | filter(isEven) | map(square)

	echo sort(["bumblebee", "bee", "wasp"], shorter)
}
