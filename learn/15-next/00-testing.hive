func celsius(fahrenheit: Float): Float {
	return (fahrenheit - 32.0) * 5.0 / 9.0
}

func isEven(n: Int): Bool {
	return n % 2 == 0
}

test "a água congela a 0 °C" {
	assert celsius(32.0) == 0.0
}

test "a água ferve a 100 °C" {
	assert celsius(212.0) == 100.0
}

test "números pares" {
	assert isEven(4)
	assert isEven(0)
}

// Este está errado de propósito: rode os testes, depois conserte.
test "números ímpares" {
	assert isEven(7) == true
}
