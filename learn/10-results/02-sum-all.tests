test "1 + 2 + 3" {
	Result<Int, Str> expected = Result.Ok(6)
	assert sumAll(["1", "2", "3"]) == expected
}

test "um deles não é número" {
	Result<Int, Str> expected = Result.Error("não é um número: dois")
	assert sumAll(["1", "dois", "3"]) == expected
}

test "o erro diz o primeiro que não é" {
	Result<Int, Str> expected = Result.Error("não é um número: x")
	assert sumAll(["x", "y"]) == expected
}

test "nada soma zero" {
	Str[dyn] none = []
	Result<Int, Str> expected = Result.Ok(0)
	assert sumAll(none) == expected
}

test "números negativos" {
	Result<Int, Str> expected = Result.Ok(-4)
	assert sumAll(["-10", "6"]) == expected
}
