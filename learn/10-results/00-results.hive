// Uma função que pode falhar diz isso no tipo.
func divide(a: Int, b: Int): Result<Int, Str> {
	if b == 0 {
		return Result.Error("não dá para dividir {a} por zero")
	}
	return Result.Ok(a / b)
}

proc main(): void {
	if divide(10, 2) is Result.Ok(n) {
		echo "10 / 2 = {n}"
	}

	// Ok e Error juntos cobrem todos os casos.
	result := divide(1, 0)
	if result is Result.Ok(n) {
		echo n
	} else if result is Result.Error(why) {
		echo "falhou: {why}"
	}

	// A biblioteca avisa das falhas do mesmo jeito.
	for each text in ["42", "quarenta e dois"] {
		parsed := hive.conv.sti(text)
		if parsed is Result.Ok(number) {
			echo "{text} mais um é {number + 1}"
		} else if parsed is Result.Error(problem) {
			echo "{text}: {problem.message}"
		}
	}
}
