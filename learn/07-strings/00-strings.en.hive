proc main(): void {
	word := "honey"
	echo len(word)
	echo len("café")

	// An index into a Str is always guarded.
	if word bounds 0 {
		echo word[0]
	}
	if word bounds 3 {
		echo word[1:3]
	}

	// Cut text into pieces, and glue them back.
	parts := split("bee,wasp,ant", ",")
	echo parts
	echo join(parts, " & ")
	echo len(split(word, ""))

	// `indexOf` answers with a Result: found, or not.
	if indexOf(word, "ney") is Result.Ok(at) {
		echo "found at {at}"
	}
	echo replaceAll("buzz buzz", "u", "i")

	// A pattern takes a string apart.
	line := "queen=Beatrix"
	if line is "{key}={value}" {
		echo "{key} is {value}"
	}
}
