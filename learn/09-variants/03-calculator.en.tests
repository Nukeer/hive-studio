test "a number is itself" {
	assert eval(Expr.Num(7)) == 7
}

test "2 + 3" {
	assert eval(Expr.Add(Expr.Num(2), Expr.Num(3))) == 5
}

test "(2 + 3) × -4" {
	assert eval(Expr.Mul(Expr.Add(Expr.Num(2), Expr.Num(3)), Expr.Neg(Expr.Num(4)))) == -20
}

test "a deep tree" {
	mut Expr e = Expr.Num(1)
	for i := 0; i < 10; i++ {
		e = Expr.Add(e, Expr.Num(1))
	}
	assert eval(e) == 11
}

test "negating twice" {
	assert eval(Expr.Neg(Expr.Neg(Expr.Num(5)))) == 5
}
