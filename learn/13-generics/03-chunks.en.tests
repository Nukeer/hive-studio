test "pieces of two" {
	Int[dyn][dyn] expected = [[1, 2], [3, 4], [5]]
	assert chunks([1, 2, 3, 4, 5], 2) == expected
}

test "one piece" {
	Str[dyn][dyn] expected = [["a", "b", "c"]]
	assert chunks(["a", "b", "c"], 3) == expected
}

test "pieces of one" {
	Str[dyn][dyn] expected = [["x"], ["y"]]
	assert chunks(["x", "y"], 1) == expected
}

test "nothing to cut" {
	Int[dyn] none = []
	assert len(chunks(none, 4)) == 0
}

test "exactly full pieces" {
	Int[dyn][dyn] expected = [[1, 2, 3], [4, 5, 6]]
	assert chunks([1, 2, 3, 4, 5, 6], 3) == expected
}
