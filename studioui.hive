// Hive Studio desenhado só com os widgets do hive.ui: sem a página própria
// (assets/shell.html), sem o servidor dela e sem JavaScript da IDE.
//
//     hivec run studioui.hive [pasta]
//
// A lógica é a do studio.hive, importado inteiro: o mesmo estado
// (`model.State`), a mesma dobra (`studio.step`) e a mesma tradução dos
// eventos (`studio.toMsg`). Muda quem desenha — lib/uiview.hive — e quem manda
// os eventos: os widgets do hive.ui mandam os mesmos que a página mandaria.
//
// O que o hive.ui não faz — teclado, cursor, área de transferência, a fonte
// do código — vem de lib/bridge.go, um script posto na página da janela.
//
// A mensagem da janela é o `model.Cmd` do serviço do Hive Studio, então o
// trabalho que roda em outra thread (git, hivec, o terminal, o vigia do disco,
// o Error Lens) manda o resultado de volta à janela exatamente como mandava
// ao serviço.

import hive.ui
import ./studio
import ./lib/model
import ./lib/uiview
import ./lib/settings
import ./lib/server
import ./lib/complete
import ./lib/navigate
import ./lib/bridge.go

// O estado da janela: o do Hive Studio e o que só esta janela lembra.
// `started` diz se os vigias (git, disco) já foram postos para rodar — isso
// espera a primeira mensagem, que é quando a janela passa a ter endereço.
type Win {
	core:    model.State
	extra:   uiview.Chrome
	started: Bool
}

func view(win: Win): hive.ui.View {
	return uiview.window(win.core, win.extra)
}

// Onde o cursor ficou depois de uma edição que só mandou o texto novo: no
// fim do trecho que mudou (o que vem antes e depois dele é igual nos dois).
func caretAfter(before: Str, after: Str): Int {
	a := split(before, "")
	b := split(after, "")
	mut same := 0
	for ; same < len(a) && same < len(b); same++ {
		if a bounds same && b bounds same {
			if a[same] != b[same] {
				break
			}
		}
	}
	mut tail := 0
	for ; tail < len(a) - same && tail < len(b) - same; tail++ {
		i := len(a) - 1 - tail
		j := len(b) - 1 - tail
		if a bounds i && b bounds j {
			if a[i] != b[j] {
				break
			}
		}
	}
	return len(b) - tail
}

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

// O `/pty` dos terminais dos agentes (o mesmo da página própria), só para
// quem traz o token.
proc ptyGate(token: Str, conn: hive.net.WsConnection): void {
	url := hive.net.wsRequest(conn).url
	if server.hasToken(url, token) {
		if url is "/pty?session={number}&{rest}" {
			if hive.conv.sti(number) is Result.Ok(session) {
				server.ptyClient(conn, session)
			}
		}
	}
	hive.net.wsClose(conn)
}

// O que só esta janela trata: os menus e a rolagem da vista realçada.
proc chromeEvent(win: mut Win, what: Str, arg: Str, self: hive.syslink.Address): void {
	if what == "menu" {
		win.extra.menu = arg
	} else if what == "top" {
		win.extra.top = numberOr(arg, 0)
	} else if what == "hover" {
		// Ctrl+passar o mouse: há para onde ir do nome nesta posição?
		caret := numberOr(arg, -1)
		mut ok := false
		if caret >= 0 && win.core.docs bounds win.core.active {
			doc := win.core.docs[win.core.active]
			ok = navigate.locate(doc.path, doc.text, caret) is Result.Ok(_)
		}
		win.extra.hoverCaret = caret
		win.extra.hoverOk = ok
	} else if what == "client" {
		win.extra.menu = ""
		win.extra.client = arg
		win.extra.clientSerial = win.extra.clientSerial + 1
	} else if what == "text" {
		// A página não tem o texto do editor (recarregou): vai de novo.
		win.extra.textSerial = -1
	} else if what == "paneFull" {
		// A página não tem o preview ou o commit à vista: vai de novo.
		win.extra.paneKey = "-"
	} else if what == "hlFull" {
		// A página perdeu o fio do realce: no fim deste turno ele vai inteiro.
		win.extra.hlVersion = -1
	}
	// "hello": a ponte avisa que a página abriu; os vigias começam no turno
	// dela (ver `update`), e não há mais nada a fazer.
}

// Um evento dos widgets, traduzido como o Hive Studio traduz os da página.
proc handle(win: mut Win, event: model.Event, self: hive.syslink.Address): void {
	if event.kind == "chrome" {
		chromeEvent(win, event.act, event.arg, self)
		return
	}
	// Qualquer outro clique fecha o menu aberto.
	win.extra.menu = ""
	// O cursor andou no editor (a ponte avisa).
	if event.kind == "caret" {
		studio.step(win.core, model.Msg.CaretAt(event.caret), self)
		return
	}
	mut sent := event
	if sent.kind == "edit" && sent.caret < 0 {
		sent.caret = caretAfter(studio.activeText(win.core), sent.text)
	}
	// Uma ação de menu vale onde o cursor está (ir para a definição, sugestões).
	if sent.kind == "act" && sent.act == "action" {
		sent.caret = win.core.caret
	}
	if studio.toMsg(win.core, sent) is Result.Ok(message) {
		studio.step(win.core, message, self)
	}
}

// Depois de cada turno: o commit da aba de commit (lido do git uma vez, quando
// a aba muda) e a vista realçada, que volta a seguir o cursor quando ele, o
// documento ou a busca mudam.
proc follow(win: mut Win): void {
	// O preview e a aba de commit vão à página uma vez, quando mudam.
	pane := uiview.paneOf(win.core)
	if pane.key != win.extra.paneKey {
		win.extra.paneKey = pane.key
		win.extra.pane = encode(pane, hive.json.codec())
	} else {
		win.extra.pane = encode(uiview.Pane(pane.key, "", false), hive.json.codec())
	}
	mut path := ""
	index := win.core.active
	if win.core.docs bounds index {
		path = win.core.docs[index].path
	}
	// O texto do editor vai à página só quando o programa o trocou (outro
	// arquivo, o Vim, o disco): a digitação ela já tem.
	win.extra.showText = win.core.textSerial != win.extra.textSerial
	win.extra.textSerial = win.core.textSerial
	// O realce que a página ainda não tem vai uma vez só; no turno seguinte,
	// sem mudança, o campo volta a dizer `keep`.
	hl := uiview.hlUpdate(win.core, win.extra.hlPath, win.extra.hlVersion)
	win.extra.hl = encode(hl, hive.json.codec())
	win.extra.hlPath = path
	win.extra.hlVersion = hl.version
	if win.core.caret != win.extra.caret || path != win.extra.path || win.core.find.serial != win.extra.findSerial {
		win.extra.top = 0
		win.extra.caret = win.core.caret
		win.extra.path = path
		win.extra.findSerial = win.core.find.serial
	}
}

proc update(win: mut Win, command: model.Cmd, self: hive.syslink.Address): model.Cmd {
	if !win.started {
		win.started = true
		async studio.watchGit(self)
		async studio.watchDocs(self)
	}
	if command is model.Cmd.Ui(text) {
		if model.Event.decode(text, hive.json.codec()) is Result.Ok(event) {
			handle(win, event, self)
		}
	} else {
		_answer := studio.serve(win.core, command, self)
	}
	follow(win)
	return command
}

proc initial(folder: Str): Win {
	prefs := settings.load()
	mut start := model.initial(folder, prefs)
	studio.openRoot(start, folder)
	studio.watchFolders(start)
	return Win(start, uiview.emptyChrome(), false)
}

// O servidor dos terminais dos agentes: o xterm.js (`server.page` serve os
// arquivos dele) e o `/pty`, na porta seguinte. Só para quem tem o token.
proc servePty(win: mut Win): void {
	token := hive.crypto.randomHex(16)
	port := server.freePort()
	async hive.net.httpServe(port, server.page(token, port + 1, _))
	async hive.net.wsServe(port + 1, ptyGate(token, _))
	win.extra.ptyPort = port
	win.extra.ptyToken = token
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	if !bridge.installed() {
		echo "Hive Studio: a ponte do hive.ui (lib/bridge.go) não entrou na página; sem teclado nem cursor."
	}
	mut start := initial(folder)
	servePty(start)
	// O navegador das Configurações, quando há um: a ponte abre a janela nele.
	_chosen := bridge.useBrowser(start.core.settings.browser)
	ui.windowAddressed("Hive Studio", view, update, start)
}
