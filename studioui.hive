// Hive Studio desenhado só com os widgets do hive.ui: sem a página própria
// (assets/shell.html), sem o servidor dela e sem JavaScript da IDE.
//
//     hivec run studioui.hive [pasta]
//
// A lógica é a do studio.hive, importado inteiro: o mesmo estado
// (`model.State`), a mesma dobra (`studio.step`) e a mesma tradução dos
// eventos (`studio.toMsg`). Muda quem desenha — lib/uiview.hive — e quem manda
// os eventos: os widgets do hive.ui mandam os mesmos que a página mandaria.
//
// O que o hive.ui não faz — teclado, cursor, área de transferência, a fonte
// do código — vem de lib/bridge.go, um script posto na página da janela.
//
// A mensagem da janela é o `model.Cmd` do serviço do Hive Studio, então o
// trabalho que roda em outra thread (git, hivec, o terminal, o vigia do disco,
// o Error Lens) manda o resultado de volta à janela exatamente como mandava
// ao serviço.

import hive.ui
import ./studio
import ./lib/model
import ./lib/uiview
import ./lib/settings
import ./lib/agents
import ./lib/git
import ./lib/process
import ./lib/server
import ./lib/complete
import ./lib/bridge.go

// O estado da janela: o do Hive Studio e o que só esta janela lembra.
// `started` diz se os vigias (git, disco) já foram postos para rodar — isso
// espera a primeira mensagem, que é quando a janela passa a ter endereço.
type Win {
	core:    model.State
	extra:   uiview.Chrome
	started: Bool
}

func view(win: Win): hive.ui.View {
	return uiview.window(win.core, win.extra)
}

// Onde o cursor ficou depois de uma edição que só mandou o texto novo: no
// fim do trecho que mudou (o que vem antes e depois dele é igual nos dois).
func caretAfter(before: Str, after: Str): Int {
	a := split(before, "")
	b := split(after, "")
	mut same := 0
	for ; same < len(a) && same < len(b); same++ {
		if a bounds same && b bounds same {
			if a[same] != b[same] {
				break
			}
		}
	}
	mut tail := 0
	for ; tail < len(a) - same && tail < len(b) - same; tail++ {
		i := len(a) - 1 - tail
		j := len(b) - 1 - tail
		if a bounds i && b bounds j {
			if a[i] != b[j] {
				break
			}
		}
	}
	return len(b) - tail
}

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

// Um agente numa janela de terminal do sistema, na pasta do projeto: o
// hive.ui não tem um emulador de terminal onde desenhar a tela dele.
proc launchExternal(root: Str, command: Str, title: Str): Str {
	if server.isWindows() {
		result := process.run("cmd", ["/c", "start", title, "cmd", "/k", command], root)
		if result.code != 0 {
			return process.firstLine(result.text)
		}
		return ""
	}
	if hive.file.exists("/usr/bin/osascript") {
		script := "tell application \"Terminal\" to do script \"cd " + replaceAll(root, "\"", "\\\"") + " && " + replaceAll(command, "\"", "\\\"") + "\""
		result := process.run("osascript", ["-e", script, "-e", "tell application \"Terminal\" to activate"], root)
		if result.code != 0 {
			return process.firstLine(result.text)
		}
		return ""
	}
	result := process.run("x-terminal-emulator", ["-e", "sh", "-c", command + "; exec $SHELL"], root)
	if result.code == -1 {
		return "x-terminal-emulator: " + result.text
	}
	return ""
}

proc openAgent(win: mut Win, agent: Str): void {
	command := agents.commandOf(win.core.settings, agent)
	problem := launchExternal(win.core.root, command, "Hive Studio — " + agents.labelOf(agent))
	win.core.agents.current = agent
	if problem != "" {
		win.core.status = agents.labelOf(agent) + ": " + problem
	} else {
		win.core.status = agents.labelOf(agent) + " — " + command
	}
}

// O que só esta janela trata: menus, a rolagem da vista realçada e os agentes.
proc chromeEvent(win: mut Win, what: Str, arg: Str, self: hive.syslink.Address): void {
	if what == "menu" {
		win.extra.menu = arg
	} else if what == "top" {
		win.extra.top = numberOr(arg, 0)
	} else if what == "agent" {
		openAgent(win, arg)
	} else if what == "agentPane" {
		win.core.pane = model.Pane.AgentPane()
		win.core.panelOpen = true
	}
}

// Um evento dos widgets, traduzido como o Hive Studio traduz os da página.
proc handle(win: mut Win, event: model.Event, self: hive.syslink.Address): void {
	if event.kind == "chrome" {
		chromeEvent(win, event.act, event.arg, self)
		return
	}
	// Qualquer outro clique fecha o menu aberto.
	win.extra.menu = ""
	// O cursor andou no editor (a ponte avisa).
	if event.kind == "caret" {
		studio.step(win.core, model.Msg.CaretAt(event.caret), self)
		return
	}
	mut sent := event
	if sent.kind == "edit" && sent.caret < 0 {
		sent.caret = caretAfter(studio.activeText(win.core), sent.text)
	}
	// Uma ação de menu vale onde o cursor está (ir para a definição, sugestões).
	if sent.kind == "act" && sent.act == "action" {
		sent.caret = win.core.caret
	}
	translated := studio.toMsg(win.core, sent)
	if translated is Result.Ok(message) {
		// Um agente pedido pelo menu ou pelo teclado abre num terminal do
		// sistema; o painel AGENTE mostra os botões de cada um.
		if message is model.Msg.ShowAgent(agent) {
			mut chosen := agent
			if !agents.isAgent(chosen) {
				chosen = win.core.agents.current
			}
			openAgent(win, chosen)
		} else if message is model.Msg.AgentRestart(agent) {
			openAgent(win, agent)
		} else {
			studio.step(win.core, message, self)
		}
	}
}

// Depois de cada turno: o commit da aba de commit (lido do git uma vez, quando
// a aba muda) e a vista realçada, que volta a seguir o cursor quando ele, o
// documento ou a busca mudam.
proc follow(win: mut Win): void {
	key := win.core.commit.key
	if key != win.extra.shown {
		win.extra.shown = key
		if key == "" {
			win.extra.commit = uiview.emptyCommit()
		} else if key is "work:{path}" {
			win.extra.commit = git.working(win.core.git, path)
		} else if git.show(win.core.git, key) is Result.Ok(commit) {
			win.extra.commit = commit
		}
	}
	mut path := ""
	index := win.core.active
	if win.core.docs bounds index {
		path = win.core.docs[index].path
	}
	if win.core.caret != win.extra.caret || path != win.extra.path || win.core.find.serial != win.extra.findSerial {
		win.extra.top = 0
		win.extra.caret = win.core.caret
		win.extra.path = path
		win.extra.findSerial = win.core.find.serial
	}
}

proc update(win: mut Win, command: model.Cmd, self: hive.syslink.Address): model.Cmd {
	if !win.started {
		win.started = true
		async studio.watchGit(self)
		async studio.watchDocs(self)
	}
	if command is model.Cmd.Ui(text) {
		if model.Event.decode(text, hive.json.codec()) is Result.Ok(event) {
			handle(win, event, self)
		}
	} else {
		_answer := studio.serve(win.core, command, self)
	}
	follow(win)
	return command
}

proc initial(folder: Str): Win {
	prefs := settings.load()
	mut start := model.initial(folder, prefs)
	studio.openRoot(start, folder)
	studio.watchFolders(start)
	return Win(start, uiview.emptyChrome(), false)
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	if !bridge.installed() {
		echo "Hive Studio: a ponte do hive.ui (lib/bridge.go) não entrou na página; sem teclado nem cursor."
	}
	ui.windowAddressed("Hive Studio", view, update, initial(folder))
}
