// Hive Studio desenhado só com os widgets do hive.ui: sem a página própria
// (assets/shell.html), sem o servidor dela e sem JavaScript da IDE.
//
//     hivec run studioui.hive [pasta]
//
// A lógica é a do studio.hive, importado inteiro: o mesmo estado
// (`model.State`), a mesma dobra (`studio.step`) e a mesma tradução dos
// eventos (`studio.toMsg`). Muda quem desenha — lib/uiview.hive — e quem manda
// os eventos: os widgets do hive.ui mandam os mesmos que a página mandaria.
//
// A janela é a nativa do hive.ui: o editor é um `ui.code`, os atalhos são
// `ui.keys`, e o menu do botão direito abre onde o mouse estava.
//
// A mensagem da janela é o `model.Cmd` do serviço do Hive Studio, então o
// trabalho que roda em outra thread (git, hivec, o terminal, o vigia do disco,
// o Error Lens) manda o resultado de volta à janela exatamente como mandava
// ao serviço.

import hive.ui
import ./studio
import ./lib/model
import ./lib/uiview
import ./lib/settings
import ./lib/server
import ./lib/render
import ./lib/vim
import ./lib/git
import ./lib/pty.go
import ./lib/native.go
import ./lib/navigate

// O estado da janela: o do Hive Studio e o que só esta janela lembra.
// `started` diz se os vigias (git, disco) já foram postos para rodar — isso
// espera a primeira mensagem, que é quando a janela passa a ter endereço.
type Win {
	core:    model.State
	extra:   uiview.Chrome
	started: Bool
}

func view(win: Win): hive.ui.View {
	return uiview.window(win.core, win.extra)
}

// Onde o cursor ficou depois de uma edição que só mandou o texto novo: no
// fim do trecho que mudou (o que vem antes e depois dele é igual nos dois).
func caretAfter(before: Str, after: Str): Int {
	a := split(before, "")
	b := split(after, "")
	mut same := 0
	for ; same < len(a) && same < len(b); same++ {
		if a bounds same && b bounds same {
			if a[same] != b[same] {
				break
			}
		}
	}
	mut tail := 0
	for ; tail < len(a) - same && tail < len(b) - same; tail++ {
		i := len(a) - 1 - tail
		j := len(b) - 1 - tail
		if a bounds i && b bounds j {
			if a[i] != b[j] {
				break
			}
		}
	}
	return len(b) - tail
}

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

// O que só esta janela trata: os menus e a rolagem da vista realçada.
proc chromeEvent(win: mut Win, what: Str, arg: Str, self: Address): void {
	if what == "menu" {
		win.extra.menu = arg
	} else if what == "top" {
		win.extra.top = numberOr(arg, 0)
	} else if what == "client" {
		// Um comando do menu Editar: o editor o faz (ver `ui.perform`).
		win.extra.menu = ""
		win.extra.client = arg
		win.extra.clientSerial = win.extra.clientSerial + 1
	} else if what == "probe" {
		// Ctrl+mouse: sublinha o nome sob o mouse quando ele tem para onde ir.
		at := numberOr(arg, -1)
		win.extra.probeFrom = -1
		win.extra.probeTo = -1
		if at >= 0 && win.core.docs bounds win.core.active {
			doc := win.core.docs[win.core.active]
			span := native.wordAt(doc.text, at)
			if span bounds 1 && navigate.locate(doc.path, doc.text, at) is Result.Ok(_) {
				win.extra.probeFrom = span[0]
				win.extra.probeTo = span[1]
			}
		}
	} else if what == "gitFold" {
		if arg == "staged" {
			win.extra.hideStaged = !win.extra.hideStaged
		} else if arg == "changes" {
			win.extra.hideChanges = !win.extra.hideChanges
		} else if arg == "log" {
			win.extra.hideLog = !win.extra.hideLog
		}
	} else if what == "cutLine" {
		cutLine(win, self)
	} else if what == "pty" {
		// Uma tecla no terminal de um agente: os bytes dela vão ao programa.
		if arg is "{session}|{combo}" {
			_typed := pty.write(numberOr(session, 0), pty.keys(combo))
		}
	} else if what == "ptyPaste" {
		if arg is "{session}|{text}" {
			_pasted := pty.write(numberOr(session, 0), text)
		}
	} else if what == "ptyFit" {
		// O terminal tem o tamanho da caixa onde ele aparece.
		if arg is "{session}|{cols},{rows}" {
			_sized := pty.resize(numberOr(session, 0), numberOr(cols, 80), numberOr(rows, 24))
		}
	} else if what == "view" {
		// As linhas do editor à vista: o realce vai só perto delas.
		if arg is "{first},{last}" {
			win.extra.first = numberOr(first, 0)
			win.extra.last = numberOr(last, 60)
		}
	} else if what == "drag" {
		// O puxador do painel: a altura acompanha o mouse, e fica ao soltar.
		if arg is "{dy},{done}" {
			if win.extra.dragBase < 0 {
				win.extra.dragBase = win.core.settings.panelHeight
			}
			height := win.extra.dragBase - numberOr(dy, 0)
			mut clamped := height
			if clamped < 90 {
				clamped = 90
			}
			win.extra.dragHeight = clamped
			if done == "1" {
				win.extra.dragBase = -1
				studio.step(win.core, model.Msg.SetPanelHeight(clamped), self)
			}
		}
	}
	// "screen": um terminal de agente mudou; o turno só redesenha.
}

// Um evento dos widgets, traduzido como o Hive Studio traduz os da página.
proc handle(win: mut Win, event: model.Event, self: Address): void {
	if event.kind == "chrome" {
		chromeEvent(win, event.act, event.arg, self)
		return
	}
	// Qualquer outro clique fecha o menu aberto.
	win.extra.menu = ""
	// O cursor andou no editor: a cabeça vai ao Hive Studio, a âncora fica aqui.
	if event.kind == "caret" {
		win.extra.anchor = numberOr(event.arg, event.caret)
		studio.step(win.core, model.Msg.CaretAt(event.caret), self)
		return
	}
	mut sent := event
	if sent.kind == "edit" && sent.caret < 0 {
		sent.caret = caretAfter(studio.activeText(win.core), sent.text)
	}
	// Uma ação de menu vale onde o cursor está (ir para a definição, sugestões).
	if sent.kind == "act" && sent.act == "action" {
		sent.caret = win.core.caret
	}
	if studio.toMsg(win.core, sent) is Result.Ok(message) {
		studio.step(win.core, message, self)
	}
}

// Depois de cada turno: o commit da aba de commit (lido do git uma vez, quando
// a aba muda) e a vista realçada, que volta a seguir o cursor quando ele, o
// documento ou a busca mudam.
proc follow(win: mut Win): void {
	// A aba de commit: o commit é lido do git uma vez, quando ela muda.
	if win.core.commit.key != win.extra.commit.hash && win.core.commit.key != "work:" + win.extra.commit.body {
		key := win.core.commit.key
		if key is "work:{path}" {
			win.extra.commit = git.working(win.core.git, path)
		} else if key != "" {
			if git.show(win.core.git, key) is Result.Ok(commit) {
				win.extra.commit = commit
			}
		}
	}
	mut path := ""
	index := win.core.active
	if win.core.docs bounds index {
		path = win.core.docs[index].path
	}
	place(win)
	if win.core.caret != win.extra.caret || path != win.extra.path || win.core.find.serial != win.extra.findSerial {
		win.extra.top = 0
		win.extra.caret = win.core.caret
		win.extra.path = path
		win.extra.findSerial = win.core.find.serial
	}
}

// Onde o editor põe o cursor, quando o programa o move: o texto trocou (outro
// arquivo, uma ida à definição), o Vim andou, ou a busca achou outra ocorrência.
// Um texto relido do disco não mexe nele.
proc place(win: mut Win): void {
	core := win.core
	extra := win.extra
	mut anchor := core.caret
	mut head := core.caret
	mut moved := false
	quiet := core.textSerial == core.quietSerial
	if core.textSerial != extra.seenText {
		win.extra.seenText = core.textSerial
		moved = !quiet
	}
	if core.vim.serial != extra.seenVim {
		win.extra.seenVim = core.vim.serial
		moved = core.settings.vim
	}
	if core.settings.vim && moved {
		span := vim.shown(render.searched(core), core.caret, core.vim)
		anchor = span.from
		head = span.to
	}
	findSerial := core.find.serial + core.vim.searchSerial
	if findSerial != extra.seenFind {
		win.extra.seenFind = findSerial
		if core.find.open {
			matches := render.findMatches(render.searched(core), core.find)
			if matches bounds core.find.index {
				anchor = matches[core.find.index]
				head = anchor + len(core.find.text)
				moved = true
			}
		}
	}
	if moved {
		win.extra.selA = anchor
		win.extra.selH = head
		win.extra.selSerial = extra.selSerial + 1
		win.extra.anchor = anchor
	}
}

// Ctrl+X sem seleção: a linha do cursor sai do texto, com a quebra, e vai para
// a área de transferência.
proc cutLine(win: mut Win, self: Address): void {
	if win.extra.anchor != win.core.caret {
		return
	}
	text := studio.activeText(win.core)
	mut start := 0
	mut line := ""
	for each piece in split(text, "\n") {
		end := start + len(piece)
		if win.core.caret >= start && win.core.caret <= end {
			line = piece
			break
		}
		start = end + 1
	}
	mut cut := len(line)
	if start + cut < len(text) {
		cut = cut + 1
	}
	win.core.vim.clip = line + "\n"
	win.core.vim.clipSerial = win.core.vim.clipSerial + 1
	studio.step(win.core, model.Msg.EditAt(native.splice(text, start, cut, ""), start), self)
	win.extra.selA = start
	win.extra.selH = start
	win.extra.selSerial = win.extra.selSerial + 1
	win.extra.anchor = start
}

// Os terminais dos agentes: quando algum recebe saída, a janela redesenha (no
// máximo uma vez a cada 30 ms).
proc watchScreens(self: Address): void {
	mut seen := -1
	for ;; {
		now := pty.pulse()
		if now != seen {
			seen = now
			async self(uiview.chrome("screen", ""))
		}
		server.pause(30)
	}
}

proc update(win: mut Win, command: model.Cmd, self: Address): model.Cmd {
	if !win.started {
		win.started = true
		async studio.watchGit(self)
		async studio.watchDocs(self)
		async watchScreens(self)
	}
	if command is model.Cmd.Ui(text) {
		if model.Event.decode(text, hive.json.codec()) is Result.Ok(event) {
			handle(win, event, self)
		}
	} else {
		_answer := studio.serve(win.core, command, self)
	}
	follow(win)
	return command
}

proc initial(folder: Str): Win {
	prefs := settings.load()
	mut start := model.initial(folder, prefs)
	studio.openRoot(start, folder)
	studio.watchFolders(start)
	mut extra := uiview.emptyChrome()
	extra.e2e = hive.env.get("HIVE_E2E") is Result.Ok("1")
	return Win(start, extra, false)
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	start := initial(folder)
	if spawn(ui.window("Hive Studio", view, update), start) is Result.Error(why) {
		panic "a janela do Hive Studio não abriu: " + why.message
	}
}
