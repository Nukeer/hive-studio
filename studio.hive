	} else if a == "resetKeys" {
		return Result.Ok(model.Msg.ResetKeys())
	} else if a == "accept" {
		return Result.Ok(model.Msg.AcceptSuggestion(numberOr(arg, 0)))
	} else if a == "closeSuggest" {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if a == "escape" {
