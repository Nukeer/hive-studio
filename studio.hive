// Manda um evento ao serviço, como a página faz, e lê o frame que volta.
proc answer(db: hive.syslink.Address, sent: model.Event): model.Frame {
	answered := db(model.Cmd.Ui(encode(sent, hive.json.codec())))
	if answered is Result.Ok(reply) {
		if reply is model.Cmd.Reply(text) {
			if model.Frame.decode(text, hive.json.codec()) is Result.Ok(frame) {
				return frame
			}
		}
	}
	panic "o serviço não respondeu com um frame"
}

// O frame depois de `sent`, sempre com o texto: quando nada mudou o frame não
// o traz (a página já tem), e aqui ele é pedido de novo, como a página faria
// se o tivesse perdido.
proc ask(db: hive.syslink.Address, sent: model.Event): model.Frame {
	frame := answer(db, sent)
	if frame.hasText {
		return frame
	}
	return answer(db, event("resync", "", "", "", 0))
}

test "o frame só leva o texto e o realce que a página ainda não tem" {
	folder := scratch()
	db := hive.syslink.spawnAddressed(serve, openDoc(fresh(folder), folder + "/main.hive"))
	first := answer(db, event("hello", "", "", "", 0))
	assert first.hasText && first.text == "proc main(): void \{\n\techo 1\n}\n"
	assert first.hl.mode == "full" && len(first.hl.lines) == 4 && first.lineCount == 4
	typed := answer(db, model.Event("edit", "", "x", "", 1, 0, 0, first.serial))
	assert !typed.hasText && typed.text == ""
	assert typed.hl.mode == "patch" && typed.hl.from == 0 && typed.hl.remove == 1
	assert typed.hl.source == ["xproc main(): void \{"] && typed.hl.version == first.hl.version + 1
	quiet := answer(db, event("caret", "", "", "", 3))
	assert !quiet.hasText && quiet.hl.mode == "keep"
	stale := answer(db, model.Event("edit", "", "y", "", 1, 0, 0, first.serial + 7))
	assert stale.hl.mode == "keep"
	again := answer(db, event("resync", "", "", "", 0))
	assert again.hasText && again.text == "xproc main(): void \{\n\techo 1\n}\n" && again.hl.mode == "full"
}

// Teclas do Vim, uma por evento, como a página manda.
proc vimKeys(db: hive.syslink.Address, keys: Str): model.Frame {
	mut frame := ask(db, event("hello", "", "", "", 0))
	for each key in vim.tokens(keys) {
		frame = ask(db, event("vim", "", "0 30", key, -1))
	}
	return frame
}

func regionOf(frame: model.Frame, id: Str): Str {
	for each r in frame.regions {
		if r.id == id {
			return r.html
		}
	}
	return ""
}

test "modo Vim: as teclas passam pelo serviço e voltam como texto, cursor e barra" {
	folder := scratch()
	mut start := fresh(folder)
	start.settings.vim = true
	start = openDoc(start, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(serve, start)

	first := vimKeys(db, "")
	assert first.vim == "normal"
	assert regionOf(first, "vimbar") != ""
	assert indexOf(regionOf(first, "status"), "VIM NORMAL") is Result.Ok(_)

	moved := vimKeys(db, "j")
	assert moved.caret == 20
	assert moved.vimSerial > first.vimSerial
	assert moved.vimAck == first.vimAck + 1

	deleted := vimKeys(db, "dd")
	assert deleted.text == "proc main(): void \{\n}\n"
	assert deleted.serial > moved.serial
	assert vimKeys(db, "u").text == "proc main(): void \{\n\techo 1\n}\n"

	// `o` abre a linha; o que se digita chega como edição, e Esc volta ao normal.
	opened := vimKeys(db, "o")
	assert opened.vim == "insert"
	assert indexOf(regionOf(opened, "vimbar"), "-- INSERÇÃO --") is Result.Ok(_)
	typed := replaceAll(opened.text, "\techo 1\n\t\n", "\techo 1\n\techo 2\n")
	_edited := ask(db, event("edit", "", "", typed, opened.caret + 6))
	back := vimKeys(db, "<Esc>")
	assert back.vim == "normal"
	assert back.text == "proc main(): void \{\n\techo 1\n\techo 2\n}\n"

	// Uma tecla que chega antes da página saber da inserção vira texto.
	late := vimKeys(db, "Ax<Esc>")
	assert late.text == "proc main(): void \{\n\techo 1\n\techo 2x\n}\n"
	assert vimKeys(db, "u").text == back.text

	// A linha de comando: `:` põe o foco nela, e `:w` salva com o fim de linha do arquivo.
	prompt := vimKeys(db, ":")
	assert prompt.focus == "vimCommand"
	assert indexOf(regionOf(prompt, "vimbar"), "data-vimcmd") is Result.Ok(_)
	saved := ask(db, event("act", "vimSubmit", "", "w", 0))
	assert saved.focus == "editor"
	assert indexOf(regionOf(saved, "vimbar"), "main.hive") is Result.Ok(_)
	if hive.file.read(folder + "/main.hive") is Result.Ok(disk) {
		assert disk == "proc main(): void \{\r\n\techo 1\r\n\techo 2\r\n}\r\n"
	} else {
		assert false
	}

	// `/` realça enquanto se digita e, com Enter, leva o cursor à ocorrência.
	_searching := vimKeys(db, "gg/")
	typing := ask(db, event("field", "vimCommand", "", "echo", 0))
	assert len(typing.marks) == 2
	assert typing.markLength == 4
	found := ask(db, event("act", "vimSubmit", "", "echo", 0))
	assert found.caret == 21
	assert len(found.marks) == 2
	assert found.markCurrent == 0
	assert len(ask(db, event("act", "vimSubmit", "", "", 0)).marks) == 2
	cleared := vimKeys(db, ":")
	assert len(ask(db, event("act", "vimSubmit", "", "noh", 0)).marks) == 0
	assert cleared.focus == "vimCommand"

	// Uma seleção com o mouse vira o modo visual.
	selected := ask(db, event("vimMouse", "", "5", "", 0))
	assert selected.vim == "visual"
	assert selected.selStart == 0 && selected.selEnd == 5
	assert vimKeys(db, "<Esc>").vim == "normal"

	// Colar no modo normal (Ctrl+V) também se desfaz com `u`.
	pasted := ask(db, event("edit", "", "", "// colado\n" + back.text, 10))
	assert pasted.vim == "normal"
	assert vimKeys(db, "u").text == back.text

	// Esc sem nada pendente fecha a busca do Ctrl+F.
	withFind := ask(db, event("key", "", "", "Ctrl+F", 0))
	assert regionOf(withFind, "find") != ""
	assert regionOf(vimKeys(db, "<Esc>"), "find") == ""

	// `:e` abre (e cria) um arquivo relativo à pasta aberta, e volta ao modo normal.
	_again := vimKeys(db, ":")
	other := ask(db, event("act", "vimSubmit", "", "e lib/outro.hive", 0))
	assert hive.file.exists(folder + "/lib/outro.hive")
	assert indexOf(other.title, "outro.hive") is Result.Ok(_)
	assert other.vim == "normal"
	assert other.text == ""
	_removed := hive.file.delete(folder + "/lib/outro.hive")
}

