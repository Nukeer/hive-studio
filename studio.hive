// Hive Studio — uma IDE simples para Hive, escrita em Hive.
//
//     hivec run studio.hive [pasta]
//
// O estado mora num serviço (`serve`, uma dobra sobre a caixa de mensagens).
// A página, numa janela Chromium em modo aplicativo, manda eventos pelo
// WebSocket e recebe de volta o frame já desenhado — ver lib/server.hive.

import hive.ui
import ./lib/model
import ./lib/workspace
import ./lib/analysis
import ./lib/toolchain
import ./lib/render
import ./lib/settings
import ./lib/highlight
import ./lib/complete
import ./lib/keys
import ./lib/server
import ./lib/git
import ./lib/navigate
import ./lib/process
import ./lib/native.go
import ./lib/dialogs
import ./lib/i18n
import ./lib/search
import ./lib/vim
import ./lib/agents
import ./lib/todo
import ./lib/jsonview
import ./lib/markdown
import ./lib/pty.go
import ./lib/watch.go

// ── explorador ───────────────────────────────────────────────────────────
//
// O estado é um só, e cada proc o altera no lugar (`state: mut`): nenhuma
// devolve um estado novo, o que deixa o compilador compartilhar o estado com
// quem só o lê em vez de copiá-lo a cada chamada.

proc reload(state: mut model.State): void {
	mut model.TreeRow[dyn] rows = []
	workspace.buildTree(state.root, 0, state.expanded, state.settings.showHidden, rows)
	state.tree = rows
}

proc gitRefresh(state: mut model.State): void {
	git.refresh(state.root, state.git)
}

// Pede para a página focar um campo (`prompt`, `termInput`…) no próximo frame.
proc withFocus(state: mut model.State, target: Str): void {
	state.focus = target
	state.focusSerial = state.focusSerial + 1
}

// ── terminal ─────────────────────────────────────────────────────────────

// Lê o shell aos pedaços e entrega à janela até ele terminar.
proc watchTerminal(db: Address, session: Int): void {
	for ;; {
		text := native.read(session)
		if text != "" {
			async db(model.Cmd.Post(model.Msg.TermOutput(session, text)))
		}
		if !native.alive(session) {
			rest := native.read(session)
			if rest != "" {
				async db(model.Cmd.Post(model.Msg.TermOutput(session, rest)))
			}
			async db(model.Cmd.Post(model.Msg.TermExited(session, native.code(session))))
			return
		}
		server.pause(40)
	}
}

// Abre o shell se ainda não houver um vivo.
proc ensureTerminal(state: mut model.State, from: Address): void {
	if state.term.session != 0 && native.alive(state.term.session) {
		return
	}
	started := native.start(state.root)
	if started is Result.Ok(session) {
		state.term.session = session
		async watchTerminal(from, session)
	} else if started is Result.Error(why) {
		state.term.log = state.term.log + "não foi possível abrir o terminal: " + why + "\n"
	}
}

// Quanto do terminal fica guardado. É uma função e não um literal de
// propósito: `len(text) > 200000` com `len(text) - 150000` logo depois faz o
// hivec 0.2.8 travar na prova de limites.
func logLimit(): Int {
	return 200 * 1000
}

// O log do terminal guarda só o fim quando fica grande demais.
func capLog(text: Str): Str {
	size := len(text)
	limit := logLimit()
	if size > limit {
		return complete.skip(text, size - limit / 4 * 3)
	}
	return text
}

// ── git ──────────────────────────────────────────────────────────────────

// Relê do disco os documentos abertos de um arquivo que o git mudou.
proc reloadDocsOf(state: mut model.State, rel: Str): void {
	for i := 0; i < len(state.docs); i++ {
		mut path := ""
		if state.docs bounds i {
			path = state.docs[i].path
		}
		if path != "" && render.relPath(state, path) == rel {
			reloadDoc(state, i)
		}
	}
	state.textSerial = state.textSerial + 1
}

// O documento `i` relido do disco, como está lá agora.
proc reloadDoc(state: mut model.State, i: Int): void {
	if state.docs bounds i {
		if diskText(state.docs[i].path) is Result.Ok(text) {
			retext(state.docs[i], text)
			if state.docs bounds i {
				state.docs[i].saved = text
			}
		}
	}
}

// O texto de um arquivo, com as quebras de linha de qualquer sistema como "\n".
proc diskText(path: Str): Result<Str, Str> {
	read := hive.file.read(path)
	if read is Result.Ok(raw) {
		return Result.Ok(replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n"))
	} else if read is Result.Error(why) {
		return Result.Error(why.reason)
	}
	return Result.Error("")
}

// Um agente (ou outro programa) mudou um arquivo aberto: o que não tem nada por
// salvar é relido — e o `u` do modo Vim volta ao que era —; o que tem fica como
// está, com um aviso, para salvar não apagar a mudança sem querer. Um arquivo
// apagado continua aberto, riscado (`gone`), até ser fechado ou salvo de novo.
// Só o documento à vista muda o editor, e sem tirar o foco de ninguém
// (`quietSerial`).
proc refreshFromDisk(state: mut model.State): void {
	mut activeChanged := false
	for i := 0; i < len(state.docs); i++ {
		if refreshDoc(state, i) && i == state.active {
			activeChanged = true
		}
	}
	if activeChanged {
		state.textSerial = state.textSerial + 1
		state.quietSerial = state.textSerial
	}
}

// O documento `i` comparado com o disco; `true` quando o texto dele foi relido.
proc refreshDoc(state: mut model.State, i: Int): Bool {
	mut path := ""
	mut name := ""
	mut current := ""
	mut saved := ""
	mut gone := false
	if state.docs bounds i {
		path = state.docs[i].path
		name = state.docs[i].name
		current = state.docs[i].text
		saved = state.docs[i].saved
		gone = state.docs[i].gone
	}
	if path == "" {
		return false
	}
	read := diskText(path)
	if read is Result.Error(reason) {
		if reason == "NotFound" && !gone {
			if state.docs bounds i {
				state.docs[i].gone = true
			}
			state.status = name + " " + render.tx(state, "foi apagado do disco")
		}
		return false
	}
	mut text := ""
	if read is Result.Ok(fresh) {
		text = fresh
	}
	if gone {
		if state.docs bounds i {
			state.docs[i].gone = false
		}
	}
	if text == saved {
		return false
	}
	if current != saved {
		state.status = name + " " + render.tx(state, "mudou no disco — salvar agora sobrescreve essa mudança")
		return false
	}
	if state.docs bounds i {
		mut model.Snapshot[dyn] undo = state.docs[i].undo
		append(undo, model.Snapshot(current, state.caret))
		if len(undo) > vim.undoLimit() {
			if undo bounds 0 {
				drop(undo, 0, 0)
			}
		}
		model.Snapshot[dyn] none = []
		retext(state.docs[i], text)
		if state.docs bounds i {
			state.docs[i].saved = text
		}
		if state.docs bounds i {
			state.docs[i].undo = undo
		}
		if state.docs bounds i {
			state.docs[i].redo = none
		}
		return true
	}
	return false
}

// Um arquivo ou pasta criado, apagado ou renomeado por fora aparece (ou some)
// na árvore; pastas expandidas que sumiram saem da lista, e as cores do git
// acompanham.
// As pastas da lista que ainda existem.
// Tira das pastas expandidas as que não existem mais.
proc pruneExpanded(state: mut model.State): void {
	mut Str[dyn] found = []
	for each folder in state.expanded {
		if present(folder) {
			append(found, folder)
		}
	}
	state.expanded = found
}

proc present(path: Str): Bool {
	return hive.file.exists(path)
}

proc refreshTree(state: mut model.State): void {
	before := len(state.expanded)
	pruneExpanded(state)
	mut model.TreeRow[dyn] fresh = []
	workspace.buildTree(state.root, 0, state.expanded, state.settings.showHidden, fresh)
	if fresh == state.tree && len(state.expanded) == before {
		return
	}
	state.tree = fresh
	gitRefresh(state)
}

// As pastas que valem vigiar, em `folders`: a raiz, as expandidas na árvore e
// as dos arquivos abertos, cada uma uma vez.
proc watchedFolders(state: mut model.State, folders: mut Str[dyn]): void {
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	addFolder(folders, seen, state.root)
	for each folder in state.expanded {
		addFolder(folders, seen, folder)
	}
	for i := 0; i < len(state.docs); i++ {
		if state.docs bounds i {
			addFolder(folders, seen, workspace.parentOf(state.docs[i].path))
		}
	}
}

proc addFolder(folders: mut Str[dyn], seen: mut hive.map.Map<Str, Bool>, folder: Str): void {
	if !hive.map.has(seen, folder) {
		hive.map.set(seen, folder, true)
		append(folders, folder)
	}
}

// Vigia a raiz, as pastas expandidas e as dos arquivos abertos.
proc watchFolders(state: mut model.State): void {
	mut Str[dyn] folders = []
	watchedFolders(state, folders)
	_watching := watch.set(folders)
}

// Espera o disco mudar e avisa a janela na hora. Sem aviso (uma pasta de rede,
// o WSL), relê mesmo assim a cada três segundos.
proc watchDocs(db: Address): void {
	mut idle := 0
	for ;; {
		changed := watch.wait(1000)
		idle++
		if changed || idle >= 3 {
			idle = 0
			async db(model.Cmd.Post(model.Msg.DiskPoll()))
		}
	}
}

proc afterGit(state: mut model.State, outcome: process.Output): void {
	reload(state)
	gitRefresh(state)
	if outcome.code != 0 {
		state.status = "git: " + process.firstLine(outcome.text)
		state.output = state.output + outcome.text
	}
}

proc openRoot(state: mut model.State, folder: Str): void {
	target := workspace.normalize(folder)
	if hive.file.list(target) is Result.Error(why) {
		state.status = render.tx(state, "não foi possível abrir") + " {target}: {why.message}"
		return
	}
	Str[dyn] closed = []
	state.root = target
	state.expanded = closed
	state.selected = ""
	state.status = render.tx(state, "pasta") + " {workspace.baseName(target)}"
	reload(state)
	gitRefresh(state)
}

func isNot(candidate: Str, path: Str): Bool {
	return candidate != path
}

proc toggle(state: mut model.State, path: Str): void {
	if workspace.isExpanded(state.expanded, path) {
		state.expanded = filter(state.expanded, isNot(_, path))
	} else {
		mut Str[dyn] expanded = state.expanded
		append(expanded, path)
		state.expanded = expanded
	}
	state.selected = path
	reload(state)
}

// Onde um arquivo novo vai: a pasta selecionada, a pasta do arquivo
// selecionado, ou a raiz.
func targetFolder(state: model.State): Str {
	if state.selected == "" {
		return state.root
	}
	for each row in state.tree {
		if row.entry.path == state.selected {
			if row.entry.folder {
				return row.entry.path
			}
			return workspace.parentOf(row.entry.path)
		}
	}
	return state.root
}

// ── documentos ───────────────────────────────────────────────────────────

// Troca o texto de um documento refazendo o realce só das linhas que mudaram;
// a página recebe só essas linhas (`patch`, sobre a versão anterior).
proc retext(doc: mut model.Doc, text: Str): void {
	done := highlight.rehighlight(doc.hl, doc.text, text, model.language(doc.path))
	doc.hl = done.result
	doc.patch = done.patch
	doc.version = doc.version + 1
	doc.text = text
}

func findDoc(docs: model.Doc[], path: Str): Result<Int, Bool> {
	for i := 0; i < len(docs); i++ {
		if docs[i].path == path {
			return Result.Ok(i)
		}
	}
	return Result.Error(false)
}

proc openDoc(state: mut model.State, path: Str): void {
	state.selected = path
	state.editorView = model.EditorView.DocView()
	if findDoc(state.docs, path) is Result.Ok(index) {
		state.active = index
		return
	}
	read := hive.file.read(path)
	if read is Result.Ok(raw) {
		mut eol := "\n"
		if indexOf(raw, "\r\n") is Result.Ok(_) {
			eol = "\r\n"
		}
		text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
		mut mode := "edit"
		if model.hasPreview(path) {
			mode = "preview"
		}
		mut model.Doc[dyn] docs = state.docs
		append(docs, model.newDoc(path, workspace.baseName(path), text, eol, mode))
		state.docs = docs
		state.active = len(docs) - 1
		state.status = render.tx(state, "aberto") + " {workspace.baseName(path)}"
		if model.hasPreview(path) && len(text) <= bigView() && (mode != "edit" || model.isJson(path)) {
			withView(state, path, 0, renderView(path, text, labelsOf(state)))
		}
	} else if read is Result.Error(why) {
		state.status = render.tx(state, "não foi possível ler") + " {path}: {why.message}"
	}
}

// Grava o documento e o marca como salvo. Devolve o erro, ou "".
proc saveDoc(doc: mut model.Doc): Str {
	mut contents := doc.text
	if doc.eol == "\r\n" {
		contents = replaceAll(doc.text, "\n", "\r\n")
	}
	if hive.file.write(doc.path, contents) is Result.Error(why) {
		return "não foi possível salvar {doc.name}: {why.message}"
	}
	doc.saved = doc.text
	doc.gone = false
	return ""
}

proc saveAll(state: mut model.State): void {
	mut count := 0
	for i := 0; i < len(state.docs); i++ {
		mut failure := "-"
		if state.docs bounds i {
			if state.docs[i].text != state.docs[i].saved {
				failure = saveDoc(state.docs[i])
			}
		}
		if failure == "" {
			count++
		} else if failure != "-" {
			state.status = failure
		}
	}
	if count > 0 {
		state.status = "{count} " + render.tx(state, "arquivo(s) salvo(s)")
	}
}

proc create(state: mut model.State, name: Str, folder: Bool): void {
	if name == "" {
		return
	}
	base := targetFolder(state)
	path := workspace.joinPath(base, name)
	if hive.file.exists(path) {
		state.status = "{name} " + render.tx(state, "já existe")
		return
	}
	if folder {
		if hive.file.makeDir(path) is Result.Error(why) {
			state.status = "não foi possível criar {path}: {why.message}"
			return
		}
	} else if hive.file.write(path, "") is Result.Error(why) {
		state.status = "não foi possível criar {path}: {why.message}"
		return
	}
	if base != state.root && !workspace.isExpanded(state.expanded, base) {
		mut Str[dyn] expanded = state.expanded
		append(expanded, base)
		state.expanded = expanded
	}
	reload(state)
	state.selected = path
	if !folder {
		openDoc(state, path)
	}
}

// A posição do documento aberto com esse caminho, ou -1.
func docIndex(state: model.State, path: Str): Int {
	for i := 0; i < len(state.docs); i++ {
		if state.docs bounds i {
			if state.docs[i].path == path {
				return i
			}
		}
	}
	return -1
}

// Se `path` é `target` ou está dentro dele.
func within(path: Str, target: Str): Bool {
	clean := workspace.normalize(path)
	gone := workspace.normalize(target)
	return clean == gone || complete.startsWith(clean, gone + "/")
}

// Um item do menu do botão direito do explorador.
proc contextAction(state: mut model.State, action: Str, path: Str, from: Address): void {
	folder := render.isFolder(state, path)
	mut here := path
	if !folder {
		here = workspace.parentOf(path)
	}
	state.selected = path
	if action == "open" {
		openDoc(state, path)
		withFocus(state, "editor")
	} else if action == "newFile" || action == "newFolder" {
		// O novo item vai para dentro da pasta, ou ao lado do arquivo.
		state.selected = here
		if here != state.root && !workspace.isExpanded(state.expanded, here) {
			toggle(state, here)
		}
		update(state, model.Msg.StartPrompt(promptFor(action)), from)
	} else if action == "rename" {
		update(state, model.Msg.StartPrompt(model.Prompt.RenamePrompt(path)), from)
	} else if action == "delete" {
		update(state, model.Msg.AskRemove(path), from)
	} else if action == "copyPath" || action == "copyRelative" {
		mut text := native.absPath(path)
		if action == "copyRelative" {
			text = render.relPath(state, path)
		}
		state.vim.clip = text
		state.vim.clipSerial = state.vim.clipSerial + 1
		state.status = render.tx(state, "caminho copiado") + ": " + text
	} else if action == "reveal" {
		revealInSystem(path)
	} else if action == "terminal" {
		update(state, model.Msg.ShowPane(model.Pane.TerminalPane()), from)
		mut command := "cd \"" + native.absPath(here) + "\""
		if server.isWindows() {
			command = "cd /d \"" + replaceAll(native.absPath(here), "/", "\\") + "\""
		}
		update(state, model.Msg.TermSubmit(command), from)
	} else if action == "entry" {
		state.entrypoint = path
		state.status = render.tx(state, "entrada") + ": " + workspace.baseName(path)
	} else if action == "stage" {
		gitPath := render.gitPathOf(state, path)
		if gitPath != "" {
			update(state, model.Msg.GitStage(gitPath), from)
		}
	} else if action == "discard" {
		gitPath := render.gitPathOf(state, path)
		if gitPath != "" {
			update(state, model.Msg.GitAskDiscard(gitPath), from)
		}
	}
}

// Mostra o arquivo (ou a pasta) no gerenciador de arquivos do sistema.
proc revealInSystem(path: Str): void {
	abs := native.absPath(path)
	if server.isWindows() {
		async server.openWith("explorer.exe", ["/select," + replaceAll(abs, "/", "\\")])
	} else if hive.file.exists("/usr/bin/open") {
		async server.openWith("open", ["-R", abs])
	} else {
		async server.openWith("xdg-open", [workspace.parentOf(abs)])
	}
}

// Troca o nome de um arquivo ou de uma pasta, e leva junto os documentos
// abertos dela, as pastas expandidas, a seleção e a entrada fixada.
proc renamePath(state: mut model.State, path: Str, name: Str): void {
	if name == "" || name == workspace.baseName(path) {
		return
	}
	if highlight.has(name, "/") || highlight.has(name, "\\") {
		state.status = render.tx(state, "o nome não pode ter barras")
		return
	}
	target := workspace.joinPath(workspace.parentOf(path), name)
	if hive.file.exists(target) {
		state.status = "{name} " + render.tx(state, "já existe")
		return
	}
	if hive.file.move(path, target) is Result.Error(why) {
		state.status = render.tx(state, "não foi possível renomear") + " " + workspace.baseName(path) + ": " + why.message
		return
	}
	for i := 0; i < len(state.docs); i++ {
		mut open := ""
		if state.docs bounds i {
			open = state.docs[i].path
		}
		if open != "" && within(open, path) {
			moved := movedPath(open, path, target)
			mut text := ""
			if state.docs bounds i {
				text = state.docs[i].text
			}
			if state.docs bounds i {
				state.docs[i].path = moved
			}
			if state.docs bounds i {
				state.docs[i].name = workspace.baseName(moved)
			}
			if state.docs bounds i {
				state.docs[i].hl = highlight.highlightText(text, model.language(moved))
			}
		}
	}
	mut Str[dyn] expanded = []
	for each folder in state.expanded {
		append(expanded, movedPath(folder, path, target))
	}
	state.expanded = expanded
	if state.entrypoint != "" && within(state.entrypoint, path) {
		state.entrypoint = movedPath(state.entrypoint, path, target)
	}
	state.selected = target
	state.textSerial = state.textSerial + 1
	reload(state)
	gitRefresh(state)
	state.status = workspace.baseName(path) + " " + render.tx(state, "renomeado para") + " " + name
}

// `path` com o começo `from` trocado por `to` (ele mesmo, se não está dentro).
func movedPath(path: Str, from: Str, to: Str): Str {
	clean := workspace.normalize(path)
	old := workspace.normalize(from)
	if clean == old {
		return to
	}
	if complete.startsWith(clean, old + "/") {
		return to + complete.skip(clean, len(old))
	}
	return path
}

// Apaga um arquivo, ou uma pasta com tudo o que tem dentro, e fecha o que
// estava aberto dela. A raiz do projeto não se apaga.
proc removePath(state: mut model.State, path: Str): void {
	state.removing = ""
	if path == "" || workspace.normalize(path) == workspace.normalize(state.root) {
		return
	}
	name := workspace.baseName(path)
	if native.removeAll(path) is Result.Error(why) {
		state.status = render.tx(state, "não foi possível excluir") + " " + name + ": " + why
		return
	}
	for i := len(state.docs) - 1; i >= 0; i-- {
		mut open := ""
		if state.docs bounds i {
			open = state.docs[i].path
		}
		if open != "" && within(open, path) {
			closeDoc(state, i)
		}
	}
	if state.selected != "" && within(state.selected, path) {
		state.selected = ""
	}
	refreshTree(state)
	gitRefresh(state)
	state.status = render.tx(state, "excluído") + " " + name
}

proc closeDoc(state: mut model.State, index: Int): void {
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		drop(docs, index, index)
		state.docs = docs
		if state.active >= index && state.active > 0 {
			state.active = state.active - 1
		}
		if len(docs) == 0 {
			state.active = -1
		}
	}
}

proc peekAt(state: mut model.State, file: Str, line: Int): void {
	if findDoc(state.docs, file) is Result.Ok(index) {
		state.active = index
		state.editorView = model.EditorView.DocView()
		if state.docs bounds index {
			state.peekText = state.docs[index].text
		}
	} else {
		read := hive.file.read(file)
		if read is Result.Ok(text) {
			openDoc(state, file)
			state.peekText = replaceAll(text, "\r", "")
		} else if read is Result.Error(why) {
			state.status = render.tx(state, "não foi possível ler") + " {file}: {why.message}"
			return
		}
	}
	state.peekFile = file
	state.peekLine = line
}

// Troca o texto do documento ativo (e o realce guardado dele).
proc withText(state: mut model.State, text: Str): void {
	index := state.active
	if state.docs bounds index {
		retext(state.docs[index], text)
	}
}

// Leituras do documento à vista. Devolvem só texto ou um booleano, e não o
// documento: uma função que devolve parte do estado obriga o compilador a
// copiar o estado inteiro de quem ainda vai alterá-lo.
func activeText(state: model.State): Str {
	index := state.active
	if state.docs bounds index {
		return state.docs[index].text
	}
	return ""
}

func hasDoc(state: model.State): Bool {
	return state.docs bounds state.active
}

func activeName(state: model.State): Str {
	index := state.active
	if state.docs bounds index {
		return state.docs[index].name
	}
	return ""
}

func activeMode(state: model.State): Str {
	index := state.active
	if state.docs bounds index {
		return state.docs[index].mode
	}
	return ""
}

proc clearSuggestions(state: mut model.State): void {
	model.Suggestion[dyn] none = []
	state.suggestions = none
	state.suggestIndex = 0
}

// Sugere só enquanto um nome está sendo digitado, ou logo depois de um ponto.
proc autoSuggest(state: mut model.State): void {
	clearSuggestions(state)
	// As sugestões são do Hive: em JSON, Markdown e texto elas só atrapalham
	// (Ctrl+Space ainda pede na mão).
	if !state.settings.autocomplete || model.language(render.activePath(state)) != "hive" {
		return
	}
	text := activeText(state)
	ctx := complete.context(text, state.caret)
	if ctx.prefix != "" || ctx.qualifier != "" {
		state.suggestions = complete.suggest(text, state.caret, 12)
	}
}

proc acceptSuggestion(state: mut model.State, index: Int): void {
	if state.suggestions bounds index {
		word := state.suggestions[index].word
		edit := complete.accept(activeText(state), state.caret, word)
		withText(state, edit.text)
		state.caret = edit.caret
		state.textSerial = state.textSerial + 1
	}
	clearSuggestions(state)
}

// ── configurações ────────────────────────────────────────────────────────

proc applySettings(state: mut model.State, prefs: settings.Settings): void {
	state.settings = prefs
	if settings.save(prefs) is Result.Error(why) {
		state.status = "não foi possível salvar as configurações: {why}"
	}
}

proc toggleSetting(state: mut model.State, name: Str): void {
	mut prefs := state.settings
	if name == "lineNumbers" {
		prefs.lineNumbers = !prefs.lineNumbers
	} else if name == "showHidden" {
		prefs.showHidden = !prefs.showHidden
	} else if name == "saveBeforeRun" {
		prefs.saveBeforeRun = !prefs.saveBeforeRun
	} else if name == "autocomplete" {
		prefs.autocomplete = !prefs.autocomplete
	} else if name == "vim" {
		prefs.vim = !prefs.vim
	} else if name == "errorLens" {
		prefs.errorLens = !prefs.errorLens
	}
	applySettings(state, prefs)
	if name == "showHidden" {
		reload(state)
	} else if name == "vim" {
		vim.reset(state.vim)
		state.status = render.tx(state, "modo Vim desligado")
		if prefs.vim {
			state.status = render.tx(state, "modo Vim ligado")
		}
		clearSuggestions(state)
		withFocus(state, "editor")
	}
}

// ── Error Lens ───────────────────────────────────────────────────────────

// Pede um check para quando a digitação parar (o último pedido vence).
proc lensSoon(state: mut model.State, from: Address): void {
	if (!state.settings.errorLens || render.targetOf(state) == "") && !state.todoScanned && !model.hasPreview(render.activePath(state)) {
		return
	}
	state.lensDue = state.lensDue + 1
	async toolchain.lensTimer(from, state.lensDue)
}

proc startLens(state: mut model.State, from: Address): void {
	target := render.targetOf(state)
	if target == "" {
		return
	}
	overlays := toolchain.packOverlays(state.docs)
	state.lensRunning = true
	state.lensAgain = false
	compiler := state.settings.compiler
	root := state.root
	async toolchain.lensCheck(from, compiler, root, target, overlays)
}

// ── visualização (Markdown, JSON) ────────────────────────────────────────

// O que a visualização mostra de um texto: o HTML e, num JSON, o erro.
type Rendered {
	view:    Str
	problem: model.Diagnostic
}

func labelsOf(state: model.State): jsonview.Labels {
	return jsonview.Labels(render.tx(state, "JSON inválido"), render.tx(state, "linha"), render.tx(state, "coluna"),
		render.tx(state, "Arquivo grande: a árvore mostra só os primeiros 20000 valores (o arquivo inteiro foi conferido)."))
}

func renderView(path: Str, text: Str, labels: jsonview.Labels): Rendered {
	if model.isJson(path) {
		seen := jsonview.view(text, 20000, labels)
		return Rendered(seen.html, model.Diagnostic(path, seen.problem.line, labels.column + " {seen.problem.column}: " + seen.problem.message,
			analysis.lineText(text, seen.problem.line)))
	}
	return Rendered("<div class=\"md\">" + markdown.render(text) + "</div>", model.Diagnostic(path, 0, "", ""))
}

// Acima disto (em caracteres), a visualização é feita numa thread à parte.
// Uma função, e não o número direto na comparação: assim o checker não
// tenta provar nada sobre o tamanho do texto.
func bigView(): Int {
	return 300000
}

// Um arquivo grande tem a visualização feita numa thread própria: a janela
// continua respondendo, e o resultado chega em `ViewReady`.
proc viewWorker(window: Address, path: Str, version: Int, text: Str, labels: jsonview.Labels): void {
	done := renderView(path, text, labels)
	async window(model.Cmd.Post(model.Msg.ViewReady(path, version, done.view, done.problem)))
}

// Refaz a visualização guardada do documento à vista, se o texto mudou desde
// a última: o preview do Markdown (quando está à vista) e, num JSON, a árvore
// e o erro — este também no modo Editor, para o Error Lens.
proc refreshView(state: mut model.State, from: Address): void {
	index := state.active
	mut found := false
	mut doc := model.newDoc("", "", "", "\n", "edit")
	if state.docs bounds index {
		doc = state.docs[index]
		found = true
	}
	if !found || !model.hasPreview(doc.path) || doc.viewOf == doc.version {
		return
	}
	if model.isMarkdown(doc.path) && doc.mode == "edit" {
		return
	}
	if len(doc.text) > bigView() {
		pending := doc.path + "#{doc.version}"
		if state.viewPending != pending {
			state.viewPending = pending
			labels := labelsOf(state)
			async viewWorker(from, doc.path, doc.version, doc.text, labels)
		}
		return
	}
	withView(state, doc.path, doc.version, renderView(doc.path, doc.text, labelsOf(state)))
}

// Guarda a visualização no documento, se ela ainda é do texto que ele tem.
proc withView(state: mut model.State, path: Str, version: Int, done: Rendered): void {
	mut model.Doc[dyn] docs = state.docs
	for i := 0; i < len(docs); i++ {
		if docs bounds i {
			mut doc := docs[i]
			if doc.path == path && doc.version == version {
				doc.view = done.view
				doc.viewOf = version
				doc.problem = done.problem
				docs[i] = doc
			}
		}
	}
	state.docs = docs
}

// ── TODO ─────────────────────────────────────────────────────────────────

// Procura os TODO da pasta no disco, numa thread própria; a lista chega em
// `TodosFound`, onde os documentos não salvos entram com o texto do editor.
proc scanTodos(state: mut model.State, from: Address): void {
	if state.todoScanning {
		return
	}
	state.todoScanning = true
	root := state.root
	hidden := state.settings.showHidden
	async todo.scan(from, root, hidden)
}

// Os erros do compilador no arquivo e na linha onde estão de fato.
proc located(state: mut model.State, found: model.Diagnostic[]): model.Diagnostic[dyn] {
	target := render.targetOf(state)
	mut Str[dyn] modules = []
	importedModules(state, target, modules)
	mut model.Diagnostic[dyn] out = []
	for each d in found {
		where := analysis.locate(d.message)
		mut file := d.file
		if where.module != "" {
			file = moduleFile(target, modules, where.module)
		}
		mut line := d.line
		if where.name != "" {
			line = analysis.refineLine(textOf(state, file), d.line, where.message)
		}
		append(out, model.Diagnostic(file, line, where.message, analysis.lineText(textOf(state, file), line)))
	}
	return out
}

// O texto de um arquivo como o editor o tem (aberto) ou como está no disco.
proc textOf(state: mut model.State, path: Str): Str {
	for each doc in state.docs {
		if workspace.normalize(doc.path) == workspace.normalize(path) {
			return doc.text
		}
	}
	if hive.file.read(path) is Result.Ok(raw) {
		return replaceAll(raw, "\r", "")
	}
	return ""
}

// O resultado do `hivec analyze` vai para o painel ANÁLISE: cada função com o
// arquivo onde ela está, para o clique abrir na linha certa.
proc withAnalysis(state: mut model.State, output: Str): void {
	target := render.targetOf(state)
	report := analysis.parseAnalyze(output)
	mut Str[dyn] modules = []
	importedModules(state, target, modules)
	mut model.Hotspot[dyn] spots = []
	for each spot in report.spots {
		mut found := spot
		found.file = moduleFile(target, modules, analysis.moduleOf(spot.name))
		found.source = analysis.lineText(textOf(state, found.file), found.line)
		append(spots, found)
	}
	state.analysisHead = report.head
	state.hotspots = spots
	state.analysisReport = ""
	if target is "{stem}.hive" {
		state.analysisReport = stem + "-analysis.html"
	}
	state.pane = model.Pane.AnalysisPane()
	state.panelOpen = true
	if report.head bounds 0 {
		state.status = "analyze: " + report.head[0]
	}
}

// Os módulos do programa, como "módulo=arquivo": os imports do arquivo de
// entrada e, em cadeia, os deles (com o texto do editor, se estiver aberto).
proc importedModules(state: mut model.State, target: Str, found: mut Str[dyn]): void {
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	mut Str[dyn] pending = [target]
	for next := 0; next < len(pending) && next < 500; next++ {
		mut file := ""
		if pending bounds next {
			file = pending[next]
		}
		if file != "" && !hive.map.has(seen, file) {
			hive.map.set(seen, file, true)
			addModules(state, file, found, pending)
		}
	}
}

// Os imports de `file` que não são Go: em `found` como "módulo=arquivo", e
// em `pending` para ler os deles depois.
proc addModules(state: mut model.State, file: Str, found: mut Str[dyn], pending: mut Str[dyn]): void {
	for each i in analysis.importsOf(textOf(state, file), workspace.parentOf(file)) {
		if i.path is "{stem}.go" {
			continue
		}
		append(found, i.name + "=" + i.path)
		append(pending, i.path)
	}
}

// O arquivo de um módulo: o que o arquivo de entrada importa com esse nome, ou
// um `lib/<módulo>.hive` / `<módulo>.hive` ao lado dele (os de segunda mão).
proc moduleFile(target: Str, modules: Str[], module: Str): Str {
	if module == "" {
		return target
	}
	for each pair in modules {
		if pair is "{name}={file}" {
			if name == module {
				return file
			}
		}
	}
	folder := workspace.parentOf(target)
	inLib := folder + "/lib/" + module + ".hive"
	if hive.file.exists(inLib) {
		return inLib
	}
	beside := folder + "/" + module + ".hive"
	if hive.file.exists(beside) {
		return beside
	}
	return target
}

func summary(state: model.State, command: Str, ok: Bool, problems: Int): Str {
	if ok {
		return "{command}: ok"
	}
	if problems > 0 {
		return "{command}: {problems} " + render.tx(state, "problema(s)")
	}
	return "{command}: " + render.tx(state, "falhou")
}

func clampInt(value: Int, low: Int, high: Int): Int {
	if value < low {
		return low
	}
	if value > high {
		return high
	}
	return value
}

// ── buscas ───────────────────────────────────────────────────────────────

func matchCount(state: model.State): Int {
	return len(render.findMatches(render.searched(state), state.find))
}

func paletteCount(state: model.State): Int {
	return len(render.paletteMatches(state.palette))
}

func paletteChoice(state: model.State, index: Int): Str {
	found := render.paletteMatches(state.palette)
	if found bounds index {
		return vim.at(state.palette.files, found[index])
	}
	return ""
}

// A primeira ocorrência da busca a partir do cursor (ou a primeira de todas).
func firstMatchFrom(state: model.State, caret: Int): Int {
	matches := render.findMatches(render.searched(state), state.find)
	for i := 0; i < len(matches); i++ {
		if matches[i] >= caret {
			return i
		}
	}
	return 0
}

// Abre um arquivo e põe o cursor numa linha e coluna (a partir de 1 e de 0).
proc jumpTo(state: mut model.State, path: Str, line: Int, column: Int): void {
	target := workspace.tidy(path)
	if workspace.tidy(render.activePath(state)) != target {
		openDoc(state, target)
	}
	state.editorView = model.EditorView.DocView()
	state.caret = navigate.offsetOf(activeText(state), line, column)
	state.textSerial = state.textSerial + 1
	clearSuggestions(state)
}

// ── modo Vim ─────────────────────────────────────────────────────────────

// As teclas vão para o motor do Vim quando ele está ligado e há um documento
// no editor.
func vimActive(state: model.State): Bool {
	return state.settings.vim && render.showsDoc(state) && render.activeDoc(state) is Result.Ok(_)
}

// O documento ativo como o motor do Vim o vê. Um `caret` negativo é "o que o
// estado já tem": a página só manda o dela quando o mudou por conta própria.
// `view` é "primeira linha visível, quantas linhas cabem".
proc vimEditor(state: mut model.State, caret: Int, view: Str): vim.Editor {
	mut top := 0
	mut rows := 30
	if view is "{first} {count}" {
		top = numberOr(first, 0)
		rows = numberOr(count, 30)
	}
	mut cursor := state.caret
	if caret >= 0 {
		cursor = caret
	}
	model.Msg[dyn] none = []
	model.Snapshot[dyn] empty = []
	mut editor := vim.Editor(text: "", caret: cursor, vim: state.vim, undo: empty, redo: empty, dirty: false,
		anyDirty: model.anyDirty(state.docs), numbers: state.settings.lineNumbers, active: state.active,
		top: top, rows: rows, tab: state.settings.tabSize, scroll: -1, clip: "", effects: none)
	index := state.active
	if state.docs bounds index {
		editor.text = state.docs[index].text
		editor.undo = state.docs[index].undo
		editor.redo = state.docs[index].redo
		editor.dirty = state.docs[index].text != state.docs[index].saved
	}
	return editor
}

// Leva o que o motor devolveu ao documento ativo e despacha os efeitos
// (salvar, fechar, abrir…) como mensagens comuns.
proc vimApply(state: mut model.State, out: mut vim.Editor, from: Address): void {
	// O que o Vim era antes desta tecla, para comparar no fim.
	wasPrompt := state.vim.prompt
	wasCommand := state.vim.command
	wasFrom := state.vim.promptFrom
	wasSerial := state.vim.serial
	wasClipSerial := state.vim.clipSerial
	wasSearchSerial := state.vim.searchSerial
	wasStatus := state.status
	wasPath := render.activePath(state)
	index := state.active
	if state.docs bounds index {
		mut doc := state.docs[index]
		changed := doc.text != out.text
		if changed {
			retext(doc, out.text)
		}
		doc.undo = out.undo
		doc.redo = out.redo
		state.docs[index] = doc
		if changed {
			state.textSerial = state.textSerial + 1
		}
	}
	state.caret = out.caret
	mut v := out.vim
	v.serial = wasSerial + 1
	v.scroll = out.scroll
	if out.clip != "" {
		v.clip = out.clip
		v.clipSerial = wasClipSerial + 1
	}
	if v.prompt != wasPrompt || v.command != wasCommand {
		v.searchSerial = wasSearchSerial + 1
	}
	state.vim = v
	if v.mode != model.VimMode.InsertMode() {
		clearSuggestions(state)
	}
	if wasPrompt == "" && v.prompt != "" {
		withFocus(state, "vimCommand")
	}
	focused := state.focusSerial
	for each effect in out.effects {
		step(state, effect, from)
	}
	// A linha de comando fechou: o foco volta para onde ela foi aberta — a não
	// ser que o comando tenha levado o foco (`:Ex`, `:term`) ou aberto um arquivo.
	if wasPrompt != "" && v.prompt == "" && state.focusSerial == focused {
		mut back := "editor"
		if wasFrom == "explorer" && render.activePath(state) == wasPath {
			back = "explorer"
		}
		withFocus(state, back)
	}
	// `:w`, `:e`… respondem na barra do Vim com o que o estúdio disse.
	if len(out.effects) > 0 && v.message == "" && state.status != wasStatus {
		Str[dyn] none = []
		state.vim.message = state.status
		state.vim.args = none
	}
}

// Guarda o texto de antes numa alteração que não passou pelo motor (colar no
// modo normal), para o `u` desfazê-la.
proc withUndo(state: mut model.State, before: model.Snapshot): void {
	index := state.active
	if state.docs bounds index {
		mut doc := state.docs[index]
		mut model.Snapshot[dyn] undo = doc.undo
		append(undo, before)
		if len(undo) > vim.undoLimit() {
			if undo bounds 0 {
				drop(undo, 0, 0)
			}
		}
		model.Snapshot[dyn] none = []
		doc.undo = undo
		doc.redo = none
		state.docs[index] = doc
	}
}

func isAbsolute(path: Str): Bool {
	clean := replaceAll(path, "\\", "/")
	return complete.startsWith(clean, "/") || clean is "{drive}:/{rest}"
}

// Um caminho digitado num comando, relativo à pasta aberta.
func resolvePath(state: model.State, path: Str): Str {
	target := workspace.tidy(replaceAll(path, "\\", "/"))
	if isAbsolute(target) {
		return target
	}
	return workspace.joinPath(state.root, target)
}

// `:e arquivo`: abre (e cria, se ainda não existir) um arquivo, relativo à pasta aberta.
proc vimEdit(state: mut model.State, path: Str): void {
	target := resolvePath(state, path)
	if hive.file.list(target) is Result.Ok(_) {
		focusExplorer(state, target)
		return
	}
	if !hive.file.exists(target) {
		if hive.file.write(target, "") is Result.Error(why) {
			state.status = "não foi possível criar {target}: {why.message}"
			return
		}
		openDoc(state, target)
		reload(state)
		state.status = render.tx(state, "novo arquivo") + " {workspace.baseName(target)}"
		return
	}
	openDoc(state, target)
}

// As mensagens do modo Vim e do explorador pelo teclado; `false` quando a
// mensagem não é daqui.
proc updateVim(state: mut model.State, message: model.Msg, from: Address): Bool {
	if message is model.Msg.VimKey(key, caret, view) {
		state.vim.acked = state.vim.acked + 1
		if !vimActive(state) {
			return true
		}
		idle := state.vim.mode == model.VimMode.NormalMode() && len(state.vim.pending) == 0 && state.vim.prompt == ""
		mut editor := vimEditor(state, caret, view)
		vim.press(editor, key)
		vimApply(state, editor, from)
		// Esc sem nada pendente fecha o que estiver aberto (busca, sugestões…).
		if vim.isEscape(key) && idle {
			if escapeFor(escapeKind(state)) is Result.Ok(closing) {
				step(state, closing, from)
			}
		}
	} else if message is model.Msg.VimMouse(start, end) {
		if !vimActive(state) {
			state.caret = start
			return true
		}
		mut editor := vimEditor(state, start, "")
		vim.click(editor, start, end)
		vimApply(state, editor, from)
	} else if message is model.Msg.VimTyped(text) {
		state.vim.command = text
		if state.vim.prompt == "/" || state.vim.prompt == "?" {
			state.vim.searchSerial = state.vim.searchSerial + 1
		}
	} else if message is model.Msg.VimSubmit(text) {
		if state.vim.prompt == "" || !state.settings.vim {
			return true
		}
		mut editor := vimEditor(state, -1, "")
		vim.submit(editor, text)
		vimApply(state, editor, from)
	} else if message is model.Msg.VimCancel {
		if state.settings.vim {
			mut editor := vimEditor(state, -1, "")
			vim.cancel(editor)
			vimApply(state, editor, from)
			return true
		}
		state.vim.prompt = ""
		state.vim.command = ""
		state.vim.serial = state.vim.serial + 1
		withFocus(state, "editor")
	} else if message is model.Msg.VimHistory(delta) {
		vim.browseHistory(state.vim, delta)
	} else if message is model.Msg.VimEdit(path) {
		vimEdit(state, path)
	} else if message is model.Msg.FocusExplorer(path) {
		if path != "" {
			focusExplorer(state, resolvePath(state, path))
			return true
		}
		// `:Ex` com o explorador já aberto o fecha e volta ao código, como o `:Lex`.
		if state.sideOpen && state.side == model.SideView.ExplorerSide() {
			state.sideOpen = false
			state.treeKeys = ""
			if hasDoc(state) {
				withFocus(state, "editor")
			}
			return true
		}
		focusExplorer(state, "")
	} else if message is model.Msg.TreeKey(key) {
		treeKey(state, key)
	} else if message is model.Msg.VimReload {
		if hasDoc(state) {
			name := activeName(state)
			reloadDocsOf(state, render.relPath(state, render.activePath(state)))
			state.status = render.tx(state, "aberto") + " {name}"
		}
	} else {
		return false
	}
	return true
}

// ── agentes: Claude Code, Codex e OpenCode ───────────────────────────────

// Espera o agente terminar e avisa a janela.
proc watchAgent(db: Address, session: Int): void {
	for ;; {
		if !pty.alive(session) {
			break
		}
		server.pause(300)
	}
	async db(model.Cmd.Post(model.Msg.AgentExited(session, pty.code(session))))
}

func agentSession(state: model.State, agent: Str): model.AgentSession {
	return agents.sessionOf(state.agents, agent)
}

// Guarda a sessão de um agente, no lugar da que ele tinha.
proc withAgent(state: mut model.State, session: model.AgentSession): void {
	mut model.AgentSession[dyn] all = []
	mut replaced := false
	for each s in state.agents.sessions {
		if s.agent == session.agent {
			append(all, session)
			replaced = true
		} else {
			append(all, s)
		}
	}
	if !replaced {
		append(all, session)
	}
	state.agents.sessions = all
}

// Abre o agente na pasta aberta: o programa do próprio usuário, num terminal de verdade.
proc launchAgent(state: mut model.State, agent: Str, from: Address): void {
	started := agents.start(state.settings, agent, state.root)
	if started is Result.Ok(session) {
		async watchAgent(from, session)
		withAgent(state, model.AgentSession(agent, session, false, 0, ""))
	} else if started is Result.Error(why) {
		withAgent(state, model.AgentSession(agent, 0, false, 0, why))
	}
}

func showingAgent(state: model.State): Bool {
	return state.panelOpen && state.pane == model.Pane.AgentPane()
}

// As mensagens do painel AGENTE; `false` quando a mensagem não é daqui.
proc updateAgents(state: mut model.State, message: model.Msg, from: Address): Bool {
	if message is model.Msg.ShowAgent(agent) {
		mut chosen := agent
		if !agents.isAgent(chosen) {
			chosen = state.agents.current
		}
		state.agents.current = chosen
		state.pane = model.Pane.AgentPane()
		state.panelOpen = true
		if agentSession(state, chosen).session == 0 {
			launchAgent(state, chosen, from)
		}
		withFocus(state, "agent")
	} else if message is model.Msg.AgentRestart(agent) {
		mut chosen := agent
		if !agents.isAgent(chosen) {
			chosen = state.agents.current
		}
		old := agentSession(state, chosen)
		if old.session != 0 {
			_stopped := pty.stop(old.session)
		}
		withAgent(state, model.AgentSession(chosen, 0, false, 0, ""))
		state.agents.current = chosen
		state.pane = model.Pane.AgentPane()
		state.panelOpen = true
		launchAgent(state, chosen, from)
		withFocus(state, "agent")
	} else if message is model.Msg.AgentExited(session, code) {
		for i := 0; i < len(state.agents.sessions) && session != 0; i++ {
			mut agent := ""
			if state.agents.sessions bounds i {
				if state.agents.sessions[i].session == session {
					agent = state.agents.sessions[i].agent
				}
			}
			if agent != "" {
				withAgent(state, model.AgentSession(agent, session, true, code, ""))
			}
		}
	} else if message is model.Msg.AgentCommand(agent, text) {
		mut prefs := state.settings
		if agent == "codex" {
			prefs.codexCommand = text
		} else if agent == "opencode" {
			prefs.opencodeCommand = text
		} else {
			prefs.claudeCommand = text
		}
		applySettings(state, prefs)
		// Um agente que não abriu tenta de novo com o comando novo.
		if agentSession(state, agent).session == 0 {
			withAgent(state, model.AgentSession(agent, 0, false, 0, ""))
		}
	} else {
		return false
	}
	return true
}

// ── o explorador pelo teclado ────────────────────────────────────────────

// A linha selecionada da árvore, ou -1.
func selectedRow(state: model.State): Int {
	for i := 0; i < len(state.tree); i++ {
		if state.tree[i].entry.path == state.selected {
			return i
		}
	}
	return -1
}

proc selectRow(state: mut model.State, index: Int): void {
	if state.tree bounds index {
		state.selected = state.tree[index].entry.path
	}
}

// Abre as pastas até `path` e o seleciona, para ele aparecer na árvore.
proc revealPath(state: mut model.State, path: Str): void {
	expandUp(state, workspace.normalize(state.root), workspace.parentOf(path), 0)
	state.selected = path
	reload(state)
}

// Expande `folder` e as pastas acima dele, até a raiz.
proc expandUp(state: mut model.State, root: Str, folder: Str, depth: Int): void {
	if depth >= 64 || !complete.startsWith(folder, root + "/") {
		return
	}
	if !workspace.isExpanded(state.expanded, folder) {
		append(state.expanded, folder)
	}
	expandUp(state, root, workspace.parentOf(folder), depth + 1)
}

// `:Ex` (e `:e .`): mostra o explorador com `target` — o arquivo atual quando
// vazio; uma pasta, aberta — selecionado, e põe o foco nele. `target` já vem
// resolvido (`resolvePath`).
proc focusExplorer(state: mut model.State, path: Str): void {
	state.sideOpen = true
	state.side = model.SideView.ExplorerSide()
	state.treeKeys = ""
	mut target := path
	if target == "" {
		target = render.activePath(state)
	}
	if target != "" && workspace.normalize(target) != workspace.normalize(state.root) {
		revealPath(state, target)
		if hive.file.list(target) is Result.Ok(_) && !workspace.isExpanded(state.expanded, target) {
			toggle(state, target)
		}
	} else if selectedRow(state) < 0 {
		selectRow(state, 0)
	}
	withFocus(state, "explorer")
}

// Uma tecla com o foco no explorador. Setas, Enter, Home e End sempre; com o
// modo Vim, também `j`, `k`, `h`, `l`, `o`, `gg`, `G`, contagens e `:`.
proc treeKey(state: mut model.State, key: Str): void {
	pending := state.treeKeys
	state.treeKeys = ""
	if key == "<Esc>" {
		if hasDoc(state) {
			withFocus(state, "editor")
		}
		return
	}
	if !(state.sideOpen && state.side == model.SideView.ExplorerSide()) {
		return
	}
	vimKeys := state.settings.vim
	waitingG := vim.endsWith(pending, "g")
	mut digits := pending
	if waitingG {
		digits = complete.take(pending, len(pending) - 1)
	}
	if vimKeys && !waitingG && vim.digitOf(key) >= 0 && (key != "0" || digits != "") {
		state.treeKeys = pending + key
		return
	}
	rows := len(state.tree)
	current := selectedRow(state)
	count := clampInt(numberOr(digits, 1), 1, 100000)
	hasCount := digits != ""
	mut row := model.TreeRow(model.Entry("", "", false), 0, false)
	if state.tree bounds current {
		row = state.tree[current]
	}
	if vimKeys && key == "g" {
		if !waitingG {
			state.treeKeys = pending + "g"
		} else if hasCount {
			selectRow(state, clampInt(count - 1, 0, rows - 1))
		} else {
			selectRow(state, 0)
		}
	} else if key == "<Down>" || (vimKeys && key == "j") {
		if current < 0 {
			selectRow(state, 0)
		} else {
			selectRow(state, clampInt(current + count, 0, rows - 1))
		}
	} else if key == "<Up>" || (vimKeys && key == "k") {
		if current < 0 {
			selectRow(state, 0)
		} else {
			selectRow(state, clampInt(current - count, 0, rows - 1))
		}
	} else if key == "<Home>" {
		selectRow(state, 0)
	} else if key == "<End>" || (vimKeys && key == "G") {
		if vimKeys && hasCount {
			selectRow(state, clampInt(count - 1, 0, rows - 1))
		} else {
			selectRow(state, rows - 1)
		}
	} else if key == "<CR>" || (vimKeys && key == "o") {
		if current < 0 {
			return
		} else if row.entry.folder {
			toggle(state, row.entry.path)
		} else {
			openDoc(state, row.entry.path)
			withFocus(state, "editor")
		}
	} else if key == "<Right>" || (vimKeys && key == "l") {
		if current < 0 {
			return
		} else if !row.entry.folder {
			openDoc(state, row.entry.path)
			withFocus(state, "editor")
			return
		} else if !row.open {
			toggle(state, row.entry.path)
			return
		}
		child := current + 1
		if state.tree bounds child {
			if state.tree[child].depth > row.depth {
				selectRow(state, child)
			}
		}
	} else if key == "<Left>" || (vimKeys && key == "h") {
		if current < 0 {
			return
		} else if row.entry.folder && row.open {
			toggle(state, row.entry.path)
			return
		}
		parent := workspace.parentOf(row.entry.path)
		for i := current - 1; i >= 0; i-- {
			if state.tree bounds i {
				if state.tree[i].entry.path == parent {
					selectRow(state, i)
					return
				}
			}
		}
	} else if key == "<F2>" {
		if current >= 0 && workspace.normalize(row.entry.path) != workspace.normalize(state.root) {
			state.prompt = model.Prompt.RenamePrompt(row.entry.path)
			state.promptText = row.entry.name
			withFocus(state, "prompt")
		}
	} else if key == "<Del>" {
		if current >= 0 && workspace.normalize(row.entry.path) != workspace.normalize(state.root) {
			state.removing = row.entry.path
		}
	} else if vimKeys && key == ":" {
		state.vim.prompt = ":"
		state.vim.command = ""
		state.vim.historyAt = len(state.vim.history)
		state.vim.promptFrom = "explorer"
		withFocus(state, "vimCommand")
	}
}

// ── a dobra ──────────────────────────────────────────────────────────────

// Painel, terminal, git e navegação: separados da dobra principal para cada
// proc continuar pequeno. `false` quando a mensagem não é daqui.
proc updateTools(state: mut model.State, message: model.Msg, from: Address): Bool {
	mut prefs := state.settings
	if message is model.Msg.TogglePanelMax {
		state.panelMax = !state.panelMax
		state.panelOpen = true
	} else if message is model.Msg.SetPanelHeight(height) {
		prefs.panelHeight = clampInt(height, 80, 4000)
		applySettings(state, prefs)
		state.panelMax = false
	} else if message is model.Msg.TermTyped(text) {
		state.term.input = text
	} else if message is model.Msg.TermSubmit(text) {
		ensureTerminal(state, from)
		if native.write(state.term.session, text + "\n") is Result.Error(why) {
			state.term.log = capLog(state.term.log + "\n[não foi possível escrever no terminal: " + why + "]\n")
		}
		if !server.isWindows() {
			state.term.log = capLog(state.term.log + text + "\n")
		}
		mut Str[dyn] history = state.term.history
		if text != "" {
			append(history, text)
		}
		state.term.history = history
		state.term.historyAt = len(history)
		state.term.input = ""
	} else if message is model.Msg.TermHistory(delta) {
		count := len(state.term.history)
		at := clampInt(state.term.historyAt + delta, 0, count)
		state.term.historyAt = at
		state.term.input = ""
		if state.term.history bounds at {
			state.term.input = state.term.history[at]
		}
	} else if message is model.Msg.TermRestart {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		state.term.session = 0
		state.term.log = capLog(state.term.log + "^C\n")
		ensureTerminal(state, from)
		withFocus(state, "termInput")
	} else if message is model.Msg.TermClear {
		state.term.log = ""
	} else if message is model.Msg.TermOutput(session, text) {
		if session == state.term.session {
			state.term.log = capLog(state.term.log + text)
		}
	} else if message is model.Msg.TermExited(session, code) {
		if session == state.term.session {
			state.term.log = capLog(state.term.log + "\n[terminal encerrado, código {code}]\n")
			state.term.session = 0
		}
		reload(state)
		gitRefresh(state)
	} else if message is model.Msg.GitPoll || message is model.Msg.GitRefresh {
		gitRefresh(state)
	} else if message is model.Msg.DiskPoll {
		refreshFromDisk(state)
		refreshTree(state)
	} else if message is model.Msg.GitStage(path) {
		afterGit(state, git.stage(state.git, path))
	} else if message is model.Msg.GitUnstage(path) {
		afterGit(state, git.unstage(state.git, path))
	} else if message is model.Msg.GitStageAll {
		afterGit(state, git.stageAll(state.git))
	} else if message is model.Msg.GitUnstageAll {
		afterGit(state, git.unstageAll(state.git))
	} else if message is model.Msg.GitAskDiscard(path) {
		state.git.confirm = path
	} else if message is model.Msg.GitCancelConfirm {
		state.git.confirm = ""
	} else if message is model.Msg.GitDiscard(path) {
		mut rel := ""
		for each file in state.git.files {
			if file.path == path {
				rel = file.rel
			}
		}
		state.git.confirm = ""
		afterGit(state, git.discard(state.git, path))
		reloadDocsOf(state, rel)
	} else if message is model.Msg.GitMessageTyped(text) {
		state.git.message = text
	} else if message is model.Msg.GitCommit {
		if state.git.message == "" || state.git.busy != "" || len(state.git.files) == 0 {
			return true
		}
		if state.settings.saveBeforeRun {
			saveAll(state)
		}
		state.git.busy = "commit"
		top := state.git.top
		text := state.git.message
		nothingStaged := git.count(state.git, true) == 0
		async git.commitAsync(from, top, text, nothingStaged)
	} else if message is model.Msg.GitPush {
		if state.git.busy != "" || !state.git.repo {
			return true
		}
		state.git.busy = "push"
		Str[dyn] arguments = ["push", "-u", "origin", "HEAD"]
		top := state.git.top
		async git.runAsync(from, top, "push", arguments)
	} else if message is model.Msg.GitPull {
		if state.git.busy != "" || !state.git.repo {
			return true
		}
		state.git.busy = "pull"
		Str[dyn] arguments = ["pull", "--ff-only"]
		top := state.git.top
		async git.runAsync(from, top, "pull", arguments)
	} else if message is model.Msg.GitInit {
		afterGit(state, process.run("git", ["init"], state.root))
	} else if message is model.Msg.GitDone(command, output, ok) {
		state.git.busy = ""
		state.output = state.output + "$ git " + command + "\n" + output
		if ok {
			state.status = "git {command}: ok"
			if command == "commit" {
				state.git.message = ""
			}
		} else {
			state.status = "git {command} " + render.tx(state, "falhou — veja SAÍDA")
			state.pane = model.Pane.OutputPane()
			state.panelOpen = true
		}
		reload(state)
		gitRefresh(state)
	} else if message is model.Msg.GitShow(hash) {
		shown := git.show(state.git, hash)
		if shown is Result.Ok(commit) {
			mut title := commit.subject
			if len(title) > 40 {
				title = complete.take(title, 40) + "…"
			}
			state.commit = model.CommitTab(commit.hash, commit.short + " " + title, render.commitPage(commit, state.words))
			state.editorView = model.EditorView.CommitPage()
			state.status = "commit {commit.short}"
		} else if shown is Result.Error(why) {
			state.status = "git: " + why
		}
	} else if message is model.Msg.GitShowWork(path) {
		commit := git.working(state.git, path)
		state.commit = model.CommitTab("work:" + path, "± " + workspace.baseName(path), render.commitPage(commit, state.words))
		state.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.FocusCommit {
		state.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.CloseCommit {
		state.commit = model.CommitTab("", "", "")
		state.editorView = model.EditorView.DocView()
	} else if message is model.Msg.FindOpen(text) {
		state.find.open = true
		if text != "" && indexOf(text, "\n") is Result.Error(_) {
			state.find.text = text
		}
		state.find.index = firstMatchFrom(state, state.caret)
		state.find.serial = state.find.serial + 1
		withFocus(state, "find")
	} else if message is model.Msg.FindTyped(text) {
		state.find.text = text
		state.find.index = firstMatchFrom(state, state.caret)
		state.find.serial = state.find.serial + 1
	} else if message is model.Msg.FindNext || message is model.Msg.FindPrev {
		count := matchCount(state)
		if count > 0 {
			mut delta := 1
			if message is model.Msg.FindPrev {
				delta = -1
			}
			state.find.index = ((state.find.index + delta) % count + count) % count
			state.find.serial = state.find.serial + 1
		}
	} else if message is model.Msg.FindToggleCase {
		state.find.caseSensitive = !state.find.caseSensitive
		state.find.index = firstMatchFrom(state, state.caret)
		state.find.serial = state.find.serial + 1
	} else if message is model.Msg.FindClose {
		state.find.open = false
		withFocus(state, "editor")
	} else if message is model.Msg.SearchTyped(text) {
		state.search.text = text
	} else if message is model.Msg.SearchRun || message is model.Msg.SearchToggleCase {
		if message is model.Msg.SearchToggleCase {
			state.search.caseSensitive = !state.search.caseSensitive
		}
		if state.search.text == "" {
			return true
		}
		found := search.searchProject(state.root, state.search.text, state.search.caseSensitive, state.settings.showHidden, 2000)
		state.search.hits = found.hits
		state.search.files = found.files
		state.search.truncated = found.truncated
		state.search.done = true
		state.sideOpen = true
		state.side = model.SideView.SearchSide()
	} else if message is model.Msg.OpenAt(path, line, column) {
		jumpTo(state, path, line, column)
	} else if message is model.Msg.PaletteOpen {
		state.palette = model.Palette(true, "", 0, search.allFiles(state.root, state.settings.showHidden, 20000))
		withFocus(state, "palette")
	} else if message is model.Msg.PaletteTyped(text) {
		state.palette.text = text
		state.palette.index = 0
	} else if message is model.Msg.PaletteMove(delta) {
		count := paletteCount(state)
		if count > 0 {
			state.palette.index = ((state.palette.index + delta) % count + count) % count
		}
	} else if message is model.Msg.PaletteAccept(chosen) {
		mut index := chosen
		if index < 0 {
			index = state.palette.index
		}
		picked := paletteChoice(state, index)
		state.palette = model.emptyPalette()
		if picked != "" {
			openDoc(state, workspace.joinPath(state.root, picked))
		} else {
			withFocus(state, "editor")
		}
	} else if message is model.Msg.PaletteClose {
		state.palette = model.emptyPalette()
		withFocus(state, "editor")
	} else if message is model.Msg.PickFolder {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		title := render.tx(state, "Abrir pasta")
		async dialogs.pickAsync(from, "folder", start, title)
	} else if message is model.Msg.PickFile {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		title := render.tx(state, "Abrir arquivo…")
		async dialogs.pickAsync(from, "file", start, title)
	} else if message is model.Msg.Picked(mode, path) {
		if mode == "file" {
			openDoc(state, path)
			return true
		}
		// Uma pasta nova: as abas limpas da anterior fecham, as sujas ficam.
		mut model.Doc[dyn] kept = []
		for each doc in state.docs {
			if model.dirty(doc) {
				append(kept, doc)
			}
		}
		state.docs = kept
		state.active = len(kept) - 1
		state.entrypoint = ""
		state.commit = model.CommitTab("", "", "")
		state.editorView = model.EditorView.DocView()
		state.sideOpen = true
		state.side = model.SideView.ExplorerSide()
		openRoot(state, path)
	} else if message is model.Msg.PickFailed(mode, reason) {
		state.status = render.tx(state, "Nenhum seletor de pastas disponível — digite o caminho.")
		if mode == "folder" {
			state.prompt = model.Prompt.OpenFolderPrompt()
			state.promptText = state.root
			state.sideOpen = true
			state.side = model.SideView.ExplorerSide()
			withFocus(state, "prompt")
		}
	} else if message is model.Msg.SetLanguage(code) {
		prefs.language = code
		applySettings(state, prefs)
		state.words = i18n.words(code)
		state.status = i18n.tr(state.words, "idioma") + ": " + code
	} else if message is model.Msg.ShowAbout {
		state.about = true
	} else if message is model.Msg.CloseAbout {
		state.about = false
	} else if message is model.Msg.OpenDocs {
		async dialogs.openUrl("https://hive-lang.run")
	} else if message is model.Msg.Quit {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		for each agent in state.agents.sessions {
			if agent.session != 0 {
				_ended := pty.stop(agent.session)
			}
		}
		async quitSoon()
	} else if message is model.Msg.GotoDefinition(caret) {
		if hasDoc(state) {
			path := render.activePath(state)
			located := navigate.locate(path, activeText(state), caret)
			if located is Result.Ok(target) {
				if workspace.tidy(target.file) != workspace.tidy(path) {
					openDoc(state, workspace.tidy(target.file))
				}
				state.caret = navigate.offsetOf(activeText(state), target.line, target.column)
				state.textSerial = state.textSerial + 1
				state.status = render.tx(state, "definição") + ": {workspace.baseName(target.file)}:{target.line}"
				clearSuggestions(state)
			} else if located is Result.Error(why) {
				state.status = why
			}
		}
	} else {
		return false
	}
	return true
}

proc update(state: mut model.State, message: model.Msg, from: Address): void {
	if updateTools(state, message, from) || updateVim(state, message, from) || updateAgents(state, message, from) {
		return
	}
	mut prefs := state.settings
	if message is model.Msg.Toggle(path) {
		toggle(state, path)
	} else if message is model.Msg.Open(path) {
		openDoc(state, path)
	} else if message is model.Msg.Refresh {
		reload(state)
	} else if message is model.Msg.CollapseAll {
		Str[dyn] closed = []
		state.expanded = closed
		reload(state)
	} else if message is model.Msg.GoUp {
		openRoot(state, workspace.parentOf(state.root))
	} else if message is model.Msg.StartPrompt(prompt) {
		state.prompt = prompt
		state.promptText = ""
		state.sideOpen = true
		state.side = model.SideView.ExplorerSide()
		if prompt is model.Prompt.OpenFolderPrompt {
			state.promptText = state.root
		} else if prompt is model.Prompt.RenamePrompt(path) {
			state.promptText = workspace.baseName(path)
		}
		withFocus(state, "prompt")
	} else if message is model.Msg.PromptTyped(text) {
		state.promptText = text
	} else if message is model.Msg.PromptSubmit(text) {
		asked := state.prompt
		mut typed := text
		if typed == "" {
			typed = state.promptText
		}
		state.prompt = model.Prompt.NoPrompt()
		state.promptText = ""
		if asked is model.Prompt.NewFilePrompt {
			create(state, typed, false)
		} else if asked is model.Prompt.NewFolderPrompt {
			create(state, typed, true)
		} else if asked is model.Prompt.OpenFolderPrompt {
			openRoot(state, typed)
		} else if asked is model.Prompt.RenamePrompt(path) {
			renamePath(state, path, typed)
		}
	} else if message is model.Msg.PromptCancel {
		state.prompt = model.Prompt.NoPrompt()
		state.promptText = ""
	} else if message is model.Msg.Focus(index) {
		state.active = index
		state.editorView = model.EditorView.DocView()
		if hasDoc(state) {
			state.selected = render.activePath(state)
		}
	} else if message is model.Msg.CloseDoc(index) {
		// Com alterações por salvar, o diálogo pergunta antes.
		mut unsaved := ""
		if state.docs bounds index {
			if model.dirty(state.docs[index]) {
				unsaved = state.docs[index].path
			}
		}
		if unsaved != "" {
			state.closing = unsaved
		} else {
			closeDoc(state, index)
		}
	} else if message is model.Msg.CloseDocNow(index) {
		closeDoc(state, index)
	} else if message is model.Msg.CloseSave(path) {
		state.closing = ""
		index := docIndex(state, path)
		if state.docs bounds index {
			failure := saveDoc(state.docs[index])
			if failure == "" {
				closeDoc(state, index)
				gitRefresh(state)
			} else {
				state.status = failure
			}
		}
	} else if message is model.Msg.CloseDiscard(path) {
		state.closing = ""
		closeDoc(state, docIndex(state, path))
	} else if message is model.Msg.AskRemove(path) {
		if path != "" && workspace.normalize(path) != workspace.normalize(state.root) {
			state.removing = path
		}
	} else if message is model.Msg.Remove(path) {
		removePath(state, path)
	} else if message is model.Msg.CancelDialog {
		state.closing = ""
		state.removing = ""
	} else if message is model.Msg.OpenContext(path, x, y) {
		state.context = model.ContextMenu(path, x, y)
		state.selected = path
	} else if message is model.Msg.CloseContext {
		state.context = model.ContextMenu("", 0, 0)
	} else if message is model.Msg.ContextPick(action, path) {
		state.context = model.ContextMenu("", 0, 0)
		contextAction(state, action, path, from)
	} else if message is model.Msg.CycleTab(step) {
		count := len(state.docs)
		if count > 0 {
			state.active = ((state.active + step) % count + count) % count
			state.editorView = model.EditorView.DocView()
		}
	} else if message is model.Msg.EditAt(text, caret) {
		before := model.Snapshot(activeText(state), state.caret)
		withText(state, text)
		state.caret = caret
		if state.settings.vim && state.vim.mode != model.VimMode.InsertMode() {
			// Colar (ou arrastar texto) fora do modo de inserção também se desfaz com `u`.
			withUndo(state, before)
			state.vim.mode = model.VimMode.NormalMode()
			return
		}
		autoSuggest(state)
	} else if message is model.Msg.CaretAt(caret) {
		state.caret = caret
	} else if message is model.Msg.SuggestAt(caret) {
		state.caret = caret
		state.suggestions = complete.suggest(activeText(state), caret, 12)
		state.suggestIndex = 0
	} else if message is model.Msg.PopupKey(key) {
		count := len(state.suggestions)
		if key == "ArrowDown" && count > 0 {
			state.suggestIndex = (state.suggestIndex + 1) % count
		} else if key == "ArrowUp" && count > 0 {
			state.suggestIndex = (state.suggestIndex - 1 + count) % count
		} else if key == "Enter" || key == "Tab" {
			acceptSuggestion(state, state.suggestIndex)
		} else {
			clearSuggestions(state)
		}
	} else if message is model.Msg.AcceptSuggestion(index) {
		acceptSuggestion(state, index)
	} else if message is model.Msg.CloseSuggest {
		clearSuggestions(state)
	} else if message is model.Msg.Save {
		index := state.active
		if state.docs bounds index {
			name := state.docs[index].name
			failure := saveDoc(state.docs[index])
			if failure == "" {
				state.status = render.tx(state, "salvo") + " {name}"
			} else {
				state.status = failure
			}
		}
		gitRefresh(state)
	} else if message is model.Msg.SaveAll {
		saveAll(state)
		gitRefresh(state)
	} else if message is model.Msg.PinEntry {
		if hasDoc(state) {
			state.entrypoint = render.activePath(state)
			state.status = render.tx(state, "entrada") + ": " + activeName(state)
		}
	} else if message is model.Msg.SetMode(mode) {
		index := state.active
		if state.docs bounds index {
			state.docs[index].mode = mode
		}
	} else if message is model.Msg.TogglePreview {
		if hasDoc(state) {
			if model.hasPreview(render.activePath(state)) {
				mut mode := "preview"
				if activeMode(state) != "edit" {
					mode = "edit"
				}
				update(state, model.Msg.SetMode(mode), from)
			}
		}
	} else if message is model.Msg.Invoke(command) {
		target := render.targetOf(state)
		if target == "" || state.running != "" {
			return
		}
		if state.settings.saveBeforeRun {
			saveAll(state)
		}
		state.running = command
		state.output = "$ hivec {command} {target}\n"
		state.pane = model.Pane.OutputPane()
		state.panelOpen = true
		state.status = "{command} {workspace.baseName(target)}…"
		compiler := state.settings.compiler
		async toolchain.invoke(from, compiler, command, target)
	} else if message is model.Msg.Finished(command, output, ok) {
		found := located(state, analysis.parseDiagnostics(output))
		state.running = ""
		state.output = state.output + output
		state.diagnostics = found
		state.status = summary(state, command, ok, len(found))
		if command == "analyze" && ok {
			withAnalysis(state, output)
		}
		if len(found) > 0 {
			state.pane = model.Pane.ProblemsPane()
			state.panelOpen = true
		}
	} else if message is model.Msg.LensDue(n) {
		if n == state.lensDue {
			refreshView(state, from)
			if state.todoScanned {
				if hasDoc(state) {
					state.todos = todo.withTodosOf(state.todos, render.activePath(state), activeText(state))
				}
			}
			if state.settings.errorLens && render.targetOf(state) != "" {
				if state.lensRunning {
					state.lensAgain = true
				} else {
					startLens(state, from)
				}
			}
		}
	} else if message is model.Msg.LensDone(output) {
		state.lensRunning = false
		if state.settings.errorLens && state.running == "" {
			state.diagnostics = located(state, analysis.parseDiagnostics(output))
		}
		if state.lensAgain {
			startLens(state, from)
		}
	} else if message is model.Msg.OpenReport {
		if state.analysisReport != "" && hive.file.exists(state.analysisReport) {
			report := state.analysisReport
			async dialogs.openUrl(report)
		}
	} else if message is model.Msg.ShowPane(pane) {
		state.pane = pane
		state.panelOpen = true
		if pane is model.Pane.TerminalPane {
			ensureTerminal(state, from)
			withFocus(state, "termInput")
		}
	} else if message is model.Msg.TogglePanel {
		state.panelOpen = !state.panelOpen
	} else if message is model.Msg.ShowSide(side) {
		if state.sideOpen && state.side == side {
			state.sideOpen = false
		} else {
			state.sideOpen = true
			state.side = side
			if side is model.SideView.TodoSide {
				scanTodos(state, from)
			}
		}
	} else if message is model.Msg.ViewReady(path, version, view, problem) {
		state.viewPending = ""
		withView(state, path, version, Rendered(view, problem))
	} else if message is model.Msg.ScanTodos {
		scanTodos(state, from)
	} else if message is model.Msg.TodosFound(found) {
		state.todos = found
		// A busca leu o disco: os documentos com alterações por salvar entram
		// com o texto do editor.
		for i := 0; i < len(state.docs); i++ {
			if state.docs bounds i {
				if model.dirty(state.docs[i]) {
					state.todos = todo.withTodosOf(state.todos, state.docs[i].path, state.docs[i].text)
				}
			}
		}
		state.todoScanned = true
		state.todoScanning = false
	} else if message is model.Msg.ToggleSidebar {
		state.sideOpen = !state.sideOpen
	} else if message is model.Msg.OpenSettings {
		state.settingsOpen = true
		state.editorView = model.EditorView.SettingsView()
	} else if message is model.Msg.CloseSettings {
		state.settingsOpen = false
		state.editorView = model.EditorView.DocView()
	} else if message is model.Msg.SetTheme(name) {
		prefs.theme = name
		applySettings(state, prefs)
		state.status = render.tx(state, "tema") + ": {name}"
	} else if message is model.Msg.ToggleSetting(name) {
		toggleSetting(state, name)
	} else if message is model.Msg.SetFontSize(size) {
		prefs.fontSize = clampInt(size, 10, 28)
		applySettings(state, prefs)
	} else if message is model.Msg.SetTabSize(size) {
		prefs.tabSize = clampInt(size, 1, 8)
		applySettings(state, prefs)
	} else if message is model.Msg.CompilerTyped(text) {
		prefs.compiler = text
		applySettings(state, prefs)
	} else if message is model.Msg.BrowserTyped(text) {
		prefs.browser = text
		applySettings(state, prefs)
	} else if message is model.Msg.StartRecording(action) {
		state.recording = action
	} else if message is model.Msg.CancelRecording {
		state.recording = ""
	} else if message is model.Msg.KeyPressed(combo) {
		recorded := state.recording
		state.recording = ""
		if combo != "Escape" && recorded != "" {
			prefs.keymap = keys.assign(prefs.keymap, recorded, combo)
			applySettings(state, prefs)
			state.status = render.tx(state, "atalho gravado") + ": {combo}"
		}
	} else if message is model.Msg.ResetKey(action) {
		prefs.keymap = keys.reset(prefs.keymap, action)
		applySettings(state, prefs)
	} else if message is model.Msg.ResetKeys {
		prefs.keymap = ""
		applySettings(state, prefs)
		state.status = render.tx(state, "atalhos restaurados")
	} else if message is model.Msg.Peek(file, line) {
		peekAt(state, file, line)
	} else if message is model.Msg.ClosePeek {
		state.peekFile = ""
	} else if message is model.Msg.ClearOutput {
		state.output = ""
		model.Diagnostic[dyn] cleared = []
		state.diagnostics = cleared
	} else if message is model.Msg.Connected {
		state.clients = state.clients + 1
	} else if message is model.Msg.Disconnected {
		state.clients = state.clients - 1
	}
}

// Um passo da dobra. Quando o documento ativo muda, a página precisa receber
// o texto novo: é o `textSerial` que avisa.
proc step(state: mut model.State, message: model.Msg, from: Address): void {
	// O que precisa ser comparado depois: só isto, e não o estado inteiro.
	wasPath := render.activePath(state)
	wasText := activeText(state)
	wasRoot := state.root
	wasExpanded := join(state.expanded, "\n")
	wasDocs := len(state.docs)
	wasScanned := state.todoScanned
	update(state, message, from)
	jumping := message is model.Msg.GotoDefinition(_) || message is model.Msg.OpenAt(_, _, _)
	otherDoc := render.activePath(state) != wasPath
	if otherDoc {
		state.textSerial = state.textSerial + 1
		if !jumping {
			state.caret = 0
		}
		clearSuggestions(state)
		vim.reset(state.vim)
	}
	// Outra pasta, uma pasta aberta ou fechada na árvore, um arquivo aberto ou
	// fechado: as pastas vigiadas acompanham.
	if state.root != wasRoot || join(state.expanded, "\n") != wasExpanded || len(state.docs) != wasDocs {
		watchFolders(state)
	}
	// Outra pasta (ou o ⟳ do explorador) procura os TODO de novo; salvar só
	// atualiza os dos documentos abertos, que o editor já tem.
	if wasScanned && (state.root != wasRoot || message is model.Msg.Refresh) {
		scanTodos(state, from)
	} else if wasScanned && (message is model.Msg.Save || message is model.Msg.SaveAll) {
		for i := 0; i < len(state.docs); i++ {
			if state.docs bounds i {
				state.todos = todo.withTodosOf(state.todos, state.docs[i].path, state.docs[i].text)
			}
		}
	}
	// Outro documento, ou outro modo de ver: a visualização é refeita na hora.
	if otherDoc || message is model.Msg.SetMode(_) || message is model.Msg.TogglePreview {
		refreshView(state, from)
	}
	// O Error Lens confere de novo quando o texto à vista muda ou outro arquivo aparece.
	if otherDoc || activeText(state) != wasText {
		lensSoon(state, from)
	}
}

// ── da página para uma mensagem ──────────────────────────────────────────

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

func promptFor(arg: Str): model.Prompt {
	if arg == "newFolder" {
		return model.Prompt.NewFolderPrompt()
	} else if arg == "openFolder" {
		return model.Prompt.OpenFolderPrompt()
	}
	return model.Prompt.NewFilePrompt()
}

proc actionMsg(state: mut model.State, action: Str, caret: Int): Result<model.Msg, Bool> {
	if action == "newFile" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFilePrompt()))
	} else if action == "newFolder" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFolderPrompt()))
	} else if action == "save" {
		return Result.Ok(model.Msg.Save())
	} else if action == "saveAll" {
		return Result.Ok(model.Msg.SaveAll())
	} else if action == "deleteFile" {
		return Result.Ok(model.Msg.AskRemove(render.removable(state)))
	} else if action == "closeTab" {
		if render.showingCommit(state) {
			return Result.Ok(model.Msg.CloseCommit())
		}
		if render.showingSettings(state) {
			return Result.Ok(model.Msg.CloseSettings())
		}
		return Result.Ok(model.Msg.CloseDoc(state.active))
	} else if action == "nextTab" {
		return Result.Ok(model.Msg.CycleTab(1))
	} else if action == "prevTab" {
		return Result.Ok(model.Msg.CycleTab(-1))
	} else if action == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if action == "toggleSidebar" {
		return Result.Ok(model.Msg.ToggleSidebar())
	} else if action == "explorer" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if action == "outline" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
	} else if action == "todo" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.TodoSide()))
	} else if action == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "suggest" {
		return Result.Ok(model.Msg.SuggestAt(caret))
	} else if action == "preview" {
		return Result.Ok(model.Msg.TogglePreview())
	} else if action == "check" || action == "run" || action == "test" || action == "build" || action == "analyze" {
		return Result.Ok(model.Msg.Invoke(action))
	} else if action == "terminal" {
		if state.panelOpen && state.pane == model.Pane.TerminalPane() {
			return Result.Ok(model.Msg.TogglePanel())
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.TerminalPane()))
	} else if action == "maximizePanel" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if action == "git" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
	} else if action == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(caret))
	} else if action == "searchProject" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.SearchSide()))
	} else if action == "quickOpen" {
		return Result.Ok(model.Msg.PaletteOpen())
	} else if action == "find" {
		return Result.Ok(model.Msg.FindOpen(""))
	} else if action == "openFolder" {
		return Result.Ok(model.Msg.PickFolder())
	} else if action == "openFile" {
		return Result.Ok(model.Msg.PickFile())
	} else if action == "quit" {
		return Result.Ok(model.Msg.Quit())
	} else if action == "about" {
		return Result.Ok(model.Msg.ShowAbout())
	} else if action == "docs" {
		return Result.Ok(model.Msg.OpenDocs())
	} else if action == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if action == "problems" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
	} else if action == "output" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if action == "colorTheme" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "newTerminal" || action == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if action == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	} else if action == "toggleVim" {
		return Result.Ok(model.Msg.ToggleSetting("vim"))
	} else if action == "agent" {
		if showingAgent(state) {
			return Result.Ok(model.Msg.TogglePanel())
		}
		return Result.Ok(model.Msg.ShowAgent(state.agents.current))
	} else if action == "agentClaude" {
		return Result.Ok(model.Msg.ShowAgent("claude"))
	} else if action == "agentCodex" {
		return Result.Ok(model.Msg.ShowAgent("codex"))
	} else if action == "agentOpencode" {
		return Result.Ok(model.Msg.ShowAgent("opencode"))
	} else if action == "agentRestart" {
		return Result.Ok(model.Msg.AgentRestart(state.agents.current))
	}
	return Result.Error(false)
}

// O que o Esc fecha, do mais de cima para o mais de baixo ("" = nada).
func escapeKind(state: model.State): Str {
	if state.context.path != "" {
		return "context"
	} else if state.vim.prompt != "" {
		return "vimCancel"
	} else if state.recording != "" {
		return "recording"
	} else if state.about {
		return "about"
	} else if state.palette.open {
		return "palette"
	} else if state.closing != "" || state.removing != "" {
		return "dialog"
	} else if state.git.confirm != "" {
		return "confirm"
	} else if state.peekFile != "" {
		return "peek"
	} else if len(state.suggestions) > 0 {
		return "suggest"
	} else if !(state.prompt == model.Prompt.NoPrompt()) {
		return "prompt"
	} else if state.find.open {
		return "find"
	}
	return ""
}

func escapeFor(kind: Str): Result<model.Msg, Bool> {
	if kind == "vimCancel" {
		return Result.Ok(model.Msg.VimCancel())
	} else if kind == "recording" {
		return Result.Ok(model.Msg.CancelRecording())
	} else if kind == "about" {
		return Result.Ok(model.Msg.CloseAbout())
	} else if kind == "palette" {
		return Result.Ok(model.Msg.PaletteClose())
	} else if kind == "dialog" {
		return Result.Ok(model.Msg.CancelDialog())
	} else if kind == "context" {
		return Result.Ok(model.Msg.CloseContext())
	} else if kind == "confirm" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if kind == "peek" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if kind == "suggest" {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if kind == "prompt" {
		return Result.Ok(model.Msg.PromptCancel())
	} else if kind == "find" {
		return Result.Ok(model.Msg.FindClose())
	}
	return Result.Error(false)
}

func escapeMsg(state: model.State): Result<model.Msg, Bool> {
	return escapeFor(escapeKind(state))
}

proc clickMsg(state: mut model.State, event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	arg := event.arg
	if a == "toggle" {
		return Result.Ok(model.Msg.Toggle(arg))
	} else if a == "open" {
		return Result.Ok(model.Msg.Open(arg))
	} else if a == "refresh" {
		return Result.Ok(model.Msg.Refresh())
	} else if a == "collapse" {
		return Result.Ok(model.Msg.CollapseAll())
	} else if a == "up" {
		return Result.Ok(model.Msg.GoUp())
	} else if a == "prompt" {
		return Result.Ok(model.Msg.StartPrompt(promptFor(arg)))
	} else if a == "promptSubmit" {
		return Result.Ok(model.Msg.PromptSubmit(event.text))
	} else if a == "promptCancel" {
		return Result.Ok(model.Msg.PromptCancel())
	} else if a == "focus" {
		return Result.Ok(model.Msg.Focus(numberOr(arg, state.active)))
	} else if a == "close" {
		return Result.Ok(model.Msg.CloseDoc(numberOr(arg, -1)))
	} else if a == "invoke" {
		return Result.Ok(model.Msg.Invoke(arg))
	} else if a == "side" {
		if arg == "outline" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
		} else if arg == "todo" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.TodoSide()))
		} else if arg == "git" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
		} else if arg == "search" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.SearchSide()))
		}
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if a == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(event.caret))
	} else if a == "findNext" {
		return Result.Ok(model.Msg.FindNext())
	} else if a == "findPrev" {
		return Result.Ok(model.Msg.FindPrev())
	} else if a == "findClose" {
		return Result.Ok(model.Msg.FindClose())
	} else if a == "findCase" {
		return Result.Ok(model.Msg.FindToggleCase())
	} else if a == "searchRun" {
		return Result.Ok(model.Msg.SearchRun())
	} else if a == "searchCase" {
		return Result.Ok(model.Msg.SearchToggleCase())
	} else if a == "openAt" {
		if event.text is "{line}:{column}" {
			return Result.Ok(model.Msg.OpenAt(arg, numberOr(line, 1), numberOr(column, 0)))
		}
		return Result.Ok(model.Msg.OpenAt(arg, 1, 0))
	} else if a == "paletteAccept" {
		return Result.Ok(model.Msg.PaletteAccept(numberOr(arg, -1)))
	} else if a == "paletteMove" {
		return Result.Ok(model.Msg.PaletteMove(numberOr(arg, 1)))
	} else if a == "action" {
		return actionMsg(state, arg, event.caret)
	} else if a == "closeAbout" {
		return Result.Ok(model.Msg.CloseAbout())
	} else if a == "panelMax" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if a == "termSubmit" {
		return Result.Ok(model.Msg.TermSubmit(event.text))
	} else if a == "termHistory" {
		return Result.Ok(model.Msg.TermHistory(numberOr(arg, 0)))
	} else if a == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if a == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	} else if a == "gitRefresh" {
		return Result.Ok(model.Msg.GitRefresh())
	} else if a == "gitStage" {
		return Result.Ok(model.Msg.GitStage(arg))
	} else if a == "gitUnstage" {
		return Result.Ok(model.Msg.GitUnstage(arg))
	} else if a == "gitStageAll" {
		return Result.Ok(model.Msg.GitStageAll())
	} else if a == "gitUnstageAll" {
		return Result.Ok(model.Msg.GitUnstageAll())
	} else if a == "gitAskDiscard" {
		return Result.Ok(model.Msg.GitAskDiscard(arg))
	} else if a == "gitDiscard" {
		return Result.Ok(model.Msg.GitDiscard(arg))
	} else if a == "gitCancel" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if a == "askRemove" {
		return Result.Ok(model.Msg.AskRemove(arg))
	} else if a == "remove" {
		return Result.Ok(model.Msg.Remove(arg))
	} else if a == "closeSave" {
		return Result.Ok(model.Msg.CloseSave(arg))
	} else if a == "closeDiscard" {
		return Result.Ok(model.Msg.CloseDiscard(arg))
	} else if a == "cancelDialog" {
		return Result.Ok(model.Msg.CancelDialog())
	} else if a == "context" {
		if event.text is "{x},{y}" {
			return Result.Ok(model.Msg.OpenContext(arg, numberOr(x, 0), numberOr(y, 0)))
		}
		return Result.Ok(model.Msg.OpenContext(arg, 0, 0))
	} else if a == "closeContext" {
		return Result.Ok(model.Msg.CloseContext())
	} else if a == "ctx" {
		return Result.Ok(model.Msg.ContextPick(arg, event.text))
	} else if a == "gitCommit" {
		return Result.Ok(model.Msg.GitCommit())
	} else if a == "gitPush" {
		return Result.Ok(model.Msg.GitPush())
	} else if a == "gitPull" {
		return Result.Ok(model.Msg.GitPull())
	} else if a == "gitInit" {
		return Result.Ok(model.Msg.GitInit())
	} else if a == "gitShow" {
		return Result.Ok(model.Msg.GitShow(arg))
	} else if a == "gitShowWork" {
		return Result.Ok(model.Msg.GitShowWork(arg))
	} else if a == "focusCommit" {
		return Result.Ok(model.Msg.FocusCommit())
	} else if a == "closeCommit" {
		return Result.Ok(model.Msg.CloseCommit())
	} else if a == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if a == "closeSettings" {
		return Result.Ok(model.Msg.CloseSettings())
	} else if a == "pane" {
		if arg == "problems" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
		} else if arg == "analysis" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.AnalysisPane()))
		} else if arg == "terminal" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.TerminalPane()))
		} else if arg == "agent" {
			return Result.Ok(model.Msg.ShowAgent(state.agents.current))
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if a == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if a == "clear" {
		return Result.Ok(model.Msg.ClearOutput())
	} else if a == "todoRefresh" {
		return Result.Ok(model.Msg.ScanTodos())
	} else if a == "openReport" {
		return Result.Ok(model.Msg.OpenReport())
	} else if a == "peek" {
		return Result.Ok(model.Msg.Peek(arg, numberOr(event.text, 1)))
	} else if a == "closePeek" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if a == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if a == "mode" {
		return Result.Ok(model.Msg.SetMode(arg))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(arg))
	} else if a == "setting" {
		return Result.Ok(model.Msg.ToggleSetting(arg))
	} else if a == "record" {
		return Result.Ok(model.Msg.StartRecording(arg))
	} else if a == "resetKey" {
		return Result.Ok(model.Msg.ResetKey(arg))
	} else if a == "resetKeys" {
		return Result.Ok(model.Msg.ResetKeys())
	} else if a == "accept" {
		return Result.Ok(model.Msg.AcceptSuggestion(numberOr(arg, 0)))
	} else if a == "closeSuggest" {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if a == "escape" {
		return escapeFor(escapeKind(state))
	} else if a == "agent" {
		return Result.Ok(model.Msg.ShowAgent(arg))
	} else if a == "agentRestart" {
		return Result.Ok(model.Msg.AgentRestart(arg))
	} else if a == "vimSubmit" {
		return Result.Ok(model.Msg.VimSubmit(event.text))
	} else if a == "vimCancel" {
		return Result.Ok(model.Msg.VimCancel())
	} else if a == "vimHistory" {
		return Result.Ok(model.Msg.VimHistory(numberOr(arg, 0)))
	}
	return Result.Error(false)
}

func fieldMsg(event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	if a == "prompt" {
		return Result.Ok(model.Msg.PromptTyped(event.text))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(event.text))
	} else if a == "fontSize" {
		return Result.Ok(model.Msg.SetFontSize(numberOr(event.text, 14)))
	} else if a == "tabSize" {
		return Result.Ok(model.Msg.SetTabSize(numberOr(event.text, 4)))
	} else if a == "compiler" {
		return Result.Ok(model.Msg.CompilerTyped(event.text))
	} else if a == "browser" {
		return Result.Ok(model.Msg.BrowserTyped(event.text))
	} else if a == "termInput" {
		return Result.Ok(model.Msg.TermTyped(event.text))
	} else if a == "gitMessage" {
		return Result.Ok(model.Msg.GitMessageTyped(event.text))
	} else if a == "find" {
		return Result.Ok(model.Msg.FindTyped(event.text))
	} else if a == "searchText" {
		return Result.Ok(model.Msg.SearchTyped(event.text))
	} else if a == "palette" {
		return Result.Ok(model.Msg.PaletteTyped(event.text))
	} else if a == "language" {
		return Result.Ok(model.Msg.SetLanguage(event.text))
	} else if a == "panelHeight" {
		return Result.Ok(model.Msg.SetPanelHeight(numberOr(event.text, 260)))
	} else if a == "vimCommand" {
		return Result.Ok(model.Msg.VimTyped(event.text))
	} else if a == "claudeCommand" {
		return Result.Ok(model.Msg.AgentCommand("claude", event.text))
	} else if a == "codexCommand" {
		return Result.Ok(model.Msg.AgentCommand("codex", event.text))
	} else if a == "opencodeCommand" {
		return Result.Ok(model.Msg.AgentCommand("opencode", event.text))
	}
	return Result.Error(false)
}

proc toMsg(state: mut model.State, event: model.Event): Result<model.Msg, Bool> {
	if event.kind == "edit" && event.at >= 0 {
		// Só a diferença: vale se foi feita sobre o texto que o programa tem.
		if event.seen != state.textSerial {
			return Result.Error(false)
		}
		text := activeText(state)
		return Result.Ok(model.Msg.EditAt(native.splice(text, event.at, event.cut, event.arg), event.caret))
	} else if event.kind == "edit" {
		return Result.Ok(model.Msg.EditAt(event.text, event.caret))
	} else if event.kind == "popup" {
		return Result.Ok(model.Msg.PopupKey(event.text))
	} else if event.kind == "key" {
		if state.recording != "" {
			return Result.Ok(model.Msg.KeyPressed(event.text))
		}
		if keys.actionFor(state.settings.keymap, event.text) is Result.Ok(action) {
			if action == "find" {
				return Result.Ok(model.Msg.FindOpen(event.arg))
			}
			return actionMsg(state, action, event.caret)
		}
	} else if event.kind == "field" {
		return fieldMsg(event)
	} else if event.kind == "act" {
		return clickMsg(state, event)
	} else if event.kind == "vim" {
		return Result.Ok(model.Msg.VimKey(event.text, event.caret, event.arg))
	} else if event.kind == "vimMouse" {
		return Result.Ok(model.Msg.VimMouse(event.caret, numberOr(event.arg, event.caret)))
	} else if event.kind == "tree" {
		return Result.Ok(model.Msg.TreeKey(event.text))
	}
	return Result.Error(false)
}

// ── o serviço ────────────────────────────────────────────────────────────

// Um turno do serviço: o estado é escrito no lugar, e o que o turno devolve é
// a resposta de quem perguntou. `from` é o endereço do próprio serviço, para o
// trabalho que ele começa em outra thread mandar o resultado de volta.
proc serve(state: mut model.State, command: model.Cmd, from: Address): model.Cmd {
	if command is model.Cmd.Ui(text) {
		decoded := model.Event.decode(text, hive.json.codec())
		if decoded is Result.Ok(hovered) {
			if hovered.kind == "hover" {
				mut ok := false
				if hasDoc(state) {
					ok = navigate.locate(render.activePath(state), activeText(state), hovered.caret) is Result.Ok(_)
				}
				return model.Cmd.Reply(encode(model.HoverReply(true, hovered.caret, ok), hive.json.codec()))
			}
		}
		if decoded is Result.Ok(event) {
			if event.kind == "resync" || event.kind == "hello" {
				resynced(state)
			} else if toMsg(state, event) is Result.Ok(message) {
				step(state, message, from)
			}
		}
		return reply(state)
	} else if command is model.Cmd.Post(message) {
		// As checagens periódicas (git, arquivos no disco) só redesenham quando algo mudou.
		quiet := message is model.Msg.GitPoll || message is model.Msg.DiskPoll || message is model.Msg.LensDue(_)
		if !quiet {
			step(state, message, from)
			state.pulse = state.pulse + 1
			return command
		}
		wasGit := encode(state.git, hive.json.codec())
		wasTree := encode(state.tree, hive.json.codec())
		wasSerial := state.textSerial
		wasStatus := state.status
		wasDocs := docsMark(state)
		step(state, message, from)
		if encode(state.git, hive.json.codec()) != wasGit || state.textSerial != wasSerial || state.status != wasStatus ||
			encode(state.tree, hive.json.codec()) != wasTree || docsMark(state) != wasDocs {
			state.pulse = state.pulse + 1
		}
		return command
	} else if command is model.Cmd.Render {
		return reply(state)
	} else if command is model.Cmd.Pulse {
		return model.Cmd.PulseIs(state.pulse)
	} else if command is model.Cmd.Clients {
		return model.Cmd.ClientsAre(state.clients)
	}
	return command
}

// O que muda num documento quando o disco o muda (versão do texto, apagado),
// sem comparar os textos inteiros.
func docsMark(state: model.State): Str {
	mut Str[dyn] parts = []
	for each doc in state.docs {
		append(parts, doc.path + "#{doc.version}#{doc.gone}")
	}
	return join(parts, "|")
}

// Manda o frame de agora e lembra o que a página passou a ter: o próximo frame
// só leva o texto e o realce se eles mudarem.
proc reply(state: mut model.State): model.Cmd {
	frame := render.encodeFrame(state)
	delivered(state)
	return model.Cmd.Reply(frame)
}

proc delivered(state: mut model.State): void {
	index := state.active
	mut version := -1
	mut path := ""
	if state.docs bounds index {
		version = state.docs[index].version
		path = state.docs[index].path
	}
	state.clientSerial = state.textSerial
	state.frameSeq = state.frameSeq + 1
	state.clientHv = version
	state.clientHvPath = path
	state.clientView = render.previewKey(state)
}

// A página se perdeu (um frame chegou fora de ordem, outra janela…): o
// próximo frame leva o texto e o realce inteiros.
proc resynced(state: mut model.State): void {
	state.clientSerial = -1
	state.clientHv = -1
	state.clientHvPath = ""
	state.clientView = ""
}

// Sai do programa pouco depois, dando tempo para a página fechar a janela.
proc quitSoon(): void {
	hive.task.sleep(300)
	hive.term.exit(0)
}

// Relê o git de tempos em tempos, para mudanças feitas fora do Hive Studio.
proc watchGit(db: Address): void {
	for ;; {
		server.pause(4000)
		async db(model.Cmd.Post(model.Msg.GitPoll()))
	}
}

func fallbackView(url: Str): hive.ui.View {
	return ui.column([ui.gap(12), ui.pad(32)], [
		ui.text([ui.size(ui.TextSize.Title())], "⬡ Hive Studio"),
		ui.text([], "Nenhum navegador Chromium (Edge, Chrome, Brave) foi encontrado para abrir a janela."),
		ui.link([], url, "Abrir o Hive Studio aqui"),
		ui.text([ui.tone(ui.Tone.Muted())], "Ou indique o executável em Configurações → Navegador da janela.")
	])
}

proc fallbackUpdate(url: mut Str, message: model.Msg): model.Msg {
	return message
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	prefs := settings.load()
	mut start := model.initial(folder, prefs)
	openRoot(start, folder)
	watchFolders(start)
	spawned := spawn(serve, start)
	if spawned is Result.Ok(db) {
		open(db, prefs)
	} else if spawned is Result.Error(why) {
		panic "o serviço do Hive Studio não começou: " + why.message
	}
}

// A página, o WebSocket e a janela, ligados ao serviço do estado em `db`.
proc open(db: Address, prefs: settings.Settings): void {
	token := hive.crypto.randomHex(16)
	port := server.freePort()
	async hive.net.httpServe(port, server.page(token, port + 1, _))
	async hive.net.wsServe(port + 1, server.client(db, token, _))
	hive.task.sleep(150)

	url := "http://127.0.0.1:{port}/?token={token}"
	browser := server.launch(url, settings.folder() + "/janela", prefs.browser)
	if browser == "" {
		// Sem Chromium conhecido: a janela do próprio hive.ui (que cai numa aba
		// do navegador padrão) mostra o endereço da IDE.
		_fallback := spawn(ui.window("Hive Studio", fallbackView, fallbackUpdate), url)
	}
	hive.term.status("Hive Studio em {url} ({browser})")
	async watchGit(db)
	async watchDocs(db)
	for ;; {
		server.pause(60000)
	}
}
