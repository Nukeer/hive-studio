// Hive Studio — uma IDE simples para Hive, escrita em Hive.
//
//     hivec run studio.hive [pasta]
//
// O estado mora num serviço (`serve`, uma dobra sobre a caixa de mensagens).
// A página, numa janela Chromium em modo aplicativo, manda eventos pelo
// WebSocket e recebe de volta o frame já desenhado — ver lib/server.hive.

import hive.ui
import ./lib/model
import ./lib/workspace
import ./lib/analysis
import ./lib/toolchain
import ./lib/render
import ./lib/settings
import ./lib/highlight
import ./lib/complete
import ./lib/keys
import ./lib/server
import ./lib/git
import ./lib/navigate
import ./lib/process
import ./lib/native.go
import ./lib/dialogs
import ./lib/i18n

// ── explorador ───────────────────────────────────────────────────────────

proc reload(state: model.State): model.State {
	mut next := state
	next.tree = workspace.buildTree(state.root, 0, state.expanded, state.settings.showHidden)
	return next
}

proc gitRefresh(state: model.State): model.State {
	mut next := state
	next.git = git.refresh(state.root, state.git)
	return next
}

// Pede para a página focar um campo (`prompt`, `termInput`…) no próximo frame.
func withFocus(state: model.State, target: Str): model.State {
	mut next := state
	next.focus = target
	next.focusSerial = state.focusSerial + 1
	return next
}

// ── terminal ─────────────────────────────────────────────────────────────

// Lê o shell aos pedaços e entrega à janela até ele terminar.
proc watchTerminal(db: hive.syslink.Address, session: Int): void {
	for ;; {
		text := native.read(session)
		if text != "" {
			async db(model.Cmd.Post(model.Msg.TermOutput(session, text)))
		}
		if !native.alive(session) {
			rest := native.read(session)
			if rest != "" {
				async db(model.Cmd.Post(model.Msg.TermOutput(session, rest)))
			}
			async db(model.Cmd.Post(model.Msg.TermExited(session, native.code(session))))
			return
		}
		hive.task.sleep(40)
	}
}

// Abre o shell se ainda não houver um vivo.
proc ensureTerminal(state: model.State, from: hive.syslink.Envelope): model.State {
	mut next := state
	if state.term.session != 0 && native.alive(state.term.session) {
		return next
	}
	started := native.start(state.root)
	if started is Result.Ok(session) {
		next.term.session = session
		async watchTerminal(hive.syslink.self(from), session)
	} else if started is Result.Error(why) {
		next.term.log = state.term.log + "não foi possível abrir o terminal: " + why + "\n"
	}
	return next
}

// Quanto do terminal fica guardado. É uma função e não um literal de
// propósito: `len(text) > 200000` com `len(text) - 150000` logo depois faz o
// hivec 0.2.8 travar na prova de limites.
func logLimit(): Int {
	return 200 * 1000
}

// O log do terminal guarda só o fim quando fica grande demais.
func capLog(text: Str): Str {
	size := len(text)
	limit := logLimit()
	if size > limit {
		return complete.skip(text, size - limit / 4 * 3)
	}
	return text
}

// ── git ──────────────────────────────────────────────────────────────────

// Relê do disco os documentos abertos de um arquivo que o git mudou.
proc reloadDocsOf(state: model.State, rel: Str): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	for i := 0; i < len(docs); i++ {
		doc := docs[i]
		if render.relPath(state, doc.path) == rel {
			if hive.file.read(doc.path) is Result.Ok(raw) {
				text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
				mut fresh := doc
				fresh.text = text
				fresh.saved = text
				fresh.html = highlightFor(doc.path, text)
				docs[i] = fresh
			}
		}
	}
	next.docs = docs
	next.textSerial = state.textSerial + 1
	return next
}

proc afterGit(state: model.State, outcome: process.Output): model.State {
	mut next := gitRefresh(reload(state))
	if outcome.code != 0 {
		next.status = "git: " + process.firstLine(outcome.text)
		next.output = state.output + outcome.text
	}
	return next
}

proc openRoot(state: model.State, folder: Str): model.State {
	mut next := state
	target := workspace.normalize(folder)
	if hive.file.list(target) is Result.Error(why) {
		next.status = render.tx(state, "não foi possível abrir") + " {target}: {why.message}"
		return next
	}
	Str[dyn] closed = []
	next.root = target
	next.expanded = closed
	next.selected = ""
	next.status = render.tx(state, "pasta") + " {workspace.baseName(target)}"
	return gitRefresh(reload(next))
}

func isNot(candidate: Str, path: Str): Bool {
	return candidate != path
}

proc toggle(state: model.State, path: Str): model.State {
	mut next := state
	if workspace.isExpanded(state.expanded, path) {
		next.expanded = filter(state.expanded, isNot(_, path))
	} else {
		mut Str[dyn] expanded = state.expanded
		append(expanded, path)
		next.expanded = expanded
	}
	next.selected = path
	return reload(next)
}

// Onde um arquivo novo vai: a pasta selecionada, a pasta do arquivo
// selecionado, ou a raiz.
func targetFolder(state: model.State): Str {
	if state.selected == "" {
		return state.root
	}
	for each row in state.tree {
		if row.entry.path == state.selected {
			if row.entry.folder {
				return row.entry.path
			}
			return workspace.parentOf(row.entry.path)
		}
	}
	return state.root
}

// ── documentos ───────────────────────────────────────────────────────────

func highlightFor(path: Str, text: Str): Str {
	if path is "{stem}.hive" || path is "{stem}.go" {
		return highlight.highlight(text)
	}
	return highlight.escape(text)
}

func findDoc(docs: model.Doc[], path: Str): Result<Int, Bool> {
	for i := 0; i < len(docs); i++ {
		if docs[i].path == path {
			return Result.Ok(i)
		}
	}
	return Result.Error(false)
}

proc openDoc(state: model.State, path: Str): model.State {
	mut next := state
	next.selected = path
	next.editorView = model.EditorView.DocView()
	if findDoc(state.docs, path) is Result.Ok(index) {
		next.active = index
		return next
	}
	read := hive.file.read(path)
	if read is Result.Ok(raw) {
		mut eol := "\n"
		if indexOf(raw, "\r\n") is Result.Ok(_) {
			eol = "\r\n"
		}
		text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
		mut mode := "edit"
		if model.isMarkdown(path) {
			mode = "preview"
		}
		mut model.Doc[dyn] docs = state.docs
		append(docs, model.Doc(path, workspace.baseName(path), text, text, eol, highlightFor(path, text), mode))
		next.docs = docs
		next.active = len(docs) - 1
		next.status = render.tx(state, "aberto") + " {workspace.baseName(path)}"
	} else if read is Result.Error(why) {
		next.status = render.tx(state, "não foi possível ler") + " {path}: {why.message}"
	}
	return next
}

proc saveDoc(doc: model.Doc): Result<model.Doc, Str> {
	mut contents := doc.text
	if doc.eol == "\r\n" {
		contents = replaceAll(doc.text, "\n", "\r\n")
	}
	if hive.file.write(doc.path, contents) is Result.Error(why) {
		return Result.Error("não foi possível salvar {doc.name}: {why.message}")
	}
	mut saved := doc
	saved.saved = doc.text
	return Result.Ok(saved)
}

proc saveAll(state: model.State): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	mut count := 0
	for i := 0; i < len(docs); i++ {
		if model.dirty(docs[i]) {
			outcome := saveDoc(docs[i])
			if outcome is Result.Ok(doc) {
				docs[i] = doc
				count++
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
	}
	next.docs = docs
	if count > 0 {
		next.status = "{count} " + render.tx(state, "arquivo(s) salvo(s)")
	}
	return next
}

proc create(state: model.State, name: Str, folder: Bool): model.State {
	mut next := state
	if name == "" {
		return next
	}
	base := targetFolder(state)
	path := workspace.joinPath(base, name)
	if hive.file.exists(path) {
		next.status = "{name} " + render.tx(state, "já existe")
		return next
	}
	if folder {
		if hive.file.makeDir(path) is Result.Error(why) {
			next.status = "não foi possível criar {path}: {why.message}"
			return next
		}
	} else if hive.file.write(path, "") is Result.Error(why) {
		next.status = "não foi possível criar {path}: {why.message}"
		return next
	}
	if base != state.root && !workspace.isExpanded(state.expanded, base) {
		mut Str[dyn] expanded = state.expanded
		append(expanded, base)
		next.expanded = expanded
	}
	next = reload(next)
	next.selected = path
	if folder {
		return next
	}
	return openDoc(next, path)
}

proc closeDoc(state: model.State, index: Int): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		drop(docs, index, index)
		next.docs = docs
		if state.active >= index && state.active > 0 {
			next.active = state.active - 1
		}
		if len(docs) == 0 {
			next.active = -1
		}
	}
	return next
}

proc peekAt(state: model.State, file: Str, line: Int): model.State {
	mut next := state
	if findDoc(state.docs, file) is Result.Ok(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if state.docs bounds index {
			next.peekText = state.docs[index].text
		}
	} else {
		read := hive.file.read(file)
		if read is Result.Ok(text) {
			next = openDoc(state, file)
			next.peekText = replaceAll(text, "\r", "")
		} else if read is Result.Error(why) {
			next.status = render.tx(state, "não foi possível ler") + " {file}: {why.message}"
			return next
		}
	}
	next.peekFile = file
	next.peekLine = line
	return next
}

// Troca o texto do documento ativo (e o realce guardado dele).
proc withText(state: model.State, text: Str): model.State {
	mut next := state
	index := state.active
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		mut doc := docs[index]
		doc.text = text
		doc.html = highlightFor(doc.path, text)
		docs[index] = doc
	}
	next.docs = docs
	return next
}

func activeText(state: model.State): Str {
	if render.activeDoc(state) is Result.Ok(doc) {
		return doc.text
	}
	return ""
}

func clearSuggestions(state: model.State): model.State {
	mut next := state
	model.Suggestion[dyn] none = []
	next.suggestions = none
	next.suggestIndex = 0
	return next
}

// Sugere só enquanto um nome está sendo digitado, ou logo depois de um ponto.
func autoSuggest(state: model.State): model.State {
	mut next := clearSuggestions(state)
	if !state.settings.autocomplete {
		return next
	}
	text := activeText(state)
	ctx := complete.context(text, state.caret)
	if ctx.prefix != "" || ctx.qualifier != "" {
		next.suggestions = complete.suggest(text, state.caret, 12)
	}
	return next
}

proc acceptSuggestion(state: model.State, index: Int): model.State {
	if state.suggestions bounds index {
		word := state.suggestions[index].word
		edit := complete.accept(activeText(state), state.caret, word)
		mut next := withText(state, edit.text)
		next.caret = edit.caret
		next.textSerial = state.textSerial + 1
		return clearSuggestions(next)
	}
	return clearSuggestions(state)
}

// ── configurações ────────────────────────────────────────────────────────

proc applySettings(state: model.State, prefs: settings.Settings): model.State {
	mut next := state
	next.settings = prefs
	if settings.save(prefs) is Result.Error(why) {
		next.status = "não foi possível salvar as configurações: {why}"
	}
	return next
}

proc toggleSetting(state: model.State, name: Str): model.State {
	mut prefs := state.settings
	if name == "lineNumbers" {
		prefs.lineNumbers = !prefs.lineNumbers
	} else if name == "showHidden" {
		prefs.showHidden = !prefs.showHidden
	} else if name == "saveBeforeRun" {
		prefs.saveBeforeRun = !prefs.saveBeforeRun
	} else if name == "autocomplete" {
		prefs.autocomplete = !prefs.autocomplete
	}
	next := applySettings(state, prefs)
	if name == "showHidden" {
		return reload(next)
	}
	return next
}

func summary(state: model.State, command: Str, ok: Bool, problems: Int): Str {
	if ok {
		return "{command}: ok"
	}
	if problems > 0 {
		return "{command}: {problems} " + render.tx(state, "problema(s)")
	}
	return "{command}: " + render.tx(state, "falhou")
}

func clampInt(value: Int, low: Int, high: Int): Int {
	if value < low {
		return low
	}
	if value > high {
		return high
	}
	return value
}

// ── a dobra ──────────────────────────────────────────────────────────────

// Painel, terminal, git e navegação: separados da dobra principal para cada
// proc continuar pequeno. `Error` quando a mensagem não é daqui.
proc updateTools(state: model.State, message: model.Msg, from: hive.syslink.Envelope): Result<model.State, Bool> {
	mut next := state
	mut prefs := state.settings
	if message is model.Msg.TogglePanelMax {
		next.panelMax = !state.panelMax
		next.panelOpen = true
	} else if message is model.Msg.SetPanelHeight(height) {
		prefs.panelHeight = clampInt(height, 80, 4000)
		next = applySettings(state, prefs)
		next.panelMax = false
	} else if message is model.Msg.TermTyped(text) {
		next.term.input = text
	} else if message is model.Msg.TermSubmit(text) {
		next = ensureTerminal(state, from)
		if native.write(next.term.session, text + "\n") is Result.Error(why) {
			next.term.log = capLog(next.term.log + "\n[não foi possível escrever no terminal: " + why + "]\n")
		}
		if !server.isWindows() {
			next.term.log = capLog(next.term.log + text + "\n")
		}
		mut Str[dyn] history = state.term.history
		if text != "" {
			append(history, text)
		}
		next.term.history = history
		next.term.historyAt = len(history)
		next.term.input = ""
	} else if message is model.Msg.TermHistory(delta) {
		count := len(state.term.history)
		at := clampInt(state.term.historyAt + delta, 0, count)
		next.term.historyAt = at
		next.term.input = ""
		if state.term.history bounds at {
			next.term.input = state.term.history[at]
		}
	} else if message is model.Msg.TermRestart {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		next.term.session = 0
		next.term.log = capLog(state.term.log + "^C\n")
		return Result.Ok(withFocus(ensureTerminal(next, from), "termInput"))
	} else if message is model.Msg.TermClear {
		next.term.log = ""
	} else if message is model.Msg.TermOutput(session, text) {
		if session == state.term.session {
			next.term.log = capLog(state.term.log + text)
		}
	} else if message is model.Msg.TermExited(session, code) {
		if session == state.term.session {
			next.term.log = capLog(state.term.log + "\n[terminal encerrado, código {code}]\n")
			next.term.session = 0
		}
		return Result.Ok(gitRefresh(reload(next)))
	} else if message is model.Msg.GitPoll || message is model.Msg.GitRefresh {
		return Result.Ok(gitRefresh(next))
	} else if message is model.Msg.GitStage(path) {
		return Result.Ok(afterGit(state, git.stage(state.git, path)))
	} else if message is model.Msg.GitUnstage(path) {
		return Result.Ok(afterGit(state, git.unstage(state.git, path)))
	} else if message is model.Msg.GitStageAll {
		return Result.Ok(afterGit(state, git.stageAll(state.git)))
	} else if message is model.Msg.GitUnstageAll {
		return Result.Ok(afterGit(state, git.unstageAll(state.git)))
	} else if message is model.Msg.GitAskDiscard(path) {
		next.git.confirm = path
	} else if message is model.Msg.GitCancelConfirm {
		next.git.confirm = ""
	} else if message is model.Msg.GitDiscard(path) {
		mut rel := ""
		for each file in state.git.files {
			if file.path == path {
				rel = file.rel
			}
		}
		next.git.confirm = ""
		next = afterGit(next, git.discard(state.git, path))
		return Result.Ok(reloadDocsOf(next, rel))
	} else if message is model.Msg.GitMessageTyped(text) {
		next.git.message = text
	} else if message is model.Msg.GitCommit {
		if state.git.message == "" || state.git.busy != "" || len(state.git.files) == 0 {
			return Result.Ok(state)
		}
		if state.settings.saveBeforeRun {
			next = saveAll(state)
		}
		next.git.busy = "commit"
		async git.commitAsync(hive.syslink.self(from), state.git.top, state.git.message, git.count(state.git, true) == 0)
	} else if message is model.Msg.GitPush {
		if state.git.busy != "" || !state.git.repo {
			return Result.Ok(state)
		}
		next.git.busy = "push"
		Str[dyn] arguments = ["push", "-u", "origin", "HEAD"]
		async git.runAsync(hive.syslink.self(from), state.git.top, "push", arguments)
	} else if message is model.Msg.GitPull {
		if state.git.busy != "" || !state.git.repo {
			return Result.Ok(state)
		}
		next.git.busy = "pull"
		Str[dyn] arguments = ["pull", "--ff-only"]
		async git.runAsync(hive.syslink.self(from), state.git.top, "pull", arguments)
	} else if message is model.Msg.GitInit {
		return Result.Ok(afterGit(state, process.run("git", ["init"], state.root)))
	} else if message is model.Msg.GitDone(command, output, ok) {
		next.git.busy = ""
		next.output = state.output + "$ git " + command + "\n" + output
		if ok {
			next.status = "git {command}: ok"
			if command == "commit" {
				next.git.message = ""
			}
		} else {
			next.status = "git {command} " + render.tx(state, "falhou — veja SAÍDA")
			next.pane = model.Pane.OutputPane()
			next.panelOpen = true
		}
		return Result.Ok(gitRefresh(reload(next)))
	} else if message is model.Msg.GitShow(hash) {
		shown := git.show(state.git, hash)
		if shown is Result.Ok(commit) {
			mut title := commit.subject
			if len(title) > 40 {
				title = complete.take(title, 40) + "…"
			}
			next.commit = model.CommitTab(commit.hash, commit.short + " " + title, render.commitPage(commit, state.words))
			next.editorView = model.EditorView.CommitPage()
			next.status = "commit {commit.short}"
		} else if shown is Result.Error(why) {
			next.status = "git: " + why
		}
	} else if message is model.Msg.GitShowWork(path) {
		commit := git.working(state.git, path)
		next.commit = model.CommitTab("work:" + path, "± " + workspace.baseName(path), render.commitPage(commit, state.words))
		next.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.FocusCommit {
		next.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.CloseCommit {
		next.commit = model.CommitTab("", "", "")
		next.editorView = model.EditorView.DocView()
	} else if message is model.Msg.PickFolder {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		async dialogs.pickAsync(hive.syslink.self(from), "folder", start, render.tx(state, "Abrir pasta"))
	} else if message is model.Msg.PickFile {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		async dialogs.pickAsync(hive.syslink.self(from), "file", start, render.tx(state, "Abrir arquivo…"))
	} else if message is model.Msg.Picked(mode, path) {
		if mode == "file" {
			return Result.Ok(openDoc(state, path))
		}
		// Uma pasta nova: as abas limpas da anterior fecham, as sujas ficam.
		mut model.Doc[dyn] kept = []
		for each doc in state.docs {
			if model.dirty(doc) {
				append(kept, doc)
			}
		}
		next.docs = kept
		next.active = len(kept) - 1
		next.entrypoint = ""
		next.commit = model.CommitTab("", "", "")
		next.editorView = model.EditorView.DocView()
		next.sideOpen = true
		next.side = model.SideView.ExplorerSide()
		return Result.Ok(openRoot(next, path))
	} else if message is model.Msg.PickFailed(mode, reason) {
		next.status = render.tx(state, "Nenhum seletor de pastas disponível — digite o caminho.")
		if mode == "folder" {
			next.prompt = model.Prompt.OpenFolderPrompt()
			next.promptText = state.root
			next.sideOpen = true
			next.side = model.SideView.ExplorerSide()
			return Result.Ok(withFocus(next, "prompt"))
		}
	} else if message is model.Msg.SetLanguage(code) {
		prefs.language = code
		next = applySettings(state, prefs)
		next.words = i18n.words(code)
		next.status = i18n.tr(next.words, "idioma") + ": " + code
	} else if message is model.Msg.ShowAbout {
		next.about = true
	} else if message is model.Msg.CloseAbout {
		next.about = false
	} else if message is model.Msg.OpenDocs {
		async dialogs.openUrl("https://hive-lang.run")
	} else if message is model.Msg.Quit {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		async quitSoon()
	} else if message is model.Msg.GotoDefinition(caret) {
		if render.activeDoc(state) is Result.Ok(doc) {
			located := navigate.locate(doc.path, doc.text, caret)
			if located is Result.Ok(target) {
				mut jumped := state
				if workspace.tidy(target.file) != workspace.tidy(doc.path) {
					jumped = openDoc(state, workspace.tidy(target.file))
				}
				jumped.caret = navigate.offsetOf(activeText(jumped), target.line, target.column)
				jumped.textSerial = jumped.textSerial + 1
				jumped.status = render.tx(state, "definição") + ": {workspace.baseName(target.file)}:{target.line}"
				return Result.Ok(clearSuggestions(jumped))
			} else if located is Result.Error(why) {
				next.status = why
			}
		}
	} else {
		return Result.Error(false)
	}
	return Result.Ok(next)
}

proc update(state: model.State, message: model.Msg, from: hive.syslink.Envelope): model.State {
	mut next := state
	mut prefs := state.settings
	if updateTools(state, message, from) is Result.Ok(done) {
		return done
	}
	if message is model.Msg.Toggle(path) {
		return toggle(state, path)
	} else if message is model.Msg.Open(path) {
		return openDoc(state, path)
	} else if message is model.Msg.Refresh {
		return reload(state)
	} else if message is model.Msg.CollapseAll {
		Str[dyn] closed = []
		next.expanded = closed
		return reload(next)
	} else if message is model.Msg.GoUp {
		return openRoot(state, workspace.parentOf(state.root))
	} else if message is model.Msg.StartPrompt(prompt) {
		next.prompt = prompt
		next.promptText = ""
		next.sideOpen = true
		next.side = model.SideView.ExplorerSide()
		if prompt is model.Prompt.OpenFolderPrompt {
			next.promptText = state.root
		}
		return withFocus(next, "prompt")
	} else if message is model.Msg.PromptTyped(text) {
		next.promptText = text
	} else if message is model.Msg.PromptSubmit(text) {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
		mut typed := text
		if typed == "" {
			typed = state.promptText
		}
		if state.prompt is model.Prompt.NewFilePrompt {
			return create(next, typed, false)
		} else if state.prompt is model.Prompt.NewFolderPrompt {
			return create(next, typed, true)
		} else if state.prompt is model.Prompt.OpenFolderPrompt {
			return openRoot(next, typed)
		}
	} else if message is model.Msg.PromptCancel {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
	} else if message is model.Msg.Focus(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if render.activeDoc(next) is Result.Ok(doc) {
			next.selected = doc.path
		}
	} else if message is model.Msg.CloseDoc(index) {
		return closeDoc(state, index)
	} else if message is model.Msg.CycleTab(step) {
		count := len(state.docs)
		if count > 0 {
			next.active = ((state.active + step) % count + count) % count
			next.editorView = model.EditorView.DocView()
		}
	} else if message is model.Msg.EditAt(text, caret) {
		next = withText(state, text)
		next.caret = caret
		return autoSuggest(next)
	} else if message is model.Msg.CaretAt(caret) {
		next.caret = caret
	} else if message is model.Msg.SuggestAt(caret) {
		next.caret = caret
		next.suggestions = complete.suggest(activeText(state), caret, 12)
		next.suggestIndex = 0
	} else if message is model.Msg.PopupKey(key) {
		count := len(state.suggestions)
		if key == "ArrowDown" && count > 0 {
			next.suggestIndex = (state.suggestIndex + 1) % count
		} else if key == "ArrowUp" && count > 0 {
			next.suggestIndex = (state.suggestIndex - 1 + count) % count
		} else if key == "Enter" || key == "Tab" {
			return acceptSuggestion(state, state.suggestIndex)
		} else {
			return clearSuggestions(state)
		}
	} else if message is model.Msg.AcceptSuggestion(index) {
		return acceptSuggestion(state, index)
	} else if message is model.Msg.CloseSuggest {
		return clearSuggestions(state)
	} else if message is model.Msg.Save {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			outcome := saveDoc(docs[index])
			if outcome is Result.Ok(doc) {
				docs[index] = doc
				next.status = render.tx(state, "salvo") + " {doc.name}"
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
		next.docs = docs
		return gitRefresh(next)
	} else if message is model.Msg.SaveAll {
		return gitRefresh(saveAll(state))
	} else if message is model.Msg.PinEntry {
		if render.activeDoc(state) is Result.Ok(doc) {
			next.entrypoint = doc.path
			next.status = render.tx(state, "entrada") + ": {doc.name}"
		}
	} else if message is model.Msg.SetMode(mode) {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			docs[index].mode = mode
		}
		next.docs = docs
	} else if message is model.Msg.TogglePreview {
		if render.activeDoc(state) is Result.Ok(doc) {
			if model.isMarkdown(doc.path) {
				mut mode := "preview"
				if doc.mode != "edit" {
					mode = "edit"
				}
				return update(state, model.Msg.SetMode(mode), from)
			}
		}
	} else if message is model.Msg.Invoke(command) {
		target := render.targetOf(state)
		if target == "" || state.running != "" {
			return state
		}
		if state.settings.saveBeforeRun {
			next = saveAll(state)
		}
		next.running = command
		next.output = "$ hivec {command} {target}\n"
		next.pane = model.Pane.OutputPane()
		next.panelOpen = true
		next.status = "{command} {workspace.baseName(target)}…"
		async toolchain.invoke(hive.syslink.self(from), state.settings.compiler, command, target)
	} else if message is model.Msg.Finished(command, output, ok) {
		found := analysis.parseDiagnostics(output)
		next.running = ""
		next.output = state.output + output
		next.diagnostics = found
		next.status = summary(state, command, ok, len(found))
		if len(found) > 0 {
			next.pane = model.Pane.ProblemsPane()
			next.panelOpen = true
		}
	} else if message is model.Msg.ShowPane(pane) {
		next.pane = pane
		next.panelOpen = true
		if pane is model.Pane.TerminalPane {
			return withFocus(ensureTerminal(next, from), "termInput")
		}
	} else if message is model.Msg.TogglePanel {
		next.panelOpen = !state.panelOpen
	} else if message is model.Msg.ShowSide(side) {
		if state.sideOpen && state.side == side {
			next.sideOpen = false
		} else {
			next.sideOpen = true
			next.side = side
		}
	} else if message is model.Msg.ToggleSidebar {
		next.sideOpen = !state.sideOpen
	} else if message is model.Msg.OpenSettings {
		next.settingsOpen = true
		next.editorView = model.EditorView.SettingsView()
	} else if message is model.Msg.CloseSettings {
		next.settingsOpen = false
		next.editorView = model.EditorView.DocView()
	} else if message is model.Msg.SetTheme(name) {
		prefs.theme = name
		next = applySettings(state, prefs)
		next.status = render.tx(state, "tema") + ": {name}"
	} else if message is model.Msg.ToggleSetting(name) {
		return toggleSetting(state, name)
	} else if message is model.Msg.SetFontSize(size) {
		prefs.fontSize = clampInt(size, 10, 28)
		return applySettings(state, prefs)
	} else if message is model.Msg.SetTabSize(size) {
		prefs.tabSize = clampInt(size, 1, 8)
		return applySettings(state, prefs)
	} else if message is model.Msg.CompilerTyped(text) {
		prefs.compiler = text
		return applySettings(state, prefs)
	} else if message is model.Msg.BrowserTyped(text) {
		prefs.browser = text
		return applySettings(state, prefs)
	} else if message is model.Msg.StartRecording(action) {
		next.recording = action
	} else if message is model.Msg.CancelRecording {
		next.recording = ""
	} else if message is model.Msg.KeyPressed(combo) {
		next.recording = ""
		if combo != "Escape" && state.recording != "" {
			prefs.keymap = keys.assign(prefs.keymap, state.recording, combo)
			next = applySettings(next, prefs)
			next.status = render.tx(state, "atalho gravado") + ": {combo}"
		}
	} else if message is model.Msg.ResetKey(action) {
		prefs.keymap = keys.reset(prefs.keymap, action)
		return applySettings(state, prefs)
	} else if message is model.Msg.ResetKeys {
		prefs.keymap = ""
		next = applySettings(state, prefs)
		next.status = render.tx(state, "atalhos restaurados")
	} else if message is model.Msg.Peek(file, line) {
		return peekAt(state, file, line)
	} else if message is model.Msg.ClosePeek {
		next.peekFile = ""
	} else if message is model.Msg.ClearOutput {
		next.output = ""
		model.Diagnostic[dyn] cleared = []
		next.diagnostics = cleared
	} else if message is model.Msg.Connected {
		next.clients = state.clients + 1
	} else if message is model.Msg.Disconnected {
		next.clients = state.clients - 1
	}
	return next
}

// Um passo da dobra. Quando o documento ativo muda, a página precisa receber
// o texto novo: é o `textSerial` que avisa.
proc step(state: model.State, message: model.Msg, from: hive.syslink.Envelope): model.State {
	mut next := update(state, message, from)
	jumping := message is model.Msg.GotoDefinition(_)
	if render.activePath(next) != render.activePath(state) {
		next.textSerial = next.textSerial + 1
		if !jumping {
			next.caret = 0
		}
		next = clearSuggestions(next)
	}
	return next
}

// ── da página para uma mensagem ──────────────────────────────────────────

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

func promptFor(arg: Str): model.Prompt {
	if arg == "newFolder" {
		return model.Prompt.NewFolderPrompt()
	} else if arg == "openFolder" {
		return model.Prompt.OpenFolderPrompt()
	}
	return model.Prompt.NewFilePrompt()
}

func actionMsg(state: model.State, action: Str, caret: Int): Result<model.Msg, Bool> {
	if action == "newFile" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFilePrompt()))
	} else if action == "newFolder" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFolderPrompt()))
	} else if action == "save" {
		return Result.Ok(model.Msg.Save())
	} else if action == "saveAll" {
		return Result.Ok(model.Msg.SaveAll())
	} else if action == "closeTab" {
		if render.showingCommit(state) {
			return Result.Ok(model.Msg.CloseCommit())
		}
		if render.showingSettings(state) {
			return Result.Ok(model.Msg.CloseSettings())
		}
		return Result.Ok(model.Msg.CloseDoc(state.active))
	} else if action == "nextTab" {
		return Result.Ok(model.Msg.CycleTab(1))
	} else if action == "prevTab" {
		return Result.Ok(model.Msg.CycleTab(-1))
	} else if action == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if action == "toggleSidebar" {
		return Result.Ok(model.Msg.ToggleSidebar())
	} else if action == "explorer" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if action == "outline" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
	} else if action == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "suggest" {
		return Result.Ok(model.Msg.SuggestAt(caret))
	} else if action == "preview" {
		return Result.Ok(model.Msg.TogglePreview())
	} else if action == "check" || action == "run" || action == "test" || action == "build" {
		return Result.Ok(model.Msg.Invoke(action))
	} else if action == "terminal" {
		if state.panelOpen && state.pane == model.Pane.TerminalPane() {
			return Result.Ok(model.Msg.TogglePanel())
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.TerminalPane()))
	} else if action == "maximizePanel" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if action == "git" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
	} else if action == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(caret))
	} else if action == "openFolder" {
		return Result.Ok(model.Msg.PickFolder())
	} else if action == "openFile" {
		return Result.Ok(model.Msg.PickFile())
	} else if action == "quit" {
		return Result.Ok(model.Msg.Quit())
	} else if action == "about" {
		return Result.Ok(model.Msg.ShowAbout())
	} else if action == "docs" {
		return Result.Ok(model.Msg.OpenDocs())
	} else if action == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if action == "problems" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
	} else if action == "output" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if action == "colorTheme" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "newTerminal" || action == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if action == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	}
	return Result.Error(false)
}

func escapeMsg(state: model.State): Result<model.Msg, Bool> {
	if state.recording != "" {
		return Result.Ok(model.Msg.CancelRecording())
	} else if state.about {
		return Result.Ok(model.Msg.CloseAbout())
	} else if state.git.confirm != "" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if state.peekFile != "" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if len(state.suggestions) > 0 {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if !(state.prompt == model.Prompt.NoPrompt()) {
		return Result.Ok(model.Msg.PromptCancel())
	}
	return Result.Error(false)
}

func clickMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	arg := event.arg
	if a == "toggle" {
		return Result.Ok(model.Msg.Toggle(arg))
	} else if a == "open" {
		return Result.Ok(model.Msg.Open(arg))
	} else if a == "refresh" {
		return Result.Ok(model.Msg.Refresh())
	} else if a == "collapse" {
		return Result.Ok(model.Msg.CollapseAll())
	} else if a == "up" {
		return Result.Ok(model.Msg.GoUp())
	} else if a == "prompt" {
		return Result.Ok(model.Msg.StartPrompt(promptFor(arg)))
	} else if a == "promptSubmit" {
		return Result.Ok(model.Msg.PromptSubmit(event.text))
	} else if a == "promptCancel" {
		return Result.Ok(model.Msg.PromptCancel())
	} else if a == "focus" {
		return Result.Ok(model.Msg.Focus(numberOr(arg, state.active)))
	} else if a == "close" {
		return Result.Ok(model.Msg.CloseDoc(numberOr(arg, -1)))
	} else if a == "invoke" {
		return Result.Ok(model.Msg.Invoke(arg))
	} else if a == "side" {
		if arg == "outline" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
		} else if arg == "git" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
		}
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if a == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(event.caret))
	} else if a == "action" {
		return actionMsg(state, arg, event.caret)
	} else if a == "closeAbout" {
		return Result.Ok(model.Msg.CloseAbout())
	} else if a == "panelMax" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if a == "termSubmit" {
		return Result.Ok(model.Msg.TermSubmit(event.text))
	} else if a == "termHistory" {
		return Result.Ok(model.Msg.TermHistory(numberOr(arg, 0)))
	} else if a == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if a == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	} else if a == "gitRefresh" {
		return Result.Ok(model.Msg.GitRefresh())
	} else if a == "gitStage" {
		return Result.Ok(model.Msg.GitStage(arg))
	} else if a == "gitUnstage" {
		return Result.Ok(model.Msg.GitUnstage(arg))
	} else if a == "gitStageAll" {
		return Result.Ok(model.Msg.GitStageAll())
	} else if a == "gitUnstageAll" {
		return Result.Ok(model.Msg.GitUnstageAll())
	} else if a == "gitAskDiscard" {
		return Result.Ok(model.Msg.GitAskDiscard(arg))
	} else if a == "gitDiscard" {
		return Result.Ok(model.Msg.GitDiscard(arg))
	} else if a == "gitCancel" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if a == "gitCommit" {
		return Result.Ok(model.Msg.GitCommit())
	} else if a == "gitPush" {
		return Result.Ok(model.Msg.GitPush())
	} else if a == "gitPull" {
		return Result.Ok(model.Msg.GitPull())
	} else if a == "gitInit" {
		return Result.Ok(model.Msg.GitInit())
	} else if a == "gitShow" {
		return Result.Ok(model.Msg.GitShow(arg))
	} else if a == "gitShowWork" {
		return Result.Ok(model.Msg.GitShowWork(arg))
	} else if a == "focusCommit" {
		return Result.Ok(model.Msg.FocusCommit())
	} else if a == "closeCommit" {
		return Result.Ok(model.Msg.CloseCommit())
	} else if a == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if a == "closeSettings" {
		return Result.Ok(model.Msg.CloseSettings())
	} else if a == "pane" {
		if arg == "problems" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
		} else if arg == "terminal" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.TerminalPane()))
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if a == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if a == "clear" {
		return Result.Ok(model.Msg.ClearOutput())
	} else if a == "peek" {
		return Result.Ok(model.Msg.Peek(arg, numberOr(event.text, 1)))
	} else if a == "closePeek" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if a == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if a == "mode" {
		return Result.Ok(model.Msg.SetMode(arg))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(arg))
	} else if a == "setting" {
		return Result.Ok(model.Msg.ToggleSetting(arg))
	} else if a == "record" {
		return Result.Ok(model.Msg.StartRecording(arg))
	} else if a == "resetKey" {
		return Result.Ok(model.Msg.ResetKey(arg))
	} else if a == "resetKeys" {
		return Result.Ok(model.Msg.ResetKeys())
	} else if a == "accept" {
		return Result.Ok(model.Msg.AcceptSuggestion(numberOr(arg, 0)))
	} else if a == "closeSuggest" {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if a == "escape" {
		return escapeMsg(state)
	}
	return Result.Error(false)
}

func fieldMsg(event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	if a == "prompt" {
		return Result.Ok(model.Msg.PromptTyped(event.text))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(event.text))
	} else if a == "fontSize" {
		return Result.Ok(model.Msg.SetFontSize(numberOr(event.text, 14)))
	} else if a == "tabSize" {
		return Result.Ok(model.Msg.SetTabSize(numberOr(event.text, 4)))
	} else if a == "compiler" {
		return Result.Ok(model.Msg.CompilerTyped(event.text))
	} else if a == "browser" {
		return Result.Ok(model.Msg.BrowserTyped(event.text))
	} else if a == "termInput" {
		return Result.Ok(model.Msg.TermTyped(event.text))
	} else if a == "gitMessage" {
		return Result.Ok(model.Msg.GitMessageTyped(event.text))
	} else if a == "language" {
		return Result.Ok(model.Msg.SetLanguage(event.text))
	} else if a == "panelHeight" {
		return Result.Ok(model.Msg.SetPanelHeight(numberOr(event.text, 260)))
	}
	return Result.Error(false)
}

func toMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	if event.kind == "edit" {
		return Result.Ok(model.Msg.EditAt(event.text, event.caret))
	} else if event.kind == "popup" {
		return Result.Ok(model.Msg.PopupKey(event.text))
	} else if event.kind == "key" {
		if state.recording != "" {
			return Result.Ok(model.Msg.KeyPressed(event.text))
		}
		if keys.actionFor(state.settings.keymap, event.text) is Result.Ok(action) {
			return actionMsg(state, action, event.caret)
		}
	} else if event.kind == "field" {
		return fieldMsg(event)
	} else if event.kind == "act" {
		return clickMsg(state, event)
	}
	return Result.Error(false)
}

// ── o serviço ────────────────────────────────────────────────────────────

proc serve(state: model.State, command: model.Cmd, from: hive.syslink.Envelope): model.State {
	if command is model.Cmd.Ui(text) {
		mut next := state
		decoded := model.Event.decode(text, hive.json.codec())
		if decoded is Result.Ok(hovered) {
			if hovered.kind == "hover" {
				mut ok := false
				if render.activeDoc(state) is Result.Ok(doc) {
					ok = navigate.locate(doc.path, doc.text, hovered.caret) is Result.Ok(_)
				}
				hive.syslink.answer(from, model.Cmd.Reply(encode(model.HoverReply(true, hovered.caret, ok), hive.json.codec())))
				return state
			}
		}
		if decoded is Result.Ok(event) {
			if toMsg(state, event) is Result.Ok(message) {
				next = step(state, message, from)
			}
		}
		hive.syslink.answer(from, model.Cmd.Reply(render.encodeFrame(next)))
		return next
	} else if command is model.Cmd.Post(message) {
		mut next := step(state, message, from)
		// A checagem periódica do git só redesenha quando algo mudou.
		quiet := message is model.Msg.GitPoll
		if !quiet || next.git != state.git {
			next.pulse = state.pulse + 1
		}
		return next
	} else if command is model.Cmd.Render {
		hive.syslink.answer(from, model.Cmd.Reply(render.encodeFrame(state)))
	} else if command is model.Cmd.Pulse {
		hive.syslink.answer(from, model.Cmd.PulseIs(state.pulse))
	} else if command is model.Cmd.Clients {
		hive.syslink.answer(from, model.Cmd.ClientsAre(state.clients))
	}
	return state
}

// Sai do programa pouco depois, dando tempo para a página fechar a janela.
proc quitSoon(): void {
	hive.task.sleep(300)
	hive.term.exit(0)
}

// Relê o git de tempos em tempos, para mudanças feitas fora do Hive Studio.
proc watchGit(db: hive.syslink.Address): void {
	for ;; {
		hive.task.sleep(4000)
		async db(model.Cmd.Post(model.Msg.GitPoll()))
	}
}

func fallbackView(url: Str): hive.ui.View {
	return ui.column([ui.gap(12), ui.pad(32)], [
		ui.text([ui.size(ui.TextSize.Title())], "⬡ Hive Studio"),
		ui.text([], "Nenhum navegador Chromium (Edge, Chrome, Brave) foi encontrado para abrir a janela."),
		ui.link([], url, "Abrir o Hive Studio aqui"),
		ui.text([ui.tone(ui.Tone.Muted())], "Ou indique o executável em Configurações → Navegador da janela.")
	])
}

proc fallbackUpdate(url: Str, message: model.Msg, from: hive.syslink.Envelope): Str {
	return url
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	prefs := settings.load()
	start := openRoot(model.initial(folder, prefs), folder)
	db := hive.syslink.spawn(serve, start)

	token := hive.crypto.randomHex(16)
	port := server.freePort()
	async hive.net.httpServe(port, server.page(token, port + 1, _))
	async hive.net.wsServe(port + 1, server.client(db, token, _))
	hive.task.sleep(150)

	url := "http://127.0.0.1:{port}/?token={token}"
	browser := server.launch(url, settings.folder() + "/janela", prefs.browser)
	if browser == "" {
		// Sem Chromium conhecido: a janela do próprio hive.ui (que cai numa aba
		// do navegador padrão) mostra o endereço da IDE.
		ui.window("Hive Studio", fallbackView, fallbackUpdate, url)
	}
	hive.term.status("Hive Studio em {url} ({browser})")
	async watchGit(db)
	for ;; {
		hive.task.sleep(60000)
	}
}

// ── testes de fluxo ──────────────────────────────────────────────────────

proc scratch(): Str {
	folder := "./studio-test"
	if hive.file.makeDir(folder + "/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\r\n\techo 1\r\n}\r\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/LEIAME.md", "# Título\n\nTexto **forte**.\n") is Result.Error(why) {
		panic why
	}
	return folder
}

proc fresh(folder: Str): model.State {
	return openRoot(model.initial(folder, settings.defaults()), folder)
}

func event(kind: Str, act: Str, arg: Str, text: Str, caret: Int): model.Event {
	return model.Event(kind, act, arg, text, caret)
}

test "abrir, editar, salvar e fechar mantém o fim de linha do arquivo" {
	folder := scratch()
	mut state := fresh(folder)
	assert len(state.tree) == 3
	state = openDoc(state, folder + "/main.hive")
	assert state.active == 0
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.eol == "\r\n"
		assert indexOf(doc.text, "\r") is Result.Error(_)
		assert indexOf(doc.html, "<span class=\"tk\">proc</span>") is Result.Ok(_)
	}
	state = withText(state, "proc main(): void \{\n\techo 2\n}\n")
	assert model.anyDirty(state.docs)
	state = saveAll(state)
	assert !model.anyDirty(state.docs)
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "proc main(): void \{\r\n\techo 2\r\n}\r\n"
	}
	state = closeDoc(state, 0)
	assert len(state.docs) == 0
	assert state.active == -1
}

test "expandir uma pasta e criar um arquivo dentro dela" {
	folder := scratch()
	mut state := fresh(folder)
	state = toggle(state, folder + "/lib")
	assert targetFolder(state) == folder + "/lib"
	state = create(state, "novo.hive", false)
	assert hive.file.exists(folder + "/lib/novo.hive")
	assert len(state.docs) == 1
	state = toggle(state, folder + "/lib")
	assert len(state.tree) == 3
	if hive.file.delete(folder + "/lib/novo.hive") is Result.Error(why) {
		panic why
	}
}

test "digitar sugere, e aceitar completa e reenvia o texto" {
	folder := scratch()
	mut state := fresh(folder)
	state = openDoc(state, folder + "/main.hive")
	typed := "proc main(): void \{\n\thive.file.re"
	if toMsg(state, event("edit", "", "", typed, len(typed))) is Result.Ok(message) {
		assert message == model.Msg.EditAt(typed, len(typed))
	}
	mut edited := withText(state, typed)
	edited.caret = len(typed)
	state = autoSuggest(edited)
	assert len(state.suggestions) > 0
	serial := state.textSerial
	state = acceptSuggestion(state, 0)
	assert len(state.suggestions) == 0
	assert state.textSerial == serial + 1
	assert activeText(state) == "proc main(): void \{\n\thive.file.read"
}

test "atalhos viram ações e podem ser regravados" {
	folder := scratch()
	mut state := fresh(folder)
	if toMsg(state, event("key", "", "", "Ctrl+`", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	} else {
		assert false
	}
	state.recording = "togglePanel"
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.KeyPressed("Ctrl+J")
	}
	state.settings.keymap = keys.assign("", "togglePanel", "Ctrl+J")
	state.recording = ""
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	}
}

test "markdown abre em preview e o frame traz o HTML renderizado" {
	folder := scratch()
	mut state := fresh(folder)
	state = openDoc(state, folder + "/LEIAME.md")
	assert render.layoutOf(state) == "preview"
	assert render.encodeFrame(state) != ""
	page := render.preview(state)
	assert indexOf(page, "<h1>Título</h1>") is Result.Ok(_)
	assert indexOf(page, "<strong>forte</strong>") is Result.Ok(_)
}

test "o frame desenha todas as telas sem erro" {
	folder := scratch()
	mut state := fresh(folder)
	assert render.encodeFrame(state) != ""
	state = peekAt(openDoc(state, folder + "/main.hive"), folder + "/main.hive", 2)
	state.diagnostics = analysis.parseDiagnostics("main.hive:2: oops")
	state.pane = model.Pane.ProblemsPane()
	page := render.encodeFrame(state)
	assert indexOf(page, "oops") is Result.Ok(_)
	state.settingsOpen = true
	state.editorView = model.EditorView.SettingsView()
	state.recording = "save"
	settingsPage := render.encodeFrame(state)
	assert indexOf(settingsPage, "Atalhos de teclado") is Result.Ok(_)
	assert indexOf(settingsPage, "Solarized Light") is Result.Ok(_)
}

test "git marca arquivo novo e editado, e commitado volta ao normal" {
	folder := "./git-test"
	if hive.file.makeDir(folder) is Result.Error(why) {
		panic why
	}
	_reset := process.run("git", ["init", "-q"], folder)
	_name := process.run("git", ["config", "user.email", "t@t"], folder)
	_mail := process.run("git", ["config", "user.name", "t"], folder)
	if hive.file.write(folder + "/a.hive", "proc main(): void \{}\n") is Result.Error(why) {
		panic why
	}
	mut state := fresh(folder)
	assert state.git.repo
	assert render.gitKindOf(state, folder + "/a.hive") == "new"
	state = afterGit(state, git.stageAll(state.git))
	_commit := process.run("git", ["commit", "-q", "-m", "um"], folder)
	state = gitRefresh(state)
	assert render.gitKindOf(state, folder + "/a.hive") == ""
	if hive.file.write(folder + "/a.hive", "proc main(): void \{ echo 1 }\n") is Result.Error(why) {
		panic why
	}
	state = gitRefresh(state)
	assert render.gitKindOf(state, folder + "/a.hive") == "modified"
	state.side = model.SideView.GitSide()
	page := render.sidePanel(state)
	assert indexOf(page, "ALTERAÇÕES") is Result.Ok(_)
	assert indexOf(page, "g-mod") is Result.Ok(_)
	assert indexOf(page, "gitShow") is Result.Ok(_)

	shown := git.show(state.git, "HEAD")
	if shown is Result.Ok(commit) {
		assert commit.subject == "um"
		html := render.commitPage(commit, state.words)
		assert indexOf(html, "<tr class=\"add\">") is Result.Ok(_)
		assert indexOf(html, "<span class=\"tk\">proc</span>") is Result.Ok(_)
	} else {
		assert false
	}
	work := git.working(state.git, "a.hive")
	if work.files is [changed] {
		assert changed.added == 1 && changed.removed == 1
	} else {
		assert false
	}
	_undo := process.run("git", ["checkout", "--", "a.hive"], folder)
}

test "ir para a definição no mesmo arquivo move o cursor e reenvia o texto" {
	folder := scratch()
	mut state := fresh(folder)
	source := "proc helper(): void \{\n}\n\nproc main(): void \{\n\thelper()\n}\n"
	if hive.file.write(folder + "/nav.hive", source) is Result.Error(why) {
		panic why
	}
	state = openDoc(state, folder + "/nav.hive")
	serial := state.textSerial
	caret := navigate.offsetOf(source, 5, 3)
	if navigate.locate(folder + "/nav.hive", source, caret) is Result.Ok(target) {
		assert target.line == 1
		assert navigate.offsetOf(source, target.line, target.column) == 5
	} else {
		assert false
	}
	assert serial == state.textSerial
}

test "o terminal roda um comando e devolve a saída" {
	started := native.start(".")
	if started is Result.Ok(session) {
		_w := native.write(session, "echo hive-terminal-ok\n")
		mut seen := ""
		for attempt := 0; attempt < 50; attempt++ {
			hive.task.sleep(100)
			seen = seen + native.read(session)
			if indexOf(seen, "hive-terminal-ok\n") is Result.Ok(_) {
				break
			}
		}
		assert indexOf(seen, "hive-terminal-ok") is Result.Ok(_)
		_s := native.stop(session)
	} else {
		assert false
	}
}

test "a interface muda de idioma na hora" {
	folder := scratch()
	mut state := fresh(folder)
	pt := render.titleBar(state)
	assert indexOf(pt, ">Arquivo<") is Result.Ok(_)
	assert indexOf(pt, ">Executar<") is Result.Ok(_)
	state.settings.language = "en"
	state.words = i18n.words("en")
	en := render.titleBar(state)
	assert indexOf(en, ">File<") is Result.Ok(_)
	assert indexOf(en, ">Open Folder…<") is Result.Ok(_)
	state.settingsOpen = true
	state.editorView = model.EditorView.SettingsView()
	assert indexOf(render.settingsPage(state), "Keyboard Shortcuts") is Result.Ok(_)
	state.words = i18n.words("es")
	assert indexOf(render.titleBar(state), ">Archivo<") is Result.Ok(_)
}

test "as opções da tela inicial são clicáveis" {
