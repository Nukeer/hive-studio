// Hive Studio — uma IDE simples para Hive, escrita em Hive.
//
//     hivec run studio.hive [pasta]
//
// O estado mora num serviço (`serve`, uma dobra sobre a caixa de mensagens).
// A página, numa janela Chromium em modo aplicativo, manda eventos pelo
// WebSocket e recebe de volta o frame já desenhado — ver lib/server.hive.

import hive.ui
import ./lib/model
import ./lib/workspace
import ./lib/analysis
import ./lib/toolchain
import ./lib/render
import ./lib/settings
import ./lib/highlight
import ./lib/complete
import ./lib/keys
import ./lib/server

// ── explorador ───────────────────────────────────────────────────────────

proc reload(state: model.State): model.State {
	mut next := state
	next.tree = workspace.buildTree(state.root, 0, state.expanded, state.settings.showHidden)
	return next
}

proc openRoot(state: model.State, folder: Str): model.State {
	mut next := state
	target := workspace.normalize(folder)
	if hive.file.list(target) is Result.Error(why) {
		next.status = "não foi possível abrir {target}: {why.message}"
		return next
	}
	Str[dyn] closed = []
	next.root = target
	next.expanded = closed
	next.selected = ""
	next.status = "pasta {workspace.baseName(target)}"
	return reload(next)
}

func isNot(candidate: Str, path: Str): Bool {
	return candidate != path
}

proc toggle(state: model.State, path: Str): model.State {
	mut next := state
	if workspace.isExpanded(state.expanded, path) {
		next.expanded = filter(state.expanded, isNot(_, path))
	} else {
		mut Str[dyn] expanded = state.expanded
		append(expanded, path)
		next.expanded = expanded
	}
	next.selected = path
	return reload(next)
}

// Onde um arquivo novo vai: a pasta selecionada, a pasta do arquivo
// selecionado, ou a raiz.
func targetFolder(state: model.State): Str {
	if state.selected == "" {
		return state.root
	}
	for each row in state.tree {
		if row.entry.path == state.selected {
			if row.entry.folder {
				return row.entry.path
			}
			return workspace.parentOf(row.entry.path)
		}
	}
	return state.root
}

// ── documentos ───────────────────────────────────────────────────────────

func highlightFor(path: Str, text: Str): Str {
	if path is "{stem}.hive" || path is "{stem}.go" {
		return highlight.highlight(text)
	}
	return highlight.escape(text)
}

func findDoc(docs: model.Doc[], path: Str): Result<Int, Bool> {
	for i := 0; i < len(docs); i++ {
		if docs[i].path == path {
			return Result.Ok(i)
		}
	}
	return Result.Error(false)
}

proc openDoc(state: model.State, path: Str): model.State {
	mut next := state
	next.selected = path
	next.editorView = model.EditorView.DocView()
	if findDoc(state.docs, path) is Result.Ok(index) {
		next.active = index
		return next
	}
	read := hive.file.read(path)
	if read is Result.Ok(raw) {
		mut eol := "\n"
		if indexOf(raw, "\r\n") is Result.Ok(_) {
			eol = "\r\n"
		}
		text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
		mut mode := "edit"
		if model.isMarkdown(path) {
			mode = "preview"
		}
		mut model.Doc[dyn] docs = state.docs
		append(docs, model.Doc(path, workspace.baseName(path), text, text, eol, highlightFor(path, text), mode))
		next.docs = docs
		next.active = len(docs) - 1
		next.status = "aberto {workspace.baseName(path)}"
	} else if read is Result.Error(why) {
		next.status = "não foi possível ler {path}: {why.message}"
	}
	return next
}

proc saveDoc(doc: model.Doc): Result<model.Doc, Str> {
	mut contents := doc.text
	if doc.eol == "\r\n" {
		contents = replaceAll(doc.text, "\n", "\r\n")
	}
	if hive.file.write(doc.path, contents) is Result.Error(why) {
		return Result.Error("não foi possível salvar {doc.name}: {why.message}")
	}
	mut saved := doc
	saved.saved = doc.text
	return Result.Ok(saved)
}

proc saveAll(state: model.State): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	mut count := 0
	for i := 0; i < len(docs); i++ {
		if model.dirty(docs[i]) {
			outcome := saveDoc(docs[i])
			if outcome is Result.Ok(doc) {
				docs[i] = doc
				count++
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
	}
	next.docs = docs
	if count > 0 {
		next.status = "{count} arquivo(s) salvo(s)"
	}
	return next
}

proc create(state: model.State, name: Str, folder: Bool): model.State {
	mut next := state
	if name == "" {
		return next
	}
	base := targetFolder(state)
	path := workspace.joinPath(base, name)
	if hive.file.exists(path) {
		next.status = "{name} já existe"
		return next
	}
	if folder {
		if hive.file.makeDir(path) is Result.Error(why) {
			next.status = "não foi possível criar {path}: {why.message}"
			return next
		}
	} else if hive.file.write(path, "") is Result.Error(why) {
		next.status = "não foi possível criar {path}: {why.message}"
		return next
	}
	if base != state.root && !workspace.isExpanded(state.expanded, base) {
		mut Str[dyn] expanded = state.expanded
		append(expanded, base)
		next.expanded = expanded
	}
	next = reload(next)
	next.selected = path
	if folder {
		return next
	}
	return openDoc(next, path)
}

proc closeDoc(state: model.State, index: Int): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		drop(docs, index, index)
		next.docs = docs
		if state.active >= index && state.active > 0 {
			next.active = state.active - 1
		}
		if len(docs) == 0 {
			next.active = -1
		}
	}
	return next
}

proc peekAt(state: model.State, file: Str, line: Int): model.State {
	mut next := state
	if findDoc(state.docs, file) is Result.Ok(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if state.docs bounds index {
			next.peekText = state.docs[index].text
		}
	} else {
		read := hive.file.read(file)
		if read is Result.Ok(text) {
			next = openDoc(state, file)
			next.peekText = replaceAll(text, "\r", "")
		} else if read is Result.Error(why) {
			next.status = "não foi possível ler {file}: {why.message}"
			return next
		}
	}
	next.peekFile = file
	next.peekLine = line
	return next
}

// Troca o texto do documento ativo (e o realce guardado dele).
proc withText(state: model.State, text: Str): model.State {
	mut next := state
	index := state.active
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		mut doc := docs[index]
		doc.text = text
		doc.html = highlightFor(doc.path, text)
		docs[index] = doc
	}
	next.docs = docs
	return next
}

func activeText(state: model.State): Str {
	if render.activeDoc(state) is Result.Ok(doc) {
		return doc.text
	}
	return ""
}

func clearSuggestions(state: model.State): model.State {
	mut next := state
	model.Suggestion[dyn] none = []
	next.suggestions = none
	next.suggestIndex = 0
	return next
}

// Sugere só enquanto um nome está sendo digitado, ou logo depois de um ponto.
func autoSuggest(state: model.State): model.State {
	mut next := clearSuggestions(state)
	if !state.settings.autocomplete {
		return next
	}
	text := activeText(state)
	ctx := complete.context(text, state.caret)
	if ctx.prefix != "" || ctx.qualifier != "" {
		next.suggestions = complete.suggest(text, state.caret, 12)
	}
	return next
}

proc acceptSuggestion(state: model.State, index: Int): model.State {
	if state.suggestions bounds index {
		word := state.suggestions[index].word
		edit := complete.accept(activeText(state), state.caret, word)
		mut next := withText(state, edit.text)
		next.caret = edit.caret
		next.textSerial = state.textSerial + 1
		return clearSuggestions(next)
	}
	return clearSuggestions(state)
}

// ── configurações ────────────────────────────────────────────────────────

proc applySettings(state: model.State, prefs: settings.Settings): model.State {
	mut next := state
	next.settings = prefs
	if settings.save(prefs) is Result.Error(why) {
		next.status = "não foi possível salvar as configurações: {why}"
	}
	return next
}

proc toggleSetting(state: model.State, name: Str): model.State {
	mut prefs := state.settings
	if name == "lineNumbers" {
		prefs.lineNumbers = !prefs.lineNumbers
	} else if name == "showHidden" {
		prefs.showHidden = !prefs.showHidden
	} else if name == "saveBeforeRun" {
		prefs.saveBeforeRun = !prefs.saveBeforeRun
	} else if name == "autocomplete" {
		prefs.autocomplete = !prefs.autocomplete
	}
	next := applySettings(state, prefs)
	if name == "showHidden" {
		return reload(next)
	}
	return next
}

func summary(command: Str, ok: Bool, problems: Int): Str {
	if ok {
		return "{command}: ok"
	}
	if problems > 0 {
		return "{command}: {problems} problema(s)"
	}
	return "{command}: falhou"
}

func clampInt(value: Int, low: Int, high: Int): Int {
	if value < low {
		return low
	}
	if value > high {
		return high
	}
	return value
}

// ── a dobra ──────────────────────────────────────────────────────────────

proc update(state: model.State, message: model.Msg, from: hive.syslink.Envelope): model.State {
	mut next := state
	mut prefs := state.settings
	if message is model.Msg.Toggle(path) {
		return toggle(state, path)
	} else if message is model.Msg.Open(path) {
		return openDoc(state, path)
	} else if message is model.Msg.Refresh {
		return reload(state)
	} else if message is model.Msg.CollapseAll {
		Str[dyn] closed = []
		next.expanded = closed
		return reload(next)
	} else if message is model.Msg.GoUp {
		return openRoot(state, workspace.parentOf(state.root))
	} else if message is model.Msg.StartPrompt(prompt) {
		next.prompt = prompt
		next.promptText = ""
		next.sideOpen = true
		next.side = model.SideView.ExplorerSide()
		if prompt is model.Prompt.OpenFolderPrompt {
			next.promptText = state.root
		}
	} else if message is model.Msg.PromptTyped(text) {
		next.promptText = text
	} else if message is model.Msg.PromptSubmit(text) {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
		mut typed := text
		if typed == "" {
			typed = state.promptText
		}
		if state.prompt is model.Prompt.NewFilePrompt {
			return create(next, typed, false)
		} else if state.prompt is model.Prompt.NewFolderPrompt {
			return create(next, typed, true)
		} else if state.prompt is model.Prompt.OpenFolderPrompt {
			return openRoot(next, typed)
		}
	} else if message is model.Msg.PromptCancel {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
	} else if message is model.Msg.Focus(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if render.activeDoc(next) is Result.Ok(doc) {
			next.selected = doc.path
		}
	} else if message is model.Msg.CloseDoc(index) {
		return closeDoc(state, index)
	} else if message is model.Msg.CycleTab(step) {
		count := len(state.docs)
		if count > 0 {
			next.active = ((state.active + step) % count + count) % count
			next.editorView = model.EditorView.DocView()
		}
	} else if message is model.Msg.EditAt(text, caret) {
		next = withText(state, text)
		next.caret = caret
		return autoSuggest(next)
	} else if message is model.Msg.CaretAt(caret) {
		next.caret = caret
	} else if message is model.Msg.SuggestAt(caret) {
		next.caret = caret
		next.suggestions = complete.suggest(activeText(state), caret, 12)
		next.suggestIndex = 0
	} else if message is model.Msg.PopupKey(key) {
		count := len(state.suggestions)
		if key == "ArrowDown" && count > 0 {
			next.suggestIndex = (state.suggestIndex + 1) % count
		} else if key == "ArrowUp" && count > 0 {
			next.suggestIndex = (state.suggestIndex - 1 + count) % count
		} else if key == "Enter" || key == "Tab" {
			return acceptSuggestion(state, state.suggestIndex)
		} else {
			return clearSuggestions(state)
		}
	} else if message is model.Msg.AcceptSuggestion(index) {
		return acceptSuggestion(state, index)
	} else if message is model.Msg.CloseSuggest {
		return clearSuggestions(state)
	} else if message is model.Msg.Save {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			outcome := saveDoc(docs[index])
			if outcome is Result.Ok(doc) {
				docs[index] = doc
				next.status = "salvo {doc.name}"
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
		next.docs = docs
	} else if message is model.Msg.SaveAll {
		return saveAll(state)
	} else if message is model.Msg.PinEntry {
		if render.activeDoc(state) is Result.Ok(doc) {
			next.entrypoint = doc.path
			next.status = "entrada: {doc.name}"
		}
	} else if message is model.Msg.SetMode(mode) {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			docs[index].mode = mode
		}
		next.docs = docs
	} else if message is model.Msg.TogglePreview {
		if render.activeDoc(state) is Result.Ok(doc) {
			if model.isMarkdown(doc.path) {
				mut mode := "preview"
				if doc.mode != "edit" {
					mode = "edit"
				}
				return update(state, model.Msg.SetMode(mode), from)
			}
		}
	} else if message is model.Msg.Invoke(command) {
		target := render.targetOf(state)
		if target == "" || state.running != "" {
			return state
		}
		if state.settings.saveBeforeRun {
			next = saveAll(state)
		}
		next.running = command
		next.output = "$ hivec {command} {target}\n"
		next.pane = model.Pane.OutputPane()
		next.panelOpen = true
		next.status = "{command} {workspace.baseName(target)}…"
		async toolchain.invoke(hive.syslink.self(from), state.settings.compiler, command, target)
	} else if message is model.Msg.Finished(command, output, ok) {
		found := analysis.parseDiagnostics(output)
		next.running = ""
		next.output = state.output + output
		next.diagnostics = found
		next.status = summary(command, ok, len(found))
		if len(found) > 0 {
			next.pane = model.Pane.ProblemsPane()
			next.panelOpen = true
		}
	} else if message is model.Msg.ShowPane(pane) {
		next.pane = pane
		next.panelOpen = true
	} else if message is model.Msg.TogglePanel {
		next.panelOpen = !state.panelOpen
	} else if message is model.Msg.ShowSide(side) {
		if state.sideOpen && state.side == side {
			next.sideOpen = false
		} else {
			next.sideOpen = true
			next.side = side
		}
	} else if message is model.Msg.ToggleSidebar {
		next.sideOpen = !state.sideOpen
	} else if message is model.Msg.OpenSettings {
		next.settingsOpen = true
		next.editorView = model.EditorView.SettingsView()
	} else if message is model.Msg.CloseSettings {
		next.settingsOpen = false
		next.editorView = model.EditorView.DocView()
	} else if message is model.Msg.SetTheme(name) {
		prefs.theme = name
		next = applySettings(state, prefs)
		next.status = "tema: {name}"
	} else if message is model.Msg.ToggleSetting(name) {
		return toggleSetting(state, name)
	} else if message is model.Msg.SetFontSize(size) {
		prefs.fontSize = clampInt(size, 10, 28)
		return applySettings(state, prefs)
	} else if message is model.Msg.SetTabSize(size) {
		prefs.tabSize = clampInt(size, 1, 8)
		return applySettings(state, prefs)
	} else if message is model.Msg.CompilerTyped(text) {
		prefs.compiler = text
		return applySettings(state, prefs)
	} else if message is model.Msg.BrowserTyped(text) {
		prefs.browser = text
		return applySettings(state, prefs)
	} else if message is model.Msg.StartRecording(action) {
		next.recording = action
	} else if message is model.Msg.CancelRecording {
		next.recording = ""
	} else if message is model.Msg.KeyPressed(combo) {
		next.recording = ""
		if combo != "Escape" && state.recording != "" {
			prefs.keymap = keys.assign(prefs.keymap, state.recording, combo)
			next = applySettings(next, prefs)
			next.status = "atalho gravado: {combo}"
		}
	} else if message is model.Msg.ResetKey(action) {
		prefs.keymap = keys.reset(prefs.keymap, action)
		return applySettings(state, prefs)
	} else if message is model.Msg.ResetKeys {
		prefs.keymap = ""
		next = applySettings(state, prefs)
		next.status = "atalhos restaurados"
	} else if message is model.Msg.Peek(file, line) {
		return peekAt(state, file, line)
	} else if message is model.Msg.ClosePeek {
		next.peekFile = ""
	} else if message is model.Msg.ClearOutput {
		next.output = ""
		model.Diagnostic[dyn] cleared = []
		next.diagnostics = cleared
	} else if message is model.Msg.Connected {
		next.clients = state.clients + 1
	} else if message is model.Msg.Disconnected {
		next.clients = state.clients - 1
	}
	return next
}

// Um passo da dobra. Quando o documento ativo muda, a página precisa receber
// o texto novo: é o `textSerial` que avisa.
proc step(state: model.State, message: model.Msg, from: hive.syslink.Envelope): model.State {
	mut next := update(state, message, from)
	if render.activePath(next) != render.activePath(state) {
		next.textSerial = next.textSerial + 1
		next.caret = 0
		next = clearSuggestions(next)
	}
	return next
}

// ── da página para uma mensagem ──────────────────────────────────────────

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

func promptFor(arg: Str): model.Prompt {
	if arg == "newFolder" {
		return model.Prompt.NewFolderPrompt()
	} else if arg == "openFolder" {
		return model.Prompt.OpenFolderPrompt()
	}
	return model.Prompt.NewFilePrompt()
}

func actionMsg(state: model.State, action: Str, caret: Int): Result<model.Msg, Bool> {
	if action == "newFile" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFilePrompt()))
	} else if action == "newFolder" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFolderPrompt()))
	} else if action == "save" {
		return Result.Ok(model.Msg.Save())
	} else if action == "saveAll" {
		return Result.Ok(model.Msg.SaveAll())
	} else if action == "closeTab" {
		if render.showingSettings(state) {
			return Result.Ok(model.Msg.CloseSettings())
		}
		return Result.Ok(model.Msg.CloseDoc(state.active))
	} else if action == "nextTab" {
		return Result.Ok(model.Msg.CycleTab(1))
	} else if action == "prevTab" {
		return Result.Ok(model.Msg.CycleTab(-1))
	} else if action == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if action == "toggleSidebar" {
		return Result.Ok(model.Msg.ToggleSidebar())
	} else if action == "explorer" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if action == "outline" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
	} else if action == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "suggest" {
		return Result.Ok(model.Msg.SuggestAt(caret))
	} else if action == "preview" {
		return Result.Ok(model.Msg.TogglePreview())
	} else if action == "check" || action == "run" || action == "test" || action == "build" {
		return Result.Ok(model.Msg.Invoke(action))
	}
	return Result.Error(false)
}

func escapeMsg(state: model.State): Result<model.Msg, Bool> {
	if state.recording != "" {
		return Result.Ok(model.Msg.CancelRecording())
	} else if state.peekFile != "" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if len(state.suggestions) > 0 {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if !(state.prompt == model.Prompt.NoPrompt()) {
		return Result.Ok(model.Msg.PromptCancel())
	}
	return Result.Error(false)
}

func clickMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	arg := event.arg
	if a == "toggle" {
		return Result.Ok(model.Msg.Toggle(arg))
	} else if a == "open" {
		return Result.Ok(model.Msg.Open(arg))
	} else if a == "refresh" {
		return Result.Ok(model.Msg.Refresh())
	} else if a == "collapse" {
		return Result.Ok(model.Msg.CollapseAll())
	} else if a == "up" {
		return Result.Ok(model.Msg.GoUp())
	} else if a == "prompt" {
		return Result.Ok(model.Msg.StartPrompt(promptFor(arg)))
	} else if a == "promptSubmit" {
		return Result.Ok(model.Msg.PromptSubmit(event.text))
	} else if a == "promptCancel" {
		return Result.Ok(model.Msg.PromptCancel())
	} else if a == "focus" {
		return Result.Ok(model.Msg.Focus(numberOr(arg, state.active)))
	} else if a == "close" {
		return Result.Ok(model.Msg.CloseDoc(numberOr(arg, -1)))
	} else if a == "invoke" {
		return Result.Ok(model.Msg.Invoke(arg))
	} else if a == "side" {
		if arg == "outline" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
		}
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if a == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if a == "closeSettings" {
		return Result.Ok(model.Msg.CloseSettings())
	} else if a == "pane" {
		if arg == "problems" {
			return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if a == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if a == "clear" {
		return Result.Ok(model.Msg.ClearOutput())
	} else if a == "peek" {
		return Result.Ok(model.Msg.Peek(arg, numberOr(event.text, 1)))
	} else if a == "closePeek" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if a == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if a == "mode" {
		return Result.Ok(model.Msg.SetMode(arg))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(arg))
	} else if a == "setting" {
		return Result.Ok(model.Msg.ToggleSetting(arg))
	} else if a == "record" {
		return Result.Ok(model.Msg.StartRecording(arg))
	} else if a == "resetKey" {
		return Result.Ok(model.Msg.ResetKey(arg))
	} else if a == "resetKeys" {
		return Result.Ok(model.Msg.ResetKeys())
	} else if a == "accept" {
		return Result.Ok(model.Msg.AcceptSuggestion(numberOr(arg, 0)))
	} else if a == "closeSuggest" {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if a == "escape" {
		return escapeMsg(state)
	}
	return Result.Error(false)
}

func fieldMsg(event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	if a == "prompt" {
		return Result.Ok(model.Msg.PromptTyped(event.text))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(event.text))
	} else if a == "fontSize" {
		return Result.Ok(model.Msg.SetFontSize(numberOr(event.text, 14)))
	} else if a == "tabSize" {
		return Result.Ok(model.Msg.SetTabSize(numberOr(event.text, 4)))
	} else if a == "compiler" {
		return Result.Ok(model.Msg.CompilerTyped(event.text))
	} else if a == "browser" {
		return Result.Ok(model.Msg.BrowserTyped(event.text))
	}
	return Result.Error(false)
}

func toMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	if event.kind == "edit" {
		return Result.Ok(model.Msg.EditAt(event.text, event.caret))
	} else if event.kind == "popup" {
		return Result.Ok(model.Msg.PopupKey(event.text))
	} else if event.kind == "key" {
		if state.recording != "" {
			return Result.Ok(model.Msg.KeyPressed(event.text))
		}
		if keys.actionFor(state.settings.keymap, event.text) is Result.Ok(action) {
			return actionMsg(state, action, event.caret)
		}
	} else if event.kind == "field" {
		return fieldMsg(event)
	} else if event.kind == "act" {
		return clickMsg(state, event)
	}
	return Result.Error(false)
}

// ── o serviço ────────────────────────────────────────────────────────────

proc serve(state: model.State, command: model.Cmd, from: hive.syslink.Envelope): model.State {
	if command is model.Cmd.Ui(text) {
		mut next := state
		if model.Event.decode(text, hive.json.codec()) is Result.Ok(event) {
			if toMsg(state, event) is Result.Ok(message) {
				next = step(state, message, from)
			}
		}
		hive.syslink.answer(from, model.Cmd.Reply(render.encodeFrame(next)))
		return next
	} else if command is model.Cmd.Post(message) {
		mut next := step(state, message, from)
		next.pulse = state.pulse + 1
		return next
	} else if command is model.Cmd.Render {
		hive.syslink.answer(from, model.Cmd.Reply(render.encodeFrame(state)))
	} else if command is model.Cmd.Pulse {
		hive.syslink.answer(from, model.Cmd.PulseIs(state.pulse))
	} else if command is model.Cmd.Clients {
		hive.syslink.answer(from, model.Cmd.ClientsAre(state.clients))
	}
	return state
}

func fallbackView(url: Str): hive.ui.View {
	return ui.column([ui.gap(12), ui.pad(32)], [
		ui.text([ui.size(ui.TextSize.Title())], "⬡ Hive Studio"),
		ui.text([], "Nenhum navegador Chromium (Edge, Chrome, Brave) foi encontrado para abrir a janela."),
		ui.link([], url, "Abrir o Hive Studio aqui"),
		ui.text([ui.tone(ui.Tone.Muted())], "Ou indique o executável em Configurações → Navegador da janela.")
	])
}

proc fallbackUpdate(url: Str, message: model.Msg, from: hive.syslink.Envelope): Str {
	return url
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	prefs := settings.load()
	start := openRoot(model.initial(folder, prefs), folder)
	db := hive.syslink.spawn(serve, start)

	token := hive.crypto.randomHex(16)
	port := server.freePort()
	async hive.net.httpServe(port, server.page(token, port + 1, _))
	async hive.net.wsServe(port + 1, server.client(db, token, _))
	hive.task.sleep(150)

	url := "http://127.0.0.1:{port}/?token={token}"
	browser := server.launch(url, settings.folder() + "/janela", prefs.browser)
	if browser == "" {
		// Sem Chromium conhecido: a janela do próprio hive.ui (que cai numa aba
		// do navegador padrão) mostra o endereço da IDE.
		ui.window("Hive Studio", fallbackView, fallbackUpdate, url)
	}
	hive.term.status("Hive Studio em {url} ({browser})")
	for ;; {
		hive.task.sleep(60000)
	}
}

// ── testes de fluxo ──────────────────────────────────────────────────────

proc scratch(): Str {
	folder := "./studio-test"
	if hive.file.makeDir(folder + "/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\r\n\techo 1\r\n}\r\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/LEIAME.md", "# Título\n\nTexto **forte**.\n") is Result.Error(why) {
		panic why
	}
	return folder
}

proc fresh(folder: Str): model.State {
	return openRoot(model.initial(folder, settings.defaults()), folder)
}

func event(kind: Str, act: Str, arg: Str, text: Str, caret: Int): model.Event {
	return model.Event(kind, act, arg, text, caret)
}

test "abrir, editar, salvar e fechar mantém o fim de linha do arquivo" {
	folder := scratch()
	mut state := fresh(folder)
	assert len(state.tree) == 3
	state = openDoc(state, folder + "/main.hive")
	assert state.active == 0
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.eol == "\r\n"
		assert indexOf(doc.text, "\r") is Result.Error(_)
		assert indexOf(doc.html, "<span class=\"tk\">proc</span>") is Result.Ok(_)
	}
	state = withText(state, "proc main(): void \{\n\techo 2\n}\n")
	assert model.anyDirty(state.docs)
	state = saveAll(state)
	assert !model.anyDirty(state.docs)
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "proc main(): void \{\r\n\techo 2\r\n}\r\n"
	}
	state = closeDoc(state, 0)
	assert len(state.docs) == 0
	assert state.active == -1
}

test "expandir uma pasta e criar um arquivo dentro dela" {
	folder := scratch()
	mut state := fresh(folder)
	state = toggle(state, folder + "/lib")
	assert targetFolder(state) == folder + "/lib"
	state = create(state, "novo.hive", false)
	assert hive.file.exists(folder + "/lib/novo.hive")
	assert len(state.docs) == 1
	state = toggle(state, folder + "/lib")
	assert len(state.tree) == 3
	if hive.file.delete(folder + "/lib/novo.hive") is Result.Error(why) {
		panic why
	}
}

test "digitar sugere, e aceitar completa e reenvia o texto" {
	folder := scratch()
	mut state := fresh(folder)
	state = openDoc(state, folder + "/main.hive")
	typed := "proc main(): void \{\n\thive.file.re"
	if toMsg(state, event("edit", "", "", typed, len(typed))) is Result.Ok(message) {
		assert message == model.Msg.EditAt(typed, len(typed))
	}
	mut edited := withText(state, typed)
	edited.caret = len(typed)
	state = autoSuggest(edited)
	assert len(state.suggestions) > 0
	serial := state.textSerial
	state = acceptSuggestion(state, 0)
	assert len(state.suggestions) == 0
	assert state.textSerial == serial + 1
	assert activeText(state) == "proc main(): void \{\n\thive.file.read"
}

test "atalhos viram ações e podem ser regravados" {
	folder := scratch()
	mut state := fresh(folder)
	if toMsg(state, event("key", "", "", "Ctrl+`", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	} else {
		assert false
	}
	state.recording = "togglePanel"
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.KeyPressed("Ctrl+J")
	}
	state.settings.keymap = keys.assign("", "togglePanel", "Ctrl+J")
	state.recording = ""
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	}
}

test "markdown abre em preview e o frame traz o HTML renderizado" {
	folder := scratch()
	mut state := fresh(folder)
	state = openDoc(state, folder + "/LEIAME.md")
	assert render.layoutOf(state) == "preview"
	assert render.encodeFrame(state) != ""
	page := render.preview(state)
	assert indexOf(page, "<h1>Título</h1>") is Result.Ok(_)
	assert indexOf(page, "<strong>forte</strong>") is Result.Ok(_)
}

test "o frame desenha todas as telas sem erro" {
	folder := scratch()
	mut state := fresh(folder)
	assert render.encodeFrame(state) != ""
	state = peekAt(openDoc(state, folder + "/main.hive"), folder + "/main.hive", 2)
	state.diagnostics = analysis.parseDiagnostics("main.hive:2: oops")
	state.pane = model.Pane.ProblemsPane()
	page := render.encodeFrame(state)
	assert indexOf(page, "oops") is Result.Ok(_)
	state.settingsOpen = true
	state.editorView = model.EditorView.SettingsView()
	state.recording = "save"
	settingsPage := render.encodeFrame(state)
	assert indexOf(settingsPage, "Atalhos de teclado") is Result.Ok(_)
	assert indexOf(settingsPage, "Solarized Light") is Result.Ok(_)
}
