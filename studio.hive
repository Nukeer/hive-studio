	} else if a == "vimHistory" {
		return Result.Ok(model.Msg.VimHistory(numberOr(arg, 0)))
	}
	return Result.Error(false)
}

func fieldMsg(event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	if a == "prompt" {
		return Result.Ok(model.Msg.PromptTyped(event.text))
	} else if a == "theme" {
		return Result.Ok(model.Msg.SetTheme(event.text))
	} else if a == "fontSize" {
		return Result.Ok(model.Msg.SetFontSize(numberOr(event.text, 14)))
	} else if a == "tabSize" {
		return Result.Ok(model.Msg.SetTabSize(numberOr(event.text, 4)))
	} else if a == "compiler" {
		return Result.Ok(model.Msg.CompilerTyped(event.text))
	} else if a == "browser" {
		return Result.Ok(model.Msg.BrowserTyped(event.text))
	} else if a == "termInput" {
		return Result.Ok(model.Msg.TermTyped(event.text))
	} else if a == "gitMessage" {
		return Result.Ok(model.Msg.GitMessageTyped(event.text))
	} else if a == "find" {
		return Result.Ok(model.Msg.FindTyped(event.text))
	} else if a == "searchText" {
		return Result.Ok(model.Msg.SearchTyped(event.text))
	} else if a == "palette" {
		return Result.Ok(model.Msg.PaletteTyped(event.text))
	} else if a == "language" {
		return Result.Ok(model.Msg.SetLanguage(event.text))
	} else if a == "panelHeight" {
		return Result.Ok(model.Msg.SetPanelHeight(numberOr(event.text, 260)))
	} else if a == "vimCommand" {
		return Result.Ok(model.Msg.VimTyped(event.text))
	} else if a == "claudeCommand" {
		return Result.Ok(model.Msg.AgentCommand("claude", event.text))
	} else if a == "codexCommand" {
		return Result.Ok(model.Msg.AgentCommand("codex", event.text))
	} else if a == "opencodeCommand" {
		return Result.Ok(model.Msg.AgentCommand("opencode", event.text))
	}
	return Result.Error(false)
}

func toMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	if event.kind == "edit" && event.at >= 0 {
		// Só a diferença: vale se foi feita sobre o texto que o programa tem.
		if event.seen != state.textSerial {
			return Result.Error(false)
		}
		text := activeText(state)
		return Result.Ok(model.Msg.EditAt(complete.take(text, event.at) + event.arg + complete.skip(text, event.at + event.cut), event.caret))
	} else if event.kind == "edit" {
		return Result.Ok(model.Msg.EditAt(event.text, event.caret))
	} else if event.kind == "popup" {
		return Result.Ok(model.Msg.PopupKey(event.text))
	} else if event.kind == "key" {
		if state.recording != "" {
			return Result.Ok(model.Msg.KeyPressed(event.text))
		}
		if keys.actionFor(state.settings.keymap, event.text) is Result.Ok(action) {
			if action == "find" {
				return Result.Ok(model.Msg.FindOpen(event.arg))
			}
			return actionMsg(state, action, event.caret)
		}
	} else if event.kind == "field" {
		return fieldMsg(event)
	} else if event.kind == "act" {
		return clickMsg(state, event)
	} else if event.kind == "vim" {
		return Result.Ok(model.Msg.VimKey(event.text, event.caret, event.arg))
	} else if event.kind == "vimMouse" {
		return Result.Ok(model.Msg.VimMouse(event.caret, numberOr(event.arg, event.caret)))
	} else if event.kind == "tree" {
		return Result.Ok(model.Msg.TreeKey(event.text))
	}
	return Result.Error(false)
}

// ── o serviço ────────────────────────────────────────────────────────────

// Um turno do serviço: o estado é escrito no lugar, e o que o turno devolve é
// a resposta de quem perguntou. `from` é o endereço do próprio serviço, para o
// trabalho que ele começa em outra thread mandar o resultado de volta.
proc serve(state: mut model.State, command: model.Cmd, from: hive.syslink.Address): model.Cmd {
	current := state
	if command is model.Cmd.Ui(text) {
		decoded := model.Event.decode(text, hive.json.codec())
		if decoded is Result.Ok(hovered) {
			if hovered.kind == "hover" {
				mut ok := false
				if render.activeDoc(current) is Result.Ok(doc) {
					ok = navigate.locate(doc.path, doc.text, hovered.caret) is Result.Ok(_)
				}
				return model.Cmd.Reply(encode(model.HoverReply(true, hovered.caret, ok), hive.json.codec()))
			}
		}
		if decoded is Result.Ok(event) {
			if event.kind == "resync" || event.kind == "hello" {
				return reply(state, resynced(current))
			}
			if toMsg(current, event) is Result.Ok(message) {
				return reply(state, step(current, message, from))
			}
		}
		return reply(state, current)
	} else if command is model.Cmd.Post(message) {
		mut next := step(current, message, from)
		// As checagens periódicas (git, arquivos no disco) só redesenham quando algo mudou.
		quiet := message is model.Msg.GitPoll || message is model.Msg.DiskPoll
		if !quiet || next.git != current.git || next.textSerial != current.textSerial || next.status != current.status ||
			next.tree != current.tree || next.docs != current.docs {
			next.pulse = current.pulse + 1
		}
		state = next
		return command
	} else if command is model.Cmd.Render {
		return reply(state, current)
	} else if command is model.Cmd.Pulse {
		return model.Cmd.PulseIs(current.pulse)
	} else if command is model.Cmd.Clients {
		return model.Cmd.ClientsAre(current.clients)
	}
	return command
}

// Manda o frame de agora e lembra o que a página passou a ter: o próximo frame
// só leva o texto e o realce se eles mudarem.
proc reply(state: mut model.State, shown: model.State): model.Cmd {
	frame := render.encodeFrame(shown)
	state = delivered(shown)
	return model.Cmd.Reply(frame)
}

func delivered(state: model.State): model.State {
	mut next := state
	next.clientSerial = state.textSerial
	next.frameSeq = state.frameSeq + 1
	next.clientHv = -1
	next.clientHvPath = ""
	if render.activeDoc(state) is Result.Ok(doc) {
		next.clientHv = doc.version
		next.clientHvPath = doc.path
	}
	return next
}

// A página se perdeu (um frame chegou fora de ordem, outra janela…): o
// próximo frame leva o texto e o realce inteiros.
func resynced(state: model.State): model.State {
	mut next := state
	next.clientSerial = -1
	next.clientHv = -1
	next.clientHvPath = ""
	return next
}

// Sai do programa pouco depois, dando tempo para a página fechar a janela.
proc quitSoon(): void {
	hive.task.sleep(300)
	hive.term.exit(0)
}

// Relê o git de tempos em tempos, para mudanças feitas fora do Hive Studio.
proc watchGit(db: hive.syslink.Address): void {
	for ;; {
		hive.task.sleep(4000)
		async db(model.Cmd.Post(model.Msg.GitPoll()))
	}
}

func fallbackView(url: Str): hive.ui.View {
	return ui.column([ui.gap(12), ui.pad(32)], [
		ui.text([ui.size(ui.TextSize.Title())], "⬡ Hive Studio"),
		ui.text([], "Nenhum navegador Chromium (Edge, Chrome, Brave) foi encontrado para abrir a janela."),
		ui.link([], url, "Abrir o Hive Studio aqui"),
		ui.text([ui.tone(ui.Tone.Muted())], "Ou indique o executável em Configurações → Navegador da janela.")
	])
}

proc fallbackUpdate(url: mut Str, message: model.Msg): model.Msg {
	return message
}

proc main(): void {
	args := hive.term.args()
	mut folder := "."
	if args is [first, ...rest] {
		folder = first
	}
	prefs := settings.load()
	start := openRoot(model.initial(folder, prefs), folder)
	_watching := watch.set(watchedFolders(start))
	db := hive.syslink.spawnAddressed(serve, start)

	token := hive.crypto.randomHex(16)
	port := server.freePort()
	async hive.net.httpServe(port, server.page(token, port + 1, _))
	async hive.net.wsServe(port + 1, server.client(db, token, _))
	hive.task.sleep(150)

	url := "http://127.0.0.1:{port}/?token={token}"
	browser := server.launch(url, settings.folder() + "/janela", prefs.browser)
	if browser == "" {
		// Sem Chromium conhecido: a janela do próprio hive.ui (que cai numa aba
		// do navegador padrão) mostra o endereço da IDE.
		ui.window("Hive Studio", fallbackView, fallbackUpdate, url)
	}
	hive.term.status("Hive Studio em {url} ({browser})")
	async watchGit(db)
	async watchDocs(db)
	for ;; {
		hive.task.sleep(60000)
	}
}

// ── testes de fluxo ──────────────────────────────────────────────────────

proc scratch(): Str {
	folder := "./studio-test"
	if hive.file.makeDir(folder + "/lib") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\r\n\techo 1\r\n}\r\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/LEIAME.md", "# Título\n\nTexto **forte**.\n") is Result.Error(why) {
		panic why
	}
	return folder
}

proc fresh(folder: Str): model.State {
	return openRoot(model.initial(folder, settings.defaults()), folder)
}

func event(kind: Str, act: Str, arg: Str, text: Str, caret: Int): model.Event {
	return model.Event(kind, act, arg, text, caret, -1, 0, -1)
}

test "o analyze enche o painel ANÁLISE e cada função aponta para o arquivo dela" {
	folder := scratch()
	if hive.file.write(folder + "/lib/util.hive", "func dobro(n: Int): Int \{\n\treturn n * 2\n}\n") is Result.Error(why) {
		panic why
	}
	state := openDoc(fresh(folder), folder + "/main.hive")
	output := "  main.hive scores 90/100 over 2 callables\n  1 finding — 1 copy\n\n  50  util.dobro                          func, line 1\n        ·      n\n             a copy\n\n  60  main                                proc, line 1\n"
	next := withAnalysis(state, output)
	assert next.pane == model.Pane.AnalysisPane() && next.panelOpen
	assert len(next.hotspots) == 2
	if next.hotspots bounds 1 {
		assert next.hotspots[0].file == folder + "/lib/util.hive"
		assert next.hotspots[1].file == folder + "/main.hive"
		assert next.hotspots[0].detail == "a copy"
	}
	assert next.analysisReport == folder + "/main-analysis.html"
	assert indexOf(render.panel(next), "util.dobro") is Result.Ok(_)
	assert indexOf(render.titleBar(next), "Analyze") is Result.Ok(_)
}

test "abrir, editar, salvar e fechar mantém o fim de linha do arquivo" {
	folder := scratch()
	mut state := fresh(folder)
	assert len(state.tree) == 3
	state = openDoc(state, folder + "/main.hive")
	assert state.active == 0
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.eol == "\r\n"
		assert indexOf(doc.text, "\r") is Result.Error(_)
		assert indexOf(join(doc.hl.lines, "\n"), "<span class=\"tk\">proc</span>") is Result.Ok(_)
	}
	state = withText(state, "proc main(): void \{\n\techo 2\n}\n")
	assert model.anyDirty(state.docs)
	state = saveAll(state)
	assert !model.anyDirty(state.docs)
	if hive.file.read(folder + "/main.hive") is Result.Ok(text) {
		assert text == "proc main(): void \{\r\n\techo 2\r\n}\r\n"
	}
	state = closeDoc(state, 0)
	assert len(state.docs) == 0
	assert state.active == -1
}

test "expandir uma pasta e criar um arquivo dentro dela" {
	folder := scratch()
	mut state := fresh(folder)
	state = toggle(state, folder + "/lib")
	assert targetFolder(state) == folder + "/lib"
	state = create(state, "novo.hive", false)
	assert hive.file.exists(folder + "/lib/novo.hive")
	assert len(state.docs) == 1
	state = toggle(state, folder + "/lib")
	assert len(state.tree) == 3
	if hive.file.delete(folder + "/lib/novo.hive") is Result.Error(why) {
		panic why
	}
}

test "digitar sugere, e aceitar completa e reenvia o texto" {
	folder := scratch()
	mut state := fresh(folder)
	state = openDoc(state, folder + "/main.hive")
	typed := "proc main(): void \{\n\thive.file.re"
	if toMsg(state, event("edit", "", "", typed, len(typed))) is Result.Ok(message) {
		assert message == model.Msg.EditAt(typed, len(typed))
	}
	mut edited := withText(state, typed)
	edited.caret = len(typed)
	state = autoSuggest(edited)
	assert len(state.suggestions) > 0
	serial := state.textSerial
	state = acceptSuggestion(state, 0)
	assert len(state.suggestions) == 0
	assert state.textSerial == serial + 1
	assert activeText(state) == "proc main(): void \{\n\thive.file.read"
}

test "atalhos viram ações e podem ser regravados" {
	folder := scratch()
	mut state := fresh(folder)
	if toMsg(state, event("key", "", "", "Ctrl+`", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	} else {
		assert false
	}
	state.recording = "togglePanel"
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.KeyPressed("Ctrl+J")
	}
	state.settings.keymap = keys.assign("", "togglePanel", "Ctrl+J")
	state.recording = ""
	if toMsg(state, event("key", "", "", "Ctrl+J", 0)) is Result.Ok(message) {
		assert message == model.Msg.TogglePanel()
	}
}

