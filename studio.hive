// Uma pasta só para os testes do explorador: `lib/`, `LEIAME.md` e `main.hive`,
// sem o que os outros testes deixam em `studio-test`.
proc explorerFolder(name: Str): Str {
	folder := "./" + name
	if hive.file.makeDir(folder + "/lib") is Result.Error(why) {
		panic why
	}
	for each file in ["/main.hive", "/LEIAME.md"] {
		if hive.file.write(folder + file, "\n") is Result.Error(why) {
			panic why
		}
	}
	return folder
}

// O nome da linha selecionada no explorador, lido do HTML da barra lateral.
func selectedName(frame: model.Frame): Str {
	html := regionOf(frame, "side")
	if html is "{before} focus\"{row}</div>{after}" {
		if row is "{head}<span class=\"nm{cls}\">{name}</span>{tail}" {
			return name
		}
	}
	return ""
}

proc treeKeys(db: hive.syslink.Address, keys: Str): model.Frame {
	mut frame := ask(db, event("hello", "", "", "", 0))
	for each key in vim.tokens(keys) {
		frame = ask(db, event("tree", "", "", key, 0))
	}
	return frame
}

test "o explorador anda pelo teclado, :Ex põe o foco nele e a linha de comando funciona lá" {
	folder := explorerFolder("explorer-test")
	if hive.file.write(folder + "/lib/util.hive", "func one(): Int \{ return 1 }\n") is Result.Error(why) {
		panic why
	}
	mut start := fresh(folder)
	start.settings.vim = true
	start = openDoc(start, folder + "/lib/util.hive")
	db := hive.syslink.spawnAddressed(serve, start)

	// O explorador começa aberto: `:Ex` o fecha e deixa o foco no código.
	_toClose := vimKeys(db, ":")
	hidden := ask(db, event("act", "vimSubmit", "", "Ex", 0))
	assert !hidden.side
	assert hidden.focus == "editor"
	// Fechado, `:Ex` o abre com as pastas até o arquivo atual, seleciona-o e leva o foco.
	_prompt := vimKeys(db, ":")
	shown := ask(db, event("act", "vimSubmit", "", "Ex", 0))
	assert shown.focus == "explorer"
	assert selectedName(shown) == "util.hive"
	assert shown.side

	assert selectedName(treeKeys(db, "k")) == "lib"
	assert selectedName(treeKeys(db, "h")) == "lib"
	collapsed := treeKeys(db, "")
	assert indexOf(regionOf(collapsed, "side"), "util.hive") is Result.Error(_)
	assert selectedName(treeKeys(db, "l")) == "lib"
	assert selectedName(treeKeys(db, "l")) == "util.hive"
	assert selectedName(treeKeys(db, "h")) == "lib"
	assert selectedName(treeKeys(db, "G")) == "main.hive"
	assert selectedName(treeKeys(db, "gg")) == "lib"
	assert selectedName(treeKeys(db, "2j")) == "LEIAME.md"
	assert selectedName(treeKeys(db, "<Up><Down><Down>")) == "main.hive"
	assert selectedName(treeKeys(db, "3G")) == "LEIAME.md"

	// `:` no explorador abre a linha de comando; Esc volta o foco para ele.
	command := treeKeys(db, ":")
	assert command.focus == "vimCommand"
	assert indexOf(regionOf(command, "vimbar"), "data-vimcmd") is Result.Ok(_)
	assert ask(db, event("act", "vimCancel", "", "", 0)).focus == "explorer"
	_again := treeKeys(db, ":")
	stayed := ask(db, event("act", "vimSubmit", "", "noh", 0))
	assert stayed.focus == "explorer"

	// Enter num arquivo abre e leva o foco ao editor.
	opened := treeKeys(db, "G<CR>")
	assert indexOf(opened.title, "main.hive") is Result.Ok(_)
	assert opened.focus == "editor"
	// `:e .` volta ao explorador, com o arquivo aberto selecionado.
	_edit := vimKeys(db, ":")
	back := ask(db, event("act", "vimSubmit", "", "e .", 0))
	assert back.focus == "explorer"
	assert selectedName(back) == "main.hive"
	// Um comando que abre arquivo, vindo do explorador, leva o foco ao editor.
	_open := treeKeys(db, ":")
	util := ask(db, event("act", "vimSubmit", "", "e lib/util.hive", 0))
	assert util.focus == "editor"
	assert indexOf(util.title, "util.hive") is Result.Ok(_)
	assert treeKeys(db, "<Esc>").focus == "editor"

	// `:Ex` com o explorador aberto o fecha e volta ao código — do editor ou do
	// próprio explorador; fechado, abre de novo com o foco nele.
	_closing := vimKeys(db, ":")
	closed := ask(db, event("act", "vimSubmit", "", "Ex", 0))
	assert !closed.side
	assert closed.focus == "editor"
	_opening := vimKeys(db, ":")
	reopened := ask(db, event("act", "vimSubmit", "", "Ex", 0))
	assert reopened.side
	assert reopened.focus == "explorer"
	_fromTree := treeKeys(db, ":")
	fromTree := ask(db, event("act", "vimSubmit", "", "Lex", 0))
	assert !fromTree.side
	assert fromTree.focus == "editor"
	// Com uma pasta, `:Ex` vai até ela em vez de fechar.
	_folder := vimKeys(db, ":")
	_shown := ask(db, event("act", "vimSubmit", "", "Ex", 0))
	_lib := vimKeys(db, ":")
	lib := ask(db, event("act", "vimSubmit", "", "Ex lib", 0))
	assert lib.side
	assert lib.focus == "explorer"
	assert selectedName(lib) == "lib"
	_removed := hive.file.delete(folder + "/lib/util.hive")
}

test "sem o modo Vim, as setas andam no explorador mas j e k não" {
	folder := explorerFolder("explorer-plain-test")
	mut start := fresh(folder)
	start.selected = folder + "/lib"
	db := hive.syslink.spawnAddressed(serve, start)
	assert selectedName(treeKeys(db, "")) == "lib"
	assert selectedName(treeKeys(db, "j")) == "lib"
	assert selectedName(treeKeys(db, "<Down>")) == "LEIAME.md"
	assert selectedName(treeKeys(db, "<End>")) == "main.hive"
	opened := treeKeys(db, "<CR>")
	assert indexOf(opened.title, "main.hive") is Result.Ok(_)
	assert treeKeys(db, ":").focus != "vimCommand"
}

// O que o agente escreveu no terminal até aparecer `wanted` (ou o tempo acabar).
proc agentOutput(session: Int, wanted: Str): Str {
	mut seen := ""
	for waited := 0; waited < 3000; waited = waited + 50 {
		if hive.crypto.base64Decode(pty.read(session, 50)) is Result.Ok(raw) {
			seen = seen + raw
		}
		if indexOf(seen, wanted) is Result.Ok(_) {
			return seen
		}
	}
	return seen
}

test "o painel AGENTE abre cada agente num terminal de verdade, troca entre eles e reinicia" {
	folder := explorerFolder("agent-test")
	mut start := fresh(folder)
	start.settings.claudeCommand = "sh"
	start.settings.codexCommand = "programa-que-nao-existe-hive --flag"
	start = openDoc(start, folder + "/main.hive")
	db := hive.syslink.spawnAddressed(serve, start)

	opened := ask(db, event("act", "agent", "claude", "", 0))
	session := opened.agentShown
	assert session != 0
	assert opened.agentSessions == [session]
	assert opened.focus == "agent"
	assert opened.panel
	assert indexOf(regionOf(opened, "panelview"), "AGENTE") is Result.Ok(_)
	assert indexOf(regionOf(opened, "panelview"), "OpenCode") is Result.Ok(_)
	assert len(opened.agentKeys) == 3
	_typed := pty.write(session, "pwd; stty size\r")
	seen := agentOutput(session, "24 80")
	assert indexOf(seen, "agent-test") is Result.Ok(_)

	// Um agente que não está instalado diz o que fazer, e o outro continua vivo.
	missing := ask(db, event("act", "agent", "codex", "", 0))
	assert missing.agentShown == 0
	assert indexOf(regionOf(missing, "panelview"), "programa-que-nao-existe-hive: não encontrado no PATH") is Result.Ok(_)
	assert indexOf(regionOf(missing, "panelview"), "Configurações") is Result.Ok(_)
	back := ask(db, event("act", "agent", "claude", "", 0))
	assert back.agentShown == session
	assert pty.alive(session)

	// Reiniciar troca a sessão; a antiga termina.
	restarted := ask(db, event("act", "agentRestart", "claude", "", 0))
	assert restarted.agentShown != session
	assert restarted.agentSessions == [restarted.agentShown]
	for waited := 0; waited < 2000 && pty.alive(session); waited = waited + 50 {
		hive.task.sleep(50)
	}
	assert !pty.alive(session)

	// Quando o programa termina, o painel diz o código e oferece abrir de novo.
	_quit := pty.write(restarted.agentShown, "exit 5\r")
	mut notice := ""
	for waited := 0; waited < 3000 && indexOf(notice, "(código 5)") is Result.Error(_); waited = waited + 100 {
		hive.task.sleep(100)
		notice = regionOf(ask(db, event("hello", "", "", "", 0)), "panelview")
	}
	assert indexOf(notice, "O agente terminou (código 5)") is Result.Ok(_)
	assert indexOf(notice, "agentRestart") is Result.Ok(_)

	// O atalho do agente fecha o painel quando ele está à vista, e abre de novo.
	combo := keys.keysFor("", "agent")
	hidden := ask(db, event("key", "", "", combo, 0))
	assert !hidden.panel
	assert hidden.agentShown == 0
	assert ask(db, event("key", "", "", combo, 0)).panel
}

test "um arquivo aberto que muda no disco é relido; um com alteração por salvar, não" {
	folder := explorerFolder("disk-test")
	mut state := openDoc(fresh(folder), folder + "/main.hive")
	if hive.file.write(folder + "/main.hive", "proc main(): void \{\n\techo 42\n}\n") is Result.Error(why) {
		panic why
	}
	serial := state.textSerial
	state = refreshFromDisk(state)
	assert activeText(state) == "proc main(): void \{\n\techo 42\n}\n"
	assert state.textSerial == serial + 1
	assert !model.anyDirty(state.docs)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert len(doc.undo) == 1
	}
	assert refreshFromDisk(state).textSerial == state.textSerial
	state = withText(state, "// meu\n")
	if hive.file.write(folder + "/main.hive", "// do agente\n") is Result.Error(why) {
		panic why
	}
	kept := refreshFromDisk(state)
	assert activeText(kept) == "// meu\n"
	assert indexOf(kept.status, "mudou no disco") is Result.Ok(_)
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
}

test "o vigia do disco avisa quando algo muda nas pastas vigiadas, e só nelas" {
	folder := explorerFolder("watch-test")
	_quiet := watch.set([folder])
	_drained := watch.wait(100)
	assert len(watch.watched()) == 1
	if hive.file.write(folder + "/novo.txt", "oi") is Result.Error(why) {
		panic why
	}
	assert watch.wait(2000)
	assert !watch.wait(150)
	if hive.file.write(folder + "/lib/fora.txt", "oi") is Result.Error(why) {
		panic why
	}
	assert !watch.wait(300)
	_again := watch.set([folder, folder + "/lib"])
	_gone := hive.file.delete(folder + "/lib/fora.txt")
	assert watch.wait(2000)
	_cleanup := hive.file.delete(folder + "/novo.txt")
	_settled := watch.wait(200)
	_off := watch.set([])
}

test "arquivos criados e apagados por fora aparecem e somem da árvore; um aberto apagado fica riscado" {
	folder := explorerFolder("tree-live-test")
	mut state := openDoc(fresh(folder), folder + "/main.hive")
	names := state.tree | map(rowName) | join(",")
	assert names == "lib,LEIAME.md,main.hive"
	if hive.file.write(folder + "/agente.hive", "proc main(): void \{}\n") is Result.Error(why) {
		panic why
	}
	state = refreshTree(refreshFromDisk(state))
	assert (state.tree | map(rowName) | join(",")) == "lib,LEIAME.md,agente.hive,main.hive"
	_removed := hive.file.delete(folder + "/agente.hive")
	state = refreshTree(state)
	assert (state.tree | map(rowName) | join(",")) == "lib,LEIAME.md,main.hive"
	// Uma pasta expandida que some sai da árvore e da lista das expandidas.
	if hive.file.makeDir(folder + "/tmp") is Result.Error(why) {
		panic why
	}
	state = toggle(refreshTree(state), folder + "/tmp")
	assert workspace.isExpanded(state.expanded, folder + "/tmp")
	assert indexOf(watchedFolders(state), folder + "/tmp") is Result.Ok(_)
	_rmdir := hive.file.delete(folder + "/tmp")
	state = refreshTree(state)
	assert !workspace.isExpanded(state.expanded, folder + "/tmp")
	// O arquivo aberto é apagado: a aba fica, riscada; volta quando ele volta.
	_gone := hive.file.delete(folder + "/main.hive")
	state = refreshFromDisk(state)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert doc.gone
	}
	assert indexOf(render.tabStrip(state), "g-del") is Result.Ok(_)
	assert indexOf(state.status, "foi apagado do disco") is Result.Ok(_)
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
	state = refreshFromDisk(state)
	if render.activeDoc(state) is Result.Ok(doc) {
		assert !doc.gone
	}
	assert indexOf(render.tabStrip(state), "g-del") is Result.Error(_)
}

test "o texto relido do disco vem quieto; abrir um arquivo, não" {
	folder := explorerFolder("quiet-test")
	mut state := openDoc(fresh(folder), folder + "/LEIAME.md")
	state = openDoc(state, folder + "/main.hive")
	assert !render.frame(state).textQuiet
	// Mudou o que não está à vista: o documento é relido, o editor não muda.
	if hive.file.write(folder + "/LEIAME.md", "# Novo\n") is Result.Error(why) {
		panic why
	}
	serial := state.textSerial
	state = refreshFromDisk(state)
	assert state.textSerial == serial
	if state.docs bounds 0 {
		assert state.docs[0].text == "# Novo\n"
	}
	// Mudou o que está à vista: o editor recebe o texto, quieto.
	if hive.file.write(folder + "/main.hive", "proc main(): void \{}\n") is Result.Error(why) {
		panic why
	}
	state = refreshFromDisk(state)
	assert state.textSerial == serial + 1
	frame := render.frame(state)
	assert frame.textQuiet
	assert frame.text == "proc main(): void \{}\n"
	state = openDoc(state, folder + "/LEIAME.md")
	state.textSerial = state.textSerial + 1
	assert !render.frame(state).textQuiet
	assert watchedFolders(state) == [folder]
	if hive.file.write(folder + "/main.hive", "\n") is Result.Error(why) {
		panic why
	}
	if hive.file.write(folder + "/LEIAME.md", "\n") is Result.Error(why) {
		panic why
	}
}

func rowName(row: model.TreeRow): Str {
	return row.entry.name
}

test "sem o modo Vim, as teclas do Vim não fazem nada e o frame não mostra a barra" {
	folder := scratch()
	state := openDoc(fresh(folder), folder + "/main.hive")
	db := hive.syslink.spawnAddressed(serve, state)
	frame := vimKeys(db, "dd")
	assert frame.vim == ""
	assert regionOf(frame, "vimbar") == ""
	assert frame.text == "proc main(): void \{\n\techo 1\n}\n"
	if toMsg(state, event("vim", "", "0 30", "j", -1)) is Result.Ok(message) {
		assert message == model.Msg.VimKey("j", -1, "0 30")
	} else {
		assert false
	}
	if actionMsg(state, "toggleVim", 0) is Result.Ok(message) {
		assert message == model.Msg.ToggleSetting("vim")
	} else {
		assert false
	}
}
