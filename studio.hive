// Hive Studio — uma IDE simples para Hive, escrita em Hive.
//
//     hivec run studio.hive [pasta]
//
// O estado mora num serviço (`serve`, uma dobra sobre a caixa de mensagens).
// A página, numa janela Chromium em modo aplicativo, manda eventos pelo
// WebSocket e recebe de volta o frame já desenhado — ver lib/server.hive.

import hive.ui
import ./lib/model
import ./lib/workspace
import ./lib/analysis
import ./lib/toolchain
import ./lib/render
import ./lib/settings
import ./lib/highlight
import ./lib/complete
import ./lib/keys
import ./lib/server
import ./lib/git
import ./lib/navigate
import ./lib/process
import ./lib/native.go
import ./lib/dialogs
import ./lib/i18n
import ./lib/search
import ./lib/vim
import ./lib/agents
import ./lib/pty.go
import ./lib/watch.go

// ── explorador ───────────────────────────────────────────────────────────

proc reload(state: model.State): model.State {
	mut next := state
	next.tree = workspace.buildTree(state.root, 0, state.expanded, state.settings.showHidden)
	return next
}

proc gitRefresh(state: model.State): model.State {
	mut next := state
	next.git = git.refresh(state.root, state.git)
	return next
}

// Pede para a página focar um campo (`prompt`, `termInput`…) no próximo frame.
func withFocus(state: model.State, target: Str): model.State {
	mut next := state
	next.focus = target
	next.focusSerial = state.focusSerial + 1
	return next
}

// ── terminal ─────────────────────────────────────────────────────────────

// Lê o shell aos pedaços e entrega à janela até ele terminar.
proc watchTerminal(db: hive.syslink.Address, session: Int): void {
	for ;; {
		text := native.read(session)
		if text != "" {
			async db(model.Cmd.Post(model.Msg.TermOutput(session, text)))
		}
		if !native.alive(session) {
			rest := native.read(session)
			if rest != "" {
				async db(model.Cmd.Post(model.Msg.TermOutput(session, rest)))
			}
			async db(model.Cmd.Post(model.Msg.TermExited(session, native.code(session))))
			return
		}
		hive.task.sleep(40)
	}
}

// Abre o shell se ainda não houver um vivo.
proc ensureTerminal(state: model.State, from: hive.syslink.Address): model.State {
	mut next := state
	if state.term.session != 0 && native.alive(state.term.session) {
		return next
	}
	started := native.start(state.root)
	if started is Result.Ok(session) {
		next.term.session = session
		async watchTerminal(from, session)
	} else if started is Result.Error(why) {
		next.term.log = state.term.log + "não foi possível abrir o terminal: " + why + "\n"
	}
	return next
}

// Quanto do terminal fica guardado. É uma função e não um literal de
// propósito: `len(text) > 200000` com `len(text) - 150000` logo depois faz o
// hivec 0.2.8 travar na prova de limites.
func logLimit(): Int {
	return 200 * 1000
}

// O log do terminal guarda só o fim quando fica grande demais.
func capLog(text: Str): Str {
	size := len(text)
	limit := logLimit()
	if size > limit {
		return complete.skip(text, size - limit / 4 * 3)
	}
	return text
}

// ── git ──────────────────────────────────────────────────────────────────

// Relê do disco os documentos abertos de um arquivo que o git mudou.
proc reloadDocsOf(state: model.State, rel: Str): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	for i := 0; i < len(docs); i++ {
		doc := docs[i]
		if render.relPath(state, doc.path) == rel {
			if hive.file.read(doc.path) is Result.Ok(raw) {
				text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
				mut fresh := doc
				retext(fresh, text)
				fresh.saved = text
				docs[i] = fresh
			}
		}
	}
	next.docs = docs
	next.textSerial = state.textSerial + 1
	return next
}

// Um agente (ou outro programa) mudou um arquivo aberto: o que não tem nada por
// salvar é relido — e o `u` do modo Vim volta ao que era —; o que tem fica como
// está, com um aviso, para salvar não apagar a mudança sem querer. Um arquivo
// apagado continua aberto, riscado (`gone`), até ser fechado ou salvo de novo.
// Só o documento à vista muda o editor, e sem tirar o foco de ninguém
// (`quietSerial`).
proc refreshFromDisk(state: model.State): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	mut changed := false
	mut activeChanged := false
	for i := 0; i < len(docs); i++ {
		doc := docs[i]
		read := hive.file.read(doc.path)
		if read is Result.Ok(raw) {
			text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
			mut current := doc
			if doc.gone {
				current.gone = false
				if docs bounds i {
					docs[i] = current
				}
				changed = true
			}
			if text != doc.saved {
				if model.dirty(doc) {
					next.status = doc.name + " " + render.tx(state, "mudou no disco — salvar agora sobrescreve essa mudança")
				} else {
					mut fresh := current
					mut model.Snapshot[dyn] undo = doc.undo
					append(undo, model.Snapshot(doc.text, state.caret))
					if len(undo) > vim.undoLimit() {
						if undo bounds 0 {
							drop(undo, 0, 0)
						}
					}
					model.Snapshot[dyn] none = []
					retext(fresh, text)
					fresh.saved = text
					fresh.undo = undo
					fresh.redo = none
					if docs bounds i {
						docs[i] = fresh
					}
					changed = true
					if i == state.active {
						activeChanged = true
					}
				}
			}
		} else if read is Result.Error(why) {
			if why.reason == "NotFound" && !doc.gone {
				mut lost := doc
				lost.gone = true
				if docs bounds i {
					docs[i] = lost
				}
				changed = true
				next.status = doc.name + " " + render.tx(state, "foi apagado do disco")
			}
		}
	}
	if changed {
		next.docs = docs
	}
	if activeChanged {
		next.textSerial = state.textSerial + 1
		next.quietSerial = next.textSerial
	}
	return next
}

// Um arquivo ou pasta criado, apagado ou renomeado por fora aparece (ou some)
// na árvore; pastas expandidas que sumiram saem da lista, e as cores do git
// acompanham.
proc refreshTree(state: model.State): model.State {
	mut Str[dyn] expanded = []
	for each folder in state.expanded {
		if hive.file.exists(folder) {
			append(expanded, folder)
		}
	}
	fresh := workspace.buildTree(state.root, 0, expanded, state.settings.showHidden)
	if fresh == state.tree && len(expanded) == len(state.expanded) {
		return state
	}
	mut next := state
	next.tree = fresh
	next.expanded = expanded
	return gitRefresh(next)
}

// As pastas que valem vigiar: a raiz, as expandidas na árvore e as dos
// arquivos abertos.
func watchedFolders(state: model.State): Str[dyn] {
	mut Str[dyn] folders = [state.root]
	for each folder in state.expanded {
		if indexOf(folders, folder) is Result.Error(_) {
			append(folders, folder)
		}
	}
	for each doc in state.docs {
		parent := workspace.parentOf(doc.path)
		if indexOf(folders, parent) is Result.Error(_) {
			append(folders, parent)
		}
	}
	return folders
}

// Espera o disco mudar e avisa a janela na hora. Sem aviso (uma pasta de rede,
// o WSL), relê mesmo assim a cada três segundos.
proc watchDocs(db: hive.syslink.Address): void {
	mut idle := 0
	for ;; {
		changed := watch.wait(1000)
		idle++
		if changed || idle >= 3 {
			idle = 0
			async db(model.Cmd.Post(model.Msg.DiskPoll()))
		}
	}
}

proc afterGit(state: model.State, outcome: process.Output): model.State {
	mut next := gitRefresh(reload(state))
	if outcome.code != 0 {
		next.status = "git: " + process.firstLine(outcome.text)
		next.output = state.output + outcome.text
	}
	return next
}

proc openRoot(state: model.State, folder: Str): model.State {
	mut next := state
	target := workspace.normalize(folder)
	if hive.file.list(target) is Result.Error(why) {
		next.status = render.tx(state, "não foi possível abrir") + " {target}: {why.message}"
		return next
	}
	Str[dyn] closed = []
	next.root = target
	next.expanded = closed
	next.selected = ""
	next.status = render.tx(state, "pasta") + " {workspace.baseName(target)}"
	return gitRefresh(reload(next))
}

func isNot(candidate: Str, path: Str): Bool {
	return candidate != path
}

proc toggle(state: model.State, path: Str): model.State {
	mut next := state
	if workspace.isExpanded(state.expanded, path) {
		next.expanded = filter(state.expanded, isNot(_, path))
	} else {
		mut Str[dyn] expanded = state.expanded
		append(expanded, path)
		next.expanded = expanded
	}
	next.selected = path
	return reload(next)
}

// Onde um arquivo novo vai: a pasta selecionada, a pasta do arquivo
// selecionado, ou a raiz.
func targetFolder(state: model.State): Str {
	if state.selected == "" {
		return state.root
	}
	for each row in state.tree {
		if row.entry.path == state.selected {
			if row.entry.folder {
				return row.entry.path
			}
			return workspace.parentOf(row.entry.path)
		}
	}
	return state.root
}

// ── documentos ───────────────────────────────────────────────────────────

// Troca o texto de um documento refazendo o realce só das linhas que mudaram;
// a página recebe só essas linhas (`patch`, sobre a versão anterior).
proc retext(doc: mut model.Doc, text: Str): void {
	done := highlight.rehighlight(doc.hl, doc.text, text, model.colored(doc.path))
	doc.hl = done.result
	doc.patch = done.patch
	doc.version = doc.version + 1
	doc.text = text
}

func findDoc(docs: model.Doc[], path: Str): Result<Int, Bool> {
	for i := 0; i < len(docs); i++ {
		if docs[i].path == path {
			return Result.Ok(i)
		}
	}
	return Result.Error(false)
}

proc openDoc(state: model.State, path: Str): model.State {
	mut next := state
	next.selected = path
	next.editorView = model.EditorView.DocView()
	if findDoc(state.docs, path) is Result.Ok(index) {
		next.active = index
		return next
	}
	read := hive.file.read(path)
	if read is Result.Ok(raw) {
		mut eol := "\n"
		if indexOf(raw, "\r\n") is Result.Ok(_) {
			eol = "\r\n"
		}
		text := replaceAll(replaceAll(raw, "\r\n", "\n"), "\r", "\n")
		mut mode := "edit"
		if model.isMarkdown(path) {
			mode = "preview"
		}
		mut model.Doc[dyn] docs = state.docs
		append(docs, model.newDoc(path, workspace.baseName(path), text, eol, mode))
		next.docs = docs
		next.active = len(docs) - 1
		next.status = render.tx(state, "aberto") + " {workspace.baseName(path)}"
	} else if read is Result.Error(why) {
		next.status = render.tx(state, "não foi possível ler") + " {path}: {why.message}"
	}
	return next
}

proc saveDoc(doc: model.Doc): Result<model.Doc, Str> {
	mut contents := doc.text
	if doc.eol == "\r\n" {
		contents = replaceAll(doc.text, "\n", "\r\n")
	}
	if hive.file.write(doc.path, contents) is Result.Error(why) {
		return Result.Error("não foi possível salvar {doc.name}: {why.message}")
	}
	mut saved := doc
	saved.saved = doc.text
	saved.gone = false
	return Result.Ok(saved)
}

proc saveAll(state: model.State): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	mut count := 0
	for i := 0; i < len(docs); i++ {
		if model.dirty(docs[i]) {
			outcome := saveDoc(docs[i])
			if outcome is Result.Ok(doc) {
				docs[i] = doc
				count++
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
	}
	next.docs = docs
	if count > 0 {
		next.status = "{count} " + render.tx(state, "arquivo(s) salvo(s)")
	}
	return next
}

proc create(state: model.State, name: Str, folder: Bool): model.State {
	mut next := state
	if name == "" {
		return next
	}
	base := targetFolder(state)
	path := workspace.joinPath(base, name)
	if hive.file.exists(path) {
		next.status = "{name} " + render.tx(state, "já existe")
		return next
	}
	if folder {
		if hive.file.makeDir(path) is Result.Error(why) {
			next.status = "não foi possível criar {path}: {why.message}"
			return next
		}
	} else if hive.file.write(path, "") is Result.Error(why) {
		next.status = "não foi possível criar {path}: {why.message}"
		return next
	}
	if base != state.root && !workspace.isExpanded(state.expanded, base) {
		mut Str[dyn] expanded = state.expanded
		append(expanded, base)
		next.expanded = expanded
	}
	next = reload(next)
	next.selected = path
	if folder {
		return next
	}
	return openDoc(next, path)
}

proc closeDoc(state: model.State, index: Int): model.State {
	mut next := state
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		drop(docs, index, index)
		next.docs = docs
		if state.active >= index && state.active > 0 {
			next.active = state.active - 1
		}
		if len(docs) == 0 {
			next.active = -1
		}
	}
	return next
}

proc peekAt(state: model.State, file: Str, line: Int): model.State {
	mut next := state
	if findDoc(state.docs, file) is Result.Ok(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if state.docs bounds index {
			next.peekText = state.docs[index].text
		}
	} else {
		read := hive.file.read(file)
		if read is Result.Ok(text) {
			next = openDoc(state, file)
			next.peekText = replaceAll(text, "\r", "")
		} else if read is Result.Error(why) {
			next.status = render.tx(state, "não foi possível ler") + " {file}: {why.message}"
			return next
		}
	}
	next.peekFile = file
	next.peekLine = line
	return next
}

// Troca o texto do documento ativo (e o realce guardado dele).
proc withText(state: model.State, text: Str): model.State {
	mut next := state
	index := state.active
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		retext(docs[index], text)
	}
	next.docs = docs
	return next
}

func activeText(state: model.State): Str {
	if render.activeDoc(state) is Result.Ok(doc) {
		return doc.text
	}
	return ""
}

func clearSuggestions(state: model.State): model.State {
	mut next := state
	model.Suggestion[dyn] none = []
	next.suggestions = none
	next.suggestIndex = 0
	return next
}

// Sugere só enquanto um nome está sendo digitado, ou logo depois de um ponto.
func autoSuggest(state: model.State): model.State {
	mut next := clearSuggestions(state)
	if !state.settings.autocomplete {
		return next
	}
	text := activeText(state)
	ctx := complete.context(text, state.caret)
	if ctx.prefix != "" || ctx.qualifier != "" {
		next.suggestions = complete.suggest(text, state.caret, 12)
	}
	return next
}

proc acceptSuggestion(state: model.State, index: Int): model.State {
	if state.suggestions bounds index {
		word := state.suggestions[index].word
		edit := complete.accept(activeText(state), state.caret, word)
		mut next := withText(state, edit.text)
		next.caret = edit.caret
		next.textSerial = state.textSerial + 1
		return clearSuggestions(next)
	}
	return clearSuggestions(state)
}

// ── configurações ────────────────────────────────────────────────────────

proc applySettings(state: model.State, prefs: settings.Settings): model.State {
	mut next := state
	next.settings = prefs
	if settings.save(prefs) is Result.Error(why) {
		next.status = "não foi possível salvar as configurações: {why}"
	}
	return next
}

proc toggleSetting(state: model.State, name: Str): model.State {
	mut prefs := state.settings
	if name == "lineNumbers" {
		prefs.lineNumbers = !prefs.lineNumbers
	} else if name == "showHidden" {
		prefs.showHidden = !prefs.showHidden
	} else if name == "saveBeforeRun" {
		prefs.saveBeforeRun = !prefs.saveBeforeRun
	} else if name == "autocomplete" {
		prefs.autocomplete = !prefs.autocomplete
	} else if name == "vim" {
		prefs.vim = !prefs.vim
	}
	mut next := applySettings(state, prefs)
	if name == "showHidden" {
		return reload(next)
	}
	if name == "vim" {
		next.vim = vim.reset(state.vim)
		next.status = render.tx(state, "modo Vim desligado")
		if prefs.vim {
			next.status = render.tx(state, "modo Vim ligado")
		}
		return withFocus(clearSuggestions(next), "editor")
	}
	return next
}

// O resultado do `hivec analyze` vai para o painel ANÁLISE: cada função com o
// arquivo onde ela está, para o clique abrir na linha certa.
proc withAnalysis(state: model.State, output: Str): model.State {
	mut next := state
	target := render.targetOf(state)
	report := analysis.parseAnalyze(output)
	modules := importedModules(target)
	mut model.Hotspot[dyn] spots = []
	for each spot in report.spots {
		mut found := spot
		found.file = moduleFile(target, modules, analysis.moduleOf(spot.name))
		append(spots, found)
	}
	next.analysisHead = report.head
	next.hotspots = spots
	next.analysisReport = ""
	if target is "{stem}.hive" {
		next.analysisReport = stem + "-analysis.html"
	}
	next.pane = model.Pane.AnalysisPane()
	next.panelOpen = true
	if report.head bounds 0 {
		next.status = "analyze: " + report.head[0]
	}
	return next
}

// Os `import ./caminho` do arquivo de entrada, como "módulo=arquivo".
proc importedModules(target: Str): Str[dyn] {
	mut Str[dyn] found = []
	if hive.file.read(target) is Result.Ok(text) {
		folder := workspace.parentOf(target)
		for each raw in split(replaceAll(text, "\r", ""), "\n") {
			if raw is "import ./{path}" {
				if path is "{stem}.go" {
					continue
				}
				append(found, workspace.baseName(path) + "=" + folder + "/" + path + ".hive")
			}
		}
	}
	return found
}

// O arquivo de um módulo: o que o arquivo de entrada importa com esse nome, ou
// um `lib/<módulo>.hive` / `<módulo>.hive` ao lado dele (os de segunda mão).
proc moduleFile(target: Str, modules: Str[], module: Str): Str {
	if module == "" {
		return target
	}
	for each pair in modules {
		if pair is "{name}={file}" {
			if name == module {
				return file
			}
		}
	}
	folder := workspace.parentOf(target)
	for each candidate in [folder + "/lib/" + module + ".hive", folder + "/" + module + ".hive"] {
		if hive.file.exists(candidate) {
			return candidate
		}
	}
	return target
}

func summary(state: model.State, command: Str, ok: Bool, problems: Int): Str {
	if ok {
		return "{command}: ok"
	}
	if problems > 0 {
		return "{command}: {problems} " + render.tx(state, "problema(s)")
	}
	return "{command}: " + render.tx(state, "falhou")
}

func clampInt(value: Int, low: Int, high: Int): Int {
	if value < low {
		return low
	}
	if value > high {
		return high
	}
	return value
}

// ── buscas ───────────────────────────────────────────────────────────────

// A primeira ocorrência da busca a partir do cursor (ou a primeira de todas).
func firstMatchFrom(state: model.State, caret: Int): Int {
	matches := render.findMatches(state)
	for i := 0; i < len(matches); i++ {
		if matches[i] >= caret {
			return i
		}
	}
	return 0
}

// Abre um arquivo e põe o cursor numa linha e coluna (a partir de 1 e de 0).
proc jumpTo(state: model.State, path: Str, line: Int, column: Int): model.State {
	target := workspace.tidy(path)
	mut jumped := state
	if workspace.tidy(render.activePath(state)) != target {
		jumped = openDoc(state, target)
	}
	jumped.editorView = model.EditorView.DocView()
	jumped.caret = navigate.offsetOf(activeText(jumped), line, column)
	jumped.textSerial = jumped.textSerial + 1
	return clearSuggestions(jumped)
}

// ── modo Vim ─────────────────────────────────────────────────────────────

// As teclas vão para o motor do Vim quando ele está ligado e há um documento
// no editor.
func vimActive(state: model.State): Bool {
	return state.settings.vim && render.showsDoc(state) && render.activeDoc(state) is Result.Ok(_)
}

// O documento ativo como o motor do Vim o vê. Um `caret` negativo é "o que o
// estado já tem": a página só manda o dela quando o mudou por conta própria.
// `view` é "primeira linha visível, quantas linhas cabem".
func vimEditor(state: model.State, caret: Int, view: Str): vim.Editor {
	mut top := 0
	mut rows := 30
	if view is "{first} {count}" {
		top = numberOr(first, 0)
		rows = numberOr(count, 30)
	}
	mut cursor := state.caret
	if caret >= 0 {
		cursor = caret
	}
	model.Msg[dyn] none = []
	model.Snapshot[dyn] empty = []
	mut editor := vim.Editor(text: "", caret: cursor, vim: state.vim, undo: empty, redo: empty, dirty: false,
		anyDirty: model.anyDirty(state.docs), numbers: state.settings.lineNumbers, active: state.active,
		top: top, rows: rows, tab: state.settings.tabSize, scroll: -1, clip: "", effects: none)
	if render.activeDoc(state) is Result.Ok(doc) {
		editor.text = doc.text
		editor.undo = doc.undo
		editor.redo = doc.redo
		editor.dirty = model.dirty(doc)
	}
	return editor
}

// Leva o que o motor devolveu ao documento ativo e despacha os efeitos
// (salvar, fechar, abrir…) como mensagens comuns.
proc vimApply(state: model.State, out: vim.Editor, from: hive.syslink.Address): model.State {
	mut next := state
	index := state.active
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		mut doc := docs[index]
		if doc.text != out.text {
			retext(doc, out.text)
			next.textSerial = state.textSerial + 1
		}
		doc.undo = out.undo
		doc.redo = out.redo
		docs[index] = doc
	}
	next.docs = docs
	next.caret = out.caret
	mut v := out.vim
	v.serial = state.vim.serial + 1
	v.scroll = out.scroll
	if out.clip != "" {
		v.clip = out.clip
		v.clipSerial = state.vim.clipSerial + 1
	}
	if v.prompt != state.vim.prompt || v.command != state.vim.command {
		v.searchSerial = state.vim.searchSerial + 1
	}
	next.vim = v
	if v.mode != model.VimMode.InsertMode() {
		next = clearSuggestions(next)
	}
	if state.vim.prompt == "" && v.prompt != "" {
		next = withFocus(next, "vimCommand")
	}
	focused := next.focusSerial
	for each effect in out.effects {
		next = step(next, effect, from)
	}
	// A linha de comando fechou: o foco volta para onde ela foi aberta — a não
	// ser que o comando tenha levado o foco (`:Ex`, `:term`) ou aberto um arquivo.
	if state.vim.prompt != "" && v.prompt == "" && next.focusSerial == focused {
		mut back := "editor"
		if state.vim.promptFrom == "explorer" && render.activePath(next) == render.activePath(state) {
			back = "explorer"
		}
		next = withFocus(next, back)
	}
	// `:w`, `:e`… respondem na barra do Vim com o que o estúdio disse.
	if len(out.effects) > 0 && v.message == "" && next.status != state.status {
		Str[dyn] none = []
		next.vim.message = next.status
		next.vim.args = none
	}
	return next
}

// Guarda o texto de antes numa alteração que não passou pelo motor (colar no
// modo normal), para o `u` desfazê-la.
func withUndo(state: model.State, before: model.Snapshot): model.State {
	mut next := state
	index := state.active
	mut model.Doc[dyn] docs = state.docs
	if docs bounds index {
		mut doc := docs[index]
		mut model.Snapshot[dyn] undo = doc.undo
		append(undo, before)
		if len(undo) > vim.undoLimit() {
			if undo bounds 0 {
				drop(undo, 0, 0)
			}
		}
		model.Snapshot[dyn] none = []
		doc.undo = undo
		doc.redo = none
		docs[index] = doc
	}
	next.docs = docs
	return next
}

func isAbsolute(path: Str): Bool {
	clean := replaceAll(path, "\\", "/")
	return complete.startsWith(clean, "/") || clean is "{drive}:/{rest}"
}

// Um caminho digitado num comando, relativo à pasta aberta.
func resolvePath(state: model.State, path: Str): Str {
	target := workspace.tidy(replaceAll(path, "\\", "/"))
	if isAbsolute(target) {
		return target
	}
	return workspace.joinPath(state.root, target)
}

// `:e arquivo`: abre (e cria, se ainda não existir) um arquivo, relativo à pasta aberta.
proc vimEdit(state: model.State, path: Str): model.State {
	target := resolvePath(state, path)
	if hive.file.list(target) is Result.Ok(_) {
		return focusExplorer(state, target)
	}
	if !hive.file.exists(target) {
		if hive.file.write(target, "") is Result.Error(why) {
			mut failed := state
			failed.status = "não foi possível criar {target}: {why.message}"
			return failed
		}
		mut created := reload(openDoc(state, target))
		created.status = render.tx(state, "novo arquivo") + " {workspace.baseName(target)}"
		return created
	}
	return openDoc(state, target)
}

proc updateVim(state: model.State, message: model.Msg, from: hive.syslink.Address): Result<model.State, Bool> {
	mut next := state
	if message is model.Msg.VimKey(key, caret, view) {
		next.vim.acked = state.vim.acked + 1
		if !vimActive(state) {
			return Result.Ok(next)
		}
		idle := state.vim.mode == model.VimMode.NormalMode() && len(state.vim.pending) == 0 && state.vim.prompt == ""
		mut done := vimApply(next, vim.press(vimEditor(next, caret, view), key), from)
		// Esc sem nada pendente fecha o que estiver aberto (busca, sugestões…).
		if vim.isEscape(key) && idle {
			if escapeMsg(done) is Result.Ok(closing) {
				done = step(done, closing, from)
			}
		}
		return Result.Ok(done)
	} else if message is model.Msg.VimMouse(start, end) {
		if !vimActive(state) {
			next.caret = start
			return Result.Ok(next)
		}
		return Result.Ok(vimApply(state, vim.click(vimEditor(state, start, ""), start, end), from))
	} else if message is model.Msg.VimTyped(text) {
		next.vim.command = text
		if state.vim.prompt == "/" || state.vim.prompt == "?" {
			next.vim.searchSerial = state.vim.searchSerial + 1
		}
	} else if message is model.Msg.VimSubmit(text) {
		if state.vim.prompt == "" || !state.settings.vim {
			return Result.Ok(state)
		}
		return Result.Ok(vimApply(state, vim.submit(vimEditor(state, -1, ""), text), from))
	} else if message is model.Msg.VimCancel {
		if state.settings.vim {
			return Result.Ok(vimApply(state, vim.cancel(vimEditor(state, -1, "")), from))
		}
		next.vim.prompt = ""
		next.vim.command = ""
		next.vim.serial = state.vim.serial + 1
		return Result.Ok(withFocus(next, "editor"))
	} else if message is model.Msg.VimHistory(delta) {
		next.vim = vim.browseHistory(state.vim, delta)
	} else if message is model.Msg.VimEdit(path) {
		return Result.Ok(vimEdit(state, path))
	} else if message is model.Msg.FocusExplorer(path) {
		if path != "" {
			return Result.Ok(focusExplorer(state, resolvePath(state, path)))
		}
		// `:Ex` com o explorador já aberto o fecha e volta ao código, como o `:Lex`.
		if state.sideOpen && state.side == model.SideView.ExplorerSide() {
			next.sideOpen = false
			next.treeKeys = ""
			if render.activeDoc(state) is Result.Ok(_) {
				return Result.Ok(withFocus(next, "editor"))
			}
			return Result.Ok(next)
		}
		return Result.Ok(focusExplorer(state, ""))
	} else if message is model.Msg.TreeKey(key) {
		return Result.Ok(treeKey(state, key))
	} else if message is model.Msg.VimReload {
		if render.activeDoc(state) is Result.Ok(doc) {
			next = reloadDocsOf(state, render.relPath(state, doc.path))
			next.status = render.tx(state, "aberto") + " {doc.name}"
		}
	} else {
		return Result.Error(false)
	}
	return Result.Ok(next)
}

// ── agentes: Claude Code, Codex e OpenCode ───────────────────────────────

// Espera o agente terminar e avisa a janela.
proc watchAgent(db: hive.syslink.Address, session: Int): void {
	for ; pty.alive(session); {
		hive.task.sleep(300)
	}
	async db(model.Cmd.Post(model.Msg.AgentExited(session, pty.code(session))))
}

func agentSession(state: model.State, agent: Str): model.AgentSession {
	return agents.sessionOf(state.agents, agent)
}

// Guarda a sessão de um agente, no lugar da que ele tinha.
func withAgent(state: model.State, session: model.AgentSession): model.State {
	mut next := state
	mut model.AgentSession[dyn] all = []
	mut replaced := false
	for each s in state.agents.sessions {
		if s.agent == session.agent {
			append(all, session)
			replaced = true
		} else {
			append(all, s)
		}
	}
	if !replaced {
		append(all, session)
	}
	next.agents.sessions = all
	return next
}

// Abre o agente na pasta aberta: o programa do próprio usuário, num terminal de verdade.
proc launchAgent(state: model.State, agent: Str, from: hive.syslink.Address): model.State {
	started := agents.start(state.settings, agent, state.root)
	if started is Result.Ok(session) {
		async watchAgent(from, session)
		return withAgent(state, model.AgentSession(agent, session, false, 0, ""))
	} else if started is Result.Error(why) {
		return withAgent(state, model.AgentSession(agent, 0, false, 0, why))
	}
}

func showingAgent(state: model.State): Bool {
	return state.panelOpen && state.pane == model.Pane.AgentPane()
}

proc updateAgents(state: model.State, message: model.Msg, from: hive.syslink.Address): Result<model.State, Bool> {
	mut next := state
	if message is model.Msg.ShowAgent(agent) {
		mut chosen := agent
		if !agents.isAgent(chosen) {
			chosen = state.agents.current
		}
		next.agents.current = chosen
		next.pane = model.Pane.AgentPane()
		next.panelOpen = true
		if agentSession(next, chosen).session == 0 {
			next = launchAgent(next, chosen, from)
		}
		return Result.Ok(withFocus(next, "agent"))
	} else if message is model.Msg.AgentRestart(agent) {
		mut chosen := agent
		if !agents.isAgent(chosen) {
			chosen = state.agents.current
		}
		old := agentSession(state, chosen)
		if old.session != 0 {
			_stopped := pty.stop(old.session)
		}
		next = withAgent(state, model.AgentSession(chosen, 0, false, 0, ""))
		next.agents.current = chosen
		next.pane = model.Pane.AgentPane()
		next.panelOpen = true
		return Result.Ok(withFocus(launchAgent(next, chosen, from), "agent"))
	} else if message is model.Msg.AgentExited(session, code) {
		for each s in state.agents.sessions {
			if s.session == session && session != 0 {
				next = withAgent(next, model.AgentSession(s.agent, session, true, code, ""))
			}
		}
	} else if message is model.Msg.AgentCommand(agent, text) {
		mut prefs := state.settings
		if agent == "codex" {
			prefs.codexCommand = text
		} else if agent == "opencode" {
			prefs.opencodeCommand = text
		} else {
			prefs.claudeCommand = text
		}
		next = applySettings(state, prefs)
		// Um agente que não abriu tenta de novo com o comando novo.
		if agentSession(state, agent).session == 0 {
			next = withAgent(next, model.AgentSession(agent, 0, false, 0, ""))
		}
	} else {
		return Result.Error(false)
	}
	return Result.Ok(next)
}

// ── o explorador pelo teclado ────────────────────────────────────────────

// A linha selecionada da árvore, ou -1.
func selectedRow(state: model.State): Int {
	for i := 0; i < len(state.tree); i++ {
		if state.tree[i].entry.path == state.selected {
			return i
		}
	}
	return -1
}

func selectRow(state: model.State, index: Int): model.State {
	mut next := state
	if state.tree bounds index {
		next.selected = state.tree[index].entry.path
	}
	return next
}

// Abre as pastas até `path` e o seleciona, para ele aparecer na árvore.
proc revealPath(state: model.State, path: Str): model.State {
	mut next := state
	mut Str[dyn] expanded = state.expanded
	root := workspace.normalize(state.root)
	mut folder := workspace.parentOf(path)
	for n := 0; n < 64 && complete.startsWith(folder, root + "/"); n++ {
		if !workspace.isExpanded(expanded, folder) {
			append(expanded, folder)
		}
		folder = workspace.parentOf(folder)
	}
	next.expanded = expanded
	next.selected = path
	return reload(next)
}

// `:Ex` (e `:e .`): mostra o explorador com `target` — o arquivo atual quando
// vazio; uma pasta, aberta — selecionado, e põe o foco nele. `target` já vem
// resolvido (`resolvePath`).
proc focusExplorer(state: model.State, path: Str): model.State {
	mut next := state
	next.sideOpen = true
	next.side = model.SideView.ExplorerSide()
	next.treeKeys = ""
	mut target := path
	if target == "" {
		target = render.activePath(state)
	}
	if target != "" && workspace.normalize(target) != workspace.normalize(state.root) {
		next = revealPath(next, target)
		if hive.file.list(target) is Result.Ok(_) && !workspace.isExpanded(next.expanded, target) {
			next = toggle(next, target)
		}
	} else if selectedRow(next) < 0 {
		next = selectRow(next, 0)
	}
	return withFocus(next, "explorer")
}

// Uma tecla com o foco no explorador. Setas, Enter, Home e End sempre; com o
// modo Vim, também `j`, `k`, `h`, `l`, `o`, `gg`, `G`, contagens e `:`.
proc treeKey(state: model.State, key: Str): model.State {
	mut next := state
	next.treeKeys = ""
	if key == "<Esc>" {
		if render.activeDoc(state) is Result.Ok(_) {
			return withFocus(next, "editor")
		}
		return next
	}
	if !(state.sideOpen && state.side == model.SideView.ExplorerSide()) {
		return next
	}
	vimKeys := state.settings.vim
	pending := state.treeKeys
	waitingG := vim.endsWith(pending, "g")
	mut digits := pending
	if waitingG {
		digits = complete.take(pending, len(pending) - 1)
	}
	if vimKeys && !waitingG && vim.digitOf(key) >= 0 && (key != "0" || digits != "") {
		next.treeKeys = pending + key
		return next
	}
	rows := len(state.tree)
	current := selectedRow(state)
	count := clampInt(numberOr(digits, 1), 1, 100000)
	hasCount := digits != ""
	mut row := model.TreeRow(model.Entry("", "", false), 0, false)
	if state.tree bounds current {
		row = state.tree[current]
	}
	if vimKeys && key == "g" {
		if !waitingG {
			next.treeKeys = pending + "g"
			return next
		}
		if hasCount {
			return selectRow(next, clampInt(count - 1, 0, rows - 1))
		}
		return selectRow(next, 0)
	} else if key == "<Down>" || (vimKeys && key == "j") {
		if current < 0 {
			return selectRow(next, 0)
		}
		return selectRow(next, clampInt(current + count, 0, rows - 1))
	} else if key == "<Up>" || (vimKeys && key == "k") {
		if current < 0 {
			return selectRow(next, 0)
		}
		return selectRow(next, clampInt(current - count, 0, rows - 1))
	} else if key == "<Home>" {
		return selectRow(next, 0)
	} else if key == "<End>" || (vimKeys && key == "G") {
		if vimKeys && hasCount {
			return selectRow(next, clampInt(count - 1, 0, rows - 1))
		}
		return selectRow(next, rows - 1)
	} else if key == "<CR>" || (vimKeys && key == "o") {
		if current < 0 {
			return next
		} else if row.entry.folder {
			return toggle(next, row.entry.path)
		}
		return withFocus(openDoc(next, row.entry.path), "editor")
	} else if key == "<Right>" || (vimKeys && key == "l") {
		if current < 0 {
			return next
		} else if !row.entry.folder {
			return withFocus(openDoc(next, row.entry.path), "editor")
		} else if !row.open {
			return toggle(next, row.entry.path)
		}
		child := current + 1
		if state.tree bounds child {
			if state.tree[child].depth > row.depth {
				return selectRow(next, child)
			}
		}
		return next
	} else if key == "<Left>" || (vimKeys && key == "h") {
		if current < 0 {
			return next
		} else if row.entry.folder && row.open {
			return toggle(next, row.entry.path)
		}
		parent := workspace.parentOf(row.entry.path)
		for i := current - 1; i >= 0; i-- {
			if state.tree bounds i {
				if state.tree[i].entry.path == parent {
					return selectRow(next, i)
				}
			}
		}
		return next
	} else if vimKeys && key == ":" {
		next.vim.prompt = ":"
		next.vim.command = ""
		next.vim.historyAt = len(state.vim.history)
		next.vim.promptFrom = "explorer"
		return withFocus(next, "vimCommand")
	}
	return next
}

// ── a dobra ──────────────────────────────────────────────────────────────

// Painel, terminal, git e navegação: separados da dobra principal para cada
// proc continuar pequeno. `Error` quando a mensagem não é daqui.
proc updateTools(state: model.State, message: model.Msg, from: hive.syslink.Address): Result<model.State, Bool> {
	mut next := state
	mut prefs := state.settings
	if message is model.Msg.TogglePanelMax {
		next.panelMax = !state.panelMax
		next.panelOpen = true
	} else if message is model.Msg.SetPanelHeight(height) {
		prefs.panelHeight = clampInt(height, 80, 4000)
		next = applySettings(state, prefs)
		next.panelMax = false
	} else if message is model.Msg.TermTyped(text) {
		next.term.input = text
	} else if message is model.Msg.TermSubmit(text) {
		next = ensureTerminal(state, from)
		if native.write(next.term.session, text + "\n") is Result.Error(why) {
			next.term.log = capLog(next.term.log + "\n[não foi possível escrever no terminal: " + why + "]\n")
		}
		if !server.isWindows() {
			next.term.log = capLog(next.term.log + text + "\n")
		}
		mut Str[dyn] history = state.term.history
		if text != "" {
			append(history, text)
		}
		next.term.history = history
		next.term.historyAt = len(history)
		next.term.input = ""
	} else if message is model.Msg.TermHistory(delta) {
		count := len(state.term.history)
		at := clampInt(state.term.historyAt + delta, 0, count)
		next.term.historyAt = at
		next.term.input = ""
		if state.term.history bounds at {
			next.term.input = state.term.history[at]
		}
	} else if message is model.Msg.TermRestart {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		next.term.session = 0
		next.term.log = capLog(state.term.log + "^C\n")
		return Result.Ok(withFocus(ensureTerminal(next, from), "termInput"))
	} else if message is model.Msg.TermClear {
		next.term.log = ""
	} else if message is model.Msg.TermOutput(session, text) {
		if session == state.term.session {
			next.term.log = capLog(state.term.log + text)
		}
	} else if message is model.Msg.TermExited(session, code) {
		if session == state.term.session {
			next.term.log = capLog(state.term.log + "\n[terminal encerrado, código {code}]\n")
			next.term.session = 0
		}
		return Result.Ok(gitRefresh(reload(next)))
	} else if message is model.Msg.GitPoll || message is model.Msg.GitRefresh {
		return Result.Ok(gitRefresh(next))
	} else if message is model.Msg.DiskPoll {
		return Result.Ok(refreshTree(refreshFromDisk(next)))
	} else if message is model.Msg.GitStage(path) {
		return Result.Ok(afterGit(state, git.stage(state.git, path)))
	} else if message is model.Msg.GitUnstage(path) {
		return Result.Ok(afterGit(state, git.unstage(state.git, path)))
	} else if message is model.Msg.GitStageAll {
		return Result.Ok(afterGit(state, git.stageAll(state.git)))
	} else if message is model.Msg.GitUnstageAll {
		return Result.Ok(afterGit(state, git.unstageAll(state.git)))
	} else if message is model.Msg.GitAskDiscard(path) {
		next.git.confirm = path
	} else if message is model.Msg.GitCancelConfirm {
		next.git.confirm = ""
	} else if message is model.Msg.GitDiscard(path) {
		mut rel := ""
		for each file in state.git.files {
			if file.path == path {
				rel = file.rel
			}
		}
		next.git.confirm = ""
		next = afterGit(next, git.discard(state.git, path))
		return Result.Ok(reloadDocsOf(next, rel))
	} else if message is model.Msg.GitMessageTyped(text) {
		next.git.message = text
	} else if message is model.Msg.GitCommit {
		if state.git.message == "" || state.git.busy != "" || len(state.git.files) == 0 {
			return Result.Ok(state)
		}
		if state.settings.saveBeforeRun {
			next = saveAll(state)
		}
		next.git.busy = "commit"
		async git.commitAsync(from, state.git.top, state.git.message, git.count(state.git, true) == 0)
	} else if message is model.Msg.GitPush {
		if state.git.busy != "" || !state.git.repo {
			return Result.Ok(state)
		}
		next.git.busy = "push"
		Str[dyn] arguments = ["push", "-u", "origin", "HEAD"]
		async git.runAsync(from, state.git.top, "push", arguments)
	} else if message is model.Msg.GitPull {
		if state.git.busy != "" || !state.git.repo {
			return Result.Ok(state)
		}
		next.git.busy = "pull"
		Str[dyn] arguments = ["pull", "--ff-only"]
		async git.runAsync(from, state.git.top, "pull", arguments)
	} else if message is model.Msg.GitInit {
		return Result.Ok(afterGit(state, process.run("git", ["init"], state.root)))
	} else if message is model.Msg.GitDone(command, output, ok) {
		next.git.busy = ""
		next.output = state.output + "$ git " + command + "\n" + output
		if ok {
			next.status = "git {command}: ok"
			if command == "commit" {
				next.git.message = ""
			}
		} else {
			next.status = "git {command} " + render.tx(state, "falhou — veja SAÍDA")
			next.pane = model.Pane.OutputPane()
			next.panelOpen = true
		}
		return Result.Ok(gitRefresh(reload(next)))
	} else if message is model.Msg.GitShow(hash) {
		shown := git.show(state.git, hash)
		if shown is Result.Ok(commit) {
			mut title := commit.subject
			if len(title) > 40 {
				title = complete.take(title, 40) + "…"
			}
			next.commit = model.CommitTab(commit.hash, commit.short + " " + title, render.commitPage(commit, state.words))
			next.editorView = model.EditorView.CommitPage()
			next.status = "commit {commit.short}"
		} else if shown is Result.Error(why) {
			next.status = "git: " + why
		}
	} else if message is model.Msg.GitShowWork(path) {
		commit := git.working(state.git, path)
		next.commit = model.CommitTab("work:" + path, "± " + workspace.baseName(path), render.commitPage(commit, state.words))
		next.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.FocusCommit {
		next.editorView = model.EditorView.CommitPage()
	} else if message is model.Msg.CloseCommit {
		next.commit = model.CommitTab("", "", "")
		next.editorView = model.EditorView.DocView()
	} else if message is model.Msg.FindOpen(text) {
		next.find.open = true
		if text != "" && indexOf(text, "\n") is Result.Error(_) {
			next.find.text = text
		}
		next.find.index = firstMatchFrom(next, state.caret)
		next.find.serial = state.find.serial + 1
		return Result.Ok(withFocus(next, "find"))
	} else if message is model.Msg.FindTyped(text) {
		next.find.text = text
		next.find.index = firstMatchFrom(next, state.caret)
		next.find.serial = state.find.serial + 1
	} else if message is model.Msg.FindNext || message is model.Msg.FindPrev {
		count := len(render.findMatches(state))
		if count > 0 {
			mut delta := 1
			if message is model.Msg.FindPrev {
				delta = -1
			}
			next.find.index = ((state.find.index + delta) % count + count) % count
			next.find.serial = state.find.serial + 1
		}
	} else if message is model.Msg.FindToggleCase {
		next.find.caseSensitive = !state.find.caseSensitive
		next.find.index = firstMatchFrom(next, state.caret)
		next.find.serial = state.find.serial + 1
	} else if message is model.Msg.FindClose {
		next.find.open = false
		return Result.Ok(withFocus(next, "editor"))
	} else if message is model.Msg.SearchTyped(text) {
		next.search.text = text
	} else if message is model.Msg.SearchRun || message is model.Msg.SearchToggleCase {
		if message is model.Msg.SearchToggleCase {
			next.search.caseSensitive = !state.search.caseSensitive
		}
		if next.search.text == "" {
			return Result.Ok(next)
		}
		found := search.searchProject(state.root, next.search.text, next.search.caseSensitive, state.settings.showHidden, 2000)
		next.search.hits = found.hits
		next.search.files = found.files
		next.search.truncated = found.truncated
		next.search.done = true
		next.sideOpen = true
		next.side = model.SideView.SearchSide()
	} else if message is model.Msg.OpenAt(path, line, column) {
		return Result.Ok(jumpTo(state, path, line, column))
	} else if message is model.Msg.PaletteOpen {
		next.palette = model.Palette(true, "", 0, search.allFiles(state.root, state.settings.showHidden, 20000))
		return Result.Ok(withFocus(next, "palette"))
	} else if message is model.Msg.PaletteTyped(text) {
		next.palette.text = text
		next.palette.index = 0
	} else if message is model.Msg.PaletteMove(delta) {
		count := len(render.paletteMatches(state))
		if count > 0 {
			next.palette.index = ((state.palette.index + delta) % count + count) % count
		}
	} else if message is model.Msg.PaletteAccept(chosen) {
		found := render.paletteMatches(state)
		mut index := chosen
		if index < 0 {
			index = state.palette.index
		}
		next.palette = model.emptyPalette()
		if found bounds index {
			return Result.Ok(openDoc(next, workspace.joinPath(state.root, found[index])))
		}
		return Result.Ok(withFocus(next, "editor"))
	} else if message is model.Msg.PaletteClose {
		next.palette = model.emptyPalette()
		return Result.Ok(withFocus(next, "editor"))
	} else if message is model.Msg.PickFolder {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		async dialogs.pickAsync(from, "folder", start, render.tx(state, "Abrir pasta"))
	} else if message is model.Msg.PickFile {
		mut start := state.root
		if state.git.repo {
			start = state.git.top
		}
		async dialogs.pickAsync(from, "file", start, render.tx(state, "Abrir arquivo…"))
	} else if message is model.Msg.Picked(mode, path) {
		if mode == "file" {
			return Result.Ok(openDoc(state, path))
		}
		// Uma pasta nova: as abas limpas da anterior fecham, as sujas ficam.
		mut model.Doc[dyn] kept = []
		for each doc in state.docs {
			if model.dirty(doc) {
				append(kept, doc)
			}
		}
		next.docs = kept
		next.active = len(kept) - 1
		next.entrypoint = ""
		next.commit = model.CommitTab("", "", "")
		next.editorView = model.EditorView.DocView()
		next.sideOpen = true
		next.side = model.SideView.ExplorerSide()
		return Result.Ok(openRoot(next, path))
	} else if message is model.Msg.PickFailed(mode, reason) {
		next.status = render.tx(state, "Nenhum seletor de pastas disponível — digite o caminho.")
		if mode == "folder" {
			next.prompt = model.Prompt.OpenFolderPrompt()
			next.promptText = state.root
			next.sideOpen = true
			next.side = model.SideView.ExplorerSide()
			return Result.Ok(withFocus(next, "prompt"))
		}
	} else if message is model.Msg.SetLanguage(code) {
		prefs.language = code
		next = applySettings(state, prefs)
		next.words = i18n.words(code)
		next.status = i18n.tr(next.words, "idioma") + ": " + code
	} else if message is model.Msg.ShowAbout {
		next.about = true
	} else if message is model.Msg.CloseAbout {
		next.about = false
	} else if message is model.Msg.OpenDocs {
		async dialogs.openUrl("https://hive-lang.run")
	} else if message is model.Msg.Quit {
		if state.term.session != 0 {
			_stopped := native.stop(state.term.session)
		}
		for each agent in state.agents.sessions {
			if agent.session != 0 {
				_ended := pty.stop(agent.session)
			}
		}
		async quitSoon()
	} else if message is model.Msg.GotoDefinition(caret) {
		if render.activeDoc(state) is Result.Ok(doc) {
			located := navigate.locate(doc.path, doc.text, caret)
			if located is Result.Ok(target) {
				mut jumped := state
				if workspace.tidy(target.file) != workspace.tidy(doc.path) {
					jumped = openDoc(state, workspace.tidy(target.file))
				}
				jumped.caret = navigate.offsetOf(activeText(jumped), target.line, target.column)
				jumped.textSerial = jumped.textSerial + 1
				jumped.status = render.tx(state, "definição") + ": {workspace.baseName(target.file)}:{target.line}"
				return Result.Ok(clearSuggestions(jumped))
			} else if located is Result.Error(why) {
				next.status = why
			}
		}
	} else {
		return Result.Error(false)
	}
	return Result.Ok(next)
}

proc update(state: model.State, message: model.Msg, from: hive.syslink.Address): model.State {
	mut next := state
	mut prefs := state.settings
	if updateTools(state, message, from) is Result.Ok(done) {
		return done
	}
	if updateVim(state, message, from) is Result.Ok(done) {
		return done
	}
	if updateAgents(state, message, from) is Result.Ok(done) {
		return done
	}
	if message is model.Msg.Toggle(path) {
		return toggle(state, path)
	} else if message is model.Msg.Open(path) {
		return openDoc(state, path)
	} else if message is model.Msg.Refresh {
		return reload(state)
	} else if message is model.Msg.CollapseAll {
		Str[dyn] closed = []
		next.expanded = closed
		return reload(next)
	} else if message is model.Msg.GoUp {
		return openRoot(state, workspace.parentOf(state.root))
	} else if message is model.Msg.StartPrompt(prompt) {
		next.prompt = prompt
		next.promptText = ""
		next.sideOpen = true
		next.side = model.SideView.ExplorerSide()
		if prompt is model.Prompt.OpenFolderPrompt {
			next.promptText = state.root
		}
		return withFocus(next, "prompt")
	} else if message is model.Msg.PromptTyped(text) {
		next.promptText = text
	} else if message is model.Msg.PromptSubmit(text) {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
		mut typed := text
		if typed == "" {
			typed = state.promptText
		}
		if state.prompt is model.Prompt.NewFilePrompt {
			return create(next, typed, false)
		} else if state.prompt is model.Prompt.NewFolderPrompt {
			return create(next, typed, true)
		} else if state.prompt is model.Prompt.OpenFolderPrompt {
			return openRoot(next, typed)
		}
	} else if message is model.Msg.PromptCancel {
		next.prompt = model.Prompt.NoPrompt()
		next.promptText = ""
	} else if message is model.Msg.Focus(index) {
		next.active = index
		next.editorView = model.EditorView.DocView()
		if render.activeDoc(next) is Result.Ok(doc) {
			next.selected = doc.path
		}
	} else if message is model.Msg.CloseDoc(index) {
		return closeDoc(state, index)
	} else if message is model.Msg.CycleTab(step) {
		count := len(state.docs)
		if count > 0 {
			next.active = ((state.active + step) % count + count) % count
			next.editorView = model.EditorView.DocView()
		}
	} else if message is model.Msg.EditAt(text, caret) {
		next = withText(state, text)
		next.caret = caret
		if state.settings.vim && state.vim.mode != model.VimMode.InsertMode() {
			// Colar (ou arrastar texto) fora do modo de inserção também se desfaz com `u`.
			next = withUndo(next, model.Snapshot(activeText(state), state.caret))
			next.vim.mode = model.VimMode.NormalMode()
			return next
		}
		return autoSuggest(next)
	} else if message is model.Msg.CaretAt(caret) {
		next.caret = caret
	} else if message is model.Msg.SuggestAt(caret) {
		next.caret = caret
		next.suggestions = complete.suggest(activeText(state), caret, 12)
		next.suggestIndex = 0
	} else if message is model.Msg.PopupKey(key) {
		count := len(state.suggestions)
		if key == "ArrowDown" && count > 0 {
			next.suggestIndex = (state.suggestIndex + 1) % count
		} else if key == "ArrowUp" && count > 0 {
			next.suggestIndex = (state.suggestIndex - 1 + count) % count
		} else if key == "Enter" || key == "Tab" {
			return acceptSuggestion(state, state.suggestIndex)
		} else {
			return clearSuggestions(state)
		}
	} else if message is model.Msg.AcceptSuggestion(index) {
		return acceptSuggestion(state, index)
	} else if message is model.Msg.CloseSuggest {
		return clearSuggestions(state)
	} else if message is model.Msg.Save {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			outcome := saveDoc(docs[index])
			if outcome is Result.Ok(doc) {
				docs[index] = doc
				next.status = render.tx(state, "salvo") + " {doc.name}"
			} else if outcome is Result.Error(why) {
				next.status = why
			}
		}
		next.docs = docs
		return gitRefresh(next)
	} else if message is model.Msg.SaveAll {
		return gitRefresh(saveAll(state))
	} else if message is model.Msg.PinEntry {
		if render.activeDoc(state) is Result.Ok(doc) {
			next.entrypoint = doc.path
			next.status = render.tx(state, "entrada") + ": {doc.name}"
		}
	} else if message is model.Msg.SetMode(mode) {
		index := state.active
		mut model.Doc[dyn] docs = state.docs
		if docs bounds index {
			docs[index].mode = mode
		}
		next.docs = docs
	} else if message is model.Msg.TogglePreview {
		if render.activeDoc(state) is Result.Ok(doc) {
			if model.isMarkdown(doc.path) {
				mut mode := "preview"
				if doc.mode != "edit" {
					mode = "edit"
				}
				return update(state, model.Msg.SetMode(mode), from)
			}
		}
	} else if message is model.Msg.Invoke(command) {
		target := render.targetOf(state)
		if target == "" || state.running != "" {
			return state
		}
		if state.settings.saveBeforeRun {
			next = saveAll(state)
		}
		next.running = command
		next.output = "$ hivec {command} {target}\n"
		next.pane = model.Pane.OutputPane()
		next.panelOpen = true
		next.status = "{command} {workspace.baseName(target)}…"
		async toolchain.invoke(from, state.settings.compiler, command, target)
	} else if message is model.Msg.Finished(command, output, ok) {
		found := analysis.parseDiagnostics(output)
		next.running = ""
		next.output = state.output + output
		next.diagnostics = found
		next.status = summary(state, command, ok, len(found))
		if command == "analyze" && ok {
			next = withAnalysis(next, output)
		}
		if len(found) > 0 {
			next.pane = model.Pane.ProblemsPane()
			next.panelOpen = true
		}
	} else if message is model.Msg.OpenReport {
		if state.analysisReport != "" && hive.file.exists(state.analysisReport) {
			async dialogs.openUrl(state.analysisReport)
		}
	} else if message is model.Msg.ShowPane(pane) {
		next.pane = pane
		next.panelOpen = true
		if pane is model.Pane.TerminalPane {
			return withFocus(ensureTerminal(next, from), "termInput")
		}
	} else if message is model.Msg.TogglePanel {
		next.panelOpen = !state.panelOpen
	} else if message is model.Msg.ShowSide(side) {
		if state.sideOpen && state.side == side {
			next.sideOpen = false
		} else {
			next.sideOpen = true
			next.side = side
		}
	} else if message is model.Msg.ToggleSidebar {
		next.sideOpen = !state.sideOpen
	} else if message is model.Msg.OpenSettings {
		next.settingsOpen = true
		next.editorView = model.EditorView.SettingsView()
	} else if message is model.Msg.CloseSettings {
		next.settingsOpen = false
		next.editorView = model.EditorView.DocView()
	} else if message is model.Msg.SetTheme(name) {
		prefs.theme = name
		next = applySettings(state, prefs)
		next.status = render.tx(state, "tema") + ": {name}"
	} else if message is model.Msg.ToggleSetting(name) {
		return toggleSetting(state, name)
	} else if message is model.Msg.SetFontSize(size) {
		prefs.fontSize = clampInt(size, 10, 28)
		return applySettings(state, prefs)
	} else if message is model.Msg.SetTabSize(size) {
		prefs.tabSize = clampInt(size, 1, 8)
		return applySettings(state, prefs)
	} else if message is model.Msg.CompilerTyped(text) {
		prefs.compiler = text
		return applySettings(state, prefs)
	} else if message is model.Msg.BrowserTyped(text) {
		prefs.browser = text
		return applySettings(state, prefs)
	} else if message is model.Msg.StartRecording(action) {
		next.recording = action
	} else if message is model.Msg.CancelRecording {
		next.recording = ""
	} else if message is model.Msg.KeyPressed(combo) {
		next.recording = ""
		if combo != "Escape" && state.recording != "" {
			prefs.keymap = keys.assign(prefs.keymap, state.recording, combo)
			next = applySettings(next, prefs)
			next.status = render.tx(state, "atalho gravado") + ": {combo}"
		}
	} else if message is model.Msg.ResetKey(action) {
		prefs.keymap = keys.reset(prefs.keymap, action)
		return applySettings(state, prefs)
	} else if message is model.Msg.ResetKeys {
		prefs.keymap = ""
		next = applySettings(state, prefs)
		next.status = render.tx(state, "atalhos restaurados")
	} else if message is model.Msg.Peek(file, line) {
		return peekAt(state, file, line)
	} else if message is model.Msg.ClosePeek {
		next.peekFile = ""
	} else if message is model.Msg.ClearOutput {
		next.output = ""
		model.Diagnostic[dyn] cleared = []
		next.diagnostics = cleared
	} else if message is model.Msg.Connected {
		next.clients = state.clients + 1
	} else if message is model.Msg.Disconnected {
		next.clients = state.clients - 1
	}
	return next
}

// Um passo da dobra. Quando o documento ativo muda, a página precisa receber
// o texto novo: é o `textSerial` que avisa.
proc step(state: model.State, message: model.Msg, from: hive.syslink.Address): model.State {
	mut next := update(state, message, from)
	jumping := message is model.Msg.GotoDefinition(_) || message is model.Msg.OpenAt(_, _, _)
	if render.activePath(next) != render.activePath(state) {
		next.textSerial = next.textSerial + 1
		if !jumping {
			next.caret = 0
		}
		next = clearSuggestions(next)
		next.vim = vim.reset(next.vim)
	}
	// Outra pasta, uma pasta aberta ou fechada na árvore, um arquivo aberto ou
	// fechado: as pastas vigiadas acompanham.
	if next.root != state.root || next.expanded != state.expanded || len(next.docs) != len(state.docs) {
		_watching := watch.set(watchedFolders(next))
	}
	return next
}

// ── da página para uma mensagem ──────────────────────────────────────────

func numberOr(text: Str, fallback: Int): Int {
	if hive.conv.sti(text) is Result.Ok(n) {
		return n
	}
	return fallback
}

func promptFor(arg: Str): model.Prompt {
	if arg == "newFolder" {
		return model.Prompt.NewFolderPrompt()
	} else if arg == "openFolder" {
		return model.Prompt.OpenFolderPrompt()
	}
	return model.Prompt.NewFilePrompt()
}

func actionMsg(state: model.State, action: Str, caret: Int): Result<model.Msg, Bool> {
	if action == "newFile" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFilePrompt()))
	} else if action == "newFolder" {
		return Result.Ok(model.Msg.StartPrompt(model.Prompt.NewFolderPrompt()))
	} else if action == "save" {
		return Result.Ok(model.Msg.Save())
	} else if action == "saveAll" {
		return Result.Ok(model.Msg.SaveAll())
	} else if action == "closeTab" {
		if render.showingCommit(state) {
			return Result.Ok(model.Msg.CloseCommit())
		}
		if render.showingSettings(state) {
			return Result.Ok(model.Msg.CloseSettings())
		}
		return Result.Ok(model.Msg.CloseDoc(state.active))
	} else if action == "nextTab" {
		return Result.Ok(model.Msg.CycleTab(1))
	} else if action == "prevTab" {
		return Result.Ok(model.Msg.CycleTab(-1))
	} else if action == "togglePanel" {
		return Result.Ok(model.Msg.TogglePanel())
	} else if action == "toggleSidebar" {
		return Result.Ok(model.Msg.ToggleSidebar())
	} else if action == "explorer" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if action == "outline" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
	} else if action == "settings" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "suggest" {
		return Result.Ok(model.Msg.SuggestAt(caret))
	} else if action == "preview" {
		return Result.Ok(model.Msg.TogglePreview())
	} else if action == "check" || action == "run" || action == "test" || action == "build" || action == "analyze" {
		return Result.Ok(model.Msg.Invoke(action))
	} else if action == "terminal" {
		if state.panelOpen && state.pane == model.Pane.TerminalPane() {
			return Result.Ok(model.Msg.TogglePanel())
		}
		return Result.Ok(model.Msg.ShowPane(model.Pane.TerminalPane()))
	} else if action == "maximizePanel" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if action == "git" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
	} else if action == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(caret))
	} else if action == "searchProject" {
		return Result.Ok(model.Msg.ShowSide(model.SideView.SearchSide()))
	} else if action == "quickOpen" {
		return Result.Ok(model.Msg.PaletteOpen())
	} else if action == "find" {
		return Result.Ok(model.Msg.FindOpen(""))
	} else if action == "openFolder" {
		return Result.Ok(model.Msg.PickFolder())
	} else if action == "openFile" {
		return Result.Ok(model.Msg.PickFile())
	} else if action == "quit" {
		return Result.Ok(model.Msg.Quit())
	} else if action == "about" {
		return Result.Ok(model.Msg.ShowAbout())
	} else if action == "docs" {
		return Result.Ok(model.Msg.OpenDocs())
	} else if action == "pin" {
		return Result.Ok(model.Msg.PinEntry())
	} else if action == "problems" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.ProblemsPane()))
	} else if action == "output" {
		return Result.Ok(model.Msg.ShowPane(model.Pane.OutputPane()))
	} else if action == "colorTheme" {
		return Result.Ok(model.Msg.OpenSettings())
	} else if action == "newTerminal" || action == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if action == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	} else if action == "toggleVim" {
		return Result.Ok(model.Msg.ToggleSetting("vim"))
	} else if action == "agent" {
		if showingAgent(state) {
			return Result.Ok(model.Msg.TogglePanel())
		}
		return Result.Ok(model.Msg.ShowAgent(state.agents.current))
	} else if action == "agentClaude" {
		return Result.Ok(model.Msg.ShowAgent("claude"))
	} else if action == "agentCodex" {
		return Result.Ok(model.Msg.ShowAgent("codex"))
	} else if action == "agentOpencode" {
		return Result.Ok(model.Msg.ShowAgent("opencode"))
	} else if action == "agentRestart" {
		return Result.Ok(model.Msg.AgentRestart(state.agents.current))
	}
	return Result.Error(false)
}

func escapeMsg(state: model.State): Result<model.Msg, Bool> {
	if state.vim.prompt != "" {
		return Result.Ok(model.Msg.VimCancel())
	} else if state.recording != "" {
		return Result.Ok(model.Msg.CancelRecording())
	} else if state.about {
		return Result.Ok(model.Msg.CloseAbout())
	} else if state.palette.open {
		return Result.Ok(model.Msg.PaletteClose())
	} else if state.git.confirm != "" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if state.peekFile != "" {
		return Result.Ok(model.Msg.ClosePeek())
	} else if len(state.suggestions) > 0 {
		return Result.Ok(model.Msg.CloseSuggest())
	} else if !(state.prompt == model.Prompt.NoPrompt()) {
		return Result.Ok(model.Msg.PromptCancel())
	} else if state.find.open {
		return Result.Ok(model.Msg.FindClose())
	}
	return Result.Error(false)
}

func clickMsg(state: model.State, event: model.Event): Result<model.Msg, Bool> {
	a := event.act
	arg := event.arg
	if a == "toggle" {
		return Result.Ok(model.Msg.Toggle(arg))
	} else if a == "open" {
		return Result.Ok(model.Msg.Open(arg))
	} else if a == "refresh" {
		return Result.Ok(model.Msg.Refresh())
	} else if a == "collapse" {
		return Result.Ok(model.Msg.CollapseAll())
	} else if a == "up" {
		return Result.Ok(model.Msg.GoUp())
	} else if a == "prompt" {
		return Result.Ok(model.Msg.StartPrompt(promptFor(arg)))
	} else if a == "promptSubmit" {
		return Result.Ok(model.Msg.PromptSubmit(event.text))
	} else if a == "promptCancel" {
		return Result.Ok(model.Msg.PromptCancel())
	} else if a == "focus" {
		return Result.Ok(model.Msg.Focus(numberOr(arg, state.active)))
	} else if a == "close" {
		return Result.Ok(model.Msg.CloseDoc(numberOr(arg, -1)))
	} else if a == "invoke" {
		return Result.Ok(model.Msg.Invoke(arg))
	} else if a == "side" {
		if arg == "outline" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.OutlineSide()))
		} else if arg == "git" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.GitSide()))
		} else if arg == "search" {
			return Result.Ok(model.Msg.ShowSide(model.SideView.SearchSide()))
		}
		return Result.Ok(model.Msg.ShowSide(model.SideView.ExplorerSide()))
	} else if a == "definition" {
		return Result.Ok(model.Msg.GotoDefinition(event.caret))
	} else if a == "findNext" {
		return Result.Ok(model.Msg.FindNext())
	} else if a == "findPrev" {
		return Result.Ok(model.Msg.FindPrev())
	} else if a == "findClose" {
		return Result.Ok(model.Msg.FindClose())
	} else if a == "findCase" {
		return Result.Ok(model.Msg.FindToggleCase())
	} else if a == "searchRun" {
		return Result.Ok(model.Msg.SearchRun())
	} else if a == "searchCase" {
		return Result.Ok(model.Msg.SearchToggleCase())
	} else if a == "openAt" {
		if event.text is "{line}:{column}" {
			return Result.Ok(model.Msg.OpenAt(arg, numberOr(line, 1), numberOr(column, 0)))
		}
		return Result.Ok(model.Msg.OpenAt(arg, 1, 0))
	} else if a == "paletteAccept" {
		return Result.Ok(model.Msg.PaletteAccept(numberOr(arg, -1)))
	} else if a == "paletteMove" {
		return Result.Ok(model.Msg.PaletteMove(numberOr(arg, 1)))
	} else if a == "action" {
		return actionMsg(state, arg, event.caret)
	} else if a == "closeAbout" {
		return Result.Ok(model.Msg.CloseAbout())
	} else if a == "panelMax" {
		return Result.Ok(model.Msg.TogglePanelMax())
	} else if a == "termSubmit" {
		return Result.Ok(model.Msg.TermSubmit(event.text))
	} else if a == "termHistory" {
		return Result.Ok(model.Msg.TermHistory(numberOr(arg, 0)))
	} else if a == "termRestart" {
		return Result.Ok(model.Msg.TermRestart())
	} else if a == "termClear" {
		return Result.Ok(model.Msg.TermClear())
	} else if a == "gitRefresh" {
		return Result.Ok(model.Msg.GitRefresh())
	} else if a == "gitStage" {
		return Result.Ok(model.Msg.GitStage(arg))
	} else if a == "gitUnstage" {
		return Result.Ok(model.Msg.GitUnstage(arg))
	} else if a == "gitStageAll" {
		return Result.Ok(model.Msg.GitStageAll())
	} else if a == "gitUnstageAll" {
		return Result.Ok(model.Msg.GitUnstageAll())
	} else if a == "gitAskDiscard" {
		return Result.Ok(model.Msg.GitAskDiscard(arg))
	} else if a == "gitDiscard" {
		return Result.Ok(model.Msg.GitDiscard(arg))
	} else if a == "gitCancel" {
		return Result.Ok(model.Msg.GitCancelConfirm())
	} else if a == "gitCommit" {
		return Result.Ok(model.Msg.GitCommit())
	} else if a == "gitPush" {
		return Result.Ok(model.Msg.GitPush())
	} else if a == "gitPull" {
		return Result.Ok(model.Msg.GitPull())
	} else if a == "gitInit" {
		return Result.Ok(model.Msg.GitInit())
	} else if a == "gitShow" {
		return Result.Ok(model.Msg.GitShow(arg))
	} else if a == "gitShowWork" {
		return Result.Ok(model.Msg.GitShowWork(arg))
	} else if a == "focusCommit" {
		return Result.Ok(model.Msg.FocusCommit())
	} else if a == "closeCommit" {
		return Result.Ok(model.Msg.CloseCommit())
	} else if a == "settings" {
